استورد sultanc_lsp.protocol.initialize;
استورد std.uri.uri;
استورد std.fs.path;
استورد std.text.compare;

// حالة مجلدات المشروع فقط. لا يقرر هذا المالك أي دلالة Module أو SourceID.
عام نوع مجلد_مساحة_عمل_لغة = {
    العنوان: نص,
    الاسم: نص,
    مسار_الملف: اختيار نص
};

عام نوع جذور_مساحة_عمل_لغة = {
    المجلدات: متجه مجلد_مساحة_عمل_لغة
};

عام عرف جذور_مساحة_عمل_لغة_جديدة(): جذور_مساحة_عمل_لغة {
    دع المجلدات_الفارغة: متجه مجلد_مساحة_عمل_لغة = [];
    دع الناتج: جذور_مساحة_عمل_لغة = { المجلدات: المجلدات_الفارغة };
    أرجع الناتج;
}

عرف حول_وصف_مجلد_مساحة_عمل_لغة(
    الوصف: &وصف_مجلد_مساحة_عمل_لغة
): مجلد_مساحة_عمل_لغة {
    دع القيمة: وصف_مجلد_مساحة_عمل_لغة = *الوصف;
    دع مرجع_العنوان: &نص = &القيمة.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع مرجع_الاسم: &نص = &القيمة.الاسم;
    دع الاسم: نص = *مرجع_الاسم;
    دع المسار: متغير اختيار نص = اختيار.لا_شيء();
    طابق عنوان_ملف_إلى_مسار(&العنوان) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(الخام) -> {
        دع المطبع: نص = طبع_المسار(&الخام);
        المسار := اختيار.بعض(المطبع);
    };
    دع الناتج: مجلد_مساحة_عمل_لغة = {
        العنوان: العنوان,
        الاسم: الاسم,
        مسار_الملف: المسار
    };
    أرجع الناتج;
}

عرف أضف_أو_حدث_مجلد_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    الوصف: &وصف_مجلد_مساحة_عمل_لغة
): فراغ {
    دع الحالة: متغير جذور_مساحة_عمل_لغة = *الجذور;
    دع الجديد: مجلد_مساحة_عمل_لغة = حول_وصف_مجلد_مساحة_عمل_لغة(الوصف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المجلدات) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.المجلدات[ف].العنوان, &الجديد.العنوان)) {
            الحالة.المجلدات[ف] := الجديد;
            *الجذور := الحالة;
            أرجع;
        };
        ف := ف + 1;
    }
    ألحق(الحالة.المجلدات, الجديد);
    *الجذور := الحالة;
}

عرف احذف_مجلد_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    العنوان: &نص
): فراغ {
    دع الحالة: جذور_مساحة_عمل_لغة = *الجذور;
    دع الباقية: متغير متجه مجلد_مساحة_عمل_لغة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المجلدات) مثل غير_موقع)) {
        لو (!نصان_متساويان(&الحالة.المجلدات[ف].العنوان, العنوان)) {
            دع مرجع_المجلد: &مجلد_مساحة_عمل_لغة = &الحالة.المجلدات[ف];
            دع المجلد: مجلد_مساحة_عمل_لغة = *مرجع_المجلد;
            ألحق(الباقية, المجلد);
        };
        ف := ف + 1;
    }
    دع الجديد: جذور_مساحة_عمل_لغة = { المجلدات: الباقية };
    *الجذور := الجديد;
}

عام عرف هيئ_جذور_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    المعاملات: &معاملات_تهيئة_لغة
): فراغ {
    دع الحالة: معاملات_تهيئة_لغة = *المعاملات;
    دع الجديد: متغير جذور_مساحة_عمل_لغة = جذور_مساحة_عمل_لغة_جديدة();
    طابق الحالة.مجلدات_مساحة_العمل مع
    | اختيار.بعض(المجلدات) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المجلدات) مثل غير_موقع)) {
            أضف_أو_حدث_مجلد_مساحة_عمل_لغة(&متغير الجديد, &المجلدات[ف]);
            ف := ف + 1;
        }
    }
    | اختيار.لا_شيء -> {
        طابق الحالة.عنوان_الجذر مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(العنوان) -> {
            دع الوصف: وصف_مجلد_مساحة_عمل_لغة = {
                العنوان: العنوان,
                الاسم: «»
            };
            أضف_أو_حدث_مجلد_مساحة_عمل_لغة(&متغير الجديد, &الوصف);
        };
    };
    *الجذور := الجديد;
}

عام عرف طبق_تغيير_جذور_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    التغيير: &تغيير_مجلدات_مساحة_عمل_لغة
): فراغ {
    دع القيمة: تغيير_مجلدات_مساحة_عمل_لغة = *التغيير;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.المحذوفة) مثل غير_موقع)) {
        احذف_مجلد_مساحة_عمل_لغة(الجذور, &القيمة.المحذوفة[ف].العنوان);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(القيمة.المضافة) مثل غير_موقع)) {
        أضف_أو_حدث_مجلد_مساحة_عمل_لغة(الجذور, &القيمة.المضافة[ف]);
        ف := ف + 1;
    }
}
