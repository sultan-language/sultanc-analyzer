استورد sultanc_lsp.workspace.documents;
استورد sultanc_lsp.protocol.text_document;
استورد std.encoding.positions;

// التحويل الوحيد عند حد LSP: UTF-16 في البروتوكول ↔ إزاحة بايت UTF-8 في SultanC.
عام عرف موضع_لغة_إلى_إزاحة_بايت(
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع موضع16: موضع_نصي_يوتيف16 = {
        السطر: الموضع.السطر,
        العمود: الموضع.المحرف
    };
    أرجع موضع_نصي_يوتيف16_إلى_إزاحة_بايت(&د.النص, &د.فهرس_السطور, &موضع16);
}

عام عرف إزاحة_بايت_إلى_موضع_لغة(
    المستند: &مستند_لغة_مفتوح,
    الإزاحة: غير_موقع
): نتيجة موضع_تغيير_لغة, خطأ_موضع_يونيكود {
    دع د: مستند_لغة_مفتوح = *المستند;
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&د.النص, &د.فهرس_السطور, الإزاحة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموضع) -> {
        دع الناتج: موضع_تغيير_لغة = {
            السطر: الموضع.السطر,
            المحرف: الموضع.العمود
        };
        أرجع نتيجة.نجح(الناتج);
    };
}
