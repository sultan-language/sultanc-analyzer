استورد std.collections.text_index_map;
استورد std.encoding.positions;
استورد std.uri.uri;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.text.compare;

عرف انسخ_نص_مستند_لغة(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف انسخ_مسار_مستند_لغة(القيمة: &اختيار نص): اختيار نص {
    دع النسخة: اختيار نص = *القيمة;
    أرجع النسخة;
}

عام نوع مستند_لغة_مفتوح = {
    العنوان: نص,
    مسار_الملف: اختيار نص,
    اللغة: نص,
    الإصدار: عدد,
    المراجعة: غير_موقع,
    مراجعة_الحفظ: اختيار غير_موقع,
    مراجعة_رفض_الدلالات: اختيار غير_موقع,
    النص: نص,
    فهرس_السطور: فهرس_سطور
};

عام نوع مساحة_عمل_لغة = {
    المستندات: متجه اختيار مستند_لغة_مفتوح,
    فهرس_العناوين: خريطة_نص_فهرس,
    فهرس_المسارات: خريطة_نص_فهرس,
    المراجعة: غير_موقع
};

عرف مسار_ملف_عنوان_لغة(العنوان: &نص): اختيار نص {
    طابق عنوان_ملف_إلى_مسار(العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(المسار) -> {
        دع المطبع: نص = طبع_المسار(&المسار);
        أرجع اختيار.بعض(المطبع);
    };
}

// Read-only URI adapter for semantic requests whose hierarchy target is not open.
// File/URI decoding remains workspace ownership; semantic analysis still goes through
// the canonical compiler frontend.
عام عرف مستند_لغة_للقراءة_من_عنوان(العنوان: &نص): اختيار مستند_لغة_مفتوح {
    طابق مسار_ملف_عنوان_لغة(العنوان) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المسار) -> {
        طابق اقرأ_الملف(&المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(النص) -> { أرجع ابن_مستند_لغة_للقراءة(&المسار, النص); };
    };
}

عرف احذف_فهرسة_مسار_مستند(
    الفهرس: &متغير خريطة_نص_فهرس,
    المستند: &مستند_لغة_مفتوح
): فراغ {
    دع القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مسار_الملف مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المسار) -> {
        احذف_من_خريطة_نص_فهرس(الفهرس, &المسار);
    };
}

عرف أضف_فهرسة_مسار_مستند(
    خريطة_المسارات: &متغير خريطة_نص_فهرس,
    المسار: &اختيار نص,
    فهرس_المستند: غير_موقع
): فراغ {
    دع قيمة_المسار: اختيار نص = *المسار;
    طابق قيمة_المسار مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        أدرج_في_خريطة_نص_فهرس(خريطة_المسارات, القيمة, فهرس_المستند);
    };
}

عام عرف ابن_مستند_لغة_للقراءة(
    المسار: &نص,
    النص: نص
): اختيار مستند_لغة_مفتوح {
    دع المطبع: نص = طبع_المسار(المسار);
    دع العنوان: متغير نص = «»;
    طابق مسار_إلى_عنوان_ملف(&المطبع) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
    دع فهرس_السطور: فهرس_سطور = ابن_فهرس_السطور(&النص);
    دع بلا_حفظ: اختيار غير_موقع = اختيار.لا_شيء();
    دع بلا_رفض: اختيار غير_موقع = اختيار.لا_شيء();
    دع اختيار_المسار: اختيار نص = اختيار.بعض(المطبع);
    دع المستند: مستند_لغة_مفتوح = {
        العنوان: العنوان,
        مسار_الملف: اختيار_المسار,
        اللغة: «sultanc»,
        الإصدار: 0,
        المراجعة: 0,
        مراجعة_الحفظ: بلا_حفظ,
        مراجعة_رفض_الدلالات: بلا_رفض,
        النص: النص,
        فهرس_السطور: فهرس_السطور
    };
    أرجع اختيار.بعض(المستند);
}

عام عرف مساحة_عمل_لغة_جديدة(): مساحة_عمل_لغة {
    دع المستندات_الفارغة: متجه اختيار مستند_لغة_مفتوح = [];
    دع فهرس_العناوين_الفارغ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع فهرس_المسارات_الفارغ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الناتج: مساحة_عمل_لغة = {
        المستندات: المستندات_الفارغة,
        فهرس_العناوين: فهرس_العناوين_الفارغ,
        فهرس_المسارات: فهرس_المسارات_الفارغ,
        المراجعة: 0
    };
    أرجع الناتج;
}

عام عرف افتح_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: نص,
    اللغة: نص,
    الإصدار: عدد,
    النص: نص
): منطقي {
    دع الحالة: متغير مساحة_عمل_لغة = *المساحة;
    الحالة.المراجعة := الحالة.المراجعة + 1;
    دع عنوان_المستند: نص = انسخ_نص_مستند_لغة(&العنوان);
    دع مسار_الملف: اختيار نص = مسار_ملف_عنوان_لغة(&العنوان);
    دع مسار_المستند: اختيار نص = انسخ_مسار_مستند_لغة(&مسار_الملف);
    دع مراجعة_الحفظ_الأولية: اختيار غير_موقع = اختيار.لا_شيء();
    دع مراجعة_رفض_الدلالات_الأولية: اختيار غير_موقع = اختيار.لا_شيء();
    دع فهرس_سطور_المستند: فهرس_سطور = ابن_فهرس_السطور(&النص);
    دع المستند: مستند_لغة_مفتوح = {
        العنوان: عنوان_المستند,
        مسار_الملف: مسار_المستند,
        اللغة: اللغة,
        الإصدار: الإصدار,
        المراجعة: الحالة.المراجعة,
        مراجعة_الحفظ: مراجعة_الحفظ_الأولية,
        مراجعة_رفض_الدلالات: مراجعة_رفض_الدلالات_الأولية,
        النص: النص,
        فهرس_السطور: فهرس_سطور_المستند
    };

    دع فهرس_المستند: متغير غير_موقع = 0;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, &العنوان) مع
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) { أرجع خطأ; };
        طابق الحالة.المستندات[الفهرس] مع
        | اختيار.بعض(القديم) -> {
            احذف_فهرسة_مسار_مستند(&متغير الحالة.فهرس_المسارات, &القديم);
        }
        | اختيار.لا_شيء -> { };
        الحالة.المستندات[الفهرس] := اختيار.بعض(المستند);
        فهرس_المستند := الفهرس;
    }
    | اختيار.لا_شيء -> {
        فهرس_المستند := الطول(الحالة.المستندات) مثل غير_موقع;
        ألحق(الحالة.المستندات, اختيار.بعض(المستند));
        أدرج_في_خريطة_نص_فهرس(&متغير الحالة.فهرس_العناوين, العنوان, فهرس_المستند);
    };
    أضف_فهرسة_مسار_مستند(&متغير الحالة.فهرس_المسارات, &مسار_الملف, فهرس_المستند);
    *المساحة := الحالة;
    أرجع صواب;
}

عام عرف غير_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    الإصدار: عدد,
    النص: نص
): منطقي {
    دع الحالة: متغير مساحة_عمل_لغة = *المساحة;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, العنوان) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) { أرجع خطأ; };
        طابق الحالة.المستندات[الفهرس] مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القديم) -> {
            // LSP TextDocumentItem.version يجب أن يزيد رتيبا؛ النسخة المكررة قد تعيد
            // تطبيق incremental edits، ولذلك نرفض <= وليس فقط النسخة الأقدم.
            لو (الإصدار <= القديم.الإصدار) { أرجع خطأ; };
            الحالة.المراجعة := الحالة.المراجعة + 1;
            دع فهرس_سطور_الجديد: فهرس_سطور = ابن_فهرس_السطور(&النص);
            دع مرجع_القديم: &مستند_لغة_مفتوح = &القديم;
            دع الجديد: متغير مستند_لغة_مفتوح = *مرجع_القديم;
            الجديد.الإصدار := الإصدار;
            الجديد.المراجعة := الحالة.المراجعة;
            الجديد.مراجعة_رفض_الدلالات := اختيار.لا_شيء();
            الجديد.النص := النص;
            الجديد.فهرس_السطور := فهرس_سطور_الجديد;
            الحالة.المستندات[الفهرس] := اختيار.بعض(الجديد);
        };
    };
    *المساحة := الحالة;
    أرجع صواب;
}

عام عرف احفظ_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    النص: &اختيار نص
): منطقي {
    دع الحالة: متغير مساحة_عمل_لغة = *المساحة;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, العنوان) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) { أرجع خطأ; };
        طابق الحالة.المستندات[الفهرس] مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القديم) -> {
            دع الجديد: متغير مستند_لغة_مفتوح = القديم;
            دع قيمة_النص: اختيار نص = *النص;
            طابق قيمة_النص مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(المحفوظ) -> {
                لو (!نصان_متساويان(&الجديد.النص, &المحفوظ)) {
                    الحالة.المراجعة := الحالة.المراجعة + 1;
                    الجديد.المراجعة := الحالة.المراجعة;
                    الجديد.مراجعة_رفض_الدلالات := اختيار.لا_شيء();
                    دع فهرس_سطور_المحفوظ: فهرس_سطور = ابن_فهرس_السطور(&المحفوظ);
                    الجديد.النص := المحفوظ;
                    الجديد.فهرس_السطور := فهرس_سطور_المحفوظ;
                };
            };
            الجديد.مراجعة_الحفظ := اختيار.بعض(الجديد.المراجعة);
            الحالة.المستندات[الفهرس] := اختيار.بعض(الجديد);
        };
    };
    *المساحة := الحالة;
    أرجع صواب;
}

عام عرف اغلق_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص
): منطقي {
    دع الحالة: متغير مساحة_عمل_لغة = *المساحة;
    طابق احذف_من_خريطة_نص_فهرس(&متغير الحالة.فهرس_العناوين, العنوان) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) { أرجع خطأ; };
        طابق الحالة.المستندات[الفهرس] مع
        | اختيار.بعض(المستند) -> {
            احذف_فهرسة_مسار_مستند(&متغير الحالة.فهرس_المسارات, &المستند);
        }
        | اختيار.لا_شيء -> { };
        الحالة.المستندات[الفهرس] := اختيار.لا_شيء();
    };
    الحالة.المراجعة := الحالة.المراجعة + 1;
    *المساحة := الحالة;
    أرجع صواب;
}

عام عرف مستند_لغة_عند(
    المساحة: &مساحة_عمل_لغة,
    العنوان: &نص
): اختيار مستند_لغة_مفتوح {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, العنوان) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        دع مرجع_المستند: &اختيار مستند_لغة_مفتوح = &الحالة.المستندات[الفهرس];
        دع النتيجة: اختيار مستند_لغة_مفتوح = *مرجع_المستند;
        أرجع النتيجة;
    };
}

عام عرف مستند_لغة_بالمسار(
    المساحة: &مساحة_عمل_لغة,
    المسار: &نص
): اختيار مستند_لغة_مفتوح {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    دع المطبع: نص = طبع_المسار(المسار);
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_المسارات, &المطبع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        دع مرجع_المستند: &اختيار مستند_لغة_مفتوح = &الحالة.المستندات[الفهرس];
        دع النتيجة: اختيار مستند_لغة_مفتوح = *مرجع_المستند;
        أرجع النتيجة;
    };
}

عام عرف لقطة_مستند_لغة_حديثة(
    المساحة: &مساحة_عمل_لغة,
    العنوان: &نص,
    الإصدار: عدد,
    المراجعة: غير_موقع
): منطقي {
    طابق مستند_لغة_عند(المساحة, العنوان) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الحالي) -> {
        أرجع (الحالي.الإصدار == الإصدار) && (الحالي.المراجعة == المراجعة);
    };
}

عام عرف مستند_لغة_محفوظ(المستند: &مستند_لغة_مفتوح): منطقي {
    دع القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مراجعة_الحفظ مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المراجعة) -> { أرجع المراجعة == القيمة.المراجعة; };
}


عام عرف سجل_رفض_دلالات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    المراجعة: غير_موقع
): منطقي {
    دع الحالة: متغير مساحة_عمل_لغة = *المساحة;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, العنوان) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الفهرس) -> {
        لو (الفهرس >= (الطول(الحالة.المستندات) مثل غير_موقع)) { أرجع خطأ; };
        طابق الحالة.المستندات[الفهرس] مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المستند) -> {
            لو (المستند.المراجعة != المراجعة) { أرجع خطأ; };
            دع الجديد: متغير مستند_لغة_مفتوح = المستند;
            الجديد.مراجعة_رفض_الدلالات := اختيار.بعض(المراجعة);
            الحالة.المستندات[الفهرس] := اختيار.بعض(الجديد);
        };
    };
    *المساحة := الحالة;
    أرجع صواب;
}

عام عرف دلالات_مستند_مرفوضة_للمراجعة(
    المستند: &مستند_لغة_مفتوح
): منطقي {
    دع القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مراجعة_رفض_الدلالات مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المراجعة) -> { أرجع المراجعة == القيمة.المراجعة; };
}

عام عرف توجد_دلالات_مرفوضة_في_مساحة_العمل_لغة(
    المساحة: &مساحة_عمل_لغة
): منطقي {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المستندات) مثل غير_موقع)) {
        طابق الحالة.المستندات[ف] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المستند) -> {
            لو (دلالات_مستند_مرفوضة_للمراجعة(&المستند)) {
                أرجع صواب;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}
