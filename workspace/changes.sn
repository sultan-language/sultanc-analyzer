استورد sultanc_lsp.workspace.documents;
استورد sultanc_lsp.workspace.positions;
استورد sultanc_lsp.protocol.text_document;
استورد std.text.substring;
استورد std.text.transform;
استورد std.encoding.positions;

عرف استبدل_نطاق_مستند_لغة(
    المستند: &مستند_لغة_مفتوح,
    النطاق: &نطاق_تغيير_لغة,
    البديل: نص
): اختيار نص {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع حدود: نطاق_تغيير_لغة = *النطاق;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = 0;

    طابق موضع_لغة_إلى_إزاحة_بايت(&د, حدود.البداية) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الإزاحة) -> { البداية := الإزاحة; };
    طابق موضع_لغة_إلى_إزاحة_بايت(&د, حدود.النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الإزاحة) -> { النهاية := الإزاحة; };
    لو (النهاية < البداية) { أرجع اختيار.لا_شيء(); };

    دع العدد: غير_موقع = الطول(د.النص) مثل غير_موقع;
    دع السابق: متغير نص = «»;
    دع اللاحق: متغير نص = «»;
    طابق مقطع_نص(&د.النص, 0, البداية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { السابق := القيمة; };
    طابق مقطع_نص(&د.النص, النهاية, العدد - النهاية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { اللاحق := القيمة; };

    دع الأجزاء: متجه نص = [السابق, البديل, اللاحق];
    دع الفاصل: نص = «»;
    أرجع اختيار.بعض(صل_النصوص(&الأجزاء, &الفاصل));
}

عام عرف طبق_تغييرات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    التغيير: &تغيير_مستند_لغة
): منطقي {
    دع الطلب: تغيير_مستند_لغة = *التغيير;
    دع مرجع_العنوان: &نص = &الطلب.العنوان;
    دع عنوان_الطلب: نص = *مرجع_العنوان;
    دع إصدار_الطلب: عدد = الطلب.الإصدار;
    دع لقطة_المساحة: مساحة_عمل_لغة = *المساحة;
    طابق مستند_لغة_عند(&لقطة_المساحة, &عنوان_الطلب) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المستند) -> {
        دع الحالي: متغير مستند_لغة_مفتوح = المستند;

        // رفض النسخة المكررة/الأقدم قبل تطبيق أي تعديل يمنع تكرار incremental edits.
        لو (إصدار_الطلب <= الحالي.الإصدار) { أرجع خطأ; };

        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الطلب.التغييرات) مثل غير_موقع)) {
            طابق الطلب.التغييرات[ف] مع
            | تغيير_محتوى_لغة.كامل(النص) -> {
                دع فهرس_سطور_النص: فهرس_سطور = ابن_فهرس_السطور(&النص);
                الحالي.النص := النص;
                الحالي.فهرس_السطور := فهرس_سطور_النص;
            }
            | تغيير_محتوى_لغة.نطاق(النطاق, البديل) -> {
                طابق استبدل_نطاق_مستند_لغة(&الحالي, &النطاق, البديل) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(النص) -> {
                    دع فهرس_سطور_النص: فهرس_سطور = ابن_فهرس_السطور(&النص);
                    الحالي.النص := النص;
                    الحالي.فهرس_السطور := فهرس_سطور_النص;
                };
            };
            ف := ف + 1;
        }

        دع مرجع_النص_النهائي: &نص = &الحالي.النص;
        دع النص_النهائي: نص = *مرجع_النص_النهائي;
        أرجع غير_مستند_لغة(
            المساحة, &عنوان_الطلب, إصدار_الطلب, النص_النهائي
        );
    };
}
