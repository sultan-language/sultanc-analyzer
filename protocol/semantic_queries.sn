استورد sultanc_lsp.protocol.model;
استورد sultanc_lsp.protocol.encode;
استورد sultanc_lsp.protocol.text_document;
استورد sultanc_lsp.analysis.semantic_queries;
استورد std.json.value;
استورد compiler.frontend.names.symbols;
استورد std.collections.text_index_map;
استورد std.text.compare;
استورد std.text.number;

عرف انسخ_نص_بروتوكول_دلالي(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف رد_نتيجة_عدم_دلالية(المعرف: معرف_طلب_جسون_اربيسي): وثيقة_جسون {
    دع المصفوفات: متجه مصفوفة_جسون = [];
    دع الكائنات: متجه كائن_جسون = [];
    دع العدم: قيمة_جسون = قيمة_جسون.عدم();
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, العدم, المصفوفات, الكائنات);
}

عام عرف ابن_رد_تحويم_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    النص: &اختيار نص,
    النطاق: &اختيار نطاق_تغيير_لغة
): وثيقة_جسون {
    دع نسخة_النص: اختيار نص = *النص;
    دع نسخة_النطاق: اختيار نطاق_تغيير_لغة = *النطاق;
    طابق نسخة_النص مع
    | اختيار.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختيار.بعض(المحتوى) -> {
        دع الكائنات: متغير متجه كائن_جسون = [];
        دع فهرس_المحتويات: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع قيمة_نوع_المحتوى: قيمة_جسون = قيمة_جسون.سلسلة(«markdown»);
        دع مدخل_نوع_المحتوى: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_نوع_المحتوى };
        دع قيمة_المحتوى: قيمة_جسون = قيمة_جسون.سلسلة(المحتوى);
        دع مدخل_المحتوى: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_المحتوى };
        دع مداخل_المحتويات: متجه مدخل_كائن_جسون = [مدخل_نوع_المحتوى, مدخل_المحتوى];
        دع فهرس_خريطة_المحتويات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع كائن_المحتويات: كائن_جسون = { المداخل: مداخل_المحتويات, الفهرس: فهرس_خريطة_المحتويات };
        ألحق(الكائنات, كائن_المحتويات);
        دع قيمة_المحتويات: قيمة_جسون = قيمة_جسون.كائن(فهرس_المحتويات);
        دع مدخل_المحتويات: مدخل_كائن_جسون = { المفتاح: «contents», القيمة: قيمة_المحتويات };
        دع مداخل_التحويم: متغير متجه مدخل_كائن_جسون = [مدخل_المحتويات];
        طابق نسخة_النطاق مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(نطاق_التحويم) -> {
            دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, نطاق_التحويم);
            دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            ألحق(مداخل_التحويم, مدخل_النطاق);
        };
        دع فهرس_التحويم: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع فهرس_خريطة_التحويم: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع كائن_التحويم: كائن_جسون = { المداخل: مداخل_التحويم, الفهرس: فهرس_خريطة_التحويم };
        ألحق(الكائنات, كائن_التحويم);
        دع المصفوفات: متجه مصفوفة_جسون = [];
        دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحويم);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تعريف_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الموقع: &اختيار موقع_دلالي_لغة
): وثيقة_جسون {
    دع نسخة: اختيار موقع_دلالي_لغة = *الموقع;
    طابق نسخة مع
    | اختيار.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختيار.بعض(القيمة) -> {
        دع الكائنات: متغير متجه كائن_جسون = [];
        دع مرجع_العنوان: &نص = &القيمة.العنوان;
        دع العنوان: نص = *مرجع_العنوان;
        دع الفهرس: غير_موقع = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, العنوان, القيمة.النطاق);
        دع المصفوفات: متجه مصفوفة_جسون = [];
        دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(الفهرس);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تهيئة_إعادة_تسمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    النطاق: &اختيار نطاق_تغيير_لغة
): وثيقة_جسون {
    دع نسخة: اختيار نطاق_تغيير_لغة = *النطاق;
    طابق نسخة مع
    | اختيار.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختيار.بعض(القيمة) -> {
        دع الكائنات: متغير متجه كائن_جسون = [];
        دع الفهرس: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, القيمة);
        دع المصفوفات: متجه مصفوفة_جسون = [];
        دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(الفهرس);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عرف ابن_رد_مواقع_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة,
    نطاقات_فقط: منطقي
): وثيقة_جسون {
    دع نسخة_المواقع: متجه موقع_دلالي_لغة = *المواقع;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(نسخة_المواقع) مثل غير_موقع)) {
        دع مرجع_الموقع: &موقع_دلالي_لغة = &نسخة_المواقع[ف];
        دع الموقع: موقع_دلالي_لغة = *مرجع_الموقع;
        لو (نطاقات_فقط) {
            دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الموقع.النطاق);
            دع فهرس_التمييز: غير_موقع = الطول(الكائنات) مثل غير_موقع;
            دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            دع مداخل_التمييز: متجه مدخل_كائن_جسون = [مدخل_النطاق];
            دع فهرس_خريطة_التمييز: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            دع التمييز: كائن_جسون = { المداخل: مداخل_التمييز, الفهرس: فهرس_خريطة_التمييز };
            ألحق(الكائنات, التمييز);
            ألحق(القيم, قيمة_جسون.كائن(فهرس_التمييز));
        } وإلا {
            دع مرجع_العنوان: &نص = &الموقع.العنوان;
            دع العنوان: نص = *مرجع_العنوان;
            دع فهرس_الموقع: غير_موقع = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, العنوان, الموقع.النطاق);
            ألحق(القيم, قيمة_جسون.كائن(فهرس_الموقع));
        };
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع فهرس_المصفوفة: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_تمييزات_مستند_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_مواقع_دلالية_لغة(المعرف, المواقع, صواب);
}

عام عرف ابن_رد_مراجع_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_مواقع_دلالية_لغة(المعرف, المواقع, خطأ);
}

نوع مجموعة_إعادة_تسمية_لغة = {
    العنوان: نص,
    النطاقات: متجه نطاق_تغيير_لغة
};

عرف اجمع_مواقع_إعادة_تسمية_لغة(
    المواقع: &متجه موقع_دلالي_لغة
): متجه مجموعة_إعادة_تسمية_لغة {
    دع المدخل: متجه موقع_دلالي_لغة = *المواقع;
    دع المجموعات: متغير متجه مجموعة_إعادة_تسمية_لغة = [];
    دع فهرس_المجموعات: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المدخل) مثل غير_موقع)) {
        دع مرجع_الموقع: &موقع_دلالي_لغة = &المدخل[ف];
        دع الموقع: موقع_دلالي_لغة = *مرجع_الموقع;
        دع مرجع_العنوان: &نص = &الموقع.العنوان;
        طابق ابحث_في_خريطة_نص_فهرس(&فهرس_المجموعات, مرجع_العنوان) مع
        | اختيار.بعض(ج) -> {
            ألحق(المجموعات[ج].النطاقات, الموقع.النطاق);
        }
        | اختيار.لا_شيء -> {
            دع ج: غير_موقع = الطول(المجموعات) مثل غير_موقع;
            دع عنوان_المجموعة: نص = *مرجع_العنوان;
            دع عنوان_الفهرس: نص = *مرجع_العنوان;
            دع النطاقات: متجه نطاق_تغيير_لغة = [الموقع.النطاق];
            دع المجموعة: مجموعة_إعادة_تسمية_لغة = {
                العنوان: عنوان_المجموعة,
                النطاقات: النطاقات
            };
            ألحق(المجموعات, المجموعة);
            أدرج_في_خريطة_نص_فهرس(&متغير فهرس_المجموعات, عنوان_الفهرس, ج);
        };
        ف := ف + 1;
    }
    أرجع المجموعات;
}

عام عرف ابن_رد_إعادة_تسمية_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة,
    الاسم_الجديد: &نص
): وثيقة_جسون {
    دع المجموعات: متجه مجموعة_إعادة_تسمية_لغة = اجمع_مواقع_إعادة_تسمية_لغة(المواقع);
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع مداخل_التغييرات: متغير متجه مدخل_كائن_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المجموعات) مثل غير_موقع)) {
        دع مرجع_المجموعة: &مجموعة_إعادة_تسمية_لغة = &المجموعات[ف];
        دع المجموعة: مجموعة_إعادة_تسمية_لغة = *مرجع_المجموعة;
        دع قيم_التحريرات: متغير متجه قيمة_جسون = [];
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(المجموعة.النطاقات) مثل غير_موقع)) {
            دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, المجموعة.النطاقات[ج]);
            دع فهرس_التحرير: غير_موقع = الطول(الكائنات) مثل غير_موقع;
            دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            دع نسخة_الاسم: نص = انسخ_نص_بروتوكول_دلالي(الاسم_الجديد);
            دع قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_الاسم);
            دع مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_الاسم };
            دع مداخل_التحرير: متجه مدخل_كائن_جسون = [مدخل_النطاق, مدخل_الاسم];
            دع فهرس_خريطة_التحرير: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            دع التحرير: كائن_جسون = { المداخل: مداخل_التحرير, الفهرس: فهرس_خريطة_التحرير };
            ألحق(الكائنات, التحرير);
            ألحق(قيم_التحريرات, قيمة_جسون.كائن(فهرس_التحرير));
            ج := ج + 1;
        }
        دع فهرس_مصفوفة_التحريرات: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
        دع مصفوفة_التحريرات: مصفوفة_جسون = { القيم: قيم_التحريرات };
        ألحق(المصفوفات, مصفوفة_التحريرات);
        دع مرجع_العنوان: &نص = &المجموعة.العنوان;
        دع العنوان: نص = *مرجع_العنوان;
        دع قيمة_التحريرات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التحريرات);
        دع المدخل: مدخل_كائن_جسون = { المفتاح: العنوان, القيمة: قيمة_التحريرات };
        ألحق(مداخل_التغييرات, المدخل);
        ف := ف + 1;
    }
    دع فهرس_التغييرات: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع فهرس_خريطة_التغييرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع كائن_التغييرات: كائن_جسون = { المداخل: مداخل_التغييرات, الفهرس: فهرس_خريطة_التغييرات };
    ألحق(الكائنات, كائن_التغييرات);
    دع فهرس_تحرير_المساحة: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_التغييرات: قيمة_جسون = قيمة_جسون.كائن(فهرس_التغييرات);
    دع مدخل_التغييرات: مدخل_كائن_جسون = { المفتاح: «changes», القيمة: قيمة_التغييرات };
    دع مداخل_تحرير_المساحة: متجه مدخل_كائن_جسون = [مدخل_التغييرات];
    دع فهرس_خريطة_تحرير_المساحة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع تحرير_المساحة: كائن_جسون = { المداخل: مداخل_تحرير_المساحة, الفهرس: فهرس_خريطة_تحرير_المساحة };
    ألحق(الكائنات, تحرير_المساحة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_تحرير_المساحة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عرف نوع_عنصر_إكمال_دلالي_لغة(النوع: نوع_تصريح): نص {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع «3»; }
    | نوع_تصريح.دالة_خارجية -> { أرجع «3»; }
    | نوع_تصريح.مرادف_نوع -> { أرجع «25»; }
    | نوع_تصريح.سجل -> { أرجع «22»; }
    | نوع_تصريح.تعداد -> { أرجع «13»; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع «20»; }
    | نوع_تصريح.معامل -> { أرجع «6»; }
    | نوع_تصريح.ربط_محلي -> { أرجع «6»; };
}

عام عرف ابن_رد_إكمال_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الاقتراحات: &متجه اقتراح_إكمال_دلالي_لغة
): وثيقة_جسون {
    دع المدخل: متجه اقتراح_إكمال_دلالي_لغة = *الاقتراحات;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المدخل) مثل غير_موقع)) {
        دع مرجع_الاقتراح: &اقتراح_إكمال_دلالي_لغة = &المدخل[ف];
        دع الاقتراح: اقتراح_إكمال_دلالي_لغة = *مرجع_الاقتراح;
        دع مرجع_النص: &نص = &الاقتراح.النص;
        دع النص: نص = *مرجع_النص;
        دع قيمة_النص: قيمة_جسون = قيمة_جسون.سلسلة(النص);
        دع مدخل_النص: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_النص };
        دع نص_النوع: نص = نوع_عنصر_إكمال_دلالي_لغة(الاقتراح.النوع);
        دع قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
        دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        دع المداخل: متغير متجه مدخل_كائن_جسون = [مدخل_النص, مدخل_النوع];
        طابق الاقتراح.التفصيل مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(التفصيل) -> {
            دع قيمة_التفصيل: قيمة_جسون = قيمة_جسون.سلسلة(التفصيل);
            دع مدخل_التفصيل: مدخل_كائن_جسون = { المفتاح: «detail», القيمة: قيمة_التفصيل };
            ألحق(المداخل, مدخل_التفصيل);
        };
        دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع الفهرس: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
        ألحق(الكائنات, الكائن);
        دع قيمة_العنصر: قيمة_جسون = قيمة_جسون.كائن(الفهرس);
        ألحق(القيم, قيمة_العنصر);
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع فهرس_المصفوفة: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}


عام عرف ابن_رد_توقيع_استدعاء_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    التوقيع: &اختيار معلومات_توقيع_استدعاء_لغة
): وثيقة_جسون {
    دع النسخة: اختيار معلومات_توقيع_استدعاء_لغة = *التوقيع;
    طابق النسخة مع
    | اختيار.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختيار.بعض(المعلومات) -> {
        دع الكائنات: متغير متجه كائن_جسون = [];
        دع المصفوفات: متغير متجه مصفوفة_جسون = [];

        دع قيم_المعاملات: متغير متجه قيمة_جسون = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المعلومات.المعاملات) مثل غير_موقع)) {
            دع مرجع_المعامل: &نص = &المعلومات.المعاملات[ف];
            دع نص_المعامل: نص = *مرجع_المعامل;
            دع قيمة_التسمية: قيمة_جسون = قيمة_جسون.سلسلة(نص_المعامل);
            دع مدخل_التسمية: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_التسمية };
            دع مداخل_المعامل: متجه مدخل_كائن_جسون = [مدخل_التسمية];
            دع فهرس_خريطة_المعامل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            دع فهرس_المعامل: غير_موقع = الطول(الكائنات) مثل غير_موقع;
            دع كائن_المعامل: كائن_جسون = { المداخل: مداخل_المعامل, الفهرس: فهرس_خريطة_المعامل };
            ألحق(الكائنات, كائن_المعامل);
            ألحق(قيم_المعاملات, قيمة_جسون.كائن(فهرس_المعامل));
            ف := ف + 1;
        }
        دع فهرس_مصفوفة_المعاملات: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
        دع مصفوفة_المعاملات: مصفوفة_جسون = { القيم: قيم_المعاملات };
        ألحق(المصفوفات, مصفوفة_المعاملات);

        دع نص_تسمية_التوقيع: نص = انسخ_نص_بروتوكول_دلالي(&المعلومات.التسمية);
        دع قيمة_تسمية_التوقيع: قيمة_جسون = قيمة_جسون.سلسلة(نص_تسمية_التوقيع);
        دع مدخل_تسمية_التوقيع: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_تسمية_التوقيع };
        دع قيمة_معاملات_التوقيع: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_المعاملات);
        دع مدخل_معاملات_التوقيع: مدخل_كائن_جسون = { المفتاح: «parameters», القيمة: قيمة_معاملات_التوقيع };
        دع مداخل_التوقيع: متجه مدخل_كائن_جسون = [مدخل_تسمية_التوقيع, مدخل_معاملات_التوقيع];
        دع فهرس_خريطة_التوقيع: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع فهرس_التوقيع: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع كائن_التوقيع: كائن_جسون = { المداخل: مداخل_التوقيع, الفهرس: فهرس_خريطة_التوقيع };
        ألحق(الكائنات, كائن_التوقيع);

        دع قيمة_التوقيع: قيمة_جسون = قيمة_جسون.كائن(فهرس_التوقيع);
        دع قيم_التواقيع: متجه قيمة_جسون = [قيمة_التوقيع];
        دع فهرس_مصفوفة_التواقيع: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
        دع مصفوفة_التواقيع: مصفوفة_جسون = { القيم: قيم_التواقيع };
        ألحق(المصفوفات, مصفوفة_التواقيع);

        دع قيمة_التواقيع: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التواقيع);
        دع مدخل_التواقيع: مدخل_كائن_جسون = { المفتاح: «signatures», القيمة: قيمة_التواقيع };
        دع قيمة_التوقيع_النشط: قيمة_جسون = قيمة_جسون.رقم(«0»);
        دع مدخل_التوقيع_النشط: مدخل_كائن_جسون = { المفتاح: «activeSignature», القيمة: قيمة_التوقيع_النشط };
        دع نص_المعامل_النشط: نص = غير_موقع_إلى_نص(المعلومات.المعامل_النشط);
        دع قيمة_المعامل_النشط: قيمة_جسون = قيمة_جسون.رقم(نص_المعامل_النشط);
        دع مدخل_المعامل_النشط: مدخل_كائن_جسون = { المفتاح: «activeParameter», القيمة: قيمة_المعامل_النشط };
        دع مداخل_الجذر: متجه مدخل_كائن_جسون = [
            مدخل_التواقيع, مدخل_التوقيع_النشط, مدخل_المعامل_النشط
        ];
        دع فهرس_خريطة_الجذر: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع فهرس_الجذر: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع كائن_الجذر: كائن_جسون = { المداخل: مداخل_الجذر, الفهرس: فهرس_خريطة_الجذر };
        ألحق(الكائنات, كائن_الجذر);
        دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عرف فهرس_نوع_رمز_دلالي_لغة(النوع: نوع_تصريح): غير_موقع {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع 0; }
    | نوع_تصريح.دالة_خارجية -> { أرجع 0; }
    | نوع_تصريح.مرادف_نوع -> { أرجع 1; }
    | نوع_تصريح.سجل -> { أرجع 2; }
    | نوع_تصريح.تعداد -> { أرجع 3; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع 4; }
    | نوع_تصريح.معامل -> { أرجع 5; }
    | نوع_تصريح.ربط_محلي -> { أرجع 6; };
}

عرف نوع_رمز_معلن_لغة(النوع: نوع_تصريح): غير_موقع {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع 12; }
    | نوع_تصريح.دالة_خارجية -> { أرجع 12; }
    | نوع_تصريح.مرادف_نوع -> { أرجع 26; }
    | نوع_تصريح.سجل -> { أرجع 23; }
    | نوع_تصريح.تعداد -> { أرجع 10; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع 22; }
    | نوع_تصريح.معامل -> { أرجع 13; }
    | نوع_تصريح.ربط_محلي -> { أرجع 13; };
}

عام عرف ابن_رد_رموز_دلالية_كاملة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الظهورات: &متجه ظهور_مصنف_لغة
): وثيقة_جسون {
    دع القيم: متغير متجه قيمة_جسون = [];
    دع الحالة: متجه ظهور_مصنف_لغة = *الظهورات;
    دع السطر_السابق: متغير غير_موقع = 0;
    دع البداية_السابقة: متغير غير_موقع = 0;
    دع له_سابق: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع الظهور: ظهور_مصنف_لغة = الحالة[ف];
        دع البداية: موضع_تغيير_لغة = الظهور.النطاق.البداية;
        دع النهاية: موضع_تغيير_لغة = الظهور.النطاق.النهاية;
        لو (البداية.السطر == النهاية.السطر && النهاية.المحرف >= البداية.المحرف) {
            دع فرق_السطر: متغير غير_موقع = البداية.السطر;
            دع فرق_البداية: متغير غير_موقع = البداية.المحرف;
            لو (له_سابق) {
                فرق_السطر := البداية.السطر - السطر_السابق;
                لو (فرق_السطر == 0) { فرق_البداية := البداية.المحرف - البداية_السابقة; };
            };
            دع الطول_النصي: غير_موقع = النهاية.المحرف - البداية.المحرف;
            دع النوع: غير_موقع = فهرس_نوع_رمز_دلالي_لغة(الظهور.النوع);
            دع المعدلات: متغير غير_موقع = 0;
            لو (الظهور.تصريح) { المعدلات := 1; };
            دع ن0: نص = غير_موقع_إلى_نص(فرق_السطر);
            دع ن1: نص = غير_موقع_إلى_نص(فرق_البداية);
            دع ن2: نص = غير_موقع_إلى_نص(الطول_النصي);
            دع ن3: نص = غير_موقع_إلى_نص(النوع);
            دع ن4: نص = غير_موقع_إلى_نص(المعدلات);
            ألحق(القيم, قيمة_جسون.رقم(ن0));
            ألحق(القيم, قيمة_جسون.رقم(ن1));
            ألحق(القيم, قيمة_جسون.رقم(ن2));
            ألحق(القيم, قيمة_جسون.رقم(ن3));
            ألحق(القيم, قيمة_جسون.رقم(ن4));
            السطر_السابق := البداية.السطر;
            البداية_السابقة := البداية.المحرف;
            له_سابق := صواب;
        };
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع فهرس_المصفوفة: غير_موقع = 0;
    دع مصفوفة_البيانات: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, مصفوفة_البيانات);
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع قيمة_البيانات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    دع مدخل_البيانات: مدخل_كائن_جسون = { المفتاح: «data», القيمة: قيمة_البيانات };
    دع مداخل_الجذر: متجه مدخل_كائن_جسون = [مدخل_البيانات];
    دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = { المداخل: مداخل_الجذر, الفهرس: فهرس_الخريطة };
    ألحق(الكائنات, الجذر);
    دع النتيجة: قيمة_جسون = قيمة_جسون.كائن(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_رموز_مستند_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرموز: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    دع الحالة: متجه رمز_معلن_لغة = *الرموز;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع مرجع_الرمز: &رمز_معلن_لغة = &الحالة[ف];
        دع الرمز: رمز_معلن_لغة = *مرجع_الرمز;
        دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الرمز.الموقع.النطاق);
        دع فهرس_التحديد: غير_موقع = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الرمز.نطاق_التحديد);
        دع مرجع_الاسم: &نص = &الرمز.الاسم;
        دع الاسم: نص = *مرجع_الاسم;
        دع قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(الاسم);
        دع مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
        دع رقم_النوع: غير_موقع = نوع_رمز_معلن_لغة(الرمز.النوع);
        دع نص_النوع: نص = غير_موقع_إلى_نص(رقم_النوع);
        دع قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
        دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
        دع قيمة_التحديد: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحديد);
        دع مدخل_التحديد: مدخل_كائن_جسون = { المفتاح: «selectionRange», القيمة: قيمة_التحديد };
        دع المداخل: متجه مدخل_كائن_جسون = [مدخل_الاسم, مدخل_النوع, مدخل_النطاق, مدخل_التحديد];
        دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع فهرس_الرمز: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
        ألحق(الكائنات, الكائن);
        ألحق(القيم, قيمة_جسون.كائن(فهرس_الرمز));
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_رموز_مساحة_عمل_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرموز: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    دع الحالة: متجه رمز_معلن_لغة = *الرموز;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع مرجع_الرمز: &رمز_معلن_لغة = &الحالة[ف];
        دع الرمز: رمز_معلن_لغة = *مرجع_الرمز;
        دع مرجع_العنوان: &نص = &الرمز.الموقع.العنوان;
        دع العنوان: نص = *مرجع_العنوان;
        دع فهرس_الموقع: غير_موقع = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, العنوان, الرمز.نطاق_التحديد);
        دع مرجع_الاسم: &نص = &الرمز.الاسم;
        دع الاسم: نص = *مرجع_الاسم;
        دع قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(الاسم);
        دع مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
        دع رقم_النوع: غير_موقع = نوع_رمز_معلن_لغة(الرمز.النوع);
        دع نص_النوع: نص = غير_موقع_إلى_نص(رقم_النوع);
        دع قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
        دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        دع قيمة_الموقع: قيمة_جسون = قيمة_جسون.كائن(فهرس_الموقع);
        دع مدخل_الموقع: مدخل_كائن_جسون = { المفتاح: «location», القيمة: قيمة_الموقع };
        دع المداخل: متجه مدخل_كائن_جسون = [مدخل_الاسم, مدخل_النوع, مدخل_الموقع];
        دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع فهرس_الرمز: غير_موقع = الطول(الكائنات) مثل غير_موقع;
        دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
        ألحق(الكائنات, الكائن);
        ألحق(القيم, قيمة_جسون.كائن(فهرس_الرمز));
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

// Call Hierarchy protocol encoding only. Semantic identity and call edges come
// from compiler-owned SymbolID/call-graph queries in the analysis adapter.
عرف أضف_عنصر_هرم_استدعاء_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    العنصر: &رمز_معلن_لغة
): غير_موقع {
    دع ع: رمز_معلن_لغة = *العنصر;
    دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(الكائنات, ع.الموقع.النطاق);
    دع فهرس_التحديد: غير_موقع = أضف_نطاق_لغة_إلى_جسون(الكائنات, ع.نطاق_التحديد);
    دع مرجع_الاسم: &نص = &ع.الاسم;
    دع الاسم: نص = *مرجع_الاسم;
    دع قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(الاسم);
    دع مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
    دع نص_النوع: نص = غير_موقع_إلى_نص(نوع_رمز_معلن_لغة(ع.النوع));
    دع قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
    دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
    دع مرجع_العنوان: &نص = &ع.الموقع.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(العنوان);
    دع مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
    دع قيمة_التحديد: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحديد);
    دع مدخل_التحديد: مدخل_كائن_جسون = { المفتاح: «selectionRange», القيمة: قيمة_التحديد };
    دع المداخل: متجه مدخل_كائن_جسون = [
        مدخل_الاسم, مدخل_النوع, مدخل_العنوان, مدخل_النطاق, مدخل_التحديد
    ];
    دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
    دع الحالة: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالة, الكائن);
    *الكائنات := الحالة;
    أرجع الفهرس;
}

عام عرف ابن_رد_تحضير_هرم_استدعاء_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العنصر: &اختيار رمز_معلن_لغة
): وثيقة_جسون {
    دع النسخة: اختيار رمز_معلن_لغة = *العنصر;
    طابق النسخة مع
    | اختيار.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختيار.بعض(القيمة) -> {
        دع الكائنات: متغير متجه كائن_جسون = [];
        دع فهرس_العنصر: غير_موقع = أضف_عنصر_هرم_استدعاء_إلى_جسون(&متغير الكائنات, &القيمة);
        دع قيمة_العنصر_في_المصفوفة: قيمة_جسون = قيمة_جسون.كائن(فهرس_العنصر);
        دع القيم: متجه قيمة_جسون = [قيمة_العنصر_في_المصفوفة];
        دع المصفوفات: متغير متجه مصفوفة_جسون = [];
        دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
        ألحق(المصفوفات, المصفوفة);
        دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تحضير_هرم_نوع_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العنصر: &اختيار رمز_معلن_لغة
): وثيقة_جسون {
    // TypeHierarchyItem and CallHierarchyItem share the same wire shape here.
    أرجع ابن_رد_تحضير_هرم_استدعاء_لغة(المعرف, العنصر);
}

عام عرف ابن_رد_علاقات_هرم_نوع_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العناصر: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    دع الحالة: متجه رمز_معلن_لغة = *العناصر;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع فهرس_العنصر: غير_موقع = أضف_عنصر_هرم_استدعاء_إلى_جسون(
            &متغير الكائنات, &الحالة[ف]
        );
        ألحق(القيم, قيمة_جسون.كائن(فهرس_العنصر));
        ف := ف + 1;
    }
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عرف أضف_نطاقات_هرم_استدعاء_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    النطاقات: &متجه نطاق_تغيير_لغة
): غير_موقع {
    دع الحالة: متجه نطاق_تغيير_لغة = *النطاقات;
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(الكائنات, الحالة[ف]);
        دع القيمة: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        ألحق(القيم, القيمة);
        ف := ف + 1;
    }
    دع الفهرس: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    دع الحالة_المصفوفية: متغير متجه مصفوفة_جسون = *المصفوفات;
    ألحق(الحالة_المصفوفية, المصفوفة);
    *المصفوفات := الحالة_المصفوفية;
    أرجع الفهرس;
}

عرف أضف_استدعاء_هرمي_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المجموعة: &مجموعة_استدعاء_هرمي_لغة,
    واردة: منطقي
): غير_موقع {
    دع م: مجموعة_استدعاء_هرمي_لغة = *المجموعة;
    دع فهرس_العنصر: غير_موقع = أضف_عنصر_هرم_استدعاء_إلى_جسون(الكائنات, &م.العنصر);
    دع فهرس_النطاقات: غير_موقع = أضف_نطاقات_هرم_استدعاء_إلى_جسون(
        الكائنات, المصفوفات, &م.النطاقات
    );
    دع مفتاح_العنصر: متغير نص = «to»;
    لو (واردة) { مفتاح_العنصر := «from»; };
    دع قيمة_العنصر: قيمة_جسون = قيمة_جسون.كائن(فهرس_العنصر);
    دع مدخل_العنصر: مدخل_كائن_جسون = { المفتاح: مفتاح_العنصر, القيمة: قيمة_العنصر };
    دع قيمة_النطاقات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_النطاقات);
    دع مدخل_النطاقات: مدخل_كائن_جسون = { المفتاح: «fromRanges», القيمة: قيمة_النطاقات };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_العنصر, مدخل_النطاقات];
    دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
    دع الحالة: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالة, الكائن);
    *الكائنات := الحالة;
    أرجع الفهرس;
}

عرف ابن_رد_استدعاءات_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة,
    واردة: منطقي
): وثيقة_جسون {
    دع الحالة: متجه مجموعة_استدعاء_هرمي_لغة = *المجموعات;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع مرجع_المجموعة: &مجموعة_استدعاء_هرمي_لغة = &الحالة[ف];
        دع فهرس_الاستدعاء: غير_موقع = أضف_استدعاء_هرمي_إلى_جسون(
            &متغير الكائنات, &متغير المصفوفات, مرجع_المجموعة, واردة
        );
        دع قيمة_الاستدعاء: قيمة_جسون = قيمة_جسون.كائن(فهرس_الاستدعاء);
        ألحق(القيم, قيمة_الاستدعاء);
        ف := ف + 1;
    }
    دع فهرس_النتيجة: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
    دع مصفوفة_النتيجة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, مصفوفة_النتيجة);
    دع النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_النتيجة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_استدعاءات_واردة_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_استدعاءات_هرمية_لغة(المعرف, المجموعات, صواب);
}

عام عرف ابن_رد_استدعاءات_صادرة_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_استدعاءات_هرمية_لغة(المعرف, المجموعات, خطأ);
}

