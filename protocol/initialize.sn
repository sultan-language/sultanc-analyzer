استورد std.json.value;

// نماذج wire الخاصة بتهيئة LSP ومساحات العمل. تحويل URI إلى مسار يبقى في workspace.
عام نوع وصف_مجلد_مساحة_عمل_لغة = {
    العنوان: نص,
    الاسم: نص
};

عام نوع معاملات_تهيئة_لغة = {
    عنوان_الجذر: اختيار نص,
    مجلدات_مساحة_العمل: اختيار متجه وصف_مجلد_مساحة_عمل_لغة
};

عام نوع تغيير_مجلدات_مساحة_عمل_لغة = {
    المضافة: متجه وصف_مجلد_مساحة_عمل_لغة,
    المحذوفة: متجه وصف_مجلد_مساحة_عمل_لغة
};

عرف فهرس_كائن_تهيئة(القيمة: قيمة_جسون): اختيار غير_موقع {
    طابق القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> { أرجع اختيار.بعض(الفهرس); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نص_تهيئة(القيمة: قيمة_جسون): اختيار نص {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع اختيار.بعض(النص); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قيمة_حقل_تهيئة(
    الوثيقة: &وثيقة_جسون,
    الفهرس: غير_موقع,
    الاسم: نص
): اختيار قيمة_جسون {
    دع المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح);
}

عرف فك_وصف_مجلد_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختيار وصف_مجلد_مساحة_عمل_لغة {
    دع الفهرس: متغير غير_موقع = 0;
    طابق فهرس_كائن_تهيئة(القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { الفهرس := ف; };

    دع العنوان: متغير نص = «»;
    دع الاسم: متغير نص = «»;
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «uri») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق نص_تهيئة(قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النص) -> { العنوان := النص; };
    };
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «name») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق نص_تهيئة(قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النص) -> { الاسم := النص; };
    };

    دع الناتج: وصف_مجلد_مساحة_عمل_لغة = {
        العنوان: العنوان,
        الاسم: الاسم
    };
    أرجع اختيار.بعض(الناتج);
}

عرف فك_مصفوفة_مجلدات_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختيار متجه وصف_مجلد_مساحة_عمل_لغة {
    دع فهرس_المصفوفة: متغير غير_موقع = 0;
    طابق القيمة مع
    | قيمة_جسون.مصفوفة(الفهرس) -> { فهرس_المصفوفة := الفهرس; }
    | _ -> { أرجع اختيار.لا_شيء(); };

    دع العدد: متغير غير_موقع = 0;
    طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ن) -> { العدد := ن; };

    دع المجلدات: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(عنصر) -> {
            طابق فك_وصف_مجلد_مساحة_عمل_لغة(الوثيقة, عنصر) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(المجلد) -> { ألحق(المجلدات, المجلد); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(المجلدات);
}

عام عرف فك_معاملات_تهيئة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار معاملات_تهيئة_لغة {
    دع الفهرس: متغير غير_موقع = 0;
    طابق فهرس_كائن_تهيئة(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { الفهرس := ف; };

    دع عنوان_الجذر: متغير اختيار نص = اختيار.لا_شيء();
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «rootUri») مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.عدم -> { }
        | قيمة_جسون.سلسلة(النص) -> { عنوان_الجذر := اختيار.بعض(النص); }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع المجلدات: متغير اختيار متجه وصف_مجلد_مساحة_عمل_لغة = اختيار.لا_شيء();
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «workspaceFolders») مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.عدم -> { }
        | _ -> {
            طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيم) -> { المجلدات := اختيار.بعض(القيم); };
        };
    };

    دع الناتج: معاملات_تهيئة_لغة = {
        عنوان_الجذر: عنوان_الجذر,
        مجلدات_مساحة_العمل: المجلدات
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_تغيير_مجلدات_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار تغيير_مجلدات_مساحة_عمل_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_تهيئة(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    دع فهرس_الحدث: متغير غير_موقع = 0;
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_المعاملات, «event») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فهرس_كائن_تهيئة(القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ف) -> { فهرس_الحدث := ف; };
    };

    دع المضافة: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    دع المحذوفة: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الحدث, «added») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيم) -> { المضافة := القيم; };
    };
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الحدث, «removed») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيم) -> { المحذوفة := القيم; };
    };

    دع الناتج: تغيير_مجلدات_مساحة_عمل_لغة = {
        المضافة: المضافة,
        المحذوفة: المحذوفة
    };
    أرجع اختيار.بعض(الناتج);
}
