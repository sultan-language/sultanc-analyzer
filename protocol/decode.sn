استورد sultanc_lsp.protocol.model;
استورد std.json.value;
استورد std.text.compare;

عرف معرف_طلب_من_قيمة_جسون(القيمة: قيمة_جسون): اختيار معرف_طلب_جسون_اربيسي {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        أرجع اختيار.بعض(معرف_طلب_جسون_اربيسي.رقم(النص));
    }
    | قيمة_جسون.سلسلة(النص) -> {
        أرجع اختيار.بعض(معرف_طلب_جسون_اربيسي.سلسلة(النص));
    }
    | قيمة_جسون.عدم -> {
        أرجع اختيار.بعض(معرف_طلب_جسون_اربيسي.عدم());
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف فك_رسالة_جسون_اربيسي(
    الوثيقة: &وثيقة_جسون
): نتيجة رسالة_جسون_اربيسي, خطأ_فك_رسالة_جسون_اربيسي {
    دع فهرس_الجذر: متغير غير_موقع = 0;
    طابق جذر_وثيقة_جسون(الوثيقة) مع
    | قيمة_جسون.كائن(الفهرس) -> { فهرس_الجذر := الفهرس; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الجذر_ليس_كائنا()); };

    دع مفتاح_الإصدار: نص = «jsonrpc»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_الإصدار) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_مفقود());
    }
    | اختيار.بعض(القيمة) -> {
        دع الإصدار_المتوقع: نص = «2.0»;
        طابق القيمة مع
        | قيمة_جسون.سلسلة(الإصدار) -> {
            لو (!نصان_متساويان(&الإصدار, &الإصدار_المتوقع)) {
                أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_غير_صالح());
            };
        }
        | _ -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_غير_صالح());
        };
    };

    دع مفتاح_الطريقة: نص = «method»;
    دع الطريقة: متغير نص = «»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_الطريقة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الطريقة_مفقودة());
    }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { الطريقة := النص; }
        | _ -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الطريقة_ليست_نصا());
        };
    };

    // غياب id يعني notification. وجود null يبقى RequestID صالحا حسب JSON-RPC 2.0.
    دع المعرف: متغير اختيار معرف_طلب_جسون_اربيسي = اختيار.لا_شيء();
    دع مفتاح_المعرف: نص = «id»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_المعرف) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق معرف_طلب_من_قيمة_جسون(القيمة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.المعرف_غير_صالح());
        }
        | اختيار.بعض(القيمة_المحللة) -> {
            المعرف := اختيار.بعض(القيمة_المحللة);
        };
    };

    دع المعاملات: متغير اختيار قيمة_جسون = اختيار.لا_شيء();
    دع مفتاح_المعاملات: نص = «params»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_المعاملات) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> { المعاملات := اختيار.بعض(القيمة); };

    دع الرسالة: رسالة_جسون_اربيسي = {
        الطريقة: الطريقة,
        المعرف: المعرف,
        المعاملات: المعاملات
    };
    أرجع نتيجة.نجح(الرسالة);
}
