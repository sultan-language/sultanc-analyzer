استورد sultanc_lsp.protocol.model;
استورد sultanc_lsp.protocol.text_document;
استورد sultanc_lsp.protocol.diagnostics;
استورد sultanc_lsp.workspace.documents;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.text.compare;
استورد std.text.number;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.wording;

// Code Action هنا مجرد تكييف لإصلاحات Diagnostics المقننة؛ لا يستنتج LSP إصلاحات جديدة.
عام نوع طلب_إجراء_شفرة_لغة = {
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة,
    يسمح_إصلاح_سريع: منطقي
};

عرف هل_قيمة_نص_تساوي(القيمة: قيمة_جسون, المطلوب: نص): منطقي {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> {
        دع م: نص = المطلوب;
        أرجع نصان_متساويان(&النص, &م);
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_السياق_يسمح_إصلاحا_سريعا(
    الوثيقة: &وثيقة_جسون,
    فهرس_المعاملات: غير_موقع
): اختيار منطقي {
    دع مفتاح_السياق: نص = «context»;
    دع فهرس_السياق: متغير غير_موقع = 0;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_السياق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.كائن(ف) -> { فهرس_السياق := ف; }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع مفتاح_فقط: نص = «only»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_السياق, &مفتاح_فقط) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(صواب); }
    | اختيار.بعض(القيمة) -> {
        دع فهرس_المصفوفة: متغير غير_موقع = 0;
        طابق القيمة مع
        | قيمة_جسون.مصفوفة(ف) -> { فهرس_المصفوفة := ف; }
        | _ -> { أرجع اختيار.لا_شيء(); };
        دع العدد: متغير غير_موقع = 0;
        طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { العدد := ن; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
            | اختيار.بعض(عنصر) -> {
                لو (هل_قيمة_نص_تساوي(عنصر, «quickfix»)) {
                    أرجع اختيار.بعض(صواب);
                };
            }
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(خطأ);
    };
}

عام عرف فك_طلب_إجراء_شفرة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_إجراء_شفرة_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختيار.لا_شيء(); };

    دع مفتاح_المستند: نص = «textDocument»;
    دع قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_المستند := القيمة; };
    دع العنوان: متغير نص = «»;
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { العنوان := القيمة; };

    دع مفتاح_النطاق: نص = «range»;
    دع موضع_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع النطاق: متغير نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_أ,
        النهاية: موضع_فارغ_ب
    };
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فك_نطاق_تغيير_لغة(الوثيقة, القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة_المحللة) -> { النطاق := القيمة_المحللة; };
    };

    دع يسمح: متغير منطقي = صواب;
    طابق هل_السياق_يسمح_إصلاحا_سريعا(الوثيقة, فهرس_المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { يسمح := القيمة; };

    دع الطلب: طلب_إجراء_شفرة_لغة = {
        العنوان: العنوان,
        النطاق: النطاق,
        يسمح_إصلاح_سريع: يسمح
    };
    أرجع اختيار.بعض(الطلب);
}

عرف موضع_لغة_قبل_أو_يساوي(أ: موضع_تغيير_لغة, ب: موضع_تغيير_لغة): منطقي {
    لو (أ.السطر < ب.السطر) { أرجع صواب; };
    لو (أ.السطر > ب.السطر) { أرجع خطأ; };
    أرجع أ.المحرف <= ب.المحرف;
}

عرف نطاقا_لغة_متداخلان(أ: نطاق_تغيير_لغة, ب: نطاق_تغيير_لغة): منطقي {
    أرجع موضع_لغة_قبل_أو_يساوي(أ.البداية, ب.النهاية)
        && موضع_لغة_قبل_أو_يساوي(ب.البداية, أ.النهاية);
}

// CodeActionParams.range يصف موضع التشخيص/اختيار المستخدم، لا موضع التحرير
// الذي قد يكون في مكان آخر (مثل نقل فاصلة منقوطة). لذلك نرشح الإصلاح
// باستخدام نطاق التشخيص الرئيسي، ثم نطبق جميع تعديلات الإصلاح المقنن.
عرف تشخيص_يتقاطع_مع_نطاق_إجراء_لغة(
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    التشخيص: &تشخيص
): منطقي {
    دع ت: تشخيص = *التشخيص;
    طابق ت.المصدر_الرئيسي مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المصدر) -> {
        لو (!مصدر_تشخيص_للمستند(&المصدر, المستند)) { أرجع خطأ; };
        طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(النطاق) -> {
            دع نطاق_التشخيص: نطاق_تغيير_لغة = {
                البداية: النطاق.البداية,
                النهاية: النطاق.النهاية
            };
            أرجع نطاقا_لغة_متداخلان(المطلوب, نطاق_التشخيص);
        };
    };
}

عرف أضف_موضع_إجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): غير_موقع {
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع نص_السطر: نص = غير_موقع_إلى_نص(الموضع.السطر);
    دع قيمة_السطر: قيمة_جسون = قيمة_جسون.رقم(نص_السطر);
    دع مدخل_السطر: مدخل_كائن_جسون = { المفتاح: «line», القيمة: قيمة_السطر };
    دع نص_المحرف: نص = غير_موقع_إلى_نص(الموضع.المحرف);
    دع قيمة_المحرف: قيمة_جسون = قيمة_جسون.رقم(نص_المحرف);
    دع مدخل_المحرف: مدخل_كائن_جسون = { المفتاح: «character», القيمة: قيمة_المحرف };
    دع مداخل_الموضع: متجه مدخل_كائن_جسون = [مدخل_السطر, مدخل_المحرف];
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: مداخل_الموضع,
        الفهرس: فهرس_الكائن
    };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عرف أضف_نطاق_إجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تغيير_لغة
): غير_موقع {
    دع البداية: غير_موقع = أضف_موضع_إجراء_شفرة(الكائنات, النطاق.البداية);
    دع النهاية: غير_موقع = أضف_موضع_إجراء_شفرة(الكائنات, النطاق.النهاية);
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_البداية: قيمة_جسون = قيمة_جسون.كائن(البداية);
    دع مدخل_البداية: مدخل_كائن_جسون = { المفتاح: «start», القيمة: قيمة_البداية };
    دع قيمة_النهاية: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    دع مدخل_النهاية: مدخل_كائن_جسون = { المفتاح: «end», القيمة: قيمة_النهاية };
    دع مداخل_النطاق: متجه مدخل_كائن_جسون = [مدخل_البداية, مدخل_النهاية];
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: مداخل_النطاق,
        الفهرس: فهرس_الكائن
    };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عرف أضف_إصلاح_كإجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    الإجراءات: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    الإصلاح: &إصلاح_تشخيص
): فراغ {
    دع ص: إصلاح_تشخيص = *الإصلاح;
    لو (!مصدر_تشخيص_للمستند(&ص.المصدر, المستند)) { أرجع; };
    دع موضع_إصلاح_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_إصلاح_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع نطاق_الإصلاح: متغير نطاق_تغيير_لغة = {
        البداية: موضع_إصلاح_فارغ_أ,
        النهاية: موضع_إصلاح_فارغ_ب
    };
    طابق نطاق_تشخيص_إلى_لغة(&ص.المصدر, المستند) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(القيمة) -> {
        دع نطاق_الإصلاح_الجديد: نطاق_تغيير_لغة = { البداية: القيمة.البداية, النهاية: القيمة.النهاية };
        نطاق_الإصلاح := نطاق_الإصلاح_الجديد;
    };
    دع فهرس_النطاق: غير_موقع = أضف_نطاق_إجراء_شفرة(الكائنات, نطاق_الإصلاح);
    دع فهرس_تحرير_النص: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_نطاق_التحرير: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    دع مدخل_نطاق_التحرير: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_نطاق_التحرير };
    دع مرجع_نص_التحرير: &نص = &ص.الاستبدال;
    دع نص_التحرير: نص = *مرجع_نص_التحرير;
    دع قيمة_نص_التحرير: قيمة_جسون = قيمة_جسون.سلسلة(نص_التحرير);
    دع مدخل_نص_التحرير: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_نص_التحرير };
    دع مداخل_تحرير_النص: متجه مدخل_كائن_جسون = [مدخل_نطاق_التحرير, مدخل_نص_التحرير];
    دع فهرس_كائن_تحرير_النص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع تحرير_النص: كائن_جسون = {
        المداخل: مداخل_تحرير_النص,
        الفهرس: فهرس_كائن_تحرير_النص
    };
    دع كائنات1: متغير متجه كائن_جسون = *الكائنات;
    ألحق(كائنات1, تحرير_النص);
    *الكائنات := كائنات1;

    دع فهرس_التحريرات: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
    دع قيمة_تحرير_النص: قيمة_جسون = قيمة_جسون.كائن(فهرس_تحرير_النص);
    دع قيم_التحريرات: متغير متجه قيمة_جسون = [قيمة_تحرير_النص];

    // الإصلاح المركب وحدة ذرية. المنتج الحالي قد يضيف تعديلات أخرى إلى
    // المستند نفسه؛ لا يجوز إسقاطها وإرسال إصلاح جزئي إلى المحرر.
    دع ت: متغير غير_موقع = 0;
    بينما (ت < (الطول(ص.التعديلات_الإضافية) مثل غير_موقع)) {
        لو (!مصدر_تشخيص_للمستند(&ص.التعديلات_الإضافية[ت].المصدر, المستند)) { أرجع; };
        دع نطاق_التعديل: متغير نطاق_تغيير_لغة = {
            البداية: موضع_إصلاح_فارغ_أ,
            النهاية: موضع_إصلاح_فارغ_ب
        };
        طابق نطاق_تشخيص_إلى_لغة(&ص.التعديلات_الإضافية[ت].المصدر, المستند) مع
        | اختيار.لا_شيء -> { أرجع; }
        | اختيار.بعض(القيمة) -> {
            دع نطاق_التعديل_الجديد: نطاق_تغيير_لغة = {
                البداية: القيمة.البداية,
                النهاية: القيمة.النهاية
            };
            نطاق_التعديل := نطاق_التعديل_الجديد;
        };

        دع فهرس_نطاق_التعديل: غير_موقع = أضف_نطاق_إجراء_شفرة(الكائنات, نطاق_التعديل);
        دع فهرس_تحرير_إضافي: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
        دع قيمة_نطاق_التعديل: قيمة_جسون = قيمة_جسون.كائن(فهرس_نطاق_التعديل);
        دع مدخل_نطاق_التعديل: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_نطاق_التعديل };
        دع مرجع_نص_التعديل: &نص = &ص.التعديلات_الإضافية[ت].الاستبدال;
        دع نص_التعديل: نص = *مرجع_نص_التعديل;
        دع قيمة_نص_التعديل: قيمة_جسون = قيمة_جسون.سلسلة(نص_التعديل);
        دع مدخل_نص_التعديل: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_نص_التعديل };
        دع مداخل_التحرير_الإضافي: متجه مدخل_كائن_جسون = [مدخل_نطاق_التعديل, مدخل_نص_التعديل];
        دع فهرس_كائن_التحرير_الإضافي: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع التحرير_الإضافي: كائن_جسون = {
            المداخل: مداخل_التحرير_الإضافي,
            الفهرس: فهرس_كائن_التحرير_الإضافي
        };
        دع كائنات_إضافية: متغير متجه كائن_جسون = *الكائنات;
        ألحق(كائنات_إضافية, التحرير_الإضافي);
        *الكائنات := كائنات_إضافية;
        ألحق(قيم_التحريرات, قيمة_جسون.كائن(فهرس_تحرير_إضافي));
        ت := ت + 1;
    }

    دع مصفوفة_التحريرات: مصفوفة_جسون = {
        القيم: قيم_التحريرات
    };
    دع مصفوفات1: متغير متجه مصفوفة_جسون = *المصفوفات;
    ألحق(مصفوفات1, مصفوفة_التحريرات);
    *المصفوفات := مصفوفات1;

    دع د: مستند_لغة_مفتوح = *المستند;
    دع مرجع_عنوان_تغييرات_المستند: &نص = &د.العنوان;
    دع عنوان_تغييرات_المستند: نص = *مرجع_عنوان_تغييرات_المستند;
    دع فهرس_التغييرات: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_تحريرات_المستند: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_التحريرات);
    دع مدخل_تغييرات_المستند: مدخل_كائن_جسون = { المفتاح: عنوان_تغييرات_المستند, القيمة: قيمة_تحريرات_المستند };
    دع مداخل_التغييرات: متجه مدخل_كائن_جسون = [مدخل_تغييرات_المستند];
    دع فهرس_كائن_التغييرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع التغييرات: كائن_جسون = {
        المداخل: مداخل_التغييرات,
        الفهرس: فهرس_كائن_التغييرات
    };
    دع كائنات2: متغير متجه كائن_جسون = *الكائنات;
    ألحق(كائنات2, التغييرات);
    *الكائنات := كائنات2;

    دع فهرس_تحرير_المساحة: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_تغييرات_المساحة: قيمة_جسون = قيمة_جسون.كائن(فهرس_التغييرات);
    دع مدخل_تغييرات_المساحة: مدخل_كائن_جسون = { المفتاح: «changes», القيمة: قيمة_تغييرات_المساحة };
    دع مداخل_تحرير_المساحة: متجه مدخل_كائن_جسون = [مدخل_تغييرات_المساحة];
    دع فهرس_كائن_تحرير_المساحة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع تحرير_المساحة: كائن_جسون = {
        المداخل: مداخل_تحرير_المساحة,
        الفهرس: فهرس_كائن_تحرير_المساحة
    };
    دع كائنات3: متغير متجه كائن_جسون = *الكائنات;
    ألحق(كائنات3, تحرير_المساحة);
    *الكائنات := كائنات3;

    دع مفضل: متغير منطقي = خطأ;
    طابق ص.القابلية مع
    | قابلية_تطبيق_إصلاح.آلي -> { مفضل := صواب; }
    | قابلية_تطبيق_إصلاح.يحتوي_عناصر_نائبة -> { }
    | قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح -> { }
    | قابلية_تطبيق_إصلاح.غير_محدد -> { };

    دع فهرس_الإجراء: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع لغة_عنوان_الإجراء: لغة_تشخيص = لغة_تشخيص.الإنجليزية();
    دع نص_عنوان_الإجراء: نص = صياغة_تشخيص(لغة_عنوان_الإجراء, ص.المفتاح);
    دع قيمة_عنوان_الإجراء: قيمة_جسون = قيمة_جسون.سلسلة(نص_عنوان_الإجراء);
    دع مدخل_عنوان_الإجراء: مدخل_كائن_جسون = { المفتاح: «title», القيمة: قيمة_عنوان_الإجراء };
    دع قيمة_نوع_الإجراء: قيمة_جسون = قيمة_جسون.سلسلة(«quickfix»);
    دع مدخل_نوع_الإجراء: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_نوع_الإجراء };
    دع قيمة_تفضيل_الإجراء: قيمة_جسون = قيمة_جسون.منطق(مفضل);
    دع مدخل_تفضيل_الإجراء: مدخل_كائن_جسون = { المفتاح: «isPreferred», القيمة: قيمة_تفضيل_الإجراء };
    دع قيمة_تحرير_الإجراء: قيمة_جسون = قيمة_جسون.كائن(فهرس_تحرير_المساحة);
    دع مدخل_تحرير_الإجراء: مدخل_كائن_جسون = { المفتاح: «edit», القيمة: قيمة_تحرير_الإجراء };
    دع مداخل_الإجراء: متجه مدخل_كائن_جسون = [مدخل_عنوان_الإجراء, مدخل_نوع_الإجراء, مدخل_تفضيل_الإجراء, مدخل_تحرير_الإجراء];
    دع فهرس_كائن_الإجراء: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الإجراء: كائن_جسون = {
        المداخل: مداخل_الإجراء,
        الفهرس: فهرس_كائن_الإجراء
    };
    دع كائنات4: متغير متجه كائن_جسون = *الكائنات;
    ألحق(كائنات4, الإجراء);
    *الكائنات := كائنات4;
    دع إجراءات1: متغير متجه قيمة_جسون = *الإجراءات;
    ألحق(إجراءات1, قيمة_جسون.كائن(فهرس_الإجراء));
    *الإجراءات := إجراءات1;
}

عام عرف ابن_رد_إجراءات_شفرة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    يسمح_إصلاح_سريع: منطقي,
    المجموعة: &مجموعة_تشخيصات
): وثيقة_جسون {
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع الإجراءات: متغير متجه قيمة_جسون = [];

    لو (يسمح_إصلاح_سريع) {
        دع ج: مجموعة_تشخيصات = *المجموعة;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ج.التشخيصات) مثل غير_موقع)) {
            دع مرجع_التشخيص: &تشخيص = &ج.التشخيصات[ف];
            دع ت: تشخيص = *مرجع_التشخيص;
            لو (تشخيص_يتقاطع_مع_نطاق_إجراء_لغة(المستند, المطلوب, &ت)) {
                دع ص: متغير غير_موقع = 0;
                بينما (ص < (الطول(ت.الإصلاحات) مثل غير_موقع)) {
                    أضف_إصلاح_كإجراء_شفرة(
                        &متغير الكائنات,
                        &متغير المصفوفات,
                        &متغير الإجراءات,
                        المستند,
                        &ت.الإصلاحات[ص]
                    );
                    ص := ص + 1;
                }
            };
            ف := ف + 1;
        }
    };

    دع فهرس_الإجراءات: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
    دع مصفوفة_الإجراءات: مصفوفة_جسون = { القيم: الإجراءات };
    ألحق(المصفوفات, مصفوفة_الإجراءات);
    دع فهرس_الجذر: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_نسخة_رد_الإجراءات: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «jsonrpc», القيمة: قيمة_نسخة_رد_الإجراءات };
    دع قيمة_معرف_رد_الإجراءات: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «id», القيمة: قيمة_معرف_رد_الإجراءات };
    دع قيمة_نتيجة_رد_الإجراءات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الإجراءات);
    دع مدخل_نتيجة_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «result», القيمة: قيمة_نتيجة_رد_الإجراءات };
    دع مداخل_رد_الإجراءات: متجه مدخل_كائن_جسون = [مدخل_نسخة_رد_الإجراءات, مدخل_معرف_رد_الإجراءات, مدخل_نتيجة_رد_الإجراءات];
    دع فهرس_كائن_رد_الإجراءات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = {
        المداخل: مداخل_رد_الإجراءات,
        الفهرس: فهرس_كائن_رد_الإجراءات
    };
    دع كائنات_الناتج: متغير متجه كائن_جسون = الكائنات;
    ألحق(كائنات_الناتج, الجذر);
    دع قيمة_جذر_رد_الإجراءات: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    دع الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_رد_الإجراءات,
        المصفوفات: المصفوفات,
        الكائنات: كائنات_الناتج
    };
    أرجع الوثيقة;
}
