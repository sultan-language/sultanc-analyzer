استورد sultanc_lsp.protocol.model;
استورد sultanc_lsp.protocol.encode;
استورد sultanc_lsp.protocol.diagnostics;
استورد sultanc_lsp.analysis.frontend;
استورد sultanc_lsp.workspace.documents;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.fs.read_file;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.transform;
استورد compiler.diagnostics.diagnostic_model;

// LSP workspace/diagnostic adapter. تحليل المشروع واكتشاف مصادره يبقيان عند
// واجهة المترجم المقننة؛ هذه الوحدة تجمع تقارير البروتوكول فقط.
عام نوع نتيجة_سابقة_لتشخيص_مساحة_لغة = {
    العنوان: نص,
    المعرف: نص
};

عام نوع طلب_تشخيص_مساحة_لغة = {
    النتائج_السابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
};

عرف قيمة_حقل_تشخيص_مساحة_لغة(
    الوثيقة: &وثيقة_جسون,
    الفهرس: غير_موقع,
    الاسم: نص
): اختيار قيمة_جسون {
    دع المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح);
}

عام عرف فك_طلب_تشخيص_مساحة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_تشخيص_مساحة_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختيار.لا_شيء(); };

    دع النتائج: متغير متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = [];
    طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_المعاملات, «previousResultIds») مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(قيمة_جسون.مصفوفة(فهرس_المصفوفة)) -> {
        دع العدد: متغير غير_موقع = 0;
        طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { العدد := ن; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            دع فهرس_العنصر: متغير غير_موقع = 0;
            طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
            | اختيار.بعض(قيمة_جسون.كائن(ك)) -> { فهرس_العنصر := ك; }
            | _ -> { أرجع اختيار.لا_شيء(); };
            دع العنوان: متغير نص = «»;
            دع المعرف: متغير نص = «»;
            طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_العنصر, «uri») مع
            | اختيار.بعض(قيمة_جسون.سلسلة(نص_العنوان)) -> { العنوان := نص_العنوان; }
            | _ -> { أرجع اختيار.لا_شيء(); };
            طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_العنصر, «value») مع
            | اختيار.بعض(قيمة_جسون.سلسلة(نص_المعرف)) -> { المعرف := نص_المعرف; }
            | _ -> { أرجع اختيار.لا_شيء(); };
            دع السابق: نتيجة_سابقة_لتشخيص_مساحة_لغة = { العنوان: العنوان, المعرف: المعرف };
            ألحق(النتائج, السابق);
            ف := ف + 1;
        }
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع الطلب: طلب_تشخيص_مساحة_لغة = { النتائج_السابقة: النتائج };
    أرجع اختيار.بعض(الطلب);
}

عام عرف معرف_نتيجة_تشخيص_مساحة_لغة(
    مراجعة_المساحة: غير_موقع,
    مراجعة_الجذور: غير_موقع
): نص {
    دع نص_مراجعة_المساحة: نص = غير_موقع_إلى_نص(مراجعة_المساحة);
    دع نص_مراجعة_الجذور: نص = غير_موقع_إلى_نص(مراجعة_الجذور);
    دع الأجزاء: متجه نص = [نص_مراجعة_المساحة, نص_مراجعة_الجذور];
    دع الفاصل: نص = «-»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف معرف_سابق_لعنوان_تشخيص_مساحة_لغة(
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة,
    العنوان: &نص
): اختيار نص {
    دع القيم: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = *السابق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&القيم[ف].العنوان, العنوان)) {
            دع مرجع_المعرف: &نص = &القيم[ف].المعرف;
            دع المعرف: نص = *مرجع_المعرف;
            أرجع اختيار.بعض(المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف مستند_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    المسار: &نص
): اختيار مستند_لغة_مفتوح {
    طابق مستند_لغة_بالمسار(المساحة, المسار) مع
    | اختيار.بعض(المفتوح) -> { أرجع اختيار.بعض(المفتوح); }
    | اختيار.لا_شيء -> {
        طابق اقرأ_الملف(المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(النص) -> { أرجع ابن_مستند_لغة_للقراءة(المسار, النص); };
    };
}

عرف عنوان_ضمن_مصادر_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    العنوان: &نص
): منطقي {
    دع المصادر: متجه نص = *المسارات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصادر) مثل غير_موقع)) {
        طابق مستند_تشخيص_مساحة_لغة(المساحة, &المصادر[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المستند) -> {
            لو (نصان_متساويان(&المستند.العنوان, العنوان)) { أرجع صواب; };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف تقارير_تشخيص_مساحة_لغة_غير_متغيرة(
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة,
    المعرف_الحالي: &نص
): منطقي {
    دع المصادر: متجه نص = *المسارات;
    لو ((الطول(المصادر) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصادر) مثل غير_موقع)) {
        طابق مستند_تشخيص_مساحة_لغة(المساحة, &المصادر[ف]) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المستند) -> {
            طابق معرف_سابق_لعنوان_تشخيص_مساحة_لغة(السابق, &المستند.العنوان) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(المعرف_السابق) -> {
                لو (!نصان_متساويان(&المعرف_السابق, المعرف_الحالي)) { أرجع خطأ; };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_تقرير_تشخيص_مساحة_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    قيم_التقارير: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات,
    المعرف_الحالي: &نص,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
): فراغ {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع مداخل: متغير متجه مدخل_كائن_جسون = [];
    دع مرجع_العنوان: &نص = &د.العنوان;
    دع نسخة_العنوان: نص = *مرجع_العنوان;
    دع قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_العنوان);
    دع مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ألحق(مداخل, مدخل_العنوان);

    دع قيمة_الإصدار: متغير قيمة_جسون = قيمة_جسون.عدم();
    لو (د.المراجعة > 0) {
        قيمة_الإصدار := قيمة_جسون.رقم(عدد_إلى_نص(د.الإصدار));
    };
    دع مدخل_الإصدار: مدخل_كائن_جسون = { المفتاح: «version», القيمة: قيمة_الإصدار };
    ألحق(مداخل, مدخل_الإصدار);

    دع غير_متغير: متغير منطقي = خطأ;
    طابق معرف_سابق_لعنوان_تشخيص_مساحة_لغة(السابق, &د.العنوان) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المعرف_السابق) -> {
        لو (نصان_متساويان(&المعرف_السابق, المعرف_الحالي)) { غير_متغير := صواب; };
    };
    لو (غير_متغير) {
        دع قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«unchanged»);
        دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ألحق(مداخل, مدخل_النوع);
        دع نسخة_المعرف: نص = *المعرف_الحالي;
        دع قيمة_المعرف: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_المعرف);
        دع مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «resultId», القيمة: قيمة_المعرف };
        ألحق(مداخل, مدخل_المعرف);
    } وإلا {
        دع قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
        دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ألحق(مداخل, مدخل_النوع);
        دع نسخة_المعرف: نص = *المعرف_الحالي;
        دع قيمة_المعرف: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_المعرف);
        دع مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «resultId», القيمة: قيمة_المعرف };
        ألحق(مداخل, مدخل_المعرف);
        دع فهرس_العناصر: غير_موقع = أضف_عناصر_تشخيصات_لغة(
            الكائنات, المصفوفات, &د, المجموعة
        );
        دع قيمة_العناصر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_العناصر);
        دع مدخل_العناصر: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_العناصر };
        ألحق(مداخل, مدخل_العناصر);
    };
    دع فهرس_التقرير: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع التقرير: كائن_جسون = { المداخل: مداخل, الفهرس: فهرس_الخريطة };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, التقرير);
    *الكائنات := الحالية;
    دع القيم: متغير متجه قيمة_جسون = *قيم_التقارير;
    ألحق(القيم, قيمة_جسون.كائن(فهرس_التقرير));
    *قيم_التقارير := القيم;
}

عرف أضف_تقرير_مسح_تشخيص_مساحة_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    قيم_التقارير: &متغير متجه قيمة_جسون,
    العنوان: &نص
): فراغ {
    دع مداخل: متغير متجه مدخل_كائن_جسون = [];
    دع نسخة_العنوان: نص = *العنوان;
    دع قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_العنوان);
    دع مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ألحق(مداخل, مدخل_العنوان);

    دع قيمة_الإصدار: قيمة_جسون = قيمة_جسون.عدم();
    دع مدخل_الإصدار: مدخل_كائن_جسون = { المفتاح: «version», القيمة: قيمة_الإصدار };
    ألحق(مداخل, مدخل_الإصدار);

    دع قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
    دع مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
    ألحق(مداخل, مدخل_النوع);

    دع قيم_العناصر: متجه قيمة_جسون = [];
    دع فهرس_العناصر: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
    دع مصفوفة_العناصر: مصفوفة_جسون = { القيم: قيم_العناصر };
    دع الحالية_مصفوفات: متغير متجه مصفوفة_جسون = *المصفوفات;
    ألحق(الحالية_مصفوفات, مصفوفة_العناصر);
    *المصفوفات := الحالية_مصفوفات;
    دع قيمة_العناصر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_العناصر);
    دع مدخل_العناصر: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_العناصر };
    ألحق(مداخل, مدخل_العناصر);

    دع فهرس_التقرير: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع التقرير: كائن_جسون = { المداخل: مداخل, الفهرس: فهرس_الخريطة };
    دع الحالية_كائنات: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية_كائنات, التقرير);
    *الكائنات := الحالية_كائنات;
    دع القيم: متغير متجه قيمة_جسون = *قيم_التقارير;
    دع قيمة_التقرير: قيمة_جسون = قيمة_جسون.كائن(فهرس_التقرير);
    ألحق(القيم, قيمة_التقرير);
    *قيم_التقارير := القيم;
}

عام عرف ابن_رد_تشخيص_مساحة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    المجموعة: &مجموعة_تشخيصات,
    مراجعة_الجذور: غير_موقع,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
): وثيقة_جسون {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    دع المعرف_الحالي: نص = معرف_نتيجة_تشخيص_مساحة_لغة(الحالة.المراجعة, مراجعة_الجذور);
    دع المصادر: متجه نص = *المسارات;
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع قيم_التقارير: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصادر) مثل غير_موقع)) {
        طابق مستند_تشخيص_مساحة_لغة(&الحالة, &المصادر[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المستند) -> {
            أضف_تقرير_تشخيص_مساحة_لغة(
                &متغير الكائنات, &متغير المصفوفات, &متغير قيم_التقارير,
                &المستند, المجموعة, &المعرف_الحالي, السابق
            );
        };
        ف := ف + 1;
    }

    // Clear diagnostics retained by the client for files that disappeared from the current project.
    دع النتائج_السابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = *السابق;
    دع س: متغير غير_موقع = 0;
    بينما (س < (الطول(النتائج_السابقة) مثل غير_موقع)) {
        لو (!عنوان_ضمن_مصادر_تشخيص_مساحة_لغة(&الحالة, &المصادر, &النتائج_السابقة[س].العنوان)) {
            أضف_تقرير_مسح_تشخيص_مساحة_لغة(
                &متغير الكائنات, &متغير المصفوفات, &متغير قيم_التقارير,
                &النتائج_السابقة[س].العنوان
            );
        };
        س := س + 1;
    }

    دع فهرس_مصفوفة_التقارير: غير_موقع = الطول(المصفوفات) مثل غير_موقع;
    دع مصفوفة_التقارير: مصفوفة_جسون = { القيم: قيم_التقارير };
    ألحق(المصفوفات, مصفوفة_التقارير);
    دع فهرس_النتيجة: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_التقارير: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التقارير);
    دع مدخل_التقارير: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_التقارير };
    دع مداخل_النتيجة: متجه مدخل_كائن_جسون = [مدخل_التقارير];
    دع فهرس_خريطة_النتيجة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع كائن_النتيجة: كائن_جسون = { المداخل: مداخل_النتيجة, الفهرس: فهرس_خريطة_النتيجة };
    ألحق(الكائنات, كائن_النتيجة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(
        المعرف, قيمة_جسون.كائن(فهرس_النتيجة), المصفوفات, الكائنات
    );
}
