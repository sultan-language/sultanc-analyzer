استورد std.json.value;
استورد std.text.number;

عام نوع موضع_تغيير_لغة = {
    السطر: غير_موقع,
    المحرف: غير_موقع
};

عام نوع نطاق_تغيير_لغة = {
    البداية: موضع_تغيير_لغة,
    النهاية: موضع_تغيير_لغة
};

عام نوع تغيير_محتوى_لغة =
    | كامل بنوع نص
    | نطاق بنوع (نطاق_تغيير_لغة, نص)
;

عام نوع فتح_مستند_لغة = {
    العنوان: نص,
    اللغة: نص,
    الإصدار: عدد,
    النص: نص
};

عام نوع تغيير_مستند_لغة = {
    العنوان: نص,
    الإصدار: عدد,
    التغييرات: متجه تغيير_محتوى_لغة
};

عام نوع حفظ_مستند_لغة = {
    العنوان: نص,
    النص: اختيار نص
};

عام نوع إغلاق_مستند_لغة = {
    العنوان: نص
};

عرف فهرس_كائن_جسون(القيمة: قيمة_جسون): اختيار غير_موقع {
    طابق القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> { أرجع اختيار.بعض(الفهرس); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نص_جسون(القيمة: قيمة_جسون): اختيار نص {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع اختيار.بعض(النص); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف غير_موقع_جسون(القيمة: قيمة_جسون): اختيار غير_موقع {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_غير_موقع(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع اختيار.بعض(العدد); }
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف حلل_إصدار_مستند(القيمة: قيمة_جسون): اختيار عدد {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع اختيار.بعض(العدد); }
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قيمة_حقل_جسون(
    الوثيقة: &وثيقة_جسون,
    فهرس_الكائن: غير_موقع,
    الاسم: نص
): اختيار قيمة_جسون {
    دع المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, فهرس_الكائن, &المفتاح);
}

عرف فك_موضع_تغيير_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختيار موضع_تغيير_لغة {
    دع الفهرس: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { الفهرس := ف; };

    دع السطر: متغير غير_موقع = 0;
    دع المحرف: متغير غير_موقع = 0;
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «line») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق غير_موقع_جسون(قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { السطر := ن; };
    };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «character») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق غير_موقع_جسون(قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { المحرف := ن; };
    };
    دع الناتج: موضع_تغيير_لغة = { السطر: السطر, المحرف: المحرف };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_نطاق_تغيير_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختيار نطاق_تغيير_لغة {
    دع الفهرس: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { الفهرس := ف; };

    دع البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «start») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(موضع) -> { البداية := موضع; };
    };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «end») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(موضع) -> { النهاية := موضع; };
    };
    دع الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_هوية_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختيار نص {
    دع الفهرس: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { الفهرس := ف; };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «uri») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> { أرجع نص_جسون(قيمة); };
}

عام عرف فك_فتح_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار فتح_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    دع قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> { قيمة_المستند := قيمة; };

    دع فهرس_المستند: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(قيمة_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المستند := ف; };

    دع العنوان: متغير نص = «»;
    دع اللغة: متغير نص = «»;
    دع الإصدار: متغير عدد = 0;
    دع النص: متغير نص = «»;

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «uri») مع
    | اختيار.بعض(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختيار.بعض(ن) -> { العنوان := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «languageId») مع
    | اختيار.بعض(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختيار.بعض(ن) -> { اللغة := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «version») مع
    | اختيار.بعض(قيمة) -> {
        طابق حلل_إصدار_مستند(قيمة) مع
        | اختيار.بعض(ن) -> { الإصدار := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «text») مع
    | اختيار.بعض(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختيار.بعض(ن) -> { النص := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    دع الناتج: فتح_مستند_لغة = {
        العنوان: العنوان,
        اللغة: اللغة,
        الإصدار: الإصدار,
        النص: النص
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_تغيير_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار تغيير_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    دع قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> { قيمة_المستند := قيمة; };

    دع فهرس_المستند: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(قيمة_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المستند := ف; };

    دع العنوان: متغير نص = «»;
    دع الإصدار: متغير عدد = 0;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «uri») مع
    | اختيار.بعض(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختيار.بعض(ن) -> { العنوان := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «version») مع
    | اختيار.بعض(قيمة) -> {
        طابق حلل_إصدار_مستند(قيمة) مع
        | اختيار.بعض(ن) -> { الإصدار := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    دع فهرس_التغييرات: متغير غير_موقع = 0;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «contentChanges») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        طابق قيمة مع
        | قيمة_جسون.مصفوفة(ف) -> { فهرس_التغييرات := ف; }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع عدد_التغييرات: متغير غير_موقع = 0;
    طابق طول_مصفوفة_جسون(الوثيقة, فهرس_التغييرات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ن) -> { عدد_التغييرات := ن; };
    لو (عدد_التغييرات == 0) { أرجع اختيار.لا_شيء(); };

    دع التغييرات: متغير متجه تغيير_محتوى_لغة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_التغييرات) {
        دع قيمة_التغيير: متغير قيمة_جسون = قيمة_جسون.عدم();
        طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_التغييرات, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(قيمة) -> { قيمة_التغيير := قيمة; };

        دع فهرس_التغيير: متغير غير_موقع = 0;
        طابق فهرس_كائن_جسون(قيمة_التغيير) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(م) -> { فهرس_التغيير := م; };

        دع النص: متغير نص = «»;
        طابق قيمة_حقل_جسون(الوثيقة, فهرس_التغيير, «text») مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(قيمة) -> {
            طابق نص_جسون(قيمة) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(ن) -> { النص := ن; };
        };

        طابق قيمة_حقل_جسون(الوثيقة, فهرس_التغيير, «range») مع
        | اختيار.لا_شيء -> {
            ألحق(التغييرات, تغيير_محتوى_لغة.كامل(النص));
        }
        | اختيار.بعض(قيمة_النطاق) -> {
            طابق فك_نطاق_تغيير_لغة(الوثيقة, قيمة_النطاق) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(النطاق) -> {
                ألحق(التغييرات, تغيير_محتوى_لغة.نطاق(النطاق, النص));
            };
        };
        ف := ف + 1;
    }

    دع الناتج: تغيير_مستند_لغة = {
        العنوان: العنوان,
        الإصدار: الإصدار,
        التغييرات: التغييرات
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_حفظ_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار حفظ_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    دع العنوان: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فك_هوية_مستند_لغة(الوثيقة, القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { العنوان := ن; };
    };

    دع النص: متغير اختيار نص = اختيار.لا_شيء();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «text») مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ن) -> { النص := اختيار.بعض(ن); };
    };

    دع الناتج: حفظ_مستند_لغة = { العنوان: العنوان, النص: النص };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_إغلاق_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار إغلاق_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق فك_هوية_مستند_لغة(الوثيقة, القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(العنوان) -> {
            دع الناتج: إغلاق_مستند_لغة = { العنوان: العنوان };
            أرجع اختيار.بعض(الناتج);
        };
    };
}

// معاملات موضع دلالي مشتركة بين hover/definition/highlight/references/rename.
عام نوع طلب_موضع_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة
};

عام نوع طلب_مراجع_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة,
    يتضمن_التصريح: منطقي
};

عام نوع طلب_إعادة_تسمية_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة,
    الاسم_الجديد: نص
};

عام عرف فك_طلب_موضع_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_موضع_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };

    دع قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_المستند := القيمة; };
    دع العنوان: متغير نص = «»;
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { العنوان := القيمة; };

    دع قيمة_الموضع: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «position») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_الموضع := القيمة; };
    دع الموضع: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة_الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الموضع := القيمة; };

    دع الناتج: طلب_موضع_مستند_لغة = { العنوان: العنوان, الموضع: الموضع };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_طلب_مراجع_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_مراجع_مستند_لغة {
    دع مرجع_المعاملات: &قيمة_جسون = &المعاملات;
    دع معاملات_الموضع: قيمة_جسون = *مرجع_المعاملات;
    دع معاملات_السياق: قيمة_جسون = *مرجع_المعاملات;
    دع الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع الأساسي: متغير طلب_موضع_مستند_لغة = {
        العنوان: «»,
        الموضع: الموضع_الفارغ
    };
    طابق فك_طلب_موضع_مستند_لغة(الوثيقة, معاملات_الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الأساسي := القيمة; };
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(معاملات_السياق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };
    دع قيمة_السياق: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «context») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_السياق := القيمة; };
    دع فهرس_السياق: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(قيمة_السياق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_السياق := ف; };
    دع يتضمن: متغير منطقي = صواب;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_السياق, «includeDeclaration») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.منطق(المنطق) -> { يتضمن := المنطق; }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
    دع مرجع_العنوان: &نص = &الأساسي.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع الموضع: موضع_تغيير_لغة = الأساسي.الموضع;
    دع الناتج: طلب_مراجع_مستند_لغة = {
        العنوان: العنوان,
        الموضع: الموضع,
        يتضمن_التصريح: يتضمن
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف فك_طلب_إعادة_تسمية_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_إعادة_تسمية_مستند_لغة {
    دع مرجع_المعاملات: &قيمة_جسون = &المعاملات;
    دع معاملات_الموضع: قيمة_جسون = *مرجع_المعاملات;
    دع معاملات_الاسم: قيمة_جسون = *مرجع_المعاملات;
    دع الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع الأساسي: متغير طلب_موضع_مستند_لغة = {
        العنوان: «»,
        الموضع: الموضع_الفارغ
    };
    طابق فك_طلب_موضع_مستند_لغة(الوثيقة, معاملات_الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الأساسي := القيمة; };
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(معاملات_الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };
    دع الاسم_الجديد: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «newName») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النص) -> { الاسم_الجديد := النص; };
    };
    دع مرجع_العنوان: &نص = &الأساسي.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع الموضع: موضع_تغيير_لغة = الأساسي.الموضع;
    دع الناتج: طلب_إعادة_تسمية_مستند_لغة = {
        العنوان: العنوان,
        الموضع: الموضع,
        الاسم_الجديد: الاسم_الجديد
    };
    أرجع اختيار.بعض(الناتج);
}

// Shared parameters for document-wide semantic requests such as symbols and
// semantic tokens. Decoding remains protocol-owned and carries only the URI.
عام نوع طلب_مستند_لغة = {
    العنوان: نص
};

عام عرف فك_طلب_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };
    دع قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_المستند := القيمة; };
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(العنوان) -> {
        دع الناتج: طلب_مستند_لغة = { العنوان: العنوان };
        أرجع اختيار.بعض(الناتج);
    };
}

عام عرف فك_استعلام_رموز_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار نص {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «query») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع نص_جسون(القيمة); };
}

// Follow-up hierarchy requests carry the previously returned hierarchy item.
// Only URI + selectionRange.start are required to re-resolve its canonical
// SymbolID in the fresh project semantic snapshot.
عام نوع طلب_عنصر_هرم_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة
};

عام عرف فك_طلب_عنصر_هرم_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_عنصر_هرم_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_المعاملات := ف; };
    دع قيمة_العنصر: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «item») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_العنصر := القيمة; };
    دع فهرس_العنصر: متغير غير_موقع = 0;
    طابق فهرس_كائن_جسون(قيمة_العنصر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ف) -> { فهرس_العنصر := ف; };
    دع العنوان: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_العنصر, «uri») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النص) -> { العنوان := النص; };
    };
    دع قيمة_النطاق: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_العنصر, «selectionRange») مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { قيمة_النطاق := القيمة; };
    دع موضع_بداية_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_نهاية_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع النطاق: متغير نطاق_تغيير_لغة = {
        البداية: موضع_بداية_فارغ,
        النهاية: موضع_نهاية_فارغ
    };
    طابق فك_نطاق_تغيير_لغة(الوثيقة, قيمة_النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { النطاق := القيمة; };
    دع الناتج: طلب_عنصر_هرم_لغة = { العنوان: العنوان, الموضع: النطاق.البداية };
    أرجع اختيار.بعض(الناتج);
}
