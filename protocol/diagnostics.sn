استورد sultanc_lsp.protocol.model;
استورد sultanc_lsp.protocol.text_document;
استورد sultanc_lsp.workspace.documents;
استورد sultanc_lsp.workspace.positions;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.text.number;
استورد std.text.compare;
استورد std.fs.path;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.diagnostics.wording;

// تمثيل LSP فقط. إحداثيات المصدر تأتي من Frontend، وتحويل UTF-16 يأتي من std.
نوع نطاق_تشخيص_لغة = {
    البداية: موضع_تغيير_لغة,
    النهاية: موضع_تغيير_لغة
};

عام عرف مصدر_تشخيص_للمستند(
    المصدر: &نطاق_مصدر_تشخيص,
    المستند: &مستند_لغة_مفتوح
): منطقي {
    دع س: نطاق_مصدر_تشخيص = *المصدر;
    دع د: مستند_لغة_مفتوح = *المستند;
    طابق س.اسم_المصدر مع
    | اختيار.لا_شيء -> { أرجع صواب; }
    | اختيار.بعض(الاسم) -> {
        طابق د.مسار_الملف مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المسار) -> {
            دع أ: نص = طبع_المسار(&الاسم);
            دع ب: نص = طبع_المسار(&المسار);
            أرجع نصان_متساويان(&أ, &ب);
        };
    };
}

عام عرف نطاق_تشخيص_إلى_لغة(
    المصدر: &نطاق_مصدر_تشخيص,
    المستند: &مستند_لغة_مفتوح
): اختيار نطاق_تشخيص_لغة {
    دع س: نطاق_مصدر_تشخيص = *المصدر;
    دع البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, س.النطاق.البداية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { البداية := الموضع; };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, س.النطاق.النهاية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { النهاية := الموضع; };
    دع الناتج: نطاق_تشخيص_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختيار.بعض(الناتج);
}

عرف شدة_تشخيص_إلى_رقم_لغة(الشدة: شدة_تشخيص): نص {
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> { أرجع «1»; }
    | شدة_تشخيص.تحذير -> { أرجع «2»; }
    | شدة_تشخيص.ملاحظة -> { أرجع «3»; };
}

عرف أضف_موضع_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): غير_موقع {
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع نص_سطر_الموضع: نص = غير_موقع_إلى_نص(الموضع.السطر);
    دع قيمة_سطر_الموضع: قيمة_جسون = قيمة_جسون.رقم(نص_سطر_الموضع);
    دع مدخل_سطر_الموضع: مدخل_كائن_جسون = {
        المفتاح: «line»,
        القيمة: قيمة_سطر_الموضع
    };
    دع نص_محرف_الموضع: نص = غير_موقع_إلى_نص(الموضع.المحرف);
    دع قيمة_محرف_الموضع: قيمة_جسون = قيمة_جسون.رقم(نص_محرف_الموضع);
    دع مدخل_محرف_الموضع: مدخل_كائن_جسون = {
        المفتاح: «character»,
        القيمة: قيمة_محرف_الموضع
    };
    دع مداخل_موضع_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_سطر_الموضع,
        مدخل_محرف_الموضع
    ];
    دع فهرس_موضع_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: مداخل_موضع_التشخيص,
        الفهرس: فهرس_موضع_التشخيص
    };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عرف أضف_نطاق_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تشخيص_لغة
): غير_موقع {
    دع البداية: غير_موقع = أضف_موضع_تشخيص_لغة(الكائنات, النطاق.البداية);
    دع النهاية: غير_موقع = أضف_موضع_تشخيص_لغة(الكائنات, النطاق.النهاية);
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_بداية_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(البداية);
    دع مدخل_بداية_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «start»,
        القيمة: قيمة_بداية_نطاق_التشخيص
    };
    دع قيمة_نهاية_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    دع مدخل_نهاية_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «end»,
        القيمة: قيمة_نهاية_نطاق_التشخيص
    };
    دع مداخل_نطاق_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_بداية_نطاق_التشخيص,
        مدخل_نهاية_نطاق_التشخيص
    ];
    دع فهرس_نطاق_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: مداخل_نطاق_التشخيص,
        الفهرس: فهرس_نطاق_التشخيص
    };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عرف أضف_معلومة_مرتبطة_بتشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    القيم: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المرتبط: &نطاق_مرتبط_بتشخيص
): فراغ {
    دع ر: نطاق_مرتبط_بتشخيص = *المرتبط;
    لو (!مصدر_تشخيص_للمستند(&ر.المصدر, المستند)) { أرجع; };
    طابق نطاق_تشخيص_إلى_لغة(&ر.المصدر, المستند) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(النطاق) -> {
        دع فهرس_النطاق: غير_موقع = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
        دع د: مستند_لغة_مفتوح = *المستند;
        دع مرجع_عنوان_موقع_التشخيص: &نص = &د.العنوان;
        دع عنوان_موقع_التشخيص: نص = *مرجع_عنوان_موقع_التشخيص;
        دع فهرس_الموقع: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
        دع قيمة_عنوان_موقع_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(عنوان_موقع_التشخيص);
        دع مدخل_عنوان_موقع_التشخيص: مدخل_كائن_جسون = {
            المفتاح: «uri»,
            القيمة: قيمة_عنوان_موقع_التشخيص
        };
        دع قيمة_نطاق_موقع_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        دع مدخل_نطاق_موقع_التشخيص: مدخل_كائن_جسون = {
            المفتاح: «range»,
            القيمة: قيمة_نطاق_موقع_التشخيص
        };
        دع مداخل_موقع_التشخيص: متجه مدخل_كائن_جسون = [
            مدخل_عنوان_موقع_التشخيص,
            مدخل_نطاق_موقع_التشخيص
        ];
        دع فهرس_كائن_موقع_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع الموقع: كائن_جسون = {
            المداخل: مداخل_موقع_التشخيص,
            الفهرس: فهرس_كائن_موقع_التشخيص
        };
        دع كائنات_الموقع: متغير متجه كائن_جسون = *الكائنات;
        ألحق(كائنات_الموقع, الموقع);
        *الكائنات := كائنات_الموقع;
        دع فهرس_المعلومة: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
        دع قيمة_موقع_المعلومة_المرتبطة: قيمة_جسون = قيمة_جسون.كائن(فهرس_الموقع);
        دع مدخل_موقع_المعلومة_المرتبطة: مدخل_كائن_جسون = {
            المفتاح: «location»,
            القيمة: قيمة_موقع_المعلومة_المرتبطة
        };
        دع لغة_رسالة_المعلومة: لغة_تشخيص = لغة_تشخيص.الإنجليزية();
        دع نص_رسالة_المعلومة: نص = صياغة_دور_نطاق(لغة_رسالة_المعلومة, ر.الدور);
        دع قيمة_رسالة_المعلومة_المرتبطة: قيمة_جسون = قيمة_جسون.سلسلة(نص_رسالة_المعلومة);
        دع مدخل_رسالة_المعلومة_المرتبطة: مدخل_كائن_جسون = {
            المفتاح: «message»,
            القيمة: قيمة_رسالة_المعلومة_المرتبطة
        };
        دع مداخل_المعلومة_المرتبطة: متجه مدخل_كائن_جسون = [
            مدخل_موقع_المعلومة_المرتبطة,
            مدخل_رسالة_المعلومة_المرتبطة
        ];
        دع فهرس_كائن_المعلومة_المرتبطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        دع المعلومة: كائن_جسون = {
            المداخل: مداخل_المعلومة_المرتبطة,
            الفهرس: فهرس_كائن_المعلومة_المرتبطة
        };
        دع كائنات_المعلومة: متغير متجه كائن_جسون = *الكائنات;
        ألحق(كائنات_المعلومة, المعلومة);
        *الكائنات := كائنات_المعلومة;
        دع قيم_المعلومة: متغير متجه قيمة_جسون = *القيم;
        ألحق(قيم_المعلومة, قيمة_جسون.كائن(فهرس_المعلومة));
        *القيم := قيم_المعلومة;
    };
}

عرف أضف_كائن_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المداخل: متجه مدخل_كائن_جسون
): غير_موقع {
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عرف أضف_مصفوفة_بيانات_تشخيص_لغة(
    المصفوفات: &متغير متجه مصفوفة_جسون,
    القيم: متجه قيمة_جسون
): غير_موقع {
    دع الفهرس: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    دع الحالية: متغير متجه مصفوفة_جسون = *المصفوفات;
    ألحق(الحالية, المصفوفة);
    *المصفوفات := الحالية;
    أرجع الفهرس;
}

عرف صياغة_قيمة_حجة_تشخيص_لغة(
    القيمة: &قيمة_حجة_تشخيص,
    اللغة: لغة_تشخيص
): نص {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع النص; }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        طابق اللغة مع
        | لغة_تشخيص.الإنجليزية -> { أرجع الإنجليزية; }
        | لغة_تشخيص.العربية -> { أرجع العربية; };
    }
    | قيمة_حجة_تشخيص.غير_موقعة(العدد) -> { أرجع غير_موقع_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> { أرجع عدد_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        لو (القيمة_المنطقية) { أرجع «true»; };
        أرجع «false»;
    };
}

عرف اسم_مفتاح_حجة_تشخيص_لغة(المفتاح: مفتاح_حجة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_حجة_تشخيص.القيمة -> { أرجع «value»; }
    | مفتاح_حجة_تشخيص.المتوقع -> { أرجع «expected»; }
    | مفتاح_حجة_تشخيص.الاستبدال -> { أرجع «replacement»; }
    | مفتاح_حجة_تشخيص.الموجود -> { أرجع «found»; }
    | مفتاح_حجة_تشخيص.الفهرس -> { أرجع «index»; }
    | مفتاح_حجة_تشخيص.الطول -> { أرجع «length»; }
    | مفتاح_حجة_تشخيص.المجال -> { أرجع «range»; }
    | مفتاح_حجة_تشخيص.النمط -> { أرجع «pattern»; }
    | مفتاح_حجة_تشخيص.المسار -> { أرجع «path»; }
    | مفتاح_حجة_تشخيص.الرمز -> { أرجع «symbol»; }
    | مفتاح_حجة_تشخيص.النوع -> { أرجع «type»; }
    | مفتاح_حجة_تشخيص.السياق -> { أرجع «context»; }
    | مفتاح_حجة_تشخيص.المرحلة -> { أرجع «phase»; }
    | مفتاح_حجة_تشخيص.الهدف -> { أرجع «target»; }
    | مفتاح_حجة_تشخيص.الدالة -> { أرجع «function»; }
    | مفتاح_حجة_تشخيص.الكتلة -> { أرجع «block»; }
    | مفتاح_حجة_تشخيص.التعليمة -> { أرجع «instruction»; }
    | مفتاح_حجة_تشخيص.العملية -> { أرجع «operation»; }
    | مفتاح_حجة_تشخيص.البدائي -> { أرجع «primitive»; }
    | مفتاح_حجة_تشخيص.المصدر -> { أرجع «source»; }
    | مفتاح_حجة_تشخيص.الوجهة -> { أرجع «destination»; }
    | مفتاح_حجة_تشخيص.السبب -> { أرجع «reason»; };
}

عرف اسم_دور_نطاق_تشخيص_لغة(الدور: دور_نطاق_تشخيص): نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع «primary»; }
    | دور_نطاق_تشخيص.استخدام_غير_صالح -> { أرجع «invalid-use»; }
    | دور_نطاق_تشخيص.أصل_النقل -> { أرجع «move-origin»; }
    | دور_نطاق_تشخيص.أصل_التحرير -> { أرجع «release-origin»; }
    | دور_نطاق_تشخيص.المالك_الأصلي -> { أرجع «original-owner»; }
    | دور_نطاق_تشخيص.استعارة_متعارضة -> { أرجع «conflicting-borrow»; }
    | دور_نطاق_تشخيص.موضع_متوقع -> { أرجع «expected-location»; }
    | دور_نطاق_تشخيص.اكتشاف_المحلل -> { أرجع «parser-found»; }
    | دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> { أرجع «misplaced-semicolon»; }
    | دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة -> { أرجع «semicolon-target»; }
    | دور_نطاق_تشخيص.عبارة_بلا_عملية -> { أرجع «bare-statement»; }
    | دور_نطاق_تشخيص.نمط_غير_قابل_للوصول -> { أرجع «unreachable-pattern»; }
    | دور_نطاق_تشخيص.تغطية_نمط_سابقة -> { أرجع «previous-pattern-coverage»; }
    | دور_نطاق_تشخيص.سياق_مرتبط -> { أرجع «related-context»; };
}

عرف قيمة_حجة_تشخيص_إلى_جسون_لغة(
    الحجة: &حجة_تشخيص,
    اللغة: لغة_تشخيص
): قيمة_جسون {
    دع ح: حجة_تشخيص = *الحجة;
    طابق ح.القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع قيمة_جسون.سلسلة(النص); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        دع النص: نص = صياغة_قيمة_حجة_تشخيص_لغة(&ح.القيمة, اللغة);
        أرجع قيمة_جسون.سلسلة(النص);
    }
    | قيمة_حجة_تشخيص.غير_موقعة(العدد) -> {
        أرجع قيمة_جسون.رقم(غير_موقع_إلى_نص(العدد));
    }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> {
        أرجع قيمة_جسون.رقم(عدد_إلى_نص(العدد));
    }
    | قيمة_حجة_تشخيص.منطقية(القيمة) -> { أرجع قيمة_جسون.منطق(القيمة); };
}

عرف أضف_حجج_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    الحجج: &متجه حجة_تشخيص,
    اللغة: لغة_تشخيص
): غير_موقع {
    دع الحالة: متجه حجة_تشخيص = *الحجج;
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع المفتاح: نص = اسم_مفتاح_حجة_تشخيص_لغة(الحالة[ف].المفتاح);
        دع قيمة_المفتاح: قيمة_جسون = قيمة_جسون.سلسلة(المفتاح);
        دع مدخل_المفتاح: مدخل_كائن_جسون = { المفتاح: «key», القيمة: قيمة_المفتاح };
        دع قيمة_الحجة: قيمة_جسون = قيمة_حجة_تشخيص_إلى_جسون_لغة(&الحالة[ف], اللغة);
        دع مدخل_القيمة: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_الحجة };
        دع تسمية_المفتاح: نص = صياغة_مفتاح_حجة(اللغة, الحالة[ف].المفتاح);
        دع قيمة_التسمية: قيمة_جسون = قيمة_جسون.سلسلة(تسمية_المفتاح);
        دع مدخل_التسمية: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_التسمية };
        دع مداخل: متجه مدخل_كائن_جسون = [مدخل_المفتاح, مدخل_القيمة, مدخل_التسمية];
        دع فهرس: غير_موقع = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_تعليقات_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    التعليقات: &متجه تعليق_تشخيص,
    اللغة: لغة_تشخيص
): غير_موقع {
    دع الحالة: متجه تعليق_تشخيص = *التعليقات;
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع الرسالة: نص = صياغة_تشخيص(اللغة, الحالة[ف].المفتاح);
        دع قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        دع مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        دع فهرس_الحجج: غير_موقع = أضف_حجج_إلى_بيانات_تشخيص_لغة(
            الكائنات, المصفوفات, &الحالة[ف].الحجج, اللغة
        );
        دع قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
        دع مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
        دع مداخل: متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_الحجج];
        دع فهرس: غير_موقع = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_إصلاحات_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): غير_موقع {
    دع ت: تشخيص = *التشخيص;
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ت.الإصلاحات) مثل غير_موقع)) {
        دع مرجع_الإصلاح: &إصلاح_تشخيص = &ت.الإصلاحات[ف];
        دع ص: إصلاح_تشخيص = *مرجع_الإصلاح;
        دع الرسالة: نص = صياغة_تشخيص(اللغة, ص.المفتاح);
        دع قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        دع مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        دع مرجع_الاستبدال: &نص = &ص.الاستبدال;
        دع الاستبدال: نص = *مرجع_الاستبدال;
        دع قيمة_الاستبدال: قيمة_جسون = قيمة_جسون.سلسلة(الاستبدال);
        دع مدخل_الاستبدال: مدخل_كائن_جسون = { المفتاح: «replacement», القيمة: قيمة_الاستبدال };
        دع القابلية: نص = صياغة_قابلية_إصلاح(لغة_تشخيص.الإنجليزية(), ص.القابلية);
        دع قيمة_القابلية: قيمة_جسون = قيمة_جسون.سلسلة(القابلية);
        دع مدخل_القابلية: مدخل_كائن_جسون = { المفتاح: «applicability», القيمة: قيمة_القابلية };
        دع مداخل: متغير متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_الاستبدال, مدخل_القابلية];

        // حافظ على التعديلات المركبة كما أنتجها Diagnostics. `range` أدناه يبقى
        // التحرير الأساسي للتوافق، و`additionalEdits` يحمل بقية التحريرات.
        دع قيم_التعديلات_الإضافية: متغير متجه قيمة_جسون = [];
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(ص.التعديلات_الإضافية) مثل غير_موقع)) {
            دع مرجع_استبدال_التعديل: &نص = &ص.التعديلات_الإضافية[ت].الاستبدال;
            دع استبدال_التعديل: نص = *مرجع_استبدال_التعديل;
            دع قيمة_استبدال_التعديل: قيمة_جسون = قيمة_جسون.سلسلة(استبدال_التعديل);
            دع مدخل_استبدال_التعديل: مدخل_كائن_جسون = {
                المفتاح: «replacement»,
                القيمة: قيمة_استبدال_التعديل
            };
            دع مداخل_التعديل: متغير متجه مدخل_كائن_جسون = [مدخل_استبدال_التعديل];
            لو (مصدر_تشخيص_للمستند(&ص.التعديلات_الإضافية[ت].المصدر, المستند)) {
                طابق نطاق_تشخيص_إلى_لغة(&ص.التعديلات_الإضافية[ت].المصدر, المستند) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(نطاق_التعديل) -> {
                    دع فهرس_نطاق_التعديل: غير_موقع = أضف_نطاق_تشخيص_لغة(الكائنات, نطاق_التعديل);
                    دع قيمة_نطاق_التعديل: قيمة_جسون = قيمة_جسون.كائن(فهرس_نطاق_التعديل);
                    دع مدخل_نطاق_التعديل: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_نطاق_التعديل };
                    ألحق(مداخل_التعديل, مدخل_نطاق_التعديل);
                };
            };
            دع فهرس_التعديل: غير_موقع = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل_التعديل);
            ألحق(قيم_التعديلات_الإضافية, قيمة_جسون.كائن(فهرس_التعديل));
            ت := ت + 1;
        }
        دع فهرس_التعديلات_الإضافية: غير_موقع = أضف_مصفوفة_بيانات_تشخيص_لغة(
            المصفوفات, قيم_التعديلات_الإضافية
        );
        دع قيمة_التعديلات_الإضافية: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_التعديلات_الإضافية);
        دع مدخل_التعديلات_الإضافية: مدخل_كائن_جسون = {
            المفتاح: «additionalEdits»,
            القيمة: قيمة_التعديلات_الإضافية
        };
        ألحق(مداخل, مدخل_التعديلات_الإضافية);

        لو (مصدر_تشخيص_للمستند(&ص.المصدر, المستند)) {
            طابق نطاق_تشخيص_إلى_لغة(&ص.المصدر, المستند) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(النطاق) -> {
                دع فهرس_النطاق: غير_موقع = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
                دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
                دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
                ألحق(مداخل, مدخل_النطاق);
            };
        };
        دع فهرس: غير_موقع = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_أثر_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    الأثر: &متجه مدخل_أثر_تشخيص,
    اللغة: لغة_تشخيص
): غير_موقع {
    دع الحالة: متجه مدخل_أثر_تشخيص = *الأثر;
    دع القيم: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع الرسالة: نص = صياغة_تشخيص(اللغة, الحالة[ف].المفتاح);
        دع قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        دع مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        دع فهرس_الحجج: غير_موقع = أضف_حجج_إلى_بيانات_تشخيص_لغة(
            الكائنات, المصفوفات, &الحالة[ف].الحجج, اللغة
        );
        دع قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
        دع مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
        دع مداخل: متغير متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_الحجج];
        طابق الحالة[ف].المصدر مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المصدر) -> {
            لو (مصدر_تشخيص_للمستند(&المصدر, المستند)) {
                طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(النطاق) -> {
                    دع فهرس_النطاق: غير_موقع = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
                    دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
                    دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
                    ألحق(مداخل, مدخل_النطاق);
                };
            };
        };
        دع فهرس: غير_موقع = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): غير_موقع {
    دع ت: تشخيص = *التشخيص;
    دع الدور: نص = اسم_دور_نطاق_تشخيص_لغة(ت.الدور_الرئيسي);
    دع قيمة_الدور: قيمة_جسون = قيمة_جسون.سلسلة(الدور);
    دع مدخل_الدور: مدخل_كائن_جسون = { المفتاح: «primaryRole», القيمة: قيمة_الدور };
    دع تسمية_الدور: نص = صياغة_دور_نطاق(اللغة, ت.الدور_الرئيسي);
    دع قيمة_تسمية_الدور: قيمة_جسون = قيمة_جسون.سلسلة(تسمية_الدور);
    دع مدخل_تسمية_الدور: مدخل_كائن_جسون = { المفتاح: «primaryRoleLabel», القيمة: قيمة_تسمية_الدور };
    دع فهرس_الحجج: غير_موقع = أضف_حجج_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.الحجج, اللغة);
    دع قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
    دع مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
    دع فهرس_الملاحظات: غير_موقع = أضف_تعليقات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.الملاحظات, اللغة);
    دع قيمة_الملاحظات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الملاحظات);
    دع مدخل_الملاحظات: مدخل_كائن_جسون = { المفتاح: «notes», القيمة: قيمة_الملاحظات };
    دع فهرس_المساعدة: غير_موقع = أضف_تعليقات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.المساعدة, اللغة);
    دع قيمة_المساعدة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المساعدة);
    دع مدخل_المساعدة: مدخل_كائن_جسون = { المفتاح: «help», القيمة: قيمة_المساعدة };
    دع فهرس_الإصلاحات: غير_موقع = أضف_إصلاحات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, المستند, التشخيص, اللغة);
    دع قيمة_الإصلاحات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الإصلاحات);
    دع مدخل_الإصلاحات: مدخل_كائن_جسون = { المفتاح: «fixes», القيمة: قيمة_الإصلاحات };
    دع فهرس_الأثر: غير_موقع = أضف_أثر_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, المستند, &ت.الأثر, اللغة);
    دع قيمة_الأثر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الأثر);
    دع مدخل_الأثر: مدخل_كائن_جسون = { المفتاح: «trace», القيمة: قيمة_الأثر };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_الدور, مدخل_تسمية_الدور, مدخل_الحجج, مدخل_الملاحظات, مدخل_المساعدة, مدخل_الإصلاحات, مدخل_الأثر];
    أرجع أضف_كائن_بيانات_تشخيص_لغة(الكائنات, المداخل);
}

عرف أضف_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    القيم: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص
): فراغ {
    دع ت: تشخيص = *التشخيص;
    دع موضع_تشخيص_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_تشخيص_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع نطاق_لغة: متغير نطاق_تشخيص_لغة = {
        البداية: موضع_تشخيص_فارغ_أ,
        النهاية: موضع_تشخيص_فارغ_ب
    };
    طابق ت.المصدر_الرئيسي مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المصدر) -> {
        لو (!مصدر_تشخيص_للمستند(&المصدر, المستند)) { أرجع; };
        طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
        | اختيار.لا_شيء -> { أرجع; }
        | اختيار.بعض(القيمة) -> { نطاق_لغة := القيمة; };
    };

    دع فهرس_النطاق: غير_موقع = أضف_نطاق_تشخيص_لغة(الكائنات, نطاق_لغة);
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(ت.المعرف);
    دع لغة_العرض: لغة_تشخيص = لغة_تشخيص.الإنجليزية();
    دع الرسالة: نص = صياغة_تشخيص(لغة_العرض, التعريف.الصياغة);

    دع قيمة_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    دع مدخل_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «range»,
        القيمة: قيمة_نطاق_التشخيص
    };
    دع نص_شدة_التشخيص: نص = شدة_تشخيص_إلى_رقم_لغة(التعريف.الشدة);
    دع قيمة_شدة_التشخيص: قيمة_جسون = قيمة_جسون.رقم(نص_شدة_التشخيص);
    دع مدخل_شدة_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «severity»,
        القيمة: قيمة_شدة_التشخيص
    };
    دع مرجع_كود_التشخيص: &نص = &التعريف.الكود;
    دع كود_التشخيص: نص = *مرجع_كود_التشخيص;
    دع قيمة_كود_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(كود_التشخيص);
    دع مدخل_كود_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «code»,
        القيمة: قيمة_كود_التشخيص
    };
    دع قيمة_مصدر_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«SultanC»);
    دع مدخل_مصدر_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «source»,
        القيمة: قيمة_مصدر_التشخيص
    };
    دع قيمة_رسالة_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
    دع مدخل_رسالة_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «message»,
        القيمة: قيمة_رسالة_التشخيص
    };
    دع مداخل: متغير متجه مدخل_كائن_جسون = [
        مدخل_نطاق_التشخيص,
        مدخل_شدة_التشخيص,
        مدخل_كود_التشخيص,
        مدخل_مصدر_التشخيص,
        مدخل_رسالة_التشخيص
    ];

    دع فهرس_البيانات: غير_موقع = أضف_بيانات_تشخيص_لغة(
        الكائنات, المصفوفات, المستند, التشخيص, لغة_العرض
    );
    دع قيمة_البيانات: قيمة_جسون = قيمة_جسون.كائن(فهرس_البيانات);
    دع مدخل_البيانات: مدخل_كائن_جسون = {
        المفتاح: «data»,
        القيمة: قيمة_البيانات
    };
    ألحق(مداخل, مدخل_البيانات);

    دع المرتبطة: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ت.النطاقات_المرتبطة) مثل غير_موقع)) {
        أضف_معلومة_مرتبطة_بتشخيص_لغة(
            الكائنات, &متغير المرتبطة, المستند, &ت.النطاقات_المرتبطة[ف]
        );
        ف := ف + 1;
    }
    لو ((الطول(المرتبطة) مثل غير_موقع) > 0) {
        دع فهرس_المرتبطة: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
        دع مصفوفة_المرتبطة: مصفوفة_جسون = { القيم: المرتبطة };
        دع المصفوفات_الحالية: متغير متجه مصفوفة_جسون = *المصفوفات;
        ألحق(المصفوفات_الحالية, مصفوفة_المرتبطة);
        *المصفوفات := المصفوفات_الحالية;
        دع قيمة_المعلومات_المرتبطة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المرتبطة);
        دع مدخل_مرتبط: مدخل_كائن_جسون = {
            المفتاح: «relatedInformation»,
            القيمة: قيمة_المعلومات_المرتبطة
        };
        ألحق(مداخل, مدخل_مرتبط);
    };

    دع فهرس_التشخيص: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع فهرس_كائن_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع كائن_التشخيص: كائن_جسون = {
        المداخل: مداخل,
        الفهرس: فهرس_كائن_التشخيص
    };
    دع كائنات_التشخيص: متغير متجه كائن_جسون = *الكائنات;
    ألحق(كائنات_التشخيص, كائن_التشخيص);
    *الكائنات := كائنات_التشخيص;
    دع قيم_التشخيص: متغير متجه قيمة_جسون = *القيم;
    ألحق(قيم_التشخيص, قيمة_جسون.كائن(فهرس_التشخيص));
    *القيم := قيم_التشخيص;
}

عام نوع عناصر_تشخيصات_لغة = {
    الكائنات: متجه كائن_جسون,
    المصفوفات: متجه مصفوفة_جسون,
    فهرس_العناصر: غير_موقع
};

// يبني عناصر Diagnostic داخل مخازن JSON مشتركة حتى تستطيع تقارير مساحة العمل
// جمع عدة ملفات من دون إعادة بناء نموذج تشخيص موازٍ.
عام عرف أضف_عناصر_تشخيصات_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات
): غير_موقع {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع ج: مجموعة_تشخيصات = *المجموعة;
    دع قيم_التشخيصات: متغير متجه قيمة_جسون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ج.التشخيصات) مثل غير_موقع)) {
        أضف_تشخيص_لغة(
            الكائنات, المصفوفات, &متغير قيم_التشخيصات, &د, &ج.التشخيصات[ف]
        );
        ف := ف + 1;
    }
    دع فهرس_العناصر: غير_موقع = الطول(*المصفوفات) مثل غير_موقع;
    دع مصفوفة_عناصر_التشخيصات: مصفوفة_جسون = { القيم: قيم_التشخيصات };
    دع الحالية: متغير متجه مصفوفة_جسون = *المصفوفات;
    ألحق(الحالية, مصفوفة_عناصر_التشخيصات);
    *المصفوفات := الحالية;
    أرجع فهرس_العناصر;
}

// يبني عناصر Diagnostic مرة واحدة ليستهلكها push و pull دون نسخ دلالة التشخيص.
عام عرف ابن_عناصر_تشخيصات_لغة(
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات
): عناصر_تشخيصات_لغة {
    دع الكائنات: متغير متجه كائن_جسون = [];
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    دع فهرس_العناصر: غير_موقع = أضف_عناصر_تشخيصات_لغة(
        &متغير الكائنات, &متغير المصفوفات, المستند, المجموعة
    );
    دع الناتج: عناصر_تشخيصات_لغة = {
        الكائنات: الكائنات,
        المصفوفات: المصفوفات,
        فهرس_العناصر: فهرس_العناصر
    };
    أرجع الناتج;
}

عام عرف ابن_نشر_تشخيصات_مستند_لغة(
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات
): وثيقة_جسون {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع العناصر: عناصر_تشخيصات_لغة = ابن_عناصر_تشخيصات_لغة(&د, المجموعة);
    دع مرجع_كائنات_العناصر: &متجه كائن_جسون = &العناصر.الكائنات;
    دع الكائنات: متغير متجه كائن_جسون = *مرجع_كائنات_العناصر;
    دع مرجع_مصفوفات_العناصر: &متجه مصفوفة_جسون = &العناصر.المصفوفات;
    دع المصفوفات: متجه مصفوفة_جسون = *مرجع_مصفوفات_العناصر;
    دع فهرس_عناصر_التشخيصات: غير_موقع = العناصر.فهرس_العناصر;

    دع مرجع_عنوان_معاملات_النشر: &نص = &د.العنوان;
    دع عنوان_معاملات_النشر: نص = *مرجع_عنوان_معاملات_النشر;
    دع إصدار_معاملات_النشر: عدد = د.الإصدار;
    دع فهرس_المعاملات: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_عنوان_معاملات_النشر: قيمة_جسون = قيمة_جسون.سلسلة(عنوان_معاملات_النشر);
    دع مدخل_عنوان_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «uri»,
        القيمة: قيمة_عنوان_معاملات_النشر
    };
    دع نص_إصدار_معاملات_النشر: نص = عدد_إلى_نص(إصدار_معاملات_النشر);
    دع قيمة_إصدار_معاملات_النشر: قيمة_جسون = قيمة_جسون.رقم(نص_إصدار_معاملات_النشر);
    دع مدخل_إصدار_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «version»,
        القيمة: قيمة_إصدار_معاملات_النشر
    };
    دع قيمة_تشخيصات_معاملات_النشر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_عناصر_التشخيصات);
    دع مدخل_تشخيصات_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «diagnostics»,
        القيمة: قيمة_تشخيصات_معاملات_النشر
    };
    دع مداخل_معاملات_النشر: متجه مدخل_كائن_جسون = [
        مدخل_عنوان_معاملات_النشر,
        مدخل_إصدار_معاملات_النشر,
        مدخل_تشخيصات_معاملات_النشر
    ];
    دع فهرس_كائن_معاملات_النشر: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع المعاملات: كائن_جسون = {
        المداخل: مداخل_معاملات_النشر,
        الفهرس: فهرس_كائن_معاملات_النشر
    };
    ألحق(الكائنات, المعاملات);
    دع فهرس_الجذر: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_نسخة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_إشعار_التشخيص
    };
    دع قيمة_طريقة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«textDocument/publishDiagnostics»);
    دع مدخل_طريقة_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «method»,
        القيمة: قيمة_طريقة_إشعار_التشخيص
    };
    دع قيمة_معاملات_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_المعاملات);
    دع مدخل_معاملات_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «params»,
        القيمة: قيمة_معاملات_إشعار_التشخيص
    };
    دع مداخل_جذر_إشعار_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_إشعار_التشخيص,
        مدخل_طريقة_إشعار_التشخيص,
        مدخل_معاملات_إشعار_التشخيص
    ];
    دع فهرس_كائن_جذر_إشعار_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = {
        المداخل: مداخل_جذر_إشعار_التشخيص,
        الفهرس: فهرس_كائن_جذر_إشعار_التشخيص
    };
    ألحق(الكائنات, الجذر);
    دع قيمة_جذر_وثيقة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    دع الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_إشعار_التشخيص,
        المصفوفات: المصفوفات,
        الكائنات: الكائنات
    };
    أرجع الوثيقة;
}

عام عرف ابن_مسح_تشخيصات_مستند_لغة(العنوان: نص): وثيقة_جسون {
    دع قيم_مصفوفة_فارغة: متجه قيمة_جسون = [];
    دع مصفوفة_فارغة: مصفوفة_جسون = { القيم: قيم_مصفوفة_فارغة };
    دع قيمة_عنوان_معاملات_المسح: قيمة_جسون = قيمة_جسون.سلسلة(العنوان);
    دع مدخل_عنوان_معاملات_المسح: مدخل_كائن_جسون = {
        المفتاح: «uri»,
        القيمة: قيمة_عنوان_معاملات_المسح
    };
    دع قيمة_تشخيصات_معاملات_المسح: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    دع مدخل_تشخيصات_معاملات_المسح: مدخل_كائن_جسون = {
        المفتاح: «diagnostics»,
        القيمة: قيمة_تشخيصات_معاملات_المسح
    };
    دع مداخل_معاملات_المسح: متجه مدخل_كائن_جسون = [
        مدخل_عنوان_معاملات_المسح,
        مدخل_تشخيصات_معاملات_المسح
    ];
    دع فهرس_كائن_معاملات_المسح: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع المعاملات: كائن_جسون = {
        المداخل: مداخل_معاملات_المسح,
        الفهرس: فهرس_كائن_معاملات_المسح
    };
    دع قيمة_نسخة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_مسح_التشخيص
    };
    دع قيمة_طريقة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«textDocument/publishDiagnostics»);
    دع مدخل_طريقة_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «method»,
        القيمة: قيمة_طريقة_مسح_التشخيص
    };
    دع قيمة_معاملات_مسح_التشخيص: قيمة_جسون = قيمة_جسون.كائن(0);
    دع مدخل_معاملات_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «params»,
        القيمة: قيمة_معاملات_مسح_التشخيص
    };
    دع مداخل_جذر_مسح_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_مسح_التشخيص,
        مدخل_طريقة_مسح_التشخيص,
        مدخل_معاملات_مسح_التشخيص
    ];
    دع فهرس_كائن_جذر_مسح_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = {
        المداخل: مداخل_جذر_مسح_التشخيص,
        الفهرس: فهرس_كائن_جذر_مسح_التشخيص
    };
    دع قيمة_جذر_وثيقة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.كائن(1);
    دع مصفوفات_وثيقة_مسح_التشخيص: متجه مصفوفة_جسون = [مصفوفة_فارغة];
    دع كائنات_وثيقة_مسح_التشخيص: متجه كائن_جسون = [المعاملات, الجذر];
    دع الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_مسح_التشخيص,
        المصفوفات: مصفوفات_وثيقة_مسح_التشخيص,
        الكائنات: كائنات_وثيقة_مسح_التشخيص
    };
    أرجع الوثيقة;
}

// معاملات textDocument/diagnostic. resultId السابق اختياري حسب LSP pull diagnostics.
عام نوع طلب_تشخيص_مستند_لغة = {
    العنوان: نص,
    معرف_النتيجة_السابق: اختيار نص
};

عام عرف فك_طلب_تشخيص_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختيار طلب_تشخيص_مستند_لغة {
    دع فهرس_المعاملات: متغير غير_موقع = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختيار.لا_شيء(); };

    دع مفتاح_المستند: نص = «textDocument»;
    دع فهرس_المستند: متغير غير_موقع = 0;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_المستند) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.كائن(ف) -> { فهرس_المستند := ف; }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع مفتاح_العنوان: نص = «uri»;
    دع العنوان: متغير نص = «»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المستند, &مفتاح_العنوان) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { العنوان := النص; }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع السابق: متغير اختيار نص = اختيار.لا_شيء();
    دع مفتاح_السابق: نص = «previousResultId»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_السابق) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { السابق := اختيار.بعض(النص); }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };

    دع الناتج: طلب_تشخيص_مستند_لغة = {
        العنوان: العنوان,
        معرف_النتيجة_السابق: السابق
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة: غير_موقع): نص {
    // أي overlay مفتوح قد يؤثر في وحدة أخرى؛ مراجعة مساحة العمل تبطل النتائج بأمان.
    أرجع غير_موقع_إلى_نص(مراجعة_المساحة);
}

عام عرف هل_نتيجة_تشخيص_مستند_لغة_غير_متغيرة(
    مراجعة_المساحة: غير_موقع,
    السابق: &اختيار نص
): منطقي {
    دع القيمة: اختيار نص = *السابق;
    طابق القيمة مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المعرف) -> {
        دع الحالي: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
        أرجع نصان_متساويان(&المعرف, &الحالي);
    };
}

عام عرف ابن_رد_تشخيصات_كاملة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    مراجعة_المساحة: غير_موقع,
    المجموعة: &مجموعة_تشخيصات
): وثيقة_جسون {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع العناصر: عناصر_تشخيصات_لغة = ابن_عناصر_تشخيصات_لغة(&د, المجموعة);
    دع مرجع_كائنات_العناصر: &متجه كائن_جسون = &العناصر.الكائنات;
    دع الكائنات: متغير متجه كائن_جسون = *مرجع_كائنات_العناصر;
    دع مرجع_مصفوفات_العناصر: &متجه مصفوفة_جسون = &العناصر.المصفوفات;
    دع المصفوفات: متجه مصفوفة_جسون = *مرجع_مصفوفات_العناصر;
    دع فهرس_عناصر_التشخيصات: غير_موقع = العناصر.فهرس_العناصر;

    دع فهرس_النتيجة: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_نوع_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
    دع مدخل_نوع_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «kind»,
        القيمة: قيمة_نوع_نتيجة_التشخيص_الكاملة
    };
    دع نص_معرف_نتيجة_التشخيص_الكاملة: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
    دع قيمة_معرف_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.سلسلة(نص_معرف_نتيجة_التشخيص_الكاملة);
    دع مدخل_معرف_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «resultId»,
        القيمة: قيمة_معرف_نتيجة_التشخيص_الكاملة
    };
    دع قيمة_عناصر_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_عناصر_التشخيصات);
    دع مدخل_عناصر_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «items»,
        القيمة: قيمة_عناصر_نتيجة_التشخيص_الكاملة
    };
    دع مداخل_نتيجة_التشخيص_الكاملة: متجه مدخل_كائن_جسون = [
        مدخل_نوع_نتيجة_التشخيص_الكاملة,
        مدخل_معرف_نتيجة_التشخيص_الكاملة,
        مدخل_عناصر_نتيجة_التشخيص_الكاملة
    ];
    دع فهرس_كائن_نتيجة_التشخيص_الكاملة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع النتيجة: كائن_جسون = {
        المداخل: مداخل_نتيجة_التشخيص_الكاملة,
        الفهرس: فهرس_كائن_نتيجة_التشخيص_الكاملة
    };
    ألحق(الكائنات, النتيجة);

    دع فهرس_الجذر: غير_موقع = الطول(الكائنات) مثل غير_موقع;
    دع قيمة_نسخة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_التشخيص_الكامل
    };
    دع قيمة_معرف_رد_التشخيص_الكامل: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_التشخيص_الكامل
    };
    دع قيمة_نتيجة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.كائن(فهرس_النتيجة);
    دع مدخل_نتيجة_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_التشخيص_الكامل
    };
    دع مداخل_رد_التشخيص_الكامل: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_التشخيص_الكامل,
        مدخل_معرف_رد_التشخيص_الكامل,
        مدخل_نتيجة_رد_التشخيص_الكامل
    ];
    دع فهرس_كائن_رد_التشخيص_الكامل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = {
        المداخل: مداخل_رد_التشخيص_الكامل,
        الفهرس: فهرس_كائن_رد_التشخيص_الكامل
    };
    ألحق(الكائنات, الجذر);
    دع قيمة_جذر_وثيقة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    دع الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_رد_التشخيص_الكامل,
        المصفوفات: المصفوفات,
        الكائنات: الكائنات
    };
    أرجع الوثيقة;
}

عام عرف ابن_رد_تشخيصات_غير_متغيرة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    مراجعة_المساحة: غير_موقع
): وثيقة_جسون {
    دع قيمة_نوع_نتيجة_التشخيص_غير_المتغيرة: قيمة_جسون = قيمة_جسون.سلسلة(«unchanged»);
    دع مدخل_نوع_نتيجة_التشخيص_غير_المتغيرة: مدخل_كائن_جسون = {
        المفتاح: «kind»,
        القيمة: قيمة_نوع_نتيجة_التشخيص_غير_المتغيرة
    };
    دع نص_معرف_نتيجة_التشخيص_غير_المتغيرة: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
    دع قيمة_معرف_نتيجة_التشخيص_غير_المتغيرة: قيمة_جسون = قيمة_جسون.سلسلة(نص_معرف_نتيجة_التشخيص_غير_المتغيرة);
    دع مدخل_معرف_نتيجة_التشخيص_غير_المتغيرة: مدخل_كائن_جسون = {
        المفتاح: «resultId»,
        القيمة: قيمة_معرف_نتيجة_التشخيص_غير_المتغيرة
    };
    دع مداخل_نتيجة_التشخيص_غير_المتغيرة: متجه مدخل_كائن_جسون = [
        مدخل_نوع_نتيجة_التشخيص_غير_المتغيرة,
        مدخل_معرف_نتيجة_التشخيص_غير_المتغيرة
    ];
    دع فهرس_كائن_نتيجة_التشخيص_غير_المتغيرة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع النتيجة: كائن_جسون = {
        المداخل: مداخل_نتيجة_التشخيص_غير_المتغيرة,
        الفهرس: فهرس_كائن_نتيجة_التشخيص_غير_المتغيرة
    };
    دع قيمة_نسخة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_التشخيص_غير_المتغير
    };
    دع قيمة_معرف_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_التشخيص_غير_المتغير
    };
    دع قيمة_نتيجة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.كائن(0);
    دع مدخل_نتيجة_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_التشخيص_غير_المتغير
    };
    دع مداخل_رد_التشخيص_غير_المتغير: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_التشخيص_غير_المتغير,
        مدخل_معرف_رد_التشخيص_غير_المتغير,
        مدخل_نتيجة_رد_التشخيص_غير_المتغير
    ];
    دع فهرس_كائن_رد_التشخيص_غير_المتغير: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الجذر: كائن_جسون = {
        المداخل: مداخل_رد_التشخيص_غير_المتغير,
        الفهرس: فهرس_كائن_رد_التشخيص_غير_المتغير
    };
    دع قيمة_جذر_وثيقة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.كائن(1);
    دع مصفوفات_وثيقة_رد_التشخيص_غير_المتغير: متجه مصفوفة_جسون = [];
    دع كائنات_وثيقة_رد_التشخيص_غير_المتغير: متجه كائن_جسون = [النتيجة, الجذر];
    دع الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_رد_التشخيص_غير_المتغير,
        المصفوفات: مصفوفات_وثيقة_رد_التشخيص_غير_المتغير,
        الكائنات: كائنات_وثيقة_رد_التشخيص_غير_المتغير
    };
    أرجع الوثيقة;
}
