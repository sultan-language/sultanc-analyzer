استورد sultanc_lsp.protocol.model;
استورد sultanc_lsp.protocol.text_document;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.text.number;

عام عرف ابن_رد_خطأ_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرمز: عدد,
    الرسالة: نص
): وثيقة_جسون {
    دع نص_رمز_الخطأ: نص = عدد_إلى_نص(الرمز);
    دع قيمة_رمز_الخطأ: قيمة_جسون = قيمة_جسون.رقم(نص_رمز_الخطأ);
    دع مدخل_رمز_الخطأ: مدخل_كائن_جسون = {
        المفتاح: «code»,
        القيمة: قيمة_رمز_الخطأ
    };
    دع قيمة_رسالة_الخطأ: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
    دع مدخل_رسالة_الخطأ: مدخل_كائن_جسون = {
        المفتاح: «message»,
        القيمة: قيمة_رسالة_الخطأ
    };
    دع مداخل_الخطأ: متجه مدخل_كائن_جسون = [
        مدخل_رمز_الخطأ,
        مدخل_رسالة_الخطأ
    ];
    دع فهرس_كائن_الخطأ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع كائن_الخطأ: كائن_جسون = {
        المداخل: مداخل_الخطأ,
        الفهرس: فهرس_كائن_الخطأ
    };

    دع قيمة_نسخة_جسون_اربيسي: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_جسون_اربيسي: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_جسون_اربيسي
    };
    دع قيمة_معرف_الرد: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_الرد: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_الرد
    };
    دع قيمة_خطأ_الرد: قيمة_جسون = قيمة_جسون.كائن(0);
    دع مدخل_خطأ_الرد: مدخل_كائن_جسون = {
        المفتاح: «error»,
        القيمة: قيمة_خطأ_الرد
    };
    دع مداخل_الرد: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_جسون_اربيسي,
        مدخل_معرف_الرد,
        مدخل_خطأ_الرد
    ];
    دع فهرس_كائن_الرد: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع كائن_الرد: كائن_جسون = {
        المداخل: مداخل_الرد,
        الفهرس: فهرس_كائن_الرد
    };
    دع جذر_وثيقة_الخطأ: قيمة_جسون = قيمة_جسون.كائن(1);
    دع مصفوفات_وثيقة_الخطأ: متجه مصفوفة_جسون = [];
    دع كائنات_وثيقة_الخطأ: متجه كائن_جسون = [كائن_الخطأ, كائن_الرد];
    دع الوثيقة: وثيقة_جسون = {
        الجذر: جذر_وثيقة_الخطأ,
        المصفوفات: مصفوفات_وثيقة_الخطأ,
        الكائنات: كائنات_وثيقة_الخطأ
    };
    أرجع الوثيقة;
}

عام عرف ابن_رد_عدم_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي
): وثيقة_جسون {
    دع قيمة_نسخة_رد_العدم: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_العدم
    };
    دع قيمة_معرف_رد_العدم: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_العدم
    };
    دع قيمة_نتيجة_رد_العدم: قيمة_جسون = قيمة_جسون.عدم();
    دع مدخل_نتيجة_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_العدم
    };
    دع المداخل: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_العدم,
        مدخل_معرف_رد_العدم,
        مدخل_نتيجة_رد_العدم
    ];
    دع فهرس_رد_العدم: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: المداخل,
        الفهرس: فهرس_رد_العدم
    };
    دع جذر_وثيقة_رد_العدم: قيمة_جسون = قيمة_جسون.كائن(0);
    دع مصفوفات_وثيقة_رد_العدم: متجه مصفوفة_جسون = [];
    دع كائنات_وثيقة_رد_العدم: متجه كائن_جسون = [الكائن];
    دع الوثيقة: وثيقة_جسون = {
        الجذر: جذر_وثيقة_رد_العدم,
        المصفوفات: مصفوفات_وثيقة_رد_العدم,
        الكائنات: كائنات_وثيقة_رد_العدم
    };
    أرجع الوثيقة;
}

// لا نعلن إلا القدرات المنفذة فعليا. مزامنة النص Incremental لأن Wave 2
// يطبق contentChanges بالتتابع على snapshot المستند الحالي.
عام عرف ابن_رد_تهيئة_خادم_لغة(
    المعرف: معرف_طلب_جسون_اربيسي
): وثيقة_جسون {
    دع قيمة_تضمين_نص_الحفظ: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_تضمين_نص_الحفظ: مدخل_كائن_جسون = {
        المفتاح: «includeText»,
        القيمة: قيمة_تضمين_نص_الحفظ
    };
    دع مداخل_خيارات_الحفظ: متجه مدخل_كائن_جسون = [مدخل_تضمين_نص_الحفظ];
    دع فهرس_خيارات_الحفظ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع خيارات_الحفظ: كائن_جسون = {
        المداخل: مداخل_خيارات_الحفظ,
        الفهرس: فهرس_خيارات_الحفظ
    };
    دع قيمة_فتح_إغلاق_المستند: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_فتح_إغلاق_المستند: مدخل_كائن_جسون = {
        المفتاح: «openClose»,
        القيمة: قيمة_فتح_إغلاق_المستند
    };
    دع قيمة_نوع_تغيير_المستند: قيمة_جسون = قيمة_جسون.رقم(«2»);
    دع مدخل_نوع_تغيير_المستند: مدخل_كائن_جسون = {
        المفتاح: «change»,
        القيمة: قيمة_نوع_تغيير_المستند
    };
    دع قيمة_حفظ_المستند: قيمة_جسون = قيمة_جسون.كائن(0);
    دع مدخل_حفظ_المستند: مدخل_كائن_جسون = {
        المفتاح: «save»,
        القيمة: قيمة_حفظ_المستند
    };
    دع مداخل_مزامنة_النص: متجه مدخل_كائن_جسون = [
        مدخل_فتح_إغلاق_المستند,
        مدخل_نوع_تغيير_المستند,
        مدخل_حفظ_المستند
    ];
    دع فهرس_مزامنة_النص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع مزامنة_النص: كائن_جسون = {
        المداخل: مداخل_مزامنة_النص,
        الفهرس: فهرس_مزامنة_النص
    };
    دع قيمة_معرف_مزود_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«sultanc»);
    دع مدخل_معرف_مزود_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «identifier»,
        القيمة: قيمة_معرف_مزود_التشخيص
    };
    دع قيمة_اعتماديات_التشخيص: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_اعتماديات_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «interFileDependencies»,
        القيمة: قيمة_اعتماديات_التشخيص
    };
    دع قيمة_تشخيص_مساحة_العمل: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_تشخيص_مساحة_العمل: مدخل_كائن_جسون = {
        المفتاح: «workspaceDiagnostics»,
        القيمة: قيمة_تشخيص_مساحة_العمل
    };
    دع مداخل_مزود_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_معرف_مزود_التشخيص,
        مدخل_اعتماديات_التشخيص,
        مدخل_تشخيص_مساحة_العمل
    ];
    دع فهرس_مزود_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع مزود_التشخيص: كائن_جسون = {
        المداخل: مداخل_مزود_التشخيص,
        الفهرس: فهرس_مزود_التشخيص
    };
    دع قيمة_دعم_مجلدات_مساحة_العمل: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_دعم_مجلدات_مساحة_العمل: مدخل_كائن_جسون = {
        المفتاح: «supported»,
        القيمة: قيمة_دعم_مجلدات_مساحة_العمل
    };
    دع قيمة_إشعارات_تغيير_المجلدات: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_إشعارات_تغيير_المجلدات: مدخل_كائن_جسون = {
        المفتاح: «changeNotifications»,
        القيمة: قيمة_إشعارات_تغيير_المجلدات
    };
    دع مداخل_قدرة_مجلدات_مساحة_العمل: متجه مدخل_كائن_جسون = [
        مدخل_دعم_مجلدات_مساحة_العمل,
        مدخل_إشعارات_تغيير_المجلدات
    ];
    دع فهرس_قدرة_مجلدات_مساحة_العمل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع قدرة_مجلدات_مساحة_العمل: كائن_جسون = {
        المداخل: مداخل_قدرة_مجلدات_مساحة_العمل,
        الفهرس: فهرس_قدرة_مجلدات_مساحة_العمل
    };
    دع قيمة_مجلدات_مساحة_العمل: قيمة_جسون = قيمة_جسون.كائن(3);
    دع مدخل_مجلدات_مساحة_العمل: مدخل_كائن_جسون = {
        المفتاح: «workspaceFolders»,
        القيمة: قيمة_مجلدات_مساحة_العمل
    };
    دع مداخل_قدرة_مساحة_العمل: متجه مدخل_كائن_جسون = [مدخل_مجلدات_مساحة_العمل];
    دع فهرس_قدرة_مساحة_العمل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع قدرة_مساحة_العمل: كائن_جسون = {
        المداخل: مداخل_قدرة_مساحة_العمل,
        الفهرس: فهرس_قدرة_مساحة_العمل
    };
    دع قيمة_تهيئة_إعادة_التسمية: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_تهيئة_إعادة_التسمية: مدخل_كائن_جسون = {
        المفتاح: «prepareProvider»,
        القيمة: قيمة_تهيئة_إعادة_التسمية
    };
    دع مداخل_مزود_إعادة_التسمية: متجه مدخل_كائن_جسون = [مدخل_تهيئة_إعادة_التسمية];
    دع فهرس_مزود_إعادة_التسمية: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع مزود_إعادة_التسمية: كائن_جسون = {
        المداخل: مداخل_مزود_إعادة_التسمية,
        الفهرس: فهرس_مزود_إعادة_التسمية
    };
    دع قيمة_ترميز_الموضع: قيمة_جسون = قيمة_جسون.سلسلة(«utf-16»);
    دع مدخل_ترميز_الموضع: مدخل_كائن_جسون = {
        المفتاح: «positionEncoding»,
        القيمة: قيمة_ترميز_الموضع
    };
    دع قيمة_مزامنة_المستند: قيمة_جسون = قيمة_جسون.كائن(1);
    دع مدخل_مزامنة_المستند: مدخل_كائن_جسون = {
        المفتاح: «textDocumentSync»,
        القيمة: قيمة_مزامنة_المستند
    };
    دع قيمة_مزود_التشخيص: قيمة_جسون = قيمة_جسون.كائن(2);
    دع مدخل_مزود_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «diagnosticProvider»,
        القيمة: قيمة_مزود_التشخيص
    };
    دع قيمة_مزود_إجراءات_الكود: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_إجراءات_الكود: مدخل_كائن_جسون = {
        المفتاح: «codeActionProvider»,
        القيمة: قيمة_مزود_إجراءات_الكود
    };
    دع قيمة_مزود_التحويم: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_التحويم: مدخل_كائن_جسون = { المفتاح: «hoverProvider», القيمة: قيمة_مزود_التحويم };
    دع قيمة_مزود_التعريف: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_التعريف: مدخل_كائن_جسون = { المفتاح: «definitionProvider», القيمة: قيمة_مزود_التعريف };
    دع قيمة_مزود_التصريح: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_التصريح: مدخل_كائن_جسون = { المفتاح: «declarationProvider», القيمة: قيمة_مزود_التصريح };
    دع قيمة_مزود_هرم_الاستدعاء: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_هرم_الاستدعاء: مدخل_كائن_جسون = { المفتاح: «callHierarchyProvider», القيمة: قيمة_مزود_هرم_الاستدعاء };
    دع قيمة_مزود_هرم_النوع: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_هرم_النوع: مدخل_كائن_جسون = { المفتاح: «typeHierarchyProvider», القيمة: قيمة_مزود_هرم_النوع };
    دع قيمة_مزود_تمييز_المستند: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_تمييز_المستند: مدخل_كائن_جسون = { المفتاح: «documentHighlightProvider», القيمة: قيمة_مزود_تمييز_المستند };
    دع قيمة_مزود_المراجع: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_المراجع: مدخل_كائن_جسون = { المفتاح: «referencesProvider», القيمة: قيمة_مزود_المراجع };
    دع قيمة_مزود_الإكمال: قيمة_جسون = قيمة_جسون.كائن(10);
    دع مدخل_مزود_الإكمال: مدخل_كائن_جسون = { المفتاح: «completionProvider», القيمة: قيمة_مزود_الإكمال };
    دع قيمة_مزود_مساعدة_التوقيع: قيمة_جسون = قيمة_جسون.كائن(10);
    دع مدخل_مزود_مساعدة_التوقيع: مدخل_كائن_جسون = { المفتاح: «signatureHelpProvider», القيمة: قيمة_مزود_مساعدة_التوقيع };
    دع قيمة_مزود_إعادة_التسمية: قيمة_جسون = قيمة_جسون.كائن(5);
    دع مدخل_مزود_إعادة_التسمية: مدخل_كائن_جسون = { المفتاح: «renameProvider», القيمة: قيمة_مزود_إعادة_التسمية };
    دع قيمة_مزود_الرموز_الدلالية: قيمة_جسون = قيمة_جسون.كائن(12);
    دع مدخل_مزود_الرموز_الدلالية: مدخل_كائن_جسون = { المفتاح: «semanticTokensProvider», القيمة: قيمة_مزود_الرموز_الدلالية };
    دع قيمة_مزود_رموز_المستند: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_رموز_المستند: مدخل_كائن_جسون = { المفتاح: «documentSymbolProvider», القيمة: قيمة_مزود_رموز_المستند };
    دع قيمة_مزود_رموز_مساحة_العمل: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_مزود_رموز_مساحة_العمل: مدخل_كائن_جسون = { المفتاح: «workspaceSymbolProvider», القيمة: قيمة_مزود_رموز_مساحة_العمل };
    دع قيمة_قدرة_مساحة_العمل: قيمة_جسون = قيمة_جسون.كائن(4);
    دع مدخل_قدرة_مساحة_العمل: مدخل_كائن_جسون = {
        المفتاح: «workspace»,
        القيمة: قيمة_قدرة_مساحة_العمل
    };
    دع مداخل_القدرات: متجه مدخل_كائن_جسون = [
        مدخل_ترميز_الموضع,
        مدخل_مزامنة_المستند,
        مدخل_مزود_التشخيص,
        مدخل_مزود_إجراءات_الكود,
        مدخل_مزود_التحويم,
        مدخل_مزود_التعريف,
        مدخل_مزود_التصريح,
        مدخل_مزود_هرم_الاستدعاء,
        مدخل_مزود_هرم_النوع,
        مدخل_مزود_تمييز_المستند,
        مدخل_مزود_المراجع,
        مدخل_مزود_الإكمال,
        مدخل_مزود_مساعدة_التوقيع,
        مدخل_مزود_إعادة_التسمية,
        مدخل_مزود_الرموز_الدلالية,
        مدخل_مزود_رموز_المستند,
        مدخل_مزود_رموز_مساحة_العمل,
        مدخل_قدرة_مساحة_العمل
    ];
    دع فهرس_القدرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع القدرات: كائن_جسون = {
        المداخل: مداخل_القدرات,
        الفهرس: فهرس_القدرات
    };
    دع قيمة_اسم_الخادم: قيمة_جسون = قيمة_جسون.سلسلة(«SultanC Language Server»);
    دع مدخل_اسم_الخادم: مدخل_كائن_جسون = {
        المفتاح: «name»,
        القيمة: قيمة_اسم_الخادم
    };
    دع قيمة_إصدار_الخادم: قيمة_جسون = قيمة_جسون.سلسلة(«0.4.1»);
    دع مدخل_إصدار_الخادم: مدخل_كائن_جسون = {
        المفتاح: «version»,
        القيمة: قيمة_إصدار_الخادم
    };
    دع مداخل_معلومات_الخادم: متجه مدخل_كائن_جسون = [مدخل_اسم_الخادم, مدخل_إصدار_الخادم];
    دع فهرس_معلومات_الخادم: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع معلومات_الخادم: كائن_جسون = {
        المداخل: مداخل_معلومات_الخادم,
        الفهرس: فهرس_معلومات_الخادم
    };
    دع قيمة_قدرات_نتيجة_التهيئة: قيمة_جسون = قيمة_جسون.كائن(6);
    دع مدخل_قدرات_نتيجة_التهيئة: مدخل_كائن_جسون = {
        المفتاح: «capabilities»,
        القيمة: قيمة_قدرات_نتيجة_التهيئة
    };
    دع قيمة_معلومات_الخادم_في_النتيجة: قيمة_جسون = قيمة_جسون.كائن(7);
    دع مدخل_معلومات_الخادم_في_النتيجة: مدخل_كائن_جسون = {
        المفتاح: «serverInfo»,
        القيمة: قيمة_معلومات_الخادم_في_النتيجة
    };
    دع مداخل_نتيجة_التهيئة: متجه مدخل_كائن_جسون = [
        مدخل_قدرات_نتيجة_التهيئة,
        مدخل_معلومات_الخادم_في_النتيجة
    ];
    دع فهرس_نتيجة_التهيئة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع نتيجة_التهيئة: كائن_جسون = {
        المداخل: مداخل_نتيجة_التهيئة,
        الفهرس: فهرس_نتيجة_التهيئة
    };
    دع قيمة_نسخة_رد_التهيئة: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_نسخة_رد_التهيئة: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_التهيئة
    };
    دع قيمة_معرف_رد_التهيئة: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_معرف_رد_التهيئة: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_التهيئة
    };
    دع قيمة_نتيجة_رد_التهيئة: قيمة_جسون = قيمة_جسون.كائن(8);
    دع مدخل_نتيجة_رد_التهيئة: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_التهيئة
    };
    دع مداخل_رد_التهيئة: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_التهيئة,
        مدخل_معرف_رد_التهيئة,
        مدخل_نتيجة_رد_التهيئة
    ];
    دع فهرس_رد_التهيئة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الرد: كائن_جسون = {
        المداخل: مداخل_رد_التهيئة,
        الفهرس: فهرس_رد_التهيئة
    };
    دع جذر_وثيقة_التهيئة: قيمة_جسون = قيمة_جسون.كائن(9);
    دع نوع_رمز_دالة: قيمة_جسون = قيمة_جسون.سلسلة(«function»);
    دع نوع_رمز_نوع: قيمة_جسون = قيمة_جسون.سلسلة(«type»);
    دع نوع_رمز_سجل: قيمة_جسون = قيمة_جسون.سلسلة(«struct»);
    دع نوع_رمز_تعداد: قيمة_جسون = قيمة_جسون.سلسلة(«enum»);
    دع نوع_رمز_عضو_تعداد: قيمة_جسون = قيمة_جسون.سلسلة(«enumMember»);
    دع نوع_رمز_معامل: قيمة_جسون = قيمة_جسون.سلسلة(«parameter»);
    دع نوع_رمز_متغير: قيمة_جسون = قيمة_جسون.سلسلة(«variable»);
    دع أنواع_الرموز_الدلالية: متجه قيمة_جسون = [
        نوع_رمز_دالة,
        نوع_رمز_نوع,
        نوع_رمز_سجل,
        نوع_رمز_تعداد,
        نوع_رمز_عضو_تعداد,
        نوع_رمز_معامل,
        نوع_رمز_متغير
    ];
    دع معدل_تصريح: قيمة_جسون = قيمة_جسون.سلسلة(«declaration»);
    دع معدلات_الرموز_الدلالية: متجه قيمة_جسون = [معدل_تصريح];
    دع مصفوفة_أنواع_الرموز: مصفوفة_جسون = { القيم: أنواع_الرموز_الدلالية };
    دع مصفوفة_معدلات_الرموز: مصفوفة_جسون = { القيم: معدلات_الرموز_الدلالية };
    دع مصفوفات_وثيقة_التهيئة: متجه مصفوفة_جسون = [مصفوفة_أنواع_الرموز, مصفوفة_معدلات_الرموز];
    دع مداخل_مزود_الإكمال: متجه مدخل_كائن_جسون = [];
    دع فهرس_مزود_الإكمال: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع مزود_الإكمال: كائن_جسون = { المداخل: مداخل_مزود_الإكمال, الفهرس: فهرس_مزود_الإكمال };
    دع قيمة_أنواع_وسيلة_الإيضاح: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    دع مدخل_أنواع_وسيلة_الإيضاح: مدخل_كائن_جسون = { المفتاح: «tokenTypes», القيمة: قيمة_أنواع_وسيلة_الإيضاح };
    دع قيمة_معدلات_وسيلة_الإيضاح: قيمة_جسون = قيمة_جسون.مصفوفة(1);
    دع مدخل_معدلات_وسيلة_الإيضاح: مدخل_كائن_جسون = { المفتاح: «tokenModifiers», القيمة: قيمة_معدلات_وسيلة_الإيضاح };
    دع مداخل_وسيلة_الإيضاح: متجه مدخل_كائن_جسون = [مدخل_أنواع_وسيلة_الإيضاح, مدخل_معدلات_وسيلة_الإيضاح];
    دع فهرس_وسيلة_الإيضاح: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع وسيلة_إيضاح_الرموز: كائن_جسون = { المداخل: مداخل_وسيلة_الإيضاح, الفهرس: فهرس_وسيلة_الإيضاح };
    دع قيمة_وسيلة_الإيضاح: قيمة_جسون = قيمة_جسون.كائن(11);
    دع مدخل_وسيلة_الإيضاح: مدخل_كائن_جسون = { المفتاح: «legend», القيمة: قيمة_وسيلة_الإيضاح };
    دع قيمة_كامل_الرموز: قيمة_جسون = قيمة_جسون.منطق(صواب);
    دع مدخل_كامل_الرموز: مدخل_كائن_جسون = { المفتاح: «full», القيمة: قيمة_كامل_الرموز };
    دع مداخل_مزود_الرموز: متجه مدخل_كائن_جسون = [مدخل_وسيلة_الإيضاح, مدخل_كامل_الرموز];
    دع فهرس_مزود_الرموز: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع مزود_الرموز_الدلالية: كائن_جسون = { المداخل: مداخل_مزود_الرموز, الفهرس: فهرس_مزود_الرموز };
    دع كائنات_وثيقة_التهيئة: متجه كائن_جسون = [
        خيارات_الحفظ,
        مزامنة_النص,
        مزود_التشخيص,
        قدرة_مجلدات_مساحة_العمل,
        قدرة_مساحة_العمل,
        مزود_إعادة_التسمية,
        القدرات,
        معلومات_الخادم,
        نتيجة_التهيئة,
        الرد,
        مزود_الإكمال,
        وسيلة_إيضاح_الرموز,
        مزود_الرموز_الدلالية
    ];
    دع الوثيقة: وثيقة_جسون = {
        الجذر: جذر_وثيقة_التهيئة,
        المصفوفات: مصفوفات_وثيقة_التهيئة,
        الكائنات: كائنات_وثيقة_التهيئة
    };
    أرجع الوثيقة;
}

// بناة JSON-RPC/LSP عامة لميزات البروتوكول الدلالية.
عام عرف أضف_موضع_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): غير_موقع {
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع نص_السطر: نص = غير_موقع_إلى_نص(الموضع.السطر);
    دع قيمة_السطر: قيمة_جسون = قيمة_جسون.رقم(نص_السطر);
    دع مدخل_السطر: مدخل_كائن_جسون = { المفتاح: «line», القيمة: قيمة_السطر };
    دع نص_المحرف: نص = غير_موقع_إلى_نص(الموضع.المحرف);
    دع قيمة_المحرف: قيمة_جسون = قيمة_جسون.رقم(نص_المحرف);
    دع مدخل_المحرف: مدخل_كائن_جسون = { المفتاح: «character», القيمة: قيمة_المحرف };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_السطر, مدخل_المحرف];
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عام عرف أضف_نطاق_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تغيير_لغة
): غير_موقع {
    دع البداية: غير_موقع = أضف_موضع_لغة_إلى_جسون(الكائنات, النطاق.البداية);
    دع النهاية: غير_موقع = أضف_موضع_لغة_إلى_جسون(الكائنات, النطاق.النهاية);
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_البداية: قيمة_جسون = قيمة_جسون.كائن(البداية);
    دع مدخل_البداية: مدخل_كائن_جسون = { المفتاح: «start», القيمة: قيمة_البداية };
    دع قيمة_النهاية: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    دع مدخل_النهاية: مدخل_كائن_جسون = { المفتاح: «end», القيمة: قيمة_النهاية };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_البداية, مدخل_النهاية];
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عام عرف أضف_موقع_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة
): غير_موقع {
    دع فهرس_النطاق: غير_موقع = أضف_نطاق_لغة_إلى_جسون(الكائنات, النطاق);
    دع الفهرس: غير_موقع = الطول(*الكائنات) مثل غير_موقع;
    دع قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(العنوان);
    دع مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    دع قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    دع مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_العنوان, مدخل_النطاق];
    دع فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    دع الحالية: متغير متجه كائن_جسون = *الكائنات;
    ألحق(الحالية, الكائن);
    *الكائنات := الحالية;
    أرجع الفهرس;
}

عام عرف ابن_رد_نتيجة_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي,
    النتيجة: قيمة_جسون,
    المصفوفات: متجه مصفوفة_جسون,
    الكائنات: متجه كائن_جسون
): وثيقة_جسون {
    دع كائنات_الناتج: متغير متجه كائن_جسون = الكائنات;
    دع فهرس_الرد: غير_موقع = الطول(كائنات_الناتج) مثل غير_موقع;
    دع قيمة_النسخة: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    دع مدخل_النسخة: مدخل_كائن_جسون = { المفتاح: «jsonrpc», القيمة: قيمة_النسخة };
    دع قيمة_المعرف: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    دع مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «id», القيمة: قيمة_المعرف };
    دع مدخل_النتيجة: مدخل_كائن_جسون = { المفتاح: «result», القيمة: النتيجة };
    دع المداخل: متجه مدخل_كائن_جسون = [مدخل_النسخة, مدخل_المعرف, مدخل_النتيجة];
    دع فهرس_كائن_الرد: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الرد: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_كائن_الرد };
    ألحق(كائنات_الناتج, الرد);
    دع الجذر: قيمة_جسون = قيمة_جسون.كائن(فهرس_الرد);
    دع الوثيقة: وثيقة_جسون = { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: كائنات_الناتج };
    أرجع الوثيقة;
}
