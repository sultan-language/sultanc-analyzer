استورد sultanc_lsp.analysis.frontend;
استورد sultanc_lsp.workspace.documents;
استورد std.text.compare;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;

// ذاكرة LSP تخزن ناتج الواجهة المقننة فقط. لا تنشئ حقائق دلالية جديدة؛
// المفتاح هو مراجعة Workspace وهوية المستند، وتبطل تلقائيا عند أي تغيير مصدر.
عام نوع مدخل_ذاكرة_لقطة_لغة = {
    مراجعة_المساحة: غير_موقع,
    العنوان: نص,
    اللقطة: لقطة_تحليل_واجهة_لغة
};

عام نوع مدخل_ذاكرة_مشروع_لغة = {
    مراجعة_المساحة: غير_موقع,
    النتيجة: اختيار نتيجة_تحليل_مشروع_لغة
};

عام نوع ذاكرة_تحليل_لغة = {
    مستندات: متجه مدخل_ذاكرة_لقطة_لغة,
    مستندات_في_مشروع: متجه مدخل_ذاكرة_لقطة_لغة,
    مشروع: مدخل_ذاكرة_مشروع_لغة
};

عام عرف ذاكرة_تحليل_لغة_جديدة(): ذاكرة_تحليل_لغة {
    دع مستندات: متجه مدخل_ذاكرة_لقطة_لغة = [];
    دع مستندات_في_مشروع: متجه مدخل_ذاكرة_لقطة_لغة = [];
    دع بلا_مشروع: اختيار نتيجة_تحليل_مشروع_لغة = اختيار.لا_شيء();
    دع مشروع: مدخل_ذاكرة_مشروع_لغة = { مراجعة_المساحة: 0, النتيجة: بلا_مشروع };
    دع الناتج: ذاكرة_تحليل_لغة = {
        مستندات: مستندات,
        مستندات_في_مشروع: مستندات_في_مشروع,
        مشروع: مشروع
    };
    أرجع الناتج;
}

عرف لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
    المداخل: &متجه مدخل_ذاكرة_لقطة_لغة,
    مراجعة_المساحة: غير_موقع,
    العنوان: &نص
): اختيار لقطة_تحليل_واجهة_لغة {
    دع القيم: متجه مدخل_ذاكرة_لقطة_لغة = *المداخل;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (
            القيم[ف].مراجعة_المساحة == مراجعة_المساحة
            && نصان_متساويان(&القيم[ف].العنوان, العنوان)
        ) {
            دع مرجع_اللقطة: &لقطة_تحليل_واجهة_لغة = &القيم[ف].اللقطة;
            دع اللقطة: لقطة_تحليل_واجهة_لغة = *مرجع_اللقطة;
            أرجع اختيار.بعض(اللقطة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف لقطة_مستند_من_ذاكرة_تحليل_لغة(
    الذاكرة: &ذاكرة_تحليل_لغة,
    مراجعة_المساحة: غير_موقع,
    العنوان: &نص,
    في_مشروع: منطقي
): اختيار لقطة_تحليل_واجهة_لغة {
    دع الحالة: ذاكرة_تحليل_لغة = *الذاكرة;
    لو (في_مشروع) {
        أرجع لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
            &الحالة.مستندات_في_مشروع, مراجعة_المساحة, العنوان
        );
    };
    أرجع لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
        &الحالة.مستندات, مراجعة_المساحة, العنوان
    );
}

عرف خزن_في_مدخلات_ذاكرة_تحليل_لغة(
    المداخل: &متجه مدخل_ذاكرة_لقطة_لغة,
    مراجعة_المساحة: غير_موقع,
    العنوان: &نص,
    اللقطة: &لقطة_تحليل_واجهة_لغة
): متجه مدخل_ذاكرة_لقطة_لغة {
    دع الحالية: متجه مدخل_ذاكرة_لقطة_لغة = *المداخل;
    دع الجديدة: متغير متجه مدخل_ذاكرة_لقطة_لغة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالية) مثل غير_موقع)) {
        لو (
            الحالية[ف].مراجعة_المساحة == مراجعة_المساحة
            && !نصان_متساويان(&الحالية[ف].العنوان, العنوان)
        ) {
            دع مرجع_المدخل: &مدخل_ذاكرة_لقطة_لغة = &الحالية[ف];
            دع المدخل: مدخل_ذاكرة_لقطة_لغة = *مرجع_المدخل;
            ألحق(الجديدة, المدخل);
        };
        ف := ف + 1;
    }
    دع نسخة_العنوان: نص = *العنوان;
    دع نسخة_اللقطة: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع المدخل_الجديد: مدخل_ذاكرة_لقطة_لغة = {
        مراجعة_المساحة: مراجعة_المساحة,
        العنوان: نسخة_العنوان,
        اللقطة: نسخة_اللقطة
    };
    ألحق(الجديدة, المدخل_الجديد);
    أرجع الجديدة;
}

عام عرف خزن_لقطة_مستند_في_ذاكرة_تحليل_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    مراجعة_المساحة: غير_موقع,
    العنوان: &نص,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    في_مشروع: منطقي
): فراغ {
    دع الحالة: متغير ذاكرة_تحليل_لغة = *الذاكرة;
    لو (في_مشروع) {
        الحالة.مستندات_في_مشروع := خزن_في_مدخلات_ذاكرة_تحليل_لغة(
            &الحالة.مستندات_في_مشروع, مراجعة_المساحة, العنوان, اللقطة
        );
    } وإلا {
        الحالة.مستندات := خزن_في_مدخلات_ذاكرة_تحليل_لغة(
            &الحالة.مستندات, مراجعة_المساحة, العنوان, اللقطة
        );
    };
    *الذاكرة := الحالة;
}

عام عرف نتيجة_مشروع_من_ذاكرة_تحليل_لغة(
    الذاكرة: &ذاكرة_تحليل_لغة,
    مراجعة_المساحة: غير_موقع
): اختيار نتيجة_تحليل_مشروع_لغة {
    دع الحالة: ذاكرة_تحليل_لغة = *الذاكرة;
    لو (الحالة.مشروع.مراجعة_المساحة != مراجعة_المساحة) { أرجع اختيار.لا_شيء(); };
    دع مرجع_النتيجة: &اختيار نتيجة_تحليل_مشروع_لغة = &الحالة.مشروع.النتيجة;
    دع النتيجة: اختيار نتيجة_تحليل_مشروع_لغة = *مرجع_النتيجة;
    أرجع النتيجة;
}

عام عرف خزن_نتيجة_مشروع_في_ذاكرة_تحليل_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    مراجعة_المساحة: غير_موقع,
    النتيجة: &نتيجة_تحليل_مشروع_لغة
): فراغ {
    دع الحالة: متغير ذاكرة_تحليل_لغة = *الذاكرة;
    دع نسخة_النتيجة: نتيجة_تحليل_مشروع_لغة = *النتيجة;
    دع اختيار_النتيجة: اختيار نتيجة_تحليل_مشروع_لغة = اختيار.بعض(نسخة_النتيجة);
    دع المدخل: مدخل_ذاكرة_مشروع_لغة = {
        مراجعة_المساحة: مراجعة_المساحة,
        النتيجة: اختيار_النتيجة
    };
    الحالة.مشروع := المدخل;
    *الذاكرة := الحالة;
}

عام عرف حلل_مشروع_بذاكرة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    المساحة: &مساحة_عمل_لغة,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    دع حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    دع حالة_الذاكرة: ذاكرة_تحليل_لغة = *الذاكرة;
    طابق نتيجة_مشروع_من_ذاكرة_تحليل_لغة(&حالة_الذاكرة, حالة_المساحة.المراجعة) مع
    | اختيار.بعض(النتيجة) -> { أرجع النتيجة; }
    | اختيار.لا_شيء -> { };
    دع النتيجة: نتيجة_تحليل_مشروع_لغة = حلل_واجهة_مشروع_لغة(المساحة, جذور_المشروع);
    خزن_نتيجة_مشروع_في_ذاكرة_تحليل_لغة(
        الذاكرة, حالة_المساحة.المراجعة, &النتيجة
    );
    أرجع النتيجة;
}

عرف ابن_لقطة_مستند_من_نتيجة_مشروع_لغة(
    المستند: &مستند_لغة_مفتوح,
    النتيجة: &نتيجة_تحليل_مشروع_لغة
): نتيجة_تحليل_واجهة_لغة {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع مرجع_العنوان: &نص = &د.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع الإصدار: عدد = د.الإصدار;
    دع المراجعة: غير_موقع = د.المراجعة;
    دع مرجع_اختيار_المسار: &اختيار نص = &د.مسار_الملف;
    دع اختيار_المسار: اختيار نص = *مرجع_اختيار_المسار;
    دع المسار: متغير نص = «»;
    طابق اختيار_المسار مع
    | اختيار.لا_شيء -> { أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل(); }
    | اختيار.بعض(القيمة) -> { المسار := القيمة; };
    دع نتيجة_المشروع: نتيجة_تحليل_مشروع_لغة = *النتيجة;
    طابق نتيجة_المشروع مع
    | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_تحليل_مشروع_لغة.مرفوضة(التشخيصات) -> {
        دع بلا_واجهة: اختيار نتيجة_واجهة_وحدة = اختيار.لا_شيء();
        دع اللقطة: لقطة_تحليل_واجهة_لغة = {
            العنوان: العنوان,
            المسار: المسار,
            الإصدار: الإصدار,
            المراجعة: المراجعة,
            الواجهة: بلا_واجهة,
            التشخيصات: التشخيصات
        };
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    }
    | نتيجة_تحليل_مشروع_لغة.مكتملة(الواجهة) -> {
        دع تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &الواجهة.تشخيصات_الأدوات);
        دع واجهة_متاحة: اختيار نتيجة_واجهة_وحدة = اختيار.بعض(الواجهة);
        دع اللقطة: لقطة_تحليل_واجهة_لغة = {
            العنوان: العنوان,
            المسار: المسار,
            الإصدار: الإصدار,
            المراجعة: المراجعة,
            الواجهة: واجهة_متاحة,
            التشخيصات: تشخيصات_الأدوات
        };
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    };
}

عام عرف حلل_مستند_بذاكرة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص,
    في_مشروع: منطقي
): نتيجة_تحليل_واجهة_لغة {
    دع حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    دع د: مستند_لغة_مفتوح = *المستند;
    دع حالة_الذاكرة: ذاكرة_تحليل_لغة = *الذاكرة;
    طابق لقطة_مستند_من_ذاكرة_تحليل_لغة(
        &حالة_الذاكرة, حالة_المساحة.المراجعة, &د.العنوان, في_مشروع
    ) مع
    | اختيار.بعض(اللقطة) -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    }
    | اختيار.لا_شيء -> { };

    دع النتيجة: متغير نتيجة_تحليل_واجهة_لغة =
        نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    لو (في_مشروع && ((الطول(*جذور_المشروع) مثل غير_موقع) > 0)) {
        دع نتيجة_المشروع: نتيجة_تحليل_مشروع_لغة = حلل_مشروع_بذاكرة_لغة(
            الذاكرة, المساحة, جذور_المشروع
        );
        النتيجة := ابن_لقطة_مستند_من_نتيجة_مشروع_لغة(&د, &نتيجة_المشروع);
    } وإلا لو (في_مشروع) {
        النتيجة := حلل_واجهة_مستند_لغة_في_مشروع(المساحة, المستند, جذور_المشروع);
    } وإلا {
        النتيجة := حلل_واجهة_مستند_لغة(المساحة, المستند);
    };
    طابق النتيجة مع
    | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
        خزن_لقطة_مستند_في_ذاكرة_تحليل_لغة(
            الذاكرة, حالة_المساحة.المراجعة, &د.العنوان, &اللقطة, في_مشروع
        );
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    };
}
