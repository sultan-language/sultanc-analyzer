استورد sultanc_lsp.workspace.documents;
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;

// حد LSP مع Frontend فقط: يمرر لقطات المستندات المفتوحة إلى مزود المصدر المقنن،
// ثم يستهلك نتيجة خط الأنابيب الدلالي نفسه. لا توجد دلالة لغة مكررة هنا.
عام نوع لقطة_تحليل_واجهة_لغة = {
    العنوان: نص,
    المسار: نص,
    الإصدار: عدد,
    المراجعة: غير_موقع,
    الواجهة: اختيار نتيجة_واجهة_وحدة,
    التشخيصات: مجموعة_تشخيصات
};

عام نوع نتيجة_تحليل_واجهة_لغة =
    | مكتملة بنوع لقطة_تحليل_واجهة_لغة
    | مصدر_غير_قابل_للتحليل
;

عام عرف ابن_لقطة_واجهة_بلا_دلالات_لغة(
    المستند: &مستند_لغة_مفتوح
): نتيجة_تحليل_واجهة_لغة {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع مرجع_العنوان: &نص = &د.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع الإصدار: عدد = د.الإصدار;
    دع المراجعة: غير_موقع = د.المراجعة;
    دع مرجع_المسار: &اختيار نص = &د.مسار_الملف;
    دع اختيار_المسار: اختيار نص = *مرجع_المسار;
    دع المسار: متغير نص = «»;
    طابق اختيار_المسار مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | اختيار.بعض(القيمة) -> { المسار := القيمة; };
    دع بلا_واجهة: اختيار نتيجة_واجهة_وحدة = اختيار.لا_شيء();
    دع بلا_تشخيصات: مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع اللقطة: لقطة_تحليل_واجهة_لغة = {
        العنوان: العنوان,
        المسار: المسار,
        الإصدار: الإصدار,
        المراجعة: المراجعة,
        الواجهة: بلا_واجهة,
        التشخيصات: بلا_تشخيصات
    };
    أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
}

// جميع overlays المفتوحة تدخل البيئة نفسها قبل التحليل. هذا لا يعيد بناء Module
// ولا Source identity داخل LSP؛ إنه يزود Source Provider المقنن بأحدث بايتات المحرر فقط.
عرف ضع_تراكبات_مساحة_العمل_في_البيئة(
    المساحة: &مساحة_عمل_لغة,
    البيئة: &متغير بيئة_وحدات_منطقية
): فراغ {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المستندات) مثل غير_موقع)) {
        طابق الحالة.المستندات[ف] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المستند) -> {
            دع مرجع_النص: &نص = &المستند.النص;
            دع نسخة_النص: نص = *مرجع_النص;
            دع مرجع_مسار_الملف: &اختيار نص = &المستند.مسار_الملف;
            دع نسخة_مسار_الملف: اختيار نص = *مرجع_مسار_الملف;
            طابق نسخة_مسار_الملف مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(المسار) -> {
                ضع_تراكب_مصدر_في_البيئة(البيئة, المسار, نسخة_النص);
            };
        };
        ف := ف + 1;
    }
}

عرف مسارات_مصادر_مفتوحة_إضافية(
    المساحة: &مساحة_عمل_لغة
): متجه نص {
    دع الحالة: مساحة_عمل_لغة = *المساحة;
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المستندات) مثل غير_موقع)) {
        طابق الحالة.المستندات[ف] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المستند) -> {
            طابق المستند.مسار_الملف مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(مسار_المستند) -> {
                ألحق(الناتج, مسار_المستند);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حلل_واجهة_مستند_لغة_بجذور(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_واجهة_لغة {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع مرجع_العنوان: &نص = &د.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع الإصدار: عدد = د.الإصدار;
    دع المراجعة: غير_موقع = د.المراجعة;
    دع المسار: متغير نص = «»;
    طابق د.مسار_الملف مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | اختيار.بعض(القيمة) -> { المسار := القيمة; };

    دع الإضافية: متجه نص = مسارات_مصادر_مفتوحة_إضافية(المساحة);
    دع الجذور: متجه نص = *جذور_المشروع;
    دع إعداد_المشروع: متغير نتيجة_إعداد_تجميع_مباشر = نتيجة_إعداد_تجميع_مباشر.غير_صالح();
    لو ((الطول(الجذور) مثل غير_موقع) == 0) {
        إعداد_المشروع := ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية);
    } وإلا {
        إعداد_المشروع := ابن_إعداد_مشروع_مباشر(&المسار, &الجذور, &الإضافية);
    };
    طابق إعداد_المشروع مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الإعداد.البيئة;
        دع البيئة: متغير بيئة_وحدات_منطقية = *مرجع_البيئة;
        دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الإعداد.المفاتيح_المباشرة;
        دع المفاتيح_الجذرية: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
        // كل مستند مفتوح يحتفظ بهوية Source/Module نفسها؛ التراكب يغير المحتوى فقط.
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير البيئة);

        دع الطلب: طلب_واجهة_مشروع = {
            البيئة: البيئة,
            المفاتيح_الجذرية: المفاتيح_الجذرية,
            احتفظ_بحقائق_الأدوات: صواب
        };
        طابق ابن_واجهة_مشروع(الطلب) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            دع واجهة_غير_متاحة: اختيار نتيجة_واجهة_وحدة = اختيار.لا_شيء();
            دع اللقطة: لقطة_تحليل_واجهة_لغة = {
                العنوان: العنوان,
                المسار: المسار,
                الإصدار: الإصدار,
                المراجعة: المراجعة,
                الواجهة: واجهة_غير_متاحة,
                التشخيصات: التشخيصات
            };
            أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
        }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            // Tooling recovery may return a useful partial semantic interface together
            // with canonical compiler diagnostics. Preserve both; LSP must not turn a
            // recovered snapshot into an apparently clean document.
            دع تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
            ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &الواجهة.تشخيصات_الأدوات);
            دع واجهة_متاحة: اختيار نتيجة_واجهة_وحدة = اختيار.بعض(الواجهة);
            دع اللقطة: لقطة_تحليل_واجهة_لغة = {
                العنوان: العنوان,
                المسار: المسار,
                الإصدار: الإصدار,
                المراجعة: المراجعة,
                الواجهة: واجهة_متاحة,
                التشخيصات: تشخيصات_الأدوات
            };
            أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
        };
    };
}

عام عرف حلل_واجهة_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح
): نتيجة_تحليل_واجهة_لغة {
    دع بلا_جذور: متجه نص = [];
    أرجع حلل_واجهة_مستند_لغة_بجذور(المساحة, المستند, &بلا_جذور);
}

عام عرف حلل_واجهة_مستند_لغة_في_مشروع(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_واجهة_لغة {
    أرجع حلل_واجهة_مستند_لغة_بجذور(المساحة, المستند, جذور_المشروع);
}

// Project-wide semantic analysis for requests that are not anchored to an open
// document (for example workspace symbols). Source discovery remains compiler
// Driver ownership; open editor overlays are applied to the same canonical environment.
عام نوع نتيجة_تحليل_مشروع_لغة =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
    | غير_قابل_للتحليل
;

عام نوع نتيجة_اكتشاف_مصادر_مشروع_لغة =
    | مكتملة بنوع متجه نص
    | فشل
;

عام عرف اكتشف_مسارات_مصادر_مشروع_لغة(
    جذور_المشروع: &متجه نص
): نتيجة_اكتشاف_مصادر_مشروع_لغة {
    طابق اكتشف_مصادر_مشروع(جذور_المشروع) مع
    | نتيجة_اكتشاف_مصادر_مشروع.فشل(_) -> {
        أرجع نتيجة_اكتشاف_مصادر_مشروع_لغة.فشل();
    }
    | نتيجة_اكتشاف_مصادر_مشروع.مكتملة(القيم) -> {
        أرجع نتيجة_اكتشاف_مصادر_مشروع_لغة.مكتملة(القيم);
    };
}

عام عرف حلل_واجهة_مشروع_لغة(
    المساحة: &مساحة_عمل_لغة,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    دع الجذور: متجه نص = *جذور_المشروع;
    لو ((الطول(الجذور) مثل غير_موقع) == 0) {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    };
    دع المكتشفة: متغير متجه نص = [];
    طابق اكتشف_مصادر_مشروع(&الجذور) مع
    | نتيجة_اكتشاف_مصادر_مشروع.فشل(_) -> {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    }
    | نتيجة_اكتشاف_مصادر_مشروع.مكتملة(القيم) -> { المكتشفة := القيم; };
    لو ((الطول(المكتشفة) مثل غير_موقع) == 0) {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    };
    دع المفتوحة: متجه نص = مسارات_مصادر_مفتوحة_إضافية(المساحة);
    دع الدخول: متغير نص = «»;
    لو ((الطول(المفتوحة) مثل غير_موقع) > 0) {
        دع مرجع_الدخول_المفتوح: &نص = &المفتوحة[0];
        الدخول := *مرجع_الدخول_المفتوح;
    } وإلا {
        دع مرجع_الدخول_المكتشف: &نص = &المكتشفة[0];
        الدخول := *مرجع_الدخول_المكتشف;
    };
    طابق ابن_إعداد_مشروع_مباشر(&الدخول, &الجذور, &المفتوحة) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الإعداد.البيئة;
        دع البيئة: متغير بيئة_وحدات_منطقية = *مرجع_البيئة;
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير البيئة);
        دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الإعداد.المفاتيح_المباشرة;
        دع المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
        دع الطلب: طلب_واجهة_مشروع = {
            البيئة: البيئة,
            المفاتيح_الجذرية: المفاتيح,
            احتفظ_بحقائق_الأدوات: صواب
        };
        طابق ابن_واجهة_مشروع(الطلب) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            أرجع نتيجة_تحليل_مشروع_لغة.مرفوضة(التشخيصات);
        }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            أرجع نتيجة_تحليل_مشروع_لغة.مكتملة(الواجهة);
        };
    };
}
