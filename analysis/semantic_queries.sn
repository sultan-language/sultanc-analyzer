// classification/enumeration. The LSP does not lex or classify source text.
عام نوع ظهور_مصنف_لغة = {
    النطاق: نطاق_تغيير_لغة,
    النوع: نوع_تصريح,
    تصريح: منطقي
};

عام نوع رمز_معلن_لغة = {
    الاسم: نص,
    النوع: نوع_تصريح,
    الموقع: موقع_دلالي_لغة,
    نطاق_التحديد: نطاق_تغيير_لغة
};

عرف اسم_رمز_من_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: &رمز_دلالي
): اختيار نص {
    دع ر: رمز_دلالي = *الرمز;
    طابق مصدر_واجهة_بمعرف(الواجهة, ر.نطاق_الاسم.البداية.المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المصدر) -> {
        دع العدد: غير_موقع = طول_نطاق_بالبايت(ر.نطاق_الاسم);
        أرجع مقطع_نص(&المصدر.المحتوى, ر.نطاق_الاسم.البداية.البايت, العدد);
    };
}

عرف حول_رمز_واجهة_إلى_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: &رمز_دلالي
): اختيار رمز_معلن_لغة {
    دع ر: رمز_دلالي = *الرمز;
    دع الاسم: متغير نص = «»;
    طابق اسم_رمز_من_واجهة_لغة(الواجهة, &ر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
    دع موضع_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع نطاق_فارغ_لغة: نطاق_تغيير_لغة = { البداية: موضع_فارغ, النهاية: موضع_فارغ };
    دع الموقع: متغير موقع_دلالي_لغة = {
        العنوان: «»,
        النطاق: نطاق_فارغ_لغة
    };
    طابق موقع_نطاق_واجهة_لغة(الواجهة, ر.نطاق_التصريح) مع
    | اختيار.لا_شيء -> {
        طابق موقع_نطاق_واجهة_لغة(الواجهة, ر.نطاق_الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الموقع := القيمة; };
    }
    | اختيار.بعض(القيمة) -> { الموقع := القيمة; };
    دع التحديد: متغير نطاق_تغيير_لغة = الموقع.النطاق;
    طابق مصدر_واجهة_بمعرف(الواجهة, ر.نطاق_الاسم.البداية.المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المصدر) -> {
        طابق نطاق_مصدر_إلى_نطاق_لغة(&المصدر, ر.نطاق_الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { التحديد := القيمة; };
    };
    دع الناتج: رمز_معلن_لغة = {
        الاسم: الاسم,
        النوع: ر.النوع,
        الموقع: الموقع,
        نطاق_التحديد: التحديد
    };
    أرجع اختيار.بعض(الناتج);
}

عام عرف ظهورات_مصنفة_دلاليا_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه ظهور_مصنف_لغة {
    دع الناتج: متغير متجه ظهور_مصنف_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع المصنفة: متجه ظهور_مصنف_دلاليا = ظهورات_مصنفة_واجهة_لمصدر(&الواجهة, المصدر);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المصنفة) مثل غير_موقع)) {
            دع مرجع_الظهور: &ظهور_مصنف_دلاليا = &المصنفة[ف];
            دع الظهور: ظهور_مصنف_دلاليا = *مرجع_الظهور;
            طابق نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(النطاق) -> {
                دع القيمة: ظهور_مصنف_لغة = {
                    النطاق: النطاق,
                    النوع: الظهور.النوع,
                    تصريح: الظهور.تصريح
                };
                ألحق(الناتج, القيمة);
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف رموز_مستند_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه رمز_معلن_لغة {
    دع الناتج: متغير متجه رمز_معلن_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(&الواجهة, المصدر);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
            طابق حول_رمز_واجهة_إلى_لغة(&الواجهة, &الرموز[ف]) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الرمز) -> { ألحق(الناتج, الرمز); };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف رموز_مشروع_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة
): متجه رمز_معلن_لغة {
    دع الناتج: متغير متجه رمز_معلن_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الواجهة) -> {
        دع الرموز: متجه رمز_دلالي = كل_رموز_واجهة(&الواجهة);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
            طابق حول_رمز_واجهة_إلى_لغة(&الواجهة, &الرموز[ف]) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الرمز) -> { ألحق(الناتج, الرمز); };
