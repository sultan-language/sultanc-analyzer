عام نوع موقع_دلالي_لغة = {
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة
};

عرف معرف_مصدر_مستند_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المستند: &مستند_لغة_مفتوح
): اختيار غير_موقع {
    دع د: مستند_لغة_مفتوح = *المستند;
    دع مرجع_المسار: &اختيار نص = &د.مسار_الملف;
    دع المسار: اختيار نص = *مرجع_المسار;
    طابق المسار مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع معرف_مصدر_واجهة_باسم(الواجهة, &القيمة); };
}

عرف نطاق_مصدر_إلى_نطاق_لغة(
    المصدر: &مصدر,
    النطاق: نطاق
): اختيار نطاق_تغيير_لغة {
    دع م: مصدر = *المصدر;
    لو ((النطاق.البداية.المصدر != م.المعرف) || (النطاق.النهاية.المصدر != م.المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&م.المحتوى);
    دع بداية16: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
    دع نهاية16: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&م.المحتوى, &الفهرس, النطاق.البداية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { بداية16 := الموضع; };
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&م.المحتوى, &الفهرس, النطاق.النهاية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { نهاية16 := الموضع; };
    دع البداية: موضع_تغيير_لغة = { السطر: بداية16.السطر, المحرف: بداية16.العمود };
    دع النهاية: موضع_تغيير_لغة = { السطر: نهاية16.السطر, المحرف: نهاية16.العمود };
    دع الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختيار.بعض(الناتج);
}

عرف موقع_نطاق_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النطاق: نطاق
): اختيار موقع_دلالي_لغة {
    طابق مصدر_واجهة_بمعرف(الواجهة, النطاق.البداية.المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المصدر) -> {
        دع مرجع_اسم_المصدر: &نص = &المصدر.الاسم;
        دع اسم_المصدر: نص = *مرجع_اسم_المصدر;
        دع العنوان: متغير نص = «»;
        طابق مسار_إلى_عنوان_ملف(&اسم_المصدر) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
        طابق نطاق_مصدر_إلى_نطاق_لغة(&المصدر, النطاق) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(نطاق_اللغة) -> {
            دع الناتج: موقع_دلالي_لغة = { العنوان: العنوان, النطاق: نطاق_اللغة };
            أرجع اختيار.بعض(الناتج);
        };
    };
}


عرف نطاق_مصدر_إلى_نطاق_لغة_للمستند(
    المستند: &مستند_لغة_مفتوح,
    النطاق: نطاق
): اختيار نطاق_تغيير_لغة {
    دع البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, النطاق.البداية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { البداية := الموضع; };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, النطاق.النهاية.البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { النهاية := الموضع; };
    دع الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختيار.بعض(الناتج);
}

عرف رمز_لقطة_عند_موضع_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار معرف_رمز {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        أرجع رمز_واجهة_عند_بايت(&الواجهة, المصدر, البايت);
    };
}

عام عرف نطاق_إعادة_تسمية_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار نطاق_تغيير_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق حضر_إعادة_تسمية_واجهة(&الواجهة, المصدر, البايت) مع
        | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(_) -> {
            طابق ظهور_اسم_واجهة_عند_بايت(&الواجهة, المصدر, البايت) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(الظهور) -> {
                أرجع نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق);
            };
        };
    };
}

عرف نص_نوع_تصريح_لغة(النوع: نوع_تصريح): نص {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع «function»; }
    | نوع_تصريح.دالة_خارجية -> { أرجع «extern function»; }
    | نوع_تصريح.مرادف_نوع -> { أرجع «type alias»; }
    | نوع_تصريح.سجل -> { أرجع «record»; }
    | نوع_تصريح.تعداد -> { أرجع «enum»; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع «constructor»; }
    | نوع_تصريح.معامل_نوع -> { أرجع «type parameter»; }
    | نوع_تصريح.معامل -> { أرجع «parameter»; }
    | نوع_تصريح.ربط_محلي -> { أرجع «local»; };
}

عرف صل_أجزاء_تحويم_لغة(الأجزاء: &متجه نص): نص {
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(الأجزاء, &الفاصل);
}

عرف اسم_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختيار نص {
    دع ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, ت.نطاق_الاسم.البداية.المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المصدر) -> {
        دع العدد: غير_موقع = طول_نطاق_بالبايت(ت.نطاق_الاسم);
        أرجع مقطع_نص(&المصدر.المحتوى, ت.نطاق_الاسم.البداية.البايت, العدد);
    };
}

عرف نوع_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختيار نص {
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(معرف_النوع) -> { أرجع تهجئة_نوع_واجهة(الواجهة, معرف_النوع); };
}

عرف رمز_هو_بدء_البرنامج_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): منطقي {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    طابق الحالة.رمز_بدء_البرنامج مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(رمز_البدء) -> { أرجع معرفا_رمز_متساويان(رمز_البدء, الرمز); };
}

عرف نوع_ناتج_دالة_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختيار نص {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(نوع_الدالة) -> {
        طابق نوع_ناتج_دالة_دلالي(&الحالة.الأنواع, نوع_الدالة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(نوع_الناتج) -> { أرجع تهجئة_نوع_واجهة(الواجهة, نوع_الناتج); };
    };
}

عرف رأس_تصريح_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختيار نص {
    دع ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, ت.نطاق_التصريح.البداية.المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المصدر) -> {
        دع البداية: غير_موقع = ت.نطاق_التصريح.البداية.البايت;
        دع حد_التصريح: غير_موقع = ت.نطاق_التصريح.النهاية.البايت;
        دع حد_المصدر: غير_موقع = الطول(المصدر.المحتوى) مثل غير_موقع;
        دع النهاية_القصوى: متغير غير_موقع = حد_المصدر;
        لو (حد_التصريح < حد_المصدر) { النهاية_القصوى := حد_التصريح; };
        لو (البداية >= النهاية_القصوى) { أرجع اختيار.لا_شيء(); };
        دع النهاية: متغير غير_موقع = البداية;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر && (النهاية < النهاية_القصوى)) {
            دع البايت: غ8 = المصدر.المحتوى[النهاية];
            لو ((البايت == 0x0A) || (البايت == 0x7B) || (البايت == 0x3B)) {
                مستمر := خطأ;
            } وإلا {
                النهاية := النهاية + 1;
            };
        }
        طابق مقطع_نص(&المصدر.المحتوى, البداية, النهاية - البداية) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرأس) -> {
            دع المنظف: نص = قص_النص(&الرأس);
            لو ((الطول(المنظف) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
            أرجع اختيار.بعض(المنظف);
        };
    };
}

عرف وصف_رمز_مالك_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المالك: معرف_رمز
): اختيار نص {
    طابق تصريح_رمز_واجهة(الواجهة, المالك) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التصريح) -> {
        طابق اسم_رمز_تحويم_لغة(الواجهة, &التصريح) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            دع النوع: نص = نص_نوع_تصريح_لغة(التصريح.النوع);
            دع الأجزاء: متجه نص = [النوع, « `», الاسم, «`»];
            أرجع اختيار.بعض(صل_أجزاء_تحويم_لغة(&الأجزاء));
        };
    };
}

عرف وصف_دالة_حاوية_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختيار نص {
    دع ت: رمز_دلالي = *التصريح;
    دع الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, ت.نطاق_الاسم.البداية.المصدر);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
        دع المرشح: رمز_دلالي = الرموز[ف];
        دع هل_دالة: متغير منطقي = خطأ;
        طابق المرشح.النوع مع
        | نوع_تصريح.دالة -> { هل_دالة := صواب; }
        | نوع_تصريح.دالة_خارجية -> { هل_دالة := صواب; }
        | _ -> { };
        لو (هل_دالة && !معرفا_رمز_متساويان(المرشح.المعرف, ت.المعرف)
            && نطاق_داخل_نطاق_تحويم_لغة(ت.نطاق_الاسم, المرشح.نطاق_التصريح)) {
            أرجع وصف_رمز_مالك_تحويم_لغة(الواجهة, المرشح.المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أسماء_رموز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرموز: &متجه معرف_رمز
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع القيم: متجه معرف_رمز = *الرموز;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق تصريح_رمز_واجهة(الواجهة, القيم[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(التصريح) -> {
            طابق اسم_رمز_تحويم_لغة(الواجهة, &التصريح) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الاسم) -> {
                دع الأجزاء: متجه نص = [«`», الاسم, «`»];
                ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سطر_وسم_تحويم_لغة(الوسم: نص, القيمة: نص): نص {
    دع الأجزاء: متجه نص = [«**», الوسم, «:** », القيمة];
    أرجع صل_أجزاء_تحويم_لغة(&الأجزاء);
}

عرف نطاق_داخل_نطاق_تحويم_لغة(الداخلي: نطاق, الخارجي: نطاق): منطقي {
    لو (الداخلي.البداية.المصدر != الخارجي.البداية.المصدر) { أرجع خطأ; };
    لو (الداخلي.النهاية.المصدر != الخارجي.النهاية.المصدر) { أرجع خطأ; };
    أرجع (الداخلي.البداية.البايت >= الخارجي.البداية.البايت)
        && (الداخلي.النهاية.البايت <= الخارجي.النهاية.البايت);
}

عرف معاملات_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    نطاق_التصريح: نطاق
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, نطاق_التصريح.البداية.المصدر);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
        دع الابن: رمز_دلالي = الرموز[ف];
        لو (نطاق_داخل_نطاق_تحويم_لغة(الابن.نطاق_الاسم, نطاق_التصريح)) {
            طابق الابن.النوع مع
            | نوع_تصريح.معامل -> {
                طابق اسم_رمز_تحويم_لغة(الواجهة, &الابن) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الاسم) -> {
                    طابق نوع_رمز_تحويم_لغة(الواجهة, الابن.المعرف) مع
                    | اختيار.لا_شيء -> {
                        دع الأجزاء: متجه نص = [«`», الاسم, «`»];
                        ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                    }
                    | اختيار.بعض(النوع) -> {
                        دع الأجزاء: متجه نص = [«`», الاسم, «: », النوع, «`»];
                        ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                    };
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف معاملات_نوع_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    نطاق_التصريح: نطاق
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, نطاق_التصريح.البداية.المصدر);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
        دع الابن: رمز_دلالي = الرموز[ف];
        لو (نطاق_داخل_نطاق_تحويم_لغة(الابن.نطاق_الاسم, نطاق_التصريح)) {
            طابق الابن.النوع مع
            | نوع_تصريح.معامل_نوع -> {
                طابق اسم_رمز_تحويم_لغة(الواجهة, &الابن) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الاسم) -> {
                    دع الأجزاء: متجه نص = [«`», الاسم, «`»];
                    ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}


عرف نص_تحويم_رمز_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز,
    التصريح: &رمز_دلالي
): اختيار نص {
    دع ت: رمز_دلالي = *التصريح;
    دع الاسم: متغير نص = «»;
    طابق اسم_رمز_تحويم_لغة(الواجهة, &ت) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الاسم := القيمة; };

    دع نص_توقيع: متغير نص = «»;
    طابق رأس_تصريح_تحويم_لغة(الواجهة, &ت) مع
    | اختيار.لا_شيء -> {
        دع نوع_التوقيع: نص = نص_نوع_تصريح_لغة(ت.النوع);
        دع أجزاء_التوقيع: متجه نص = [نوع_التوقيع, « », الاسم];
        نص_توقيع := صل_أجزاء_تحويم_لغة(&أجزاء_التوقيع);
    }
    | اختيار.بعض(الرأس) -> { نص_توقيع := الرأس; };
    دع رأس: متجه نص = ["```sultanc\n", نص_توقيع, "\n```"];
    دع نص_الرأس: نص = صل_أجزاء_تحويم_لغة(&رأس);
    دع الأسطر: متغير متجه نص = [نص_الرأس];

    دع نوع_التصريح: نص = نص_نوع_تصريح_لغة(ت.النوع);
    دع سطر_الصنف: نص = سطر_وسم_تحويم_لغة(«Kind», نوع_التصريح);
    ألحق(الأسطر, سطر_الصنف);
    طابق نوع_رمز_تحويم_لغة(الواجهة, الرمز) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(النوع) -> {
        دع أجزاء_النوع: متجه نص = [«`», النوع, «`»];
        دع نص_النوع: نص = صل_أجزاء_تحويم_لغة(&أجزاء_النوع);
        دع سطر_النوع: نص = سطر_وسم_تحويم_لغة(«Type», نص_النوع);
        ألحق(الأسطر, سطر_النوع);
    };

    دع هو_بدء_البرنامج: منطقي = رمز_هو_بدء_البرنامج_تحويم_لغة(الواجهة, الرمز);
    لو (هو_بدء_البرنامج) {
        دع سطر_الدور: نص = سطر_وسم_تحويم_لغة(«Role», «program entry point»);
        ألحق(الأسطر, سطر_الدور);
    };
    لو (ت.علني) {
        دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «public»);
        ألحق(الأسطر, سطر_الرؤية);
    } وإلا لو (!هو_بدء_البرنامج) {
        طابق ت.النوع مع
        | نوع_تصريح.دالة -> { دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «private»); ألحق(الأسطر, سطر_الرؤية); }
        | نوع_تصريح.دالة_خارجية -> { دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «private»); ألحق(الأسطر, سطر_الرؤية); }
        | نوع_تصريح.مرادف_نوع -> { دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «private»); ألحق(الأسطر, سطر_الرؤية); }
        | نوع_تصريح.سجل -> { دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «private»); ألحق(الأسطر, سطر_الرؤية); }
        | نوع_تصريح.تعداد -> { دع سطر_الرؤية: نص = سطر_وسم_تحويم_لغة(«Visibility», «private»); ألحق(الأسطر, سطر_الرؤية); }
        | _ -> { };
    };

    دع يعرض_معاملات_نوع: متغير منطقي = خطأ;
    دع يعرض_معاملات: متغير منطقي = خطأ;
    طابق ت.النوع مع
    | نوع_تصريح.دالة -> { يعرض_معاملات_نوع := صواب; يعرض_معاملات := صواب; }
    | نوع_تصريح.دالة_خارجية -> { يعرض_معاملات_نوع := صواب; يعرض_معاملات := صواب; }
    | نوع_تصريح.مرادف_نوع -> { يعرض_معاملات_نوع := صواب; }
    | نوع_تصريح.سجل -> { يعرض_معاملات_نوع := صواب; }
    | نوع_تصريح.تعداد -> { يعرض_معاملات_نوع := صواب; }
    | _ -> { };
    لو (يعرض_معاملات_نوع) {
        دع معاملات_النوع: متجه نص = معاملات_نوع_رمز_تحويم_لغة(الواجهة, ت.نطاق_التصريح);
        لو ((الطول(معاملات_النوع) مثل غير_موقع) > 0) {
            دع الفاصل: نص = «, »;
            دع النص: نص = صل_النصوص(&معاملات_النوع, &الفاصل);
            دع السطر: نص = سطر_وسم_تحويم_لغة(«Type parameters», النص);
            ألحق(الأسطر, السطر);
        };
    };
    لو (يعرض_معاملات) {
        دع المعاملات: متجه نص = معاملات_رمز_تحويم_لغة(الواجهة, ت.نطاق_التصريح);
        لو ((الطول(المعاملات) مثل غير_موقع) > 0) {
            دع الفاصل: نص = «, »;
            دع النص: نص = صل_النصوص(&المعاملات, &الفاصل);
            دع السطر: نص = سطر_وسم_تحويم_لغة(«Parameters», النص);
            ألحق(الأسطر, السطر);
        };
    };
    طابق ت.النوع مع
    | نوع_تصريح.دالة -> {
        طابق نوع_ناتج_دالة_تحويم_لغة(الواجهة, الرمز) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الناتج) -> {
            دع أجزاء_الناتج: متجه نص = [«`», الناتج, «`»];
            دع نص_الناتج: نص = صل_أجزاء_تحويم_لغة(&أجزاء_الناتج);
            دع السطر: نص = سطر_وسم_تحويم_لغة(«Returns», نص_الناتج);
            ألحق(الأسطر, السطر);
        };
    }
    | نوع_تصريح.دالة_خارجية -> {
        طابق نوع_ناتج_دالة_تحويم_لغة(الواجهة, الرمز) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الناتج) -> {
            دع أجزاء_الناتج: متجه نص = [«`», الناتج, «`»];
            دع نص_الناتج: نص = صل_أجزاء_تحويم_لغة(&أجزاء_الناتج);
            دع السطر: نص = سطر_وسم_تحويم_لغة(«Returns», نص_الناتج);
            ألحق(الأسطر, السطر);
        };
    }
    | _ -> { };

    دع عرض_المالك: متغير منطقي = خطأ;
    طابق ت.المالك مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المالك) -> {
        طابق وصف_رمز_مالك_تحويم_لغة(الواجهة, المالك) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الوصف) -> {
            دع سطر_المالك: نص = سطر_وسم_تحويم_لغة(«Owner», الوصف);
            ألحق(الأسطر, سطر_المالك);
            عرض_المالك := صواب;
        };
    };
    لو (!عرض_المالك) {
        طابق وصف_دالة_حاوية_تحويم_لغة(الواجهة, &ت) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الوصف) -> {
            دع سطر_المالك: نص = سطر_وسم_تحويم_لغة(«Owner», الوصف);
            ألحق(الأسطر, سطر_المالك);
        };
    };

    طابق اسم_مصدر_واجهة_بمعرف(الواجهة, ت.نطاق_الاسم.البداية.المصدر) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المصدر) -> {
        دع السطر: نص = غير_موقع_إلى_نص(ت.نطاق_الاسم.البداية.السطر مثل غير_موقع);
        دع العمود: نص = غير_موقع_إلى_نص((ت.نطاق_الاسم.البداية.العمود مثل غير_موقع) + 1);
        دع أجزاء_الموقع: متجه نص = [«`», المصدر, «:», السطر, «:», العمود, «`»];
        دع نص_الموقع: نص = صل_أجزاء_تحويم_لغة(&أجزاء_الموقع);
        دع سطر_الموقع: نص = سطر_وسم_تحويم_لغة(«Defined in», نص_الموقع);
        ألحق(الأسطر, سطر_الموقع);
    };

    طابق ت.النوع مع
    | نوع_تصريح.مرادف_نوع -> {
        دع العليا: متجه معرف_رمز = أنواع_عليا_لرمز_واجهة(الواجهة, الرمز);
        دع أسماء_العليا: متجه نص = أسماء_رموز_تحويم_لغة(الواجهة, &العليا);
        لو ((الطول(أسماء_العليا) مثل غير_موقع) > 0) {
            دع فاصل_أسماء: نص = «, »;
            دع نص_العليا: نص = صل_النصوص(&أسماء_العليا, &فاصل_أسماء);
            دع سطر_العليا: نص = سطر_وسم_تحويم_لغة(«Alias of», نص_العليا);
            ألحق(الأسطر, سطر_العليا);
        };
        دع الفرعية: متجه معرف_رمز = أنواع_فرعية_لرمز_واجهة(الواجهة, الرمز);
        دع أسماء_الفرعية: متجه نص = أسماء_رموز_تحويم_لغة(الواجهة, &الفرعية);
        لو ((الطول(أسماء_الفرعية) مثل غير_موقع) > 0) {
            دع فاصل_أسماء: نص = «, »;
            دع نص_الفرعية: نص = صل_النصوص(&أسماء_الفرعية, &فاصل_أسماء);
            دع سطر_الفرعية: نص = سطر_وسم_تحويم_لغة(«Aliased by», نص_الفرعية);
            ألحق(الأسطر, سطر_الفرعية);
        };
    }
    | _ -> { };

    دع الفاصل: نص = "\n\n";
    أرجع اختيار.بعض(صل_النصوص(&الأسطر, &الفاصل));
}

عام عرف نطاق_تحويم_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار نطاق_تغيير_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق ظهور_اسم_واجهة_عند_بايت(&الواجهة, المصدر, البايت) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الظهور) -> { أرجع نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق); };
    };
}

عام عرف نص_تحويم_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار نص {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };

        طابق رمز_واجهة_عند_بايت(&الواجهة, المصدر, البايت) مع
        | اختيار.بعض(الرمز) -> {
            طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(التصريح) -> {
                طابق نص_تحويم_رمز_لغة(&الواجهة, الرمز, &التصريح) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(النص) -> { أرجع اختيار.بعض(النص); };
            };
        }
        | اختيار.لا_شيء -> { };

        طابق نوع_واجهة_عند_بايت(&الواجهة, المصدر, البايت) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(معرف_النوع) -> {
            طابق تهجئة_نوع_واجهة(&الواجهة, معرف_النوع) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(النوع) -> {
                دع الأجزاء: متجه نص = ["```sultanc\nexpression: ", النوع, "\n```"];
                أرجع اختيار.بعض(صل_أجزاء_تحويم_لغة(&الأجزاء));
            };
        };
    };
}

عام عرف تعريف_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار موقع_دلالي_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرمز) -> {
            طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(التصريح) -> { أرجع موقع_نطاق_واجهة_لغة(&الواجهة, التصريح.نطاق_الاسم); };
        };
    };
}

عام عرف ظهورات_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    يتضمن_التصريح: منطقي,
    المستند_الحالي_فقط: منطقي
): متجه موقع_دلالي_لغة {
    دع الناتج: متغير متجه موقع_دلالي_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر_الحالي: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(المعرف) -> { المصدر_الحالي := المعرف; };
        دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(المعرف) -> { الرمز := المعرف; };
        دع نطاق_الاسم_المعلن: متغير نطاق = نطاق_فارغ();
        طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(التصريح) -> { نطاق_الاسم_المعلن := التصريح.نطاق_الاسم; };
        دع الظهورات: متجه ظهور_اسم_محلول = ظهورات_رمز_واجهة(&الواجهة, الرمز);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الظهورات) مثل غير_موقع)) {
            دع مرجع_الظهور: &ظهور_اسم_محلول = &الظهورات[ف];
            دع الظهور: ظهور_اسم_محلول = *مرجع_الظهور;
            دع مقبول: متغير منطقي = صواب;
            لو (المستند_الحالي_فقط && (الظهور.النطاق.البداية.المصدر != المصدر_الحالي)) { مقبول := خطأ; };
            لو ((!يتضمن_التصريح) && نطاقان_متساويان(الظهور.النطاق, نطاق_الاسم_المعلن)) { مقبول := خطأ; };
            لو (مقبول) {
                طابق موقع_نطاق_واجهة_لغة(&الواجهة, الظهور.النطاق) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الموقع) -> { ألحق(الناتج, الموقع); };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}


عام نوع نتيجة_خطة_إعادة_تسمية_لغة =
    | جاهزة بنوع متجه موقع_دلالي_لغة
    | مرفوضة بنوع رفض_إعادة_تسمية_دلالي
;

عام عرف خطة_إعادة_تسمية_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الاسم_الجديد: &نص
): نتيجة_خطة_إعادة_تسمية_لغة {
    دع المواقع: متغير متجه موقع_دلالي_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق خطط_إعادة_تسمية_واجهة(&الواجهة, المصدر, البايت, الاسم_الجديد) مع
        | نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب) -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(السبب);
        }
        | نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(الخطة) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الخطة.النطاقات) مثل غير_موقع)) {
                طابق موقع_نطاق_واجهة_لغة(&الواجهة, الخطة.النطاقات[ف]) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الموقع) -> { ألحق(المواقع, الموقع); };
                ف := ف + 1;
            }
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.جاهزة(المواقع);
        };
    };
}

عام نوع اقتراح_إكمال_دلالي_لغة = {
    النص: نص,
    النوع: نوع_تصريح,
    التفصيل: اختيار نص
};

عام عرف اقتراحات_إكمال_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): متجه اقتراح_إكمال_دلالي_لغة {
    دع الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع الناتج; }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        دع الروابط: متجه ربط_اسم_نطاق = روابط_مرئية_واجهة_عند_بايت(&الواجهة, المصدر, البايت);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الروابط) مثل غير_موقع)) {
            دع الربط: ربط_اسم_نطاق = الروابط[ف];
            طابق اسم_مقنن_واجهة(&الواجهة, الربط.الاسم) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الاسم) -> {
                طابق تصريح_رمز_واجهة(&الواجهة, الربط.الرمز) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الرمز) -> {
                    دع النص: نص = من_بايتات(&الاسم.البايتات);
                    دع التفصيل: متغير اختيار نص = اختيار.لا_شيء();
                    طابق نوع_رمز_واجهة(&الواجهة, الربط.الرمز) مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(معرف_النوع) -> {
                        التفصيل := تهجئة_نوع_واجهة(&الواجهة, معرف_النوع);
                    };
                    دع الاقتراح: اقتراح_إكمال_دلالي_لغة = {
                        النص: النص,
                        النوع: الرمز.النوع,
                        التفصيل: التفصيل
                    };
                    ألحق(الناتج, الاقتراح);
                };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام نوع معلومات_توقيع_استدعاء_لغة = {
    التسمية: نص,
    المعاملات: متجه نص,
    المعامل_النشط: غير_موقع
};

عام عرف توقيع_استدعاء_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار معلومات_توقيع_استدعاء_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    دع مرجع_الواجهة: &اختيار نتيجة_واجهة_وحدة = &ل.الواجهة;
    دع اختيار_الواجهة: اختيار نتيجة_واجهة_وحدة = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        دع المصدر: متغير غير_موقع = 0;
        طابق معرف_مصدر_مستند_لغة(&الواجهة, المستند) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
        دع البايت: متغير غير_موقع = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق استدعاء_واجهة_عند_بايت(&الواجهة, المصدر, البايت) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاستدعاء) -> {
            دع نص_النوع: متغير نص = «»;
            طابق تهجئة_نوع_واجهة(&الواجهة, الاستدعاء.نوع_المستدعى) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(النص) -> { نص_النوع := النص; };

            دع اسم_المستدعى: متغير اختيار نص = اختيار.لا_شيء();
            طابق الاستدعاء.الرمز مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الرمز) -> {
                طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(التصريح) -> {
                    طابق اسم_مقنن_واجهة(&الواجهة, التصريح.الاسم) مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(الاسم) -> {
                        اسم_المستدعى := اختيار.بعض(من_بايتات(&الاسم.البايتات));
                    };
                };
            };

            دع التسمية: متغير نص = «»;
            طابق اسم_المستدعى مع
            | اختيار.لا_شيء -> { التسمية := نص_النوع; }
            | اختيار.بعض(الاسم) -> {
                دع الأجزاء: متجه نص = [الاسم, نص_النوع];
                دع الفاصل: نص = «: »;
                التسمية := صل_النصوص(&الأجزاء, &الفاصل);
            };

            دع المعاملات: متغير متجه نص = [];
            طابق عدد_معاملات_نوع_واجهة(&الواجهة, الاستدعاء.نوع_المستدعى) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(العدد) -> {
                دع ف: متغير غير_موقع = 0;
                بينما (ف < العدد) {
                    طابق نوع_معامل_نوع_واجهة_عند(&الواجهة, الاستدعاء.نوع_المستدعى, ف) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                    | اختيار.بعض(نوع_المعامل) -> {
                        طابق تهجئة_نوع_واجهة(&الواجهة, نوع_المعامل) مع
                        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                        | اختيار.بعض(النص) -> { ألحق(المعاملات, النص); };
                    };
                    ف := ف + 1;
                }
                دع النشط: متغير غير_موقع = الاستدعاء.الحجة_النشطة;
                لو ((العدد > 0) && (النشط >= العدد)) { النشط := العدد - 1; };
                دع الناتج: معلومات_توقيع_استدعاء_لغة = {
                    التسمية: التسمية,
                    المعاملات: المعاملات,
                    المعامل_النشط: النشط
                };
                أرجع اختيار.بعض(الناتج);
            };
        };
    };
}

