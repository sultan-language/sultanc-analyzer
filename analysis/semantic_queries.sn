        }
        أرجع الناتج;
    };
}

عام عرف رموز_واجهة_مشروع_دلالية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه رمز_معلن_لغة {
    دع الناتج: متغير متجه رمز_معلن_لغة = [];
    دع الرموز: متجه رمز_دلالي = كل_رموز_واجهة(الواجهة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
        طابق حول_رمز_واجهة_إلى_لغة(الواجهة, &الرموز[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الرمز) -> { ألحق(الناتج, الرمز); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Hierarchy adapters remain protocol-neutral: compiler SymbolIDs and call edges
// decide semantic identity; this layer only converts canonical source facts to
// URI/UTF-16 locations.
عام نوع مجموعة_استدعاء_هرمي_لغة = {
    الرمز: معرف_رمز,
    العنصر: رمز_معلن_لغة,
    النطاقات: متجه نطاق_تغيير_لغة
};

عرف هل_رمز_دالة_لغة(النوع: نوع_تصريح): منطقي {
    أرجع النوع == نوع_تصريح.دالة() || النوع == نوع_تصريح.دالة_خارجية();
}

عرف هل_رمز_نوع_لغة(النوع: نوع_تصريح): منطقي {
    أرجع النوع == نوع_تصريح.مرادف_نوع()
        || النوع == نوع_تصريح.سجل()
        || النوع == نوع_تصريح.تعداد();
}

عرف رمز_واجهة_عند_موقع_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): اختيار معرف_رمز {
    دع المسار: متغير نص = «»;
    طابق عنوان_ملف_إلى_مسار(العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { المسار := القيمة; };
    دع المصدر: متغير غير_موقع = 0;
    طابق معرف_مصدر_واجهة_باسم(الواجهة, &المسار) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المعرف) -> { المصدر := المعرف; };
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&القيمة.المحتوى);
        دع موضع16: موضع_نصي_يوتيف16 = { السطر: الموضع.السطر, العمود: الموضع.المحرف };
        طابق موضع_نصي_يوتيف16_إلى_إزاحة_بايت(&القيمة.المحتوى, &الفهرس, &موضع16) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(البايت) -> { أرجع رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت); };
    };
}

عرف عنصر_رمز_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختيار رمز_معلن_لغة {
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التصريح) -> { أرجع حول_رمز_واجهة_إلى_لغة(الواجهة, &التصريح); };
}

عام عرف حضر_هرم_استدعاء_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار رمز_معلن_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرمز) -> {
            طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(التصريح) -> {
                لو (!هل_رمز_دالة_لغة(التصريح.النوع)) { أرجع اختيار.لا_شيء(); };
                أرجع حول_رمز_واجهة_إلى_لغة(&الواجهة, &التصريح);
            };
        };
    };
}

عام عرف حضر_هرم_نوع_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختيار رمز_معلن_لغة {
    دع ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الواجهة) -> {
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرمز) -> {
            طابق تصريح_رمز_واجهة(&الواجهة, الرمز) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(التصريح) -> {
                لو (!هل_رمز_نوع_لغة(التصريح.النوع)) { أرجع اختيار.لا_شيء(); };
                أرجع حول_رمز_واجهة_إلى_لغة(&الواجهة, &التصريح);
            };
        };
    };
}

عرف حول_رموز_هرم_نوع_إلى_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرموز: &متجه معرف_رمز
): متجه رمز_معلن_لغة {
    دع المدخل: متجه معرف_رمز = *الرموز;
    دع الناتج: متغير متجه رمز_معلن_لغة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المدخل) مثل غير_موقع)) {
        طابق عنصر_رمز_واجهة_لغة(الواجهة, المدخل[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(العنصر) -> { ألحق(الناتج, العنصر); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنواع_عليا_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه رمز_معلن_لغة {
    دع الفارغ: متجه رمز_معلن_لغة = [];
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختيار.لا_شيء -> { أرجع الفارغ; }
    | اختيار.بعض(الرمز) -> {
        دع الرموز: متجه معرف_رمز = أنواع_عليا_لرمز_واجهة(الواجهة, الرمز);
        أرجع حول_رموز_هرم_نوع_إلى_لغة(الواجهة, &الرموز);
    };
}

عام عرف أنواع_فرعية_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه رمز_معلن_لغة {
    دع الفارغ: متجه رمز_معلن_لغة = [];
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختيار.لا_شيء -> { أرجع الفارغ; }
    | اختيار.بعض(الرمز) -> {
        دع الرموز: متجه معرف_رمز = أنواع_فرعية_لرمز_واجهة(الواجهة, الرمز);
        أرجع حول_رموز_هرم_نوع_إلى_لغة(الواجهة, &الرموز);
    };
}

عرف أضف_حافة_إلى_مجموعات_هرمية(
    الواجهة: &نتيجة_واجهة_وحدة,
    المجموعات: &متغير متجه مجموعة_استدعاء_هرمي_لغة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): فراغ {
    دع الحالة: متغير متجه مجموعة_استدعاء_هرمي_لغة = *المجموعات;
    دع موضع_فارغ_بداية: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_فارغ_نهاية: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع نطاق_لغة: متغير نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_بداية,
        النهاية: موضع_فارغ_نهاية
    };
    طابق موقع_نطاق_واجهة_لغة(الواجهة, النطاق) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(الموقع) -> { نطاق_لغة := الموقع.النطاق; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_رمز_متساويان(الحالة[ف].الرمز, الرمز)) {
            ألحق(الحالة[ف].النطاقات, نطاق_لغة);
            *المجموعات := الحالة;
            أرجع;
        };
        ف := ف + 1;
    }
    طابق عنصر_رمز_واجهة_لغة(الواجهة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(العنصر) -> {
        دع النطاقات: متجه نطاق_تغيير_لغة = [نطاق_لغة];
        دع المجموعة: مجموعة_استدعاء_هرمي_لغة = {
            الرمز: الرمز,
            العنصر: العنصر,
            النطاقات: النطاقات
        };
        ألحق(الحالة, المجموعة);
        *المجموعات := الحالة;
    };
}

عام عرف استدعاءات_واردة_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه مجموعة_استدعاء_هرمي_لغة {
    دع الناتج: متغير متجه مجموعة_استدعاء_هرمي_لغة = [];
    دع الهدف: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الرمز) -> { الهدف := الرمز; };
    دع الحواف: متجه حافة_استدعاء_دلالية = استدعاءات_واردة_رمز_واجهة(الواجهة, الهدف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحواف) مثل غير_موقع)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        أضف_حافة_إلى_مجموعات_هرمية(الواجهة, &متغير الناتج, الحافة.المستدعي, الحافة.النطاق);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف استدعاءات_صادرة_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه مجموعة_استدعاء_هرمي_لغة {
    دع الناتج: متغير متجه مجموعة_استدعاء_هرمي_لغة = [];
    دع الهدف: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الرمز) -> { الهدف := الرمز; };
    دع الحواف: متجه حافة_استدعاء_دلالية = استدعاءات_صادرة_رمز_واجهة(الواجهة, الهدف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحواف) مثل غير_موقع)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        أضف_حافة_إلى_مجموعات_هرمية(الواجهة, &متغير الناتج, الحافة.المستدعى, الحافة.النطاق);
        ف := ف + 1;
    }
    أرجع الناتج;
}
