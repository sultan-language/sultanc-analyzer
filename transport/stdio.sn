استورد std.io.read_line;
استورد std.io.print;
استورد std.text.search;
استورد std.text.transform;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.from_bytes;

عام نوع نتيجة_قراءة_إطار_لغة =
    | نهاية
    | إطار بنوع نص
    | خطأ_دخل بنوع عدد
    | رأس_غير_صالح
    | طول_غير_صالح
    | جسم_مبتور
;

عام عرف اقرأ_إطار_لغة(): نتيجة_قراءة_إطار_لغة {
    دع طول_الجسم: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع قرأ_رأسا: متغير منطقي = خطأ;
    دع مستمر: متغير منطقي = صواب;
    دع بادئة_الطول: نص = «Content-Length:»;

    بينما (مستمر) {
        دع السطر: متغير نص = «»;
        طابق اقرأ_السطر() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_إطار_لغة.خطأ_دخل(الخطأ); }
        | نتيجة.نجح(القيمة) -> { السطر := القيمة; };

        // read_line يعيد نصا فارغا عند EOF قبل أي بايت.
        لو ((الطول(السطر) == 0) && !قرأ_رأسا) {
            أرجع نتيجة_قراءة_إطار_لغة.نهاية();
        };

        دع المنقح: نص = قص_النص(&السطر);
        لو (الطول(المنقح) == 0) {
            مستمر := خطأ;
        } وإلا {
            قرأ_رأسا := صواب;
            لو (يبدأ_بـ(&المنقح, &بادئة_الطول)) {
                دع بداية: غير_موقع = الطول(بادئة_الطول) مثل غير_موقع;
                طابق مقطع_نص(
                    &المنقح,
                    بداية,
                    (الطول(المنقح) مثل غير_موقع) - بداية
                ) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_إطار_لغة.طول_غير_صالح(); }
                | اختيار.بعض(جزء_الطول) -> {
                    دع نص_الطول: نص = قص_النص(&جزء_الطول);
                    طابق حلل_غير_موقع(&نص_الطول) مع
                    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_إطار_لغة.طول_غير_صالح(); }
                    | نتيجة.نجح(القيمة) -> { طول_الجسم := اختيار.بعض(القيمة); };
                };
            };
        };
    }

    دع العدد: متغير غير_موقع = 0;
    طابق طول_الجسم مع
    | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_إطار_لغة.رأس_غير_صالح(); }
    | اختيار.بعض(القيمة) -> { العدد := القيمة; };

    طابق اقرأ_بالضبط(العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_إطار_لغة.خطأ_دخل(الخطأ); }
    | نتيجة.نجح(القراءة) -> {
        لو ((الطول(القراءة.البايتات) مثل غير_موقع) != العدد) {
            أرجع نتيجة_قراءة_إطار_لغة.جسم_مبتور();
        };
        أرجع نتيجة_قراءة_إطار_لغة.إطار(من_بايتات(&القراءة.البايتات));
    };
}

عام عرف اكتب_إطار_لغة(الجسم: &نص): نتيجة عدد, عدد {
    دع النص: نص = *الجسم;
    دع طول_النص: نص = غير_موقع_إلى_نص(الطول(النص) مثل غير_موقع);
    دع البايتات: متغير متجه غ8 = [];
    دع البادئة: نص = «Content-Length: »;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(البادئة) مثل غير_موقع)) { ألحق(البايتات, البادئة[ف]); ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول(طول_النص) مثل غير_موقع)) { ألحق(البايتات, طول_النص[ف]); ف := ف + 1; }
    ألحق(البايتات, 13);
    ألحق(البايتات, 10);
    ألحق(البايتات, 13);
    ألحق(البايتات, 10);
    ف := 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }

    // std owns stdout byte-write semantics; LSP only composes one protocol frame.
    أرجع اكتب_بايتات_خرج(&البايتات);
}
