استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.env.environment;
استورد std.text.search;
استورد std.text.compare;
استورد std.text.substring;
استورد std.text.transform;
استورد std.text.from_bytes;

// Public std declarations for auto-import completion: `عام عرف`, `عام نوع` and
// their `عام مرادف` spellings (the English names), with the module path that
// imports them (std.io.println). Built once from library/std under the working
// directory (the SultanC checkout). Platform back-ends are internal.

عام نوع مدخل_فهرس_مكتبة_لغة = {
    الاسم: نص,
    الوحدة: نص,
    هو_دالة: منطقي
};

عرف اسم_بعد_بادئة_لغة(السطر: &نص, البادئة: &نص): اختياري نص {
    إذا (!يبدأ_بـ(السطر, البادئة)) { أرجع اختياري.لا_شيء(); };
    ليكن البداية: طبيعي = الطول(*البادئة) مثل طبيعي;
    ليكن الحد: طبيعي = الطول(*السطر) مثل طبيعي;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*السطر)[ف];
        إذا ((ب == 0x28) || (ب == 0x20) || (ب == 0x3C) || (ب == 0x3D) || (ب == 0x3B) || (ب == 0x2E)) {
            اخرج_من_حلقة;
        };
        ف := ف + 1;
    }
    إذا (ف == البداية) { أرجع اختياري.لا_شيء(); };
    // Dotted aliases (enum.variant spellings) are not importable names.
    إذا ((ف < الحد) && ((*السطر)[ف] == 0x2E)) { أرجع اختياري.لا_شيء(); };
    أرجع مقطع_نص(السطر, البداية, ف - البداية);
}

عام عرف فهرس_ملف_مكتبة_لغة(
    المسار: &نص,
    الوحدة: &نص,
    الناتج: &متغير متجه مدخل_فهرس_مكتبة_لغة
): فراغ {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المحتوى) -> {
        ليكن بادئة_دالة: نص = «عام عرف »;
        ليكن نوع_عام: نص = «عام نوع »;
        ليكن بادئة_مرادف: نص = «عام مرادف »;
        ليكن الحد: طبيعي = الطول(المحتوى) مثل طبيعي;
        ليكن البداية: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف <= الحد) {
            إذا ((ف == الحد) || (المحتوى[ف] == 0x0A)) {
                طابق مقطع_نص(&المحتوى, البداية, ف - البداية) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الخام) -> {
                    ليكن السطر: نص = قص_النص(&الخام);
                    طابق اسم_بعد_بادئة_لغة(&السطر, &بادئة_دالة) مع
                    | اختياري.موجود(الاسم) -> {
                        ليكن م: مدخل_فهرس_مكتبة_لغة = { الاسم: الاسم, الوحدة: استنسخ(الوحدة), هو_دالة: صواب };
                        ألحق(*الناتج, م);
                    }
                    | اختياري.لا_شيء -> {
                        طابق اسم_بعد_بادئة_لغة(&السطر, &نوع_عام) مع
                        | اختياري.موجود(الاسم) -> {
                            ليكن م: مدخل_فهرس_مكتبة_لغة = { الاسم: الاسم, الوحدة: استنسخ(الوحدة), هو_دالة: خطأ };
                            ألحق(*الناتج, م);
                        }
                        | اختياري.لا_شيء -> {
                            طابق اسم_بعد_بادئة_لغة(&السطر, &بادئة_مرادف) مع
                            | اختياري.موجود(الاسم) -> {
                                ليكن م: مدخل_فهرس_مكتبة_لغة = { الاسم: الاسم, الوحدة: استنسخ(الوحدة), هو_دالة: صواب };
                                ألحق(*الناتج, م);
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    };
                };
                البداية := ف + 1;
            };
            ف := ف + 1;
        }
    };
}

عرف فهرس_دليل_مكتبة_لغة(
    الدليل: &نص,
    الوحدة: &نص,
    الناتج: &متغير متجه مدخل_فهرس_مكتبة_لغة
): فراغ {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المدخلات) -> {
        ليكن لاحقة: نص = «.sn»;
        ليكن منصة: نص = «platform»;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
            ليكن الاسم: نص = استنسخ(&المدخلات[ف].الاسم);
            ليكن المسار: نص = صل_المسار(الدليل, &الاسم);
            طابق المدخلات[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                إذا (!نصان_متساويان(&الاسم, &منصة)) {
                    ليكن أجزاء: متجه نص = [استنسخ(الوحدة), «.», استنسخ(&الاسم)];
                    ليكن فارغ: نص = «»;
                    ليكن الفرعية: نص = صل_النصوص(&أجزاء, &فارغ);
                    فهرس_دليل_مكتبة_لغة(&المسار, &الفرعية, الناتج);
                };
            }
            | نوع_مدخل_دليل.ملف -> {
                إذا (ينتهي_بـ(&الاسم, &لاحقة)) {
                    طابق مقطع_نص(&الاسم, 0, (الطول(الاسم) مثل طبيعي) - 3) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(القيمة) -> {
                        ليكن أجزاء: متجه نص = [استنسخ(الوحدة), «.», القيمة];
                        ليكن فارغ: نص = «»;
                        ليكن الوحدة_الكاملة: نص = صل_النصوص(&أجزاء, &فارغ);
                        فهرس_ملف_مكتبة_لغة(&المسار, &الوحدة_الكاملة, الناتج);
                    };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
    };
}

عام عرف ابن_فهرس_مكتبة_لغة(): متجه مدخل_فهرس_مكتبة_لغة {
    ليكن الناتج: متغير متجه مدخل_فهرس_مكتبة_لغة = [];
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(الجذر) -> {
        // std is layered (library/core, library/alloc, library/std); every
        // layer's modules are imported as `std.…` (std.text.number lives in
        // library/alloc/text/number.sn). A checkout without layers has only
        // library/std.
        ليكن الطبقات: متجه نص = [«library/core», «library/alloc», «library/std»];
        ليكن الوحدة: نص = «std»;
        ليكن ط: متغير طبيعي = 0;
        طالما (ط < (الطول(الطبقات) مثل طبيعي)) {
            ليكن الدليل: نص = صل_المسار(&الجذر, &الطبقات[ط]);
            فهرس_دليل_مكتبة_لغة(&الدليل, &الوحدة, &متغير الناتج);
            ط := ط + 1;
        }
    };
    أرجع الناتج;
}
