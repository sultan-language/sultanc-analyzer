// Editor refactorings built on the compiler's own analysis. Every edit that
// can change meaning (removing an import, extracting or inlining a variable)
// is applied to a copy of the workspace and re-checked by the compiler; it is
// offered only when it introduces no new error.

عام نوع تعديل_نصي_لغة = {
    النطاق: نطاق_تغيير_لغة,
    النص: نص
};

عام نوع إجراء_بسيط_لغة = {
    العنوان: نص,
    النوع: نص,
    مفضل: منطقي,
    التعديلات: متجه تعديل_نصي_لغة
};

نوع تعديل_بايتات_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي,
    النص: نص
};

عرف جزء_لغة(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    إذا (النهاية <= البداية) { أرجع «»; };
    طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
    | اختياري.لا_شيء -> { أرجع «»; }
    | اختياري.موجود(القيمة) -> { أرجع القيمة; };
}

عرف صل_لغة(الأجزاء: &متجه نص): نص {
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(الأجزاء, &الفاصل);
}

عرف بايت_معرف_لغة(ب: ط8): منطقي {
    أرجع (ب >= 0x80) || (ب == 0x5F) || ((ب >= 0x30) && (ب <= 0x39))
        || ((ب >= 0x41) && (ب <= 0x5A)) || ((ب >= 0x61) && (ب <= 0x7A));
}

عرف بايت_فراغ_لغة(ب: ط8): منطقي {
    أرجع (ب == 0x20) || (ب == 0x09) || (ب == 0x0D);
}

// Applies non-overlapping byte edits (any order) to a text.
عرف طبق_تعديلات_بايتات_لغة(النص: &نص, التعديلات: &متجه تعديل_بايتات_لغة): نص {
    ليكن المرتبة: متغير متجه تعديل_بايتات_لغة = استنسخ(التعديلات);
    رتب_بالمقارنة(&متغير المرتبة, قارن_تعديلين_لغة);
    ليكن الأجزاء: متغير متجه نص = [];
    ليكن الموضع: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرتبة) مثل طبيعي)) {
        ألحق(الأجزاء, جزء_لغة(النص, الموضع, المرتبة[ف].البداية));
        ألحق(الأجزاء, استنسخ(&المرتبة[ف].النص));
        الموضع := المرتبة[ف].النهاية;
        ف := ف + 1;
    }
    ألحق(الأجزاء, جزء_لغة(النص, الموضع, الطول(*النص) مثل طبيعي));
    أرجع صل_لغة(&الأجزاء);
}

عرف قارن_تعديلين_لغة(الأول: &تعديل_بايتات_لغة, الثاني: &تعديل_بايتات_لغة): عدد {
    إذا ((*الأول).البداية < (*الثاني).البداية) { أرجع -1; };
    إذا ((*الأول).البداية > (*الثاني).البداية) { أرجع 1; };
    أرجع 0;
}

عرف تعديلات_نصية_لغة(
    المستند: &مستند_لغة_مفتوح,
    التعديلات: &متجه تعديل_بايتات_لغة
): اختياري متجه تعديل_نصي_لغة {
    ليكن الناتج: متغير متجه تعديل_نصي_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعديلات) مثل طبيعي)) {
        ليكن البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
        ليكن النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
        طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (*التعديلات)[ف].البداية) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(الموضع) -> { البداية := الموضع; };
        طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (*التعديلات)[ف].النهاية) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(الموضع) -> { النهاية := الموضع; };
        ليكن النطاق: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
        ليكن التعديل: تعديل_نصي_لغة = { النطاق: النطاق, النص: استنسخ(&(*التعديلات)[ف].النص) };
        ألحق(الناتج, التعديل);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// Compiler error count of the document with `النص` as its content, analysed
// exactly as the open document is (same identity, same overlays).
عام عرف عدد_أخطاء_نص_بديل_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    النص: نص
): اختياري طبيعي {
    ليكن النسخة: متغير مساحة_عمل_لغة = استنسخ(المساحة);
    ليكن التغييرات: متجه تغيير_محتوى_لغة = [تغيير_محتوى_لغة.كامل(النص)];
    ليكن التغيير: تغيير_مستند_لغة = {
        العنوان: استنسخ(&(*المستند).العنوان),
        الإصدار: (*المستند).الإصدار + 1,
        التغييرات: التغييرات
    };
    إذا (!طبق_تغييرات_مستند_لغة(&متغير النسخة, &التغيير)) { أرجع اختياري.لا_شيء(); };
    طابق مستند_لغة_عند(&النسخة, &(*المستند).العنوان) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجديد) -> {
        طابق حلل_واجهة_مستند_لغة(&النسخة, &الجديد) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            أرجع اختياري.موجود(اللقطة.التشخيصات.عدد_الأخطاء);
        };
    };
}

عرف تعديل_سليم_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    التعديلات: &متجه تعديل_بايتات_لغة,
    الأخطاء_الحالية: طبيعي
): منطقي {
    ليكن الجديد: نص = طبق_تعديلات_بايتات_لغة(&(*المستند).النص, التعديلات);
    طابق عدد_أخطاء_نص_بديل_لغة(المساحة, المستند, الجديد) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(العدد) -> { أرجع العدد <= الأخطاء_الحالية; };
}

عرف إجراء_لغة(
    المستند: &مستند_لغة_مفتوح,
    العنوان: نص,
    النوع: نص,
    مفضل: منطقي,
    التعديلات: &متجه تعديل_بايتات_لغة
): اختياري إجراء_بسيط_لغة {
    طابق تعديلات_نصية_لغة(المستند, التعديلات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النصية) -> {
        ليكن الإجراء: إجراء_بسيط_لغة = {
            العنوان: العنوان,
            النوع: النوع,
            مفضل: مفضل,
            التعديلات: النصية
        };
        أرجع اختياري.موجود(الإجراء);
    };
}

// Byte offset where the line holding `البايت` starts.
عرف بداية_السطر_لغة(النص: &نص, البايت: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = البايت;
    طالما ((ف > 0) && ((*النص)[ف - 1] != 0x0A)) { ف := ف - 1; }
    أرجع ف;
}

عرف نهاية_السطر_لغة(النص: &نص, البايت: طبيعي): طبيعي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = البايت;
    طالما ((ف < الحد) && ((*النص)[ف] != 0x0A)) { ف := ف + 1; }
    أرجع ف;
}

عرف يحتوي_معرفا_لغة(النص: &نص, الاسم: &نص): منطقي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن الطول_الاسم: طبيعي = الطول(*الاسم) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + الطول_الاسم <= الحد) {
        إذا ((ف == 0) || !بايت_معرف_لغة((*النص)[ف - 1])) {
            ليكن النهاية: طبيعي = ف + الطول_الاسم;
            إذا ((النهاية == الحد) || !بايت_معرف_لغة((*النص)[النهاية])) {
                ليكن المقطع: نص = جزء_لغة(النص, ف, النهاية);
                إذا (نصان_متساويان(&المقطع, الاسم)) { أرجع صواب; };
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// ---- Quick fix: add the missing import ----------------------------------------
// An unknown name that a std module exports publicly: offer `import that.module;`.
// The compiler suggests the import itself (`import-module`) when a module the
// compilation loaded declares the name; this covers the std modules it did
// not load, and is not offered where the compiler's suggestion is.

عرف فيه_إصلاح_استيراد_لغة(التشخيص: &تشخيص): منطقي {
    ليكن المطلوب: نص = «import-module»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التشخيص).الإصلاحات) مثل طبيعي)) {
        طابق نوع_اقتراح_آلي((*التشخيص).الإصلاحات[ف].المفتاح) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النوع) -> { إذا (نصان_متساويان(&النوع, &المطلوب)) { أرجع صواب; }; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف إجراءات_استيراد_مفقود_لغة(
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات,
    المطلوب: نطاق_تغيير_لغة,
    الفهرس: &متجه مدخل_فهرس_مكتبة_لغة
): متجه إجراء_بسيط_لغة {
    ليكن الناتج: متغير متجه إجراء_بسيط_لغة = [];
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن الكود_المطلوب: نص = «SULTANC-NAME-UNKNOWN»;
    ليكن المسار_الحالي: متغير نص = «»;
    طابق استنسخ(&(*المستند).مسار_الملف) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { المسار_الحالي := القيمة; };
    ليكن الأسماء_المعروضة: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعة).التشخيصات) مثل طبيعي)) {
        ليكن التعريف: تعريف_تشخيص = تعريف_التشخيص((*المجموعة).التشخيصات[ف].المعرف);
        إذا (نصان_متساويان(&التعريف.الكود, &الكود_المطلوب) && !فيه_إصلاح_استيراد_لغة(&(*المجموعة).التشخيصات[ف])) {
            طابق استنسخ(&(*المجموعة).التشخيصات[ف].المصدر_الرئيسي) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المصدر) -> {
                ليكن للمستند: متغير منطقي = صواب;
                طابق استنسخ(&المصدر.اسم_المصدر) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الاسم) -> { للمستند := مساران_لنفس_الملف_لغة(&الاسم, &المسار_الحالي); };
                ليكن البداية: طبيعي = (المصدر.النطاق.البداية.البايت مثل طبيعي);
                ليكن النهاية: طبيعي = (المصدر.النطاق.النهاية.البايت مثل طبيعي);
                ليكن في_المدى: متغير منطقي = خطأ;
                طابق إزاحة_بايت_إلى_موضع_لغة(المستند, البداية) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(الموضع) -> {
                    في_المدى := (الموضع.السطر >= المطلوب.البداية.السطر) && (الموضع.السطر <= المطلوب.النهاية.السطر);
                };
                ليكن الاسم: نص = جزء_لغة(&(*المستند).النص, البداية, النهاية);
                ليكن معروض: متغير منطقي = خطأ;
                ليكن م: متغير طبيعي = 0;
                طالما (م < (الطول(الأسماء_المعروضة) مثل طبيعي)) {
                    إذا (نصان_متساويان(&الأسماء_المعروضة[م], &الاسم)) { معروض := صواب; };
                    م := م + 1;
                }
                إذا (للمستند && في_المدى && !معروض && ((الطول(الاسم) مثل طبيعي) > 0)) {
                    ألحق(الأسماء_المعروضة, استنسخ(&الاسم));
                    ليكن الوحدات: متغير متجه نص = [];
                    ليكن ك: متغير طبيعي = 0;
                    طالما (ك < (الطول(*الفهرس) مثل طبيعي)) {
                        إذا (نصان_متساويان(&(*الفهرس)[ك].الاسم, &الاسم)) {
                            ألحق(الوحدات, استنسخ(&(*الفهرس)[ك].الوحدة));
                        };
                        ك := ك + 1;
                    }
                    ليكن سطر_الإدراج: طبيعي = سطر_إدراج_استيراد_لغة(المستند);
                    ليكن كلمة: متغير نص = «import »;
                    إذا (عربي) { كلمة := «استورد »; };
                    ليكن و: متغير طبيعي = 0;
                    طالما (و < (الطول(الوحدات) مثل طبيعي)) {
                        ليكن أجزاء_السطر: متجه نص = [استنسخ(&كلمة), استنسخ(&الوحدات[و]), «;»];
                        ليكن السطر: نص = صل_لغة(&أجزاء_السطر);
                        ليكن موجود_مسبقا: منطقي = يحتوي_نصا(&(*المستند).النص, &السطر);
                        إذا (!موجود_مسبقا) {
                            ليكن أجزاء_الإدراج: متجه نص = [استنسخ(&السطر), «
»];
                            ليكن موضع_الإدراج: موضع_تغيير_لغة = { السطر: سطر_الإدراج, المحرف: 0 };
                            ليكن نطاق_الإدراج: نطاق_تغيير_لغة = { البداية: موضع_الإدراج, النهاية: موضع_الإدراج };
                            ليكن التعديل: تعديل_نصي_لغة = { النطاق: نطاق_الإدراج, النص: صل_لغة(&أجزاء_الإدراج) };
                            ليكن التعديلات: متجه تعديل_نصي_لغة = [التعديل];
                            ليكن البادئة: متغير نص = «Import `»;
                            ليكن الوسط: متغير نص = «` from »;
                            إذا (عربي) {
                                البادئة := «استيراد `»;
                                الوسط := «` من »;
                            };
                            ليكن أجزاء_العنوان: متجه نص = [البادئة, استنسخ(&الاسم), الوسط, استنسخ(&الوحدات[و])];
                            ليكن الإجراء: إجراء_بسيط_لغة = {
                                العنوان: صل_لغة(&أجزاء_العنوان),
                                النوع: «quickfix»,
                                مفضل: (الطول(الوحدات) مثل طبيعي) == 1,
                                التعديلات: التعديلات
                            };
                            ألحق(الناتج, الإجراء);
                        };
                        و := و + 1;
                    }
                };
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// ---- Organize imports ---------------------------------------------------------
// The leading import block, sorted and without duplicates; an import none of
// whose public names appear in the file is removed when the compiler confirms
// the file has no new error without it.

نوع سطر_مصدر_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي,
    النص: نص
};

عرف أسطر_المصدر_لغة(النص: &نص): متجه سطر_مصدر_لغة {
    ليكن الناتج: متغير متجه سطر_مصدر_لغة = [];
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن البداية: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= الحد) {
        إذا ((ف == الحد) || ((*النص)[ف] == 0x0A)) {
            ليكن السطر: سطر_مصدر_لغة = { البداية: البداية, النهاية: ف, النص: جزء_لغة(النص, البداية, ف) };
            ألحق(الناتج, السطر);
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سطر_استيراد_مرتب_لغة(السطر: &نص): منطقي {
    ليكن المقصوص: نص = قص_النص(السطر);
    ليكن البدايات: متجه نص = [«import », «استورد », «from », «من »];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        إذا (يبدأ_بـ(&المقصوص, &البدايات[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف قارن_نصين_لغة(الأول: &نص, الثاني: &نص): عدد {
    أرجع قارن_نصين_معجميا(الأول, الثاني);
}

// All identifier tokens of `النص`, without duplicates.
// Module path of a simple `import a.b.c;` line, else none.
عرف كتلة_استيرادات_لغة(الأسطر: &متجه نص): نص {
    ليكن الفاصل: نص = «
»;
    أرجع صل_النصوص(الأسطر, &الفاصل);
}

عام عرف إجراء_تنظيم_الاستيرادات_لغة(
    المساحة: &مساحة_عمل_لغة,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الأخطاء_الحالية: طبيعي
): اختياري إجراء_بسيط_لغة {
    ليكن النص: &نص = &(*المستند).النص;
    ليكن الأسطر: متجه سطر_مصدر_لغة = أسطر_المصدر_لغة(النص);
    ليكن الأول: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن الأخير: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        إذا (سطر_استيراد_مرتب_لغة(&الأسطر[ف].النص)) {
            طابق الأول مع
            | اختياري.لا_شيء -> { الأول := اختياري.موجود(ف); }
            | اختياري.موجود(_) -> { };
            الأخير := ف;
        };
        ف := ف + 1;
    }
    ليكن البداية_سطر: متغير طبيعي = 0;
    طابق الأول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { البداية_سطر := القيمة; };

    // Only a block made of import lines (blank lines allowed) is reordered.
    ليكن الحالية: متغير متجه نص = [];
    ليكن الأصلية: متغير متجه نص = [];
    ف := البداية_سطر;
    طالما (ف <= الأخير) {
        ليكن المقصوص: نص = قص_النص(&الأسطر[ف].النص);
        إذا ((الطول(المقصوص) مثل طبيعي) > 0) {
            إذا (!سطر_استيراد_مرتب_لغة(&المقصوص)) { أرجع اختياري.لا_شيء(); };
            ألحق(الحالية, استنسخ(&المقصوص));
        };
        ألحق(الأصلية, استنسخ(&الأسطر[ف].النص));
        ف := ف + 1;
    }
    ليكن المرتبة: متغير متجه نص = استنسخ(&الحالية);
    رتب_بالمقارنة(&متغير المرتبة, قارن_نصين_لغة);
    ليكن الفريدة: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول(المرتبة) مثل طبيعي)) {
        ليكن جديد: متغير منطقي = صواب;
        إذا (ف > 0) { جديد := !نصان_متساويان(&المرتبة[ف], &المرتبة[ف - 1]); };
        إذا (جديد) { ألحق(الفريدة, استنسخ(&المرتبة[ف])); };
        ف := ف + 1;
    }

    // Unused: the compiler's answer from real resolution
    // (استيرادات_غير_مستخدمة_واجهة): an import nothing resolves through, or
    // the selected names a used selective import does not need.
    ليكن بداية_الكتلة: طبيعي = الأسطر[البداية_سطر].البداية;
    ليكن نهاية_الكتلة: طبيعي = الأسطر[الأخير].النهاية;
    ليكن غير_المستعملة: متغير متجه نص = [];
    ليكن أسماء_زائدة: متغير متجه نص = [];
    ليكن أسطر_الأسماء: متغير متجه نص = [];
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المصدر) -> {
            ليكن الزائدة: متجه استيراد_غير_مستخدم = استيرادات_غير_مستخدمة_واجهة(الواجهة, المصدر);
            ليكن ز: متغير طبيعي = 0;
            طالما (ز < (الطول(الزائدة) مثل طبيعي)) {
                طابق الزائدة[ز].نطاق_العبارة مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(العبارة) -> {
                    ليكن الخام: نص = جزء_لغة(النص, العبارة.البداية.البايت مثل طبيعي, العبارة.النهاية.البايت مثل طبيعي);
                    ليكن العبارة_نص: نص = قص_النص(&الخام);
                    // A duplicate is dropped by deduplication; only a statement
                    // nothing uses is removed.
                    إذا (!الزائدة[ز].مكرر && عبارة_كلها_غير_مستخدمة_لغة(&الزائدة, ز)) { ألحق(غير_المستعملة, استنسخ(&العبارة_نص)); };
                    ليكن ن: متغير طبيعي = 0;
                    طالما (ن < (الطول(الزائدة[ز].الأسماء_غير_المستخدمة) مثل طبيعي)) {
                        ليكن م: نطاق = الزائدة[ز].الأسماء_غير_المستخدمة[ن];
                        ألحق(أسطر_الأسماء, استنسخ(&العبارة_نص));
                        ألحق(أسماء_زائدة, جزء_لغة(النص, م.البداية.البايت مثل طبيعي, م.النهاية.البايت مثل طبيعي));
                        ن := ن + 1;
                    }
                };
                ز := ز + 1;
            }
        };
    };
    ليكن المستعملة: متغير متجه نص = [];
    ليكن حذف_شيء: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول(الفريدة) مثل طبيعي)) {
        إذا (في_قائمة_لغة(&غير_المستعملة, &الفريدة[ف])) {
            حذف_شيء := صواب;
        } وإلا {
            ليكن السطر: نص = أزل_أسماء_انتقائية_لغة(&الفريدة[ف], &أسطر_الأسماء, &أسماء_زائدة);
            إذا (!نصان_متساويان(&السطر, &الفريدة[ف])) { حذف_شيء := صواب; };
            ألحق(المستعملة, السطر);
        };
        ف := ف + 1;
    }

    ليكن الأصلي: نص = كتلة_استيرادات_لغة(&الأصلية);
    ليكن الكتلة: متغير نص = كتلة_استيرادات_لغة(&الفريدة);
    إذا (حذف_شيء) {
        ليكن المقترحة: نص = كتلة_استيرادات_لغة(&المستعملة);
        ليكن تعديل_مقترح: تعديل_بايتات_لغة = { البداية: بداية_الكتلة, النهاية: نهاية_الكتلة, النص: استنسخ(&المقترحة) };
        ليكن المقترح: متجه تعديل_بايتات_لغة = [تعديل_مقترح];
        إذا (تعديل_سليم_لغة(المساحة, المستند, &المقترح, الأخطاء_الحالية)) {
            الكتلة := المقترحة;
        };
    };
    إذا (نصان_متساويان(&الكتلة, &الأصلي)) { أرجع اختياري.لا_شيء(); };
    ليكن التعديل: تعديل_بايتات_لغة = { البداية: بداية_الكتلة, النهاية: نهاية_الكتلة, النص: الكتلة };
    ليكن التعديلات: متجه تعديل_بايتات_لغة = [التعديل];
    ليكن العنوان: متغير نص = «Organize imports»;
    إذا (مستند_لغة_بالعربية(المستند)) { العنوان := «تنظيم الاستيرادات»; };
    أرجع إجراء_لغة(المستند, العنوان, «source.organizeImports», خطأ, &التعديلات);
}

عرف في_قائمة_لغة(القائمة: &متجه نص, النص: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القائمة)[ف], النص)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// `from m import a, b, c;` without the names the compiler reports unused for
// this statement (أسطر[ف] is the statement whose name أسماء[ف] is unused).
عرف أزل_أسماء_انتقائية_لغة(السطر: &نص, الأسطر: &متجه نص, الأسماء: &متجه نص): نص {
    ليكن الزائدة: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الأسطر)[ف], السطر)) { ألحق(الزائدة, استنسخ(&(*الأسماء)[ف])); };
        ف := ف + 1;
    }
    إذا ((الطول(الزائدة) مثل طبيعي) == 0) { أرجع استنسخ(السطر); };
    ليكن الكلمات: متجه نص = [« import », « استورد »];
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < 2) {
        طابق ابحث_نصا(السطر, &الكلمات[ك]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> {
            ليكن بعد_الكلمة: طبيعي = الموضع + (الطول(الكلمات[ك]) مثل طبيعي);
            ليكن الرأس: نص = جزء_لغة(السطر, 0, بعد_الكلمة);
            ليكن الطول_الكلي: طبيعي = الطول(*السطر) مثل طبيعي;
            ليكن الذيل_الخام: نص = جزء_لغة(السطر, بعد_الكلمة, الطول_الكلي);
            ليكن فاصلة_منقوطة: نص = «;»;
            ليكن الذيل: نص = استبدل_في_النص(&الذيل_الخام, &فاصلة_منقوطة, &«»);
            ليكن فاصلة: نص = «,»;
            ليكن الأجزاء: متجه نص = قسم_النص(&الذيل, &فاصلة);
            ليكن الباقية: متغير متجه نص = [];
            ليكن ج: متغير طبيعي = 0;
            طالما (ج < (الطول(الأجزاء) مثل طبيعي)) {
                ليكن الاسم: نص = قص_النص(&الأجزاء[ج]);
                إذا ((الطول(الاسم) مثل طبيعي) > 0 && !في_قائمة_لغة(&الزائدة, &الاسم)) { ألحق(الباقية, الاسم); };
                ج := ج + 1;
            }
            إذا ((الطول(الباقية) مثل طبيعي) == 0) { أرجع استنسخ(السطر); };
            ليكن فاصل: نص = «, »;
            ليكن القائمة: نص = صل_النصوص(&الباقية, &فاصل);
            ليكن الكل: متجه نص = [الرأس, القائمة, «;»];
            أرجع صل_لغة(&الكل);
        };
        ك := ك + 1;
    }
    أرجع استنسخ(السطر);
}

// ---- Extract variable ---------------------------------------------------------
// The selected expression becomes `ليكن قيمة: T = …;` on the line before its
// statement, with T spelled by the compiler.



عرف اسم_جديد_لغة(النص: &نص, الأساس: نص): نص {
    إذا (!يحتوي_معرفا_لغة(النص, &الأساس)) { أرجع الأساس; };
    ليكن ف: متغير طبيعي = 2;
    طالما (ف < 100) {
        ليكن أجزاء: متجه نص = [استنسخ(&الأساس), طبيعي_إلى_نص(ف)];
        ليكن المرشح: نص = صل_لغة(&أجزاء);
        إذا (!يحتوي_معرفا_لغة(النص, &المرشح)) { أرجع المرشح; };
        ف := ف + 1;
    }
    أرجع الأساس;
}

عام عرف إجراء_استخراج_متغير_لغة(
    المساحة: &مساحة_عمل_لغة,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    الأخطاء_الحالية: طبيعي
): اختياري إجراء_بسيط_لغة {
    ليكن النص: &نص = &(*المستند).النص;
    ليكن أ: متغير طبيعي = 0;
    ليكن ب: متغير طبيعي = 0;
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, المطلوب.البداية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { أ := القيمة; };
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, المطلوب.النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { ب := القيمة; };
    طالما ((أ < ب) && بايت_فراغ_لغة((*النص)[أ])) { أ := أ + 1; }
    طالما ((ب > أ) && بايت_فراغ_لغة((*النص)[ب - 1])) { ب := ب - 1; }
    إذا (أ >= ب) { أرجع اختياري.لا_شيء(); };
    ليكن التعبير: نص = جزء_لغة(النص, أ, ب);

    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: طبيعي;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
        // The compiler's Type of the expression whose span is exactly the
        // selection (tooling_queries.sn نوع_تعبير_بمدى_واجهة); nothing for a
        // partial expression, so no textual check is needed.
        ليكن المرشحة: متغير متجه نص = [];
        طابق نوع_تعبير_بمدى_واجهة(الواجهة, المصدر, أ, ب) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(معرف_النوع) -> {
            طابق تهجئة_نوع_لغة(الواجهة, معرف_النوع, عربي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التهجئة) -> { ألحق(المرشحة, التهجئة); };
        };

        ليكن بداية_السطر: طبيعي = بداية_السطر_لغة(النص, أ);
        ليكن م: متغير طبيعي = بداية_السطر;
        طالما ((م < أ) && (((*النص)[م] == 0x20) || ((*النص)[م] == 0x09))) { م := م + 1; }
        ليكن المسافة: نص = جزء_لغة(النص, بداية_السطر, م);
        ليكن الاسم: متغير نص = اسم_جديد_لغة(النص, «value»);
        ليكن كلمة: متغير نص = «let »;
        إذا (عربي) {
            الاسم := اسم_جديد_لغة(النص, «قيمة»);
            كلمة := «ليكن »;
        };
        ليكن العنوان: متغير نص = «Extract into variable»;
        إذا (عربي) { العنوان := «استخراج إلى متغير»; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المرشحة) مثل طبيعي)) {
            ليكن أجزاء: متجه نص = [
                استنسخ(&المسافة), استنسخ(&كلمة), استنسخ(&الاسم), «: », استنسخ(&المرشحة[ف]),
                « = », استنسخ(&التعبير), «;
»
            ];
            ليكن الإدراج: تعديل_بايتات_لغة = { البداية: بداية_السطر, النهاية: بداية_السطر, النص: صل_لغة(&أجزاء) };
            ليكن الاستبدال: تعديل_بايتات_لغة = { البداية: أ, النهاية: ب, النص: استنسخ(&الاسم) };
            ليكن التعديلات: متجه تعديل_بايتات_لغة = [الإدراج, الاستبدال];
            إذا (تعديل_سليم_لغة(المساحة, المستند, &التعديلات, الأخطاء_الحالية)) {
                أرجع إجراء_لغة(المستند, العنوان, «refactor.extract.variable», خطأ, &التعديلات);
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// ---- Inline variable ----------------------------------------------------------
// `ليكن س: T = تعبير;` (immutable) under the cursor: every use of س becomes the
// expression and the declaration line is removed.

عرف تعبير_بسيط_لغة(النص: &نص): منطقي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    ليكن عمق: متغير طبيعي = 0;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا ((ب == 0x28) || (ب == 0x5B)) { عمق := عمق + 1; }
        وإلا إذا (((ب == 0x29) || (ب == 0x5D)) && (عمق > 0)) { عمق := عمق - 1; }
        وإلا إذا ((عمق == 0) && !(بايت_معرف_لغة(ب) || (ب == 0x2E) || (ب == 0x22) || (ب == 0x26) || (ب == 0x2A))) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف إجراء_تضمين_متغير_لغة(
    المساحة: &مساحة_عمل_لغة,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الأخطاء_الحالية: طبيعي
): اختياري إجراء_بسيط_لغة {
    ليكن النص: &نص = &(*المستند).النص;
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن الرمز: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الرمز := القيمة; };
        // The compiler's facts: the `let` statement, its initializer, and
        // whether anything writes the local (معلومات_تضمين_محلي_واجهة).
        ليكن المعلومات: معلومات_تضمين_محلي;
        طابق معلومات_تضمين_محلي_واجهة(الواجهة, الرمز) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { المعلومات := القيمة; };
        إذا (المعلومات.قابل_للتغيير || المعلومات.عدد_الكتابات > 0) { أرجع اختياري.لا_شيء(); };
        ليكن التهيئة: نطاق;
        طابق المعلومات.نطاق_التهيئة مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { التهيئة := القيمة; };
        ليكن التعبير: نص = جزء_لغة(النص, التهيئة.البداية.البايت مثل طبيعي, التهيئة.النهاية.البايت مثل طبيعي);
        ليكن البديل: متغير نص = استنسخ(&التعبير);
        إذا (!تعبير_بسيط_لغة(&التعبير)) {
            ليكن أجزاء: متجه نص = [«(», استنسخ(&التعبير), «)»];
            البديل := صل_لغة(&أجزاء);
        };
        // Remove the statement; when it is alone on its line, the whole line.
        ليكن بداية_الحذف: متغير طبيعي = المعلومات.نطاق_التصريح.البداية.البايت مثل طبيعي;
        ليكن نهاية_الحذف: متغير طبيعي = المعلومات.نطاق_التصريح.النهاية.البايت مثل طبيعي;
        ليكن بداية_السطر: طبيعي = بداية_السطر_لغة(النص, بداية_الحذف);
        ليكن نهاية_السطر: طبيعي = نهاية_السطر_لغة(النص, بداية_الحذف);
        ليكن قبل: نص = جزء_لغة(النص, بداية_السطر, بداية_الحذف);
        ليكن بعد: نص = جزء_لغة(النص, نهاية_الحذف, نهاية_السطر);
        ليكن قبل_مقصوص: نص = قص_النص(&قبل);
        ليكن بعد_مقصوص: نص = قص_النص(&بعد);
        إذا ((الطول(قبل_مقصوص) مثل طبيعي) == 0 && (الطول(بعد_مقصوص) مثل طبيعي) == 0) {
            بداية_الحذف := بداية_السطر;
            نهاية_الحذف := نهاية_السطر;
            إذا (نهاية_الحذف < (الطول(*النص) مثل طبيعي)) { نهاية_الحذف := نهاية_الحذف + 1; };
        };
        ليكن الحذف: تعديل_بايتات_لغة = { البداية: بداية_الحذف, النهاية: نهاية_الحذف, النص: «» };
        ليكن التعديلات: متغير متجه تعديل_بايتات_لغة = [الحذف];
        ليكن المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, الرمز);
        ليكن الاستعمالات: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المراجع) مثل طبيعي)) {
            إذا (المراجع[ف].الدور != دور_مرجع.تصريح()) {
                ليكن الاستبدال: تعديل_بايتات_لغة = {
                    البداية: المراجع[ف].النطاق.البداية.البايت مثل طبيعي,
                    النهاية: المراجع[ف].النطاق.النهاية.البايت مثل طبيعي,
                    النص: استنسخ(&البديل)
                };
                ألحق(التعديلات, الاستبدال);
                الاستعمالات := الاستعمالات + 1;
            };
            ف := ف + 1;
        }
        إذا (الاستعمالات == 0) { أرجع اختياري.لا_شيء(); };
        إذا (!تعديل_سليم_لغة(المساحة, المستند, &التعديلات, الأخطاء_الحالية)) { أرجع اختياري.لا_شيء(); };
        ليكن العنوان: متغير نص = «Inline variable»;
        إذا (مستند_لغة_بالعربية(المستند)) { العنوان := «تضمين المتغير»; };
        أرجع إجراء_لغة(المستند, العنوان, «refactor.inline», خطأ, &التعديلات);
    };
}

// ---- Shared scanning -----------------------------------------------------------

// Index just past the bracket that closes the one at `الفتح`, skipping strings,
// raw strings and comments; none when unbalanced.
عرف بعد_الإغلاق_لغة(النص: &نص, الفتح: طبيعي): اختياري طبيعي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = الفتح;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا ((ب == 0x2F) && (ف + 1 < الحد) && ((*النص)[ف + 1] == 0x2F)) {
            طالما ((ف < الحد) && ((*النص)[ف] != 0x0A)) { ف := ف + 1; }
        } وإلا إذا (ب == 0x22) {
            ف := ف + 1;
            طالما ((ف < الحد) && ((*النص)[ف] != 0x22)) {
                إذا ((*النص)[ف] == 0x5C) { ف := ف + 2; } وإلا { ف := ف + 1; };
            }
            ف := ف + 1;
        } وإلا إذا ((ب == 0xC2) && (ف + 1 < الحد) && ((*النص)[ف + 1] == 0xAB)) {
            ف := ف + 2;
            طالما ((ف + 1 < الحد) && !(((*النص)[ف] == 0xC2) && ((*النص)[ف + 1] == 0xBB))) { ف := ف + 1; }
            ف := ف + 2;
        } وإلا إذا ((ب == 0x28) || (ب == 0x5B) || (ب == 0x7B)) {
            العمق := العمق + 1;
            ف := ف + 1;
        } وإلا إذا ((ب == 0x29) || (ب == 0x5D) || (ب == 0x7D)) {
            إذا (العمق == 0) { أرجع اختياري.لا_شيء(); };
            العمق := العمق - 1;
            ف := ف + 1;
            إذا (العمق == 0) { أرجع اختياري.موجود(ف); };
        } وإلا {
            ف := ف + 1;
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف تخطى_فراغا_لغة(النص: &نص, الموضع: طبيعي): طبيعي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = الموضع;
    طالما ((ف < الحد) && (بايت_فراغ_لغة((*النص)[ف]) || ((*النص)[ف] == 0x0A))) { ف := ف + 1; }
    أرجع ف;
}

// `الكلمة` at `الموضع`, followed by a non-identifier byte.
عرف كلمة_عند_لغة(النص: &نص, الموضع: طبيعي, الكلمة: نص): منطقي {
    ليكن الطول_الكلمة: طبيعي = الطول(الكلمة) مثل طبيعي;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (الموضع + الطول_الكلمة > الحد) { أرجع خطأ; };
    ليكن المقطع: نص = جزء_لغة(النص, الموضع, الموضع + الطول_الكلمة);
    إذا (!نصان_متساويان(&المقطع, &الكلمة)) { أرجع خطأ; };
    أرجع (الموضع + الطول_الكلمة == الحد) || !بايت_معرف_لغة((*النص)[الموضع + الطول_الكلمة]);
}

عرف مسافة_السطر_لغة(النص: &نص, البايت: طبيعي): نص {
    ليكن البداية: طبيعي = بداية_السطر_لغة(النص, البايت);
    ليكن ف: متغير طبيعي = البداية;
    طالما ((ف < البايت) && (((*النص)[ف] == 0x20) || ((*النص)[ف] == 0x09))) { ف := ف + 1; }
    أرجع جزء_لغة(النص, البداية, ف);
}

// ---- إذا: invert the condition, add the missing وإلا ---------------------------

نوع شرط_إذا_لغة = {
    بداية_الشرط: طبيعي,
    نهاية_الشرط: طبيعي,
    بداية_الأول: طبيعي,
    نهاية_الأول: طبيعي,
    // The وإلا block, when it is a plain block (not `وإلا إذا`).
    له_وإلا: منطقي,
    بداية_الثاني: طبيعي,
    نهاية_الثاني: طبيعي,
    // `وإلا إذا …` follows: neither refactoring applies.
    سلسلة: منطقي
};

// The `إذا (…) {…} [وإلا {…}]` that starts on the cursor's line.
عرف شرط_إذا_عند_لغة(النص: &نص, البايت: طبيعي): اختياري شرط_إذا_لغة {
    ليكن البداية: طبيعي = بداية_السطر_لغة(النص, البايت);
    ليكن ف: متغير طبيعي = البداية;
    طالما ((ف < (الطول(*النص) مثل طبيعي)) && (((*النص)[ف] == 0x20) || ((*النص)[ف] == 0x09))) { ف := ف + 1; }
    ليكن بعد_الكلمة: متغير طبيعي = 0;
    إذا (كلمة_عند_لغة(النص, ف, «إذا»)) { بعد_الكلمة := ف + (الطول(«إذا») مثل طبيعي); }
    وإلا إذا (كلمة_عند_لغة(النص, ف, «if»)) { بعد_الكلمة := ف + 2; }
    وإلا { أرجع اختياري.لا_شيء(); };
    ليكن فتح_الشرط: طبيعي = تخطى_فراغا_لغة(النص, بعد_الكلمة);
    إذا ((فتح_الشرط >= (الطول(*النص) مثل طبيعي)) || ((*النص)[فتح_الشرط] != 0x28)) { أرجع اختياري.لا_شيء(); };
    ليكن نهاية_الشرط: متغير طبيعي = 0;
    طابق بعد_الإغلاق_لغة(النص, فتح_الشرط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { نهاية_الشرط := القيمة; };
    ليكن فتح_الأول: طبيعي = تخطى_فراغا_لغة(النص, نهاية_الشرط);
    إذا ((فتح_الأول >= (الطول(*النص) مثل طبيعي)) || ((*النص)[فتح_الأول] != 0x7B)) { أرجع اختياري.لا_شيء(); };
    ليكن نهاية_الأول: متغير طبيعي = 0;
    طابق بعد_الإغلاق_لغة(النص, فتح_الأول) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { نهاية_الأول := القيمة; };
    ليكن الشرط: متغير شرط_إذا_لغة = {
        بداية_الشرط: فتح_الشرط, نهاية_الشرط: نهاية_الشرط,
        بداية_الأول: فتح_الأول, نهاية_الأول: نهاية_الأول,
        له_وإلا: خطأ, بداية_الثاني: 0, نهاية_الثاني: 0, سلسلة: خطأ
    };
    ليكن بعد: طبيعي = تخطى_فراغا_لغة(النص, نهاية_الأول);
    ليكن بعد_وإلا: متغير طبيعي = 0;
    إذا (كلمة_عند_لغة(النص, بعد, «وإلا»)) { بعد_وإلا := بعد + (الطول(«وإلا») مثل طبيعي); }
    وإلا إذا (كلمة_عند_لغة(النص, بعد, «else»)) { بعد_وإلا := بعد + 4; };
    إذا (بعد_وإلا > 0) {
        ليكن فتح_الثاني: طبيعي = تخطى_فراغا_لغة(النص, بعد_وإلا);
        إذا ((فتح_الثاني < (الطول(*النص) مثل طبيعي)) && ((*النص)[فتح_الثاني] == 0x7B)) {
            طابق بعد_الإغلاق_لغة(النص, فتح_الثاني) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> {
                الشرط.له_وإلا := صواب;
                الشرط.بداية_الثاني := فتح_الثاني;
                الشرط.نهاية_الثاني := القيمة;
            };
        } وإلا {
            الشرط.سلسلة := صواب;
        };
    };
    أرجع اختياري.موجود(الشرط);
}

// `!(…)` around the condition, or the condition without its `!`.
عرف شرط_معكوس_لغة(الداخل: &نص): نص {
    ليكن المقصوص: نص = قص_النص(الداخل);
    ليكن الحد: طبيعي = الطول(المقصوص) مثل طبيعي;
    إذا ((الحد > 2) && (المقصوص[0] == 0x21) && (المقصوص[1] == 0x28)) {
        طابق بعد_الإغلاق_لغة(&المقصوص, 1) مع
        | اختياري.موجود(النهاية) -> {
            إذا (النهاية == الحد) { أرجع جزء_لغة(&المقصوص, 2, الحد - 1); };
        }
        | اختياري.لا_شيء -> { };
    };
    إذا ((الحد > 1) && (المقصوص[0] == 0x21)) {
        ليكن الباقي: نص = جزء_لغة(&المقصوص, 1, الحد);
        ليكن بسيط: متغير منطقي = صواب;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الباقي) مثل طبيعي)) {
            ليكن ب: ط8 = الباقي[ف];
            إذا (!(بايت_معرف_لغة(ب) || (ب == 0x2E))) { بسيط := خطأ; };
            ف := ف + 1;
        }
        إذا (بسيط) { أرجع الباقي; };
    };
    ليكن أجزاء: متجه نص = [«!(», استنسخ(&المقصوص), «)»];
    أرجع صل_لغة(&أجزاء);
}

عام عرف إجراءات_شرط_إذا_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الأخطاء_الحالية: طبيعي
): متجه إجراء_بسيط_لغة {
    ليكن الناتج: متغير متجه إجراء_بسيط_لغة = [];
    ليكن النص: &نص = &(*المستند).النص;
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن البايت: متغير طبيعي = 0;
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.خطأ(_) -> { أرجع الناتج; }
    | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
    طابق شرط_إذا_عند_لغة(النص, البايت) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(ش) -> {
        إذا (ش.سلسلة) { أرجع الناتج; };
        إذا (ش.له_وإلا) {
            ليكن الداخل: نص = جزء_لغة(النص, ش.بداية_الشرط + 1, ش.نهاية_الشرط - 1);
            ليكن المعكوس: نص = شرط_معكوس_لغة(&الداخل);
            ليكن الأول: نص = جزء_لغة(النص, ش.بداية_الأول, ش.نهاية_الأول);
            ليكن الثاني: نص = جزء_لغة(النص, ش.بداية_الثاني, ش.نهاية_الثاني);
            ليكن تعديل_الشرط: تعديل_بايتات_لغة = { البداية: ش.بداية_الشرط + 1, النهاية: ش.نهاية_الشرط - 1, النص: المعكوس };
            ليكن تعديل_الأول: تعديل_بايتات_لغة = { البداية: ش.بداية_الأول, النهاية: ش.نهاية_الأول, النص: الثاني };
            ليكن تعديل_الثاني: تعديل_بايتات_لغة = { البداية: ش.بداية_الثاني, النهاية: ش.نهاية_الثاني, النص: الأول };
            ليكن التعديلات: متجه تعديل_بايتات_لغة = [تعديل_الشرط, تعديل_الأول, تعديل_الثاني];
            إذا (تعديل_سليم_لغة(المساحة, المستند, &التعديلات, الأخطاء_الحالية)) {
                ليكن العنوان: متغير نص = «Invert condition and swap branches»;
                إذا (عربي) { العنوان := «عكس الشرط وتبديل الفرعين»; };
                طابق إجراء_لغة(المستند, العنوان, «refactor.rewrite», خطأ, &التعديلات) مع
                | اختياري.موجود(الإجراء) -> { ألحق(الناتج, الإجراء); }
                | اختياري.لا_شيء -> { };
            };
        } وإلا {
            ليكن المسافة: نص = مسافة_السطر_لغة(النص, البايت);
            ليكن كلمة: متغير نص = « else {»;
            إذا (عربي) { كلمة := « وإلا {»; };
            ليكن أجزاء: متجه نص = [استنسخ(&كلمة), «

», استنسخ(&المسافة), «}»];
            ليكن الإضافة: تعديل_بايتات_لغة = { البداية: ش.نهاية_الأول, النهاية: ش.نهاية_الأول, النص: صل_لغة(&أجزاء) };
            ليكن التعديلات: متجه تعديل_بايتات_لغة = [الإضافة];
            إذا (تعديل_سليم_لغة(المساحة, المستند, &التعديلات, الأخطاء_الحالية)) {
                ليكن العنوان: متغير نص = «Add else branch»;
                إذا (عربي) { العنوان := «إضافة فرع وإلا»; };
                طابق إجراء_لغة(المستند, العنوان, «refactor.rewrite», خطأ, &التعديلات) مع
                | اختياري.موجود(الإجراء) -> { ألحق(الناتج, الإجراء); }
                | اختياري.لا_شيء -> { };
            };
        };
    };
    أرجع الناتج;
}

// ---- Extract function ------------------------------------------------------------
// The selection (whole statements of one block, or one whole expression)
// becomes a new function after the enclosing one. The compiler decides what
// it needs (tooling_queries.sn حلل_استخراج_دالة / حلل_استخراج_دالة_واجهة):
// المدخلات by value, المستعارة_متغيرة by `&متغير` (their uses in the body
// become `(*name)`), at most one returned local (المخرجات) or the value of
// the selected expression. The edit is offered only when the recheck adds no
// error.

عرف نوع_بلا_متغير_لغة(التهجئة: &نص): نص {
    ليكن البادئات: متجه نص = [«متغير », «mutable »];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        طابق أزل_البادئة(التهجئة, &البادئات[ف]) مع
        | اختياري.موجود(الباقي) -> { أرجع الباقي; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع استنسخ(التهجئة);
}

عرف اسم_رمز_استخراج_لغة(الواجهة: &نتيجة_واجهة_وحدة, الرمز: معرف_رمز): اختياري نص {
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التصريح) -> { أرجع اسم_رمز_من_واجهة_لغة(الواجهة, &التصريح); };
}

// The enclosing top-level function's span (from the compiler's AST).
عرف نطاق_الدالة_المحيطة_لغة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, البايت: طبيعي): اختياري نطاق {
    طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الواجهة).الوحدات[الموضع].العناصر) مثل طبيعي)) {
            طابق استنسخ(&(*الواجهة).الوحدات[الموضع].العناصر[ف]) مع
            | عنصر_وحدة.دالة(الدالة) -> {
                إذا ((الدالة.النطاق.البداية.البايت مثل طبيعي) <= البايت && البايت <= (الدالة.النطاق.النهاية.البايت مثل طبيعي)) {
                    أرجع اختياري.موجود(الدالة.النطاق);
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// The selected lines without their common indentation, each indented once.
عرف جسم_بمسافة_لغة(النص: &نص, المسافة: &نص): نص {
    ليكن الأسطر: متجه نص = أسطر_النص(النص);
    ليكن أقل: متغير طبيعي = 1000000;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن المقصوص: نص = قص_النص(&الأسطر[ف]);
        إذا ((الطول(المقصوص) مثل طبيعي) > 0) {
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأسطر[ف]) مثل طبيعي) && (الأسطر[ف][ع] == 0x20 || الأسطر[ف][ع] == 0x09)) { ع := ع + 1; }
            إذا (ف > 0 && ع < أقل) { أقل := ع; };
        };
        ف := ف + 1;
    }
    ليكن الناتج: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن المقصوص: نص = قص_النص(&الأسطر[ف]);
        إذا ((الطول(المقصوص) مثل طبيعي) > 0) {
            ليكن السطر: متغير نص = استنسخ(&المقصوص);
            إذا (ف > 0 && أقل < 1000000 && أقل <= (الطول(الأسطر[ف]) مثل طبيعي)) {
                السطر := جزء_لغة(&الأسطر[ف], أقل, الطول(الأسطر[ف]) مثل طبيعي);
            };
            ليكن أجزاء: متجه نص = [استنسخ(المسافة), السطر];
            ألحق(الناتج, صل_لغة(&أجزاء));
        };
        ف := ف + 1;
    }
    ليكن سطر_جديد: نص = "\n";
    أرجع صل_النصوص(&الناتج, &سطر_جديد);
}

عام عرف إجراء_استخراج_دالة_لغة(
    المساحة: &مساحة_عمل_لغة,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    الأخطاء_الحالية: طبيعي
): اختياري إجراء_بسيط_لغة {
    ليكن النص: &نص = &(*المستند).النص;
    ليكن أ: متغير طبيعي = 0;
    ليكن ب: متغير طبيعي = 0;
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, المطلوب.البداية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { أ := القيمة; };
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, المطلوب.النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { ب := القيمة; };
    طالما ((أ < ب) && بايت_فراغ_لغة((*النص)[أ])) { أ := أ + 1; }
    طالما ((ب > أ) && بايت_فراغ_لغة((*النص)[ب - 1])) { ب := ب - 1; }
    إذا (أ >= ب) { أرجع اختياري.لا_شيء(); };
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: طبيعي;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن الخطة: خطة_استخراج;
        طابق حلل_استخراج_دالة(الواجهة, المصدر, أ, ب) مع
        | نتيجة_حلل_استخراج.غير_صالح(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_حلل_استخراج.صالح(القيمة) -> { الخطة := القيمة; };
        ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
        ليكن تعبير: منطقي = اختياري_نوع_موجود_لغة(&الخطة.نوع_القيمة);
        إذا ((الطول(الخطة.المخرجات) مثل طبيعي) > 1) { أرجع اختياري.لا_شيء(); };
        إذا (تعبير && (الطول(الخطة.المستعارة_متغيرة) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };

        // Uses inside the range of each &mutable local (detailed form).
        ليكن البدائل: متغير متجه تعديل_بايتات_لغة = [];
        إذا (!تعبير) {
            طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, أ, ب) مع
            | نتيجة_استخراج_دالة_واجهة.مرفوض(_) -> { أرجع اختياري.لا_شيء(); }
            | نتيجة_استخراج_دالة_واجهة.جاهز(التفصيل) -> {
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(التفصيل.المدخلات) مثل طبيعي)) {
                    ليكن م: متغير_استخراج_واجهة = استنسخ(&التفصيل.المدخلات[ف]);
                    إذا (رمز_في_خطة_لغة(&الخطة.المستعارة_متغيرة, م.الرمز)) {
                        ليكن ك: متغير طبيعي = 0;
                        طالما (ك < (الطول(م.الاستخدامات) مثل طبيعي)) {
                            ليكن س: طبيعي = م.الاستخدامات[ك].البداية.البايت مثل طبيعي;
                            ليكن ن: طبيعي = م.الاستخدامات[ك].النهاية.البايت مثل طبيعي;
                            إذا (س >= أ && ن <= ب) {
                                ليكن الاسم: نص = جزء_لغة(النص, س, ن);
                                ليكن أجزاء: متجه نص = [«(*», الاسم, «)»];
                                ليكن البديل: تعديل_بايتات_لغة = { البداية: س - أ, النهاية: ن - أ, النص: صل_لغة(&أجزاء) };
                                ألحق(البدائل, البديل);
                            };
                            ك := ك + 1;
                        }
                    };
                    ف := ف + 1;
                }
            };
        };

        // Parameters and arguments.
        ليكن المعاملات: متغير متجه نص = [];
        ليكن الحجج: متغير متجه نص = [];
        // By-value inputs first, then the `&متغير` ones (two lists in the plan).
        ليكن كل_المدخلات: متغير متجه متغير_استخراج = استنسخ(&الخطة.المدخلات);
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول(الخطة.المستعارة_متغيرة) مثل طبيعي)) {
            إذا (!رمز_في_خطة_لغة(&كل_المدخلات, الخطة.المستعارة_متغيرة[ق].الرمز)) { ألحق(كل_المدخلات, الخطة.المستعارة_متغيرة[ق]); };
            ق := ق + 1;
        }
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(كل_المدخلات) مثل طبيعي)) {
            ليكن م: متغير_استخراج = كل_المدخلات[ف];
            ليكن الاسم: نص;
            طابق اسم_رمز_استخراج_لغة(الواجهة, م.الرمز) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
            ليكن النوع: نص;
            طابق م.النوع مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المعرف) -> {
                طابق تهجئة_نوع_لغة(الواجهة, المعرف, عربي) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(التهجئة) -> { النوع := نوع_بلا_متغير_لغة(&التهجئة); };
            };
            ليكن بالمرجع: منطقي = رمز_في_خطة_لغة(&الخطة.المستعارة_متغيرة, م.الرمز);
            ليكن البادئة_النوع: متغير نص = «»;
            ليكن البادئة_الحجة: متغير نص = «»;
            إذا (بالمرجع) {
                إذا (عربي) { البادئة_النوع := «&متغير »; البادئة_الحجة := «&متغير »; }
                وإلا { البادئة_النوع := «&mutable »; البادئة_الحجة := «&mutable »; };
            };
            ليكن معامل: متجه نص = [استنسخ(&الاسم), «: », البادئة_النوع, النوع];
            ألحق(المعاملات, صل_لغة(&معامل));
            ليكن حجة: متجه نص = [البادئة_الحجة, الاسم];
            ألحق(الحجج, صل_لغة(&حجة));
            ف := ف + 1;
        }

        // Result: the expression's Type, the one returned local, or void.
        ليكن الناتج_نوع: متغير نص = «فراغ»;
        إذا (!عربي) { الناتج_نوع := «void»; };
        ليكن المخرج_اسم: متغير اختياري نص = اختياري.لا_شيء();
        ليكن المخرج_نوع_كامل: متغير نص = «»;
        طابق الخطة.نوع_القيمة مع
        | اختياري.موجود(المعرف) -> {
            طابق تهجئة_نوع_لغة(الواجهة, المعرف, عربي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التهجئة) -> { الناتج_نوع := التهجئة; };
        }
        | اختياري.لا_شيء -> {
            إذا ((الطول(الخطة.المخرجات) مثل طبيعي) == 1) {
                ليكن م: متغير_استخراج = الخطة.المخرجات[0];
                طابق اسم_رمز_استخراج_لغة(الواجهة, م.الرمز) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(القيمة) -> { المخرج_اسم := اختياري.موجود(القيمة); };
                طابق م.النوع مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(المعرف) -> {
                    طابق تهجئة_نوع_لغة(الواجهة, المعرف, عربي) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(التهجئة) -> {
                        المخرج_نوع_كامل := استنسخ(&التهجئة);
                        الناتج_نوع := نوع_بلا_متغير_لغة(&التهجئة);
                    };
                };
            };
        };

        // The new function.
        ليكن الدالة_المحيطة: نطاق;
        طابق نطاق_الدالة_المحيطة_لغة(الواجهة, المصدر, أ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الدالة_المحيطة := القيمة; };
        ليكن الاسم_الجديد: نص = اسم_جديد_لغة(النص, «extracted»);
        ليكن اسم_الدالة: متغير نص = الاسم_الجديد;
        إذا (عربي) { اسم_الدالة := اسم_جديد_لغة(النص, «مستخرجة»); };
        ليكن المحدد: نص = جزء_لغة(النص, أ, ب);
        ليكن المحدد_المعدل: نص = طبق_تعديلات_بايتات_لغة(&المحدد, &البدائل);
        ليكن كلمة_الدالة: متغير نص = «def »;
        ليكن كلمة_الإرجاع: متغير نص = «return »;
        ليكن كلمة_الربط: متغير نص = «let »;
        إذا (عربي) { كلمة_الدالة := «عرف »; كلمة_الإرجاع := «أرجع »; كلمة_الربط := «ليكن »; };
        ليكن مسافة: نص = «    »;
        ليكن فاصل: نص = «, »;
        ليكن الجسم: متغير نص = «»;
        إذا (تعبير) {
            ليكن أجزاء: متجه نص = [استنسخ(&مسافة), استنسخ(&كلمة_الإرجاع), استنسخ(&المحدد_المعدل), «;»];
            الجسم := صل_لغة(&أجزاء);
        } وإلا {
            الجسم := جسم_بمسافة_لغة(&المحدد_المعدل, &مسافة);
            طابق استنسخ(&المخرج_اسم) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الاسم) -> {
                ليكن أجزاء: متجه نص = [استنسخ(&الجسم), "\n", استنسخ(&مسافة), استنسخ(&كلمة_الإرجاع), الاسم, «;»];
                الجسم := صل_لغة(&أجزاء);
            };
        };
        ليكن قائمة_المعاملات: نص = صل_النصوص(&المعاملات, &فاصل);
        ليكن تعريف: متجه نص = ["\n\n", استنسخ(&كلمة_الدالة), استنسخ(&اسم_الدالة), «(», قائمة_المعاملات, «): », استنسخ(&الناتج_نوع), " {\n", الجسم, "\n}"];
        ليكن نهاية_الدالة: طبيعي = الدالة_المحيطة.النهاية.البايت مثل طبيعي;
        ليكن إدراج_الدالة: تعديل_بايتات_لغة = { البداية: نهاية_الدالة, النهاية: نهاية_الدالة, النص: صل_لغة(&تعريف) };

        // The call that replaces the selection.
        ليكن قائمة_الحجج: نص = صل_النصوص(&الحجج, &فاصل);
        ليكن النداء_أجزاء: متجه نص = [استنسخ(&اسم_الدالة), «(», قائمة_الحجج, «)»];
        ليكن النداء: نص = صل_لغة(&النداء_أجزاء);
        ليكن البديل: متغير نص = استنسخ(&النداء);
        إذا (!تعبير) {
            طابق استنسخ(&المخرج_اسم) مع
            | اختياري.لا_شيء -> { ليكن أجزاء: متجه نص = [استنسخ(&النداء), «;»]; البديل := صل_لغة(&أجزاء); }
            | اختياري.موجود(الاسم) -> {
                ليكن أجزاء: متجه نص = [استنسخ(&كلمة_الربط), الاسم, «: », استنسخ(&المخرج_نوع_كامل), « = », استنسخ(&النداء), «;»];
                البديل := صل_لغة(&أجزاء);
            };
        };
        ليكن الاستبدال: تعديل_بايتات_لغة = { البداية: أ, النهاية: ب, النص: البديل };
        ليكن التعديلات: متجه تعديل_بايتات_لغة = [الاستبدال, إدراج_الدالة];
        إذا (!تعديل_سليم_لغة(المساحة, المستند, &التعديلات, الأخطاء_الحالية)) { أرجع اختياري.لا_شيء(); };
        ليكن العنوان: متغير نص = «Extract into function»;
        إذا (عربي) { العنوان := «استخراج إلى دالة»; };
        أرجع إجراء_لغة(المستند, العنوان, «refactor.extract.function», خطأ, &التعديلات);
    };
}

عرف اختياري_نوع_موجود_لغة(القيمة: &اختياري معرف_نوع): منطقي {
    طابق *القيمة مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف رمز_في_خطة_لغة(القائمة: &متجه متغير_استخراج, الرمز: معرف_رمز): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*القائمة)[ف].الرمز, الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}
