استورد compiler.frontend.identifier_identity;

// Workspace-symbol query matching. Both sides are reduced to the compiler's
// identifier identity (compiler/frontend/identifier_identity.sn: Alef forms
// are one letter, Kashida is ignored), so `اداة` finds `أداة` and `عـرف_x`
// finds `عرف_x` exactly as name resolution would. ASCII letters fold case.
// A query matches when its characters appear in order (fuzzy subsequence, as
// rust-analyzer and gopls match workspace symbols); the client ranks the
// results.

عرف بداية_محرف_لغة(البايت: ط8): منطقي {
    أرجع (البايت مثل طبيعي) < 128 || (البايت مثل طبيعي) >= 192;
}

عرف صغر_أسكي_لغة(البايت: ط8): ط8 {
    إذا ((البايت مثل طبيعي) >= 65 && (البايت مثل طبيعي) <= 90) {
        أرجع ((البايت مثل طبيعي) + 32) مثل ط8;
    };
    أرجع البايت;
}

عرف هوية_مطوية_لغة(النص: &نص): متجه ط8 {
    ليكن الهوية: متجه ط8 = انسخ_هوية_معرف_من_نص(النص);
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الهوية) مثل طبيعي)) {
        ألحق(الناتج, صغر_أسكي_لغة(الهوية[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Length in bytes of the UTF-8 scalar starting at `الموضع`.
عرف طول_محرف_عند_لغة(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    ليكن الطول_الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    ليكن ن: متغير طبيعي = الموضع + 1;
    طالما (ن < الطول_الكلي && !بداية_محرف_لغة((*البايتات)[ن])) { ن := ن + 1; }
    أرجع ن - الموضع;
}

عرف محرفان_متساويان_لغة(أ: &متجه ط8, م_أ: طبيعي, ب: &متجه ط8, م_ب: طبيعي, الطول_المحرف: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الطول_المحرف) {
        إذا ((*أ)[م_أ + ف] != (*ب)[م_ب + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف يطابق_استعلام_رمز_لغة(الاسم: &نص, الاستعلام: &نص): منطقي {
    ليكن الاستعلام_المطوي: متجه ط8 = هوية_مطوية_لغة(الاستعلام);
    ليكن طول_الاستعلام: طبيعي = الطول(الاستعلام_المطوي) مثل طبيعي;
    إذا (طول_الاستعلام == 0) { أرجع صواب; };
    ليكن الاسم_المطوي: متجه ط8 = هوية_مطوية_لغة(الاسم);
    ليكن طول_الاسم: طبيعي = الطول(الاسم_المطوي) مثل طبيعي;
    ليكن س: متغير طبيعي = 0;
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < طول_الاستعلام && س < طول_الاسم) {
        ليكن طول_ق: طبيعي = طول_محرف_عند_لغة(&الاستعلام_المطوي, ق);
        ليكن طول_س: طبيعي = طول_محرف_عند_لغة(&الاسم_المطوي, س);
        إذا (طول_ق == طول_س && محرفان_متساويان_لغة(&الاستعلام_المطوي, ق, &الاسم_المطوي, س, طول_ق)) {
            ق := ق + طول_ق;
        };
        س := س + طول_س;
    }
    أرجع ق >= طول_الاستعلام;
}
