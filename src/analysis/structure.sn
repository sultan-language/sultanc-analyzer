استورد sultanc_analyzer.workspace.documents;
استورد std.text.substring;
استورد std.text.transform;
استورد std.text.search;
استورد std.fs.path;
استورد std.fs.metadata;
استورد std.env.environment;
استورد std.text.compare;
استورد std.text.from_bytes;

// Syntax-level structure from the document text alone: bracket pairs, comment
// and import blocks, import links. It needs no semantic analysis, so folding,
// selection ranges and links keep working while the file does not parse.
// The scanner knows `//` comments, "..." strings with escapes and raw «...».

عام نوع زوج_أقواس_لغة = {
    الفتح: طبيعي,
    الإغلاق: طبيعي,
    سطر_الفتح: طبيعي,
    سطر_الإغلاق: طبيعي,
    المحرف: ط8
};

عام نوع نطاق_طي_بنيوي_لغة = {
    السطر_الأول: طبيعي,
    السطر_الأخير: طبيعي,
    // "", "comment" or "imports" (LSP FoldingRangeKind).
    الصنف: نص
};

عام نوع رابط_بنيوي_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي,
    المسار: نص
};

عرف قوس_مطابق_لغة(الفتح: ط8, الإغلاق: ط8): منطقي {
    أرجع ((الفتح == 0x28) && (الإغلاق == 0x29))
        || ((الفتح == 0x5B) && (الإغلاق == 0x5D))
        || ((الفتح == 0x7B) && (الإغلاق == 0x7D));
}

عام عرف أزواج_أقواس_لغة(النص: &نص): متجه زوج_أقواس_لغة {
    ليكن الناتج: متغير متجه زوج_أقواس_لغة = [];
    ليكن مكدس_المواضع: متغير متجه طبيعي = [];
    ليكن مكدس_الأسطر: متغير متجه طبيعي = [];
    ليكن مكدس_المحارف: متغير متجه ط8 = [];
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن السطر: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب == 0x0A) {
            السطر := السطر + 1;
            ف := ف + 1;
        } وإلا إذا ((ب == 0x2F) && (ف + 1 < الحد) && ((*النص)[ف + 1] == 0x2F)) {
            طالما ((ف < الحد) && ((*النص)[ف] != 0x0A)) { ف := ف + 1; }
        } وإلا إذا (ب == 0x22) {
            ف := ف + 1;
            ليكن مستمر: متغير منطقي = صواب;
            طالما (مستمر && (ف < الحد)) {
                ليكن ح: ط8 = (*النص)[ف];
                إذا (ح == 0x5C) { ف := ف + 2; }
                وإلا إذا (ح == 0x22) { ف := ف + 1; مستمر := خطأ; }
                وإلا إذا (ح == 0x0A) { مستمر := خطأ; }
                وإلا { ف := ف + 1; };
            }
        } وإلا إذا ((ب == 0xC2) && (ف + 1 < الحد) && ((*النص)[ف + 1] == 0xAB)) {
            // «raw»: no escapes, ends at the first ».
            ف := ف + 2;
            ليكن مستمر: متغير منطقي = صواب;
            طالما (مستمر && (ف < الحد)) {
                إذا (((*النص)[ف] == 0xC2) && (ف + 1 < الحد) && ((*النص)[ف + 1] == 0xBB)) {
                    ف := ف + 2; مستمر := خطأ;
                } وإلا {
                    إذا ((*النص)[ف] == 0x0A) { السطر := السطر + 1; };
                    ف := ف + 1;
                };
            }
        } وإلا إذا ((ب == 0x28) || (ب == 0x5B) || (ب == 0x7B)) {
            ألحق(مكدس_المواضع, ف);
            ألحق(مكدس_الأسطر, السطر);
            ألحق(مكدس_المحارف, ب);
            ف := ف + 1;
        } وإلا إذا ((ب == 0x29) || (ب == 0x5D) || (ب == 0x7D)) {
            // Recovery: an unclosed opener above the match is dropped, so one
            // stray `(` does not swallow every enclosing block.
            ليكن العمق: طبيعي = الطول(مكدس_المواضع) مثل طبيعي;
            ليكن المطابق: متغير طبيعي = العمق;
            ليكن ك: متغير طبيعي = العمق;
            طالما ((ك > 0) && (المطابق == العمق)) {
                إذا (قوس_مطابق_لغة(مكدس_المحارف[ك - 1], ب)) { المطابق := ك - 1; };
                ك := ك - 1;
            }
            إذا (المطابق < العمق) {
                طالما ((الطول(مكدس_المواضع) مثل طبيعي) > المطابق + 1) {
                    أزل_آخر_طبيعي_لغة(&متغير مكدس_المواضع);
                    أزل_آخر_طبيعي_لغة(&متغير مكدس_الأسطر);
                    أزل_آخر_غ8_لغة(&متغير مكدس_المحارف);
                }
            };
            ليكن العمق_الجديد: طبيعي = الطول(مكدس_المواضع) مثل طبيعي;
            إذا ((المطابق < العمق) && (العمق_الجديد > 0)) {
                ليكن الأعلى: طبيعي = العمق_الجديد - 1;
                إذا (قوس_مطابق_لغة(مكدس_المحارف[الأعلى], ب)) {
                    ليكن الزوج: زوج_أقواس_لغة = {
                        الفتح: مكدس_المواضع[الأعلى],
                        الإغلاق: ف,
                        سطر_الفتح: مكدس_الأسطر[الأعلى],
                        سطر_الإغلاق: السطر,
                        المحرف: مكدس_المحارف[الأعلى]
                    };
                    ألحق(الناتج, الزوج);
                    أزل_آخر_طبيعي_لغة(&متغير مكدس_المواضع);
                    أزل_آخر_طبيعي_لغة(&متغير مكدس_الأسطر);
                    أزل_آخر_غ8_لغة(&متغير مكدس_المحارف);
                };
            };
            ف := ف + 1;
        } وإلا {
            ف := ف + 1;
        };
    }
    أرجع الناتج;
}

عرف أزل_آخر_طبيعي_لغة(القيم: &متغير متجه طبيعي): فراغ {
    ليكن الباقية: متغير متجه طبيعي = [];
    ليكن العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف + 1) < العدد) { ألحق(الباقية, (*القيم)[ف]); ف := ف + 1; }
    *القيم := الباقية;
}

عرف أزل_آخر_غ8_لغة(القيم: &متغير متجه ط8): فراغ {
    ليكن الباقية: متغير متجه ط8 = [];
    ليكن العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف + 1) < العدد) { ألحق(الباقية, (*القيم)[ف]); ف := ف + 1; }
    *القيم := الباقية;
}

// One trimmed line per entry, so block detection works line by line.
عرف أسطر_مقصوصة_لغة(النص: &نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن البداية: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= الحد) {
        إذا ((ف == الحد) || ((*النص)[ف] == 0x0A)) {
            طابق مقطع_نص(النص, البداية, ف - البداية) مع
            | اختياري.لا_شيء -> { ألحق(الناتج, «»); }
            | اختياري.موجود(السطر) -> { ألحق(الناتج, قص_النص(&السطر)); };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سطر_استيراد_لغة(السطر: &نص): منطقي {
    ليكن إنجليزي: نص = «import »;
    ليكن عربي: نص = «استورد »;
    أرجع يبدأ_بـ(السطر, &إنجليزي) || يبدأ_بـ(السطر, &عربي);
}

عرف أضف_كتلة_طي_لغة(
    الناتج: &متغير متجه نطاق_طي_بنيوي_لغة,
    الأول: طبيعي,
    الأخير: طبيعي,
    الصنف: نص
): فراغ {
    إذا (الأخير > الأول) {
        ليكن النطاق: نطاق_طي_بنيوي_لغة = { السطر_الأول: الأول, السطر_الأخير: الأخير, الصنف: الصنف };
        ألحق(*الناتج, النطاق);
    };
}

عام عرف نطاقات_طي_بنيوية_لغة(المستند: &مستند_لغة_مفتوح): متجه نطاق_طي_بنيوي_لغة {
    ليكن الناتج: متغير متجه نطاق_طي_بنيوي_لغة = [];
    // Multi-line bracket blocks; the closing line stays visible.
    ليكن الأزواج: متجه زوج_أقواس_لغة = أزواج_أقواس_لغة(&(*المستند).النص);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأزواج) مثل طبيعي)) {
        ليكن الزوج: زوج_أقواس_لغة = الأزواج[ف];
        إذا (الزوج.سطر_الإغلاق > الزوج.سطر_الفتح + 1) {
            أضف_كتلة_طي_لغة(&متغير الناتج, الزوج.سطر_الفتح, الزوج.سطر_الإغلاق - 1, «»);
        } وإلا إذا ((الزوج.سطر_الإغلاق == الزوج.سطر_الفتح + 1) && (الزوج.المحرف == 0x7B)) {
            أضف_كتلة_طي_لغة(&متغير الناتج, الزوج.سطر_الفتح, الزوج.سطر_الإغلاق, «»);
        };
        ف := ف + 1;
    }
    // Comment blocks and import blocks of two or more lines.
    ليكن الأسطر: متجه نص = أسطر_مقصوصة_لغة(&(*المستند).النص);
    ليكن بادئة_تعليق: نص = «//»;
    ليكن ح: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول(الأسطر) مثل طبيعي;
    طالما (ح < العدد) {
        إذا (يبدأ_بـ(&الأسطر[ح], &بادئة_تعليق)) {
            ليكن الأول: طبيعي = ح;
            طالما ((ح + 1 < العدد) && يبدأ_بـ(&الأسطر[ح + 1], &بادئة_تعليق)) { ح := ح + 1; }
            أضف_كتلة_طي_لغة(&متغير الناتج, الأول, ح, «comment»);
        } وإلا إذا (سطر_استيراد_لغة(&الأسطر[ح])) {
            ليكن الأول: طبيعي = ح;
            طالما ((ح + 1 < العدد) && سطر_استيراد_لغة(&الأسطر[ح + 1])) { ح := ح + 1; }
            أضف_كتلة_طي_لغة(&متغير الناتج, الأول, ح, «imports»);
        };
        ح := ح + 1;
    }
    أرجع الناتج;
}

عرف بايت_معرف_بنيوي_لغة(ب: ط8): منطقي {
    أرجع (ب >= 0x80) || (ب == 0x5F) || (ب >= 0x30 && ب <= 0x39)
        || (ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A);
}

// Selection ranges, innermost first: identifier, then each enclosing bracket
// pair (contents, then with brackets), then the whole document. Each range
// strictly contains the previous one. Ranges are byte pairs [start, end).
عام عرف نطاقات_تحديد_بنيوية_لغة(النص: &نص, البايت: طبيعي): متجه نطاق_بايتات_بنيوي_لغة {
    ليكن الناتج: متغير متجه نطاق_بايتات_بنيوي_لغة = [];
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن الموضع: متغير طبيعي = البايت;
    إذا (الموضع > الحد) { الموضع := الحد; };
    ليكن البداية: متغير طبيعي = الموضع;
    ليكن النهاية: متغير طبيعي = الموضع;
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && (البداية > 0)) {
        إذا (بايت_معرف_بنيوي_لغة((*النص)[البداية - 1])) { البداية := البداية - 1; } وإلا { مستمر := خطأ; };
    }
    مستمر := صواب;
    طالما (مستمر && (النهاية < الحد)) {
        إذا (بايت_معرف_بنيوي_لغة((*النص)[النهاية])) { النهاية := النهاية + 1; } وإلا { مستمر := خطأ; };
    }
    إذا (النهاية > البداية) {
        ليكن الكلمة: نطاق_بايتات_بنيوي_لغة = { البداية: البداية, النهاية: النهاية };
        ألحق(الناتج, الكلمة);
    };
    // Enclosing pairs come out of the scanner inner-first (closed earlier).
    ليكن الأزواج: متجه زوج_أقواس_لغة = أزواج_أقواس_لغة(النص);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأزواج) مثل طبيعي)) {
        ليكن الزوج: زوج_أقواس_لغة = الأزواج[ف];
        إذا ((الزوج.الفتح < الموضع) && (الموضع <= الزوج.الإغلاق)) {
            ليكن الداخل: نطاق_بايتات_بنيوي_لغة = { البداية: الزوج.الفتح + 1, النهاية: الزوج.الإغلاق };
            أضف_نطاق_محتو_لغة(&متغير الناتج, الداخل);
            ليكن الكامل: نطاق_بايتات_بنيوي_لغة = { البداية: الزوج.الفتح, النهاية: الزوج.الإغلاق + 1 };
            أضف_نطاق_محتو_لغة(&متغير الناتج, الكامل);
        };
        ف := ف + 1;
    }
    ليكن الكل: نطاق_بايتات_بنيوي_لغة = { البداية: 0, النهاية: الحد };
    أضف_نطاق_محتو_لغة(&متغير الناتج, الكل);
    أرجع الناتج;
}

عام نوع نطاق_بايتات_بنيوي_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي
};

// Appends only a range that strictly contains the last one.
عرف أضف_نطاق_محتو_لغة(
    الناتج: &متغير متجه نطاق_بايتات_بنيوي_لغة,
    النطاق: نطاق_بايتات_بنيوي_لغة
): فراغ {
    ليكن العدد: طبيعي = الطول(*الناتج) مثل طبيعي;
    إذا (العدد > 0) {
        ليكن الأخير: نطاق_بايتات_بنيوي_لغة = (*الناتج)[العدد - 1];
        إذا (!((النطاق.البداية <= الأخير.البداية) && (النطاق.النهاية >= الأخير.النهاية))) { أرجع; };
        إذا ((النطاق.البداية == الأخير.البداية) && (النطاق.النهاية == الأخير.النهاية)) { أرجع; };
    };
    ألحق(*الناتج, النطاق);
}
