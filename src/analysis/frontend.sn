// حد LSP مع Frontend فقط: يمرر لقطات المستندات المفتوحة إلى مزود المصدر المقنن،
// ثم يستهلك نتيجة خط الأنابيب الدلالي نفسه. لا توجد دلالة لغة مكررة هنا.
عام نوع لقطة_تحليل_واجهة_لغة = {
    العنوان: نص,
    المسار: نص,
    الإصدار: عدد,
    المراجعة: طبيعي,
    // Shared (std.sync.arc): a cached snapshot and the requests reading it
    // hold one analysed interface, never a copy of it.
    الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة>,
    التشخيصات: مجموعة_تشخيصات
};

عام نوع نتيجة_تحليل_واجهة_لغة =
    | مكتملة بنوع لقطة_تحليل_واجهة_لغة
    | مصدر_غير_قابل_للتحليل
;

// A copy of the module environment. `استنسخ` of the whole environment stops
// the current compiler (ICE in msir-verifier: a clone of a vector of records,
// here `متجه معرف_جذر_مكتبة`, is lowered to a block copy the verifier rejects),
// so those two vectors are copied element by element and the rest is cloned.
عرف انسخ_معرفات_جذور_لغة(القيم: &متجه معرف_جذر_مكتبة): متجه معرف_جذر_مكتبة {
    ليكن الناتج: متغير متجه معرف_جذر_مكتبة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        ألحق(الناتج, معرف_جذر_مكتبة_من((*القيم)[ف].القيمة));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_بيئة_لغة(البيئة: &بيئة_وحدات_منطقية): بيئة_وحدات_منطقية {
    ليكن النسخة: بيئة_وحدات_منطقية = {
        معرف_الجذر_التالي: (*البيئة).معرف_الجذر_التالي,
        جذر_قياسي_موثوق: استنسخ(&(*البيئة).جذر_قياسي_موثوق),
        الجذور: انسخ_معرفات_جذور_لغة(&(*البيئة).الجذور),
        روابط_الجذور: استنسخ(&(*البيئة).روابط_الجذور),
        جذور_المصادر: انسخ_معرفات_جذور_لغة(&(*البيئة).جذور_المصادر),
        الجذور_القياسية: انسخ_معرفات_جذور_لغة(&(*البيئة).الجذور_القياسية),
        الطبقات_السفلى: استنسخ(&(*البيئة).الطبقات_السفلى),
        مسارات_جذور_المصادر: استنسخ(&(*البيئة).مسارات_جذور_المصادر),
        المسارات_العامة: استنسخ(&(*البيئة).المسارات_العامة),
        مواقع_المصادر: استنسخ(&(*البيئة).مواقع_المصادر),
        أسماء_الحزم: استنسخ(&(*البيئة).أسماء_الحزم),
        مزود_المصادر: استنسخ(&(*البيئة).مزود_المصادر)
    };
    أرجع النسخة;
}

عام عرف ابن_لقطة_واجهة_بلا_دلالات_لغة(
    المستند: &مستند_لغة_مفتوح
): نتيجة_تحليل_واجهة_لغة {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مرجع_العنوان: &نص = &د.العنوان;
    ليكن العنوان: نص = استنسخ(مرجع_العنوان);
    ليكن الإصدار: عدد = د.الإصدار;
    ليكن المراجعة: طبيعي = د.المراجعة;
    ليكن مرجع_المسار: &اختياري نص = &د.مسار_الملف;
    ليكن اختيار_المسار: اختياري نص = استنسخ(مرجع_المسار);
    ليكن المسار: متغير نص = «»;
    طابق اختيار_المسار مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | اختياري.موجود(القيمة) -> { المسار := استنسخ(&القيمة); };
    ليكن بلا_واجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.لا_شيء();
    ليكن بلا_تشخيصات: مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن اللقطة: لقطة_تحليل_واجهة_لغة = {
        العنوان: استنسخ(&العنوان),
        المسار: المسار,
        الإصدار: الإصدار,
        المراجعة: المراجعة,
        الواجهة: بلا_واجهة,
        التشخيصات: بلا_تشخيصات
    };
    أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
}

// Analysis target: the registered host, exactly as `sultanc check` resolves it.
// Target-conditional declarations (std.os.io and friends) exist only for a
// concrete target; a target-neutral build rejects every file importing std.io.
عام عرف هدف_تحليل_لغة(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الوصف) -> { أرجع اختياري.موجود(الوصف); };
}

// Target-aware build through the compiler's public cancellable entry point
// (ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء), or through an incremental session
// (ابن_واجهة_في_جلسة: same arguments, same result as a full analysis). The
// first key is the analysed module; the other keys join the same module
// graph. A document request passes only its own key: its imports are loaded
// through the module graph.
// الجلسة: 0 none, 1 the project session, 2 the document session. The
// analysed root is declared open, so its edits analyse it and its importers
// only.
عرف ابن_واجهة_بهدف_لغة(
    المساحة: &مساحة_عمل_لغة,
    البيئة: بيئة_وحدات_منطقية,
    المفاتيح: &متجه مفتاح_وحدة_مقنن,
    كل_المفاتيح: منطقي,
    الجلسة: طبيعي
): نتيجة_بناء_واجهة_وحدة {
    ليكن الإلغاء: &حالة_إلغاء_واجهة = اقرأ_مشترك(&(*المساحة).الإلغاء);
    إذا ((الطول(*المفاتيح) مثل طبيعي) == 0) {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(مجموعة_تشخيصات_جديدة());
    };
    ليكن الجذر: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(&(*المفاتيح)[0]);
    ليكن الإضافية: متغير متجه مفتاح_وحدة_مقنن = [];
    إذا (كل_المفاتيح) {
        ليكن ف: متغير طبيعي = 1;
        طالما (ف < (الطول(*المفاتيح) مثل طبيعي)) {
            ألحق(الإضافية, انسخ_مفتاح_وحدة_مقنن(&(*المفاتيح)[ف]));
            ف := ف + 1;
        }
    };
    ليكن الطلب: طلب_واجهة_وحدة = {
        البيئة: البيئة,
        المفتاح_الجذري: انسخ_مفتاح_وحدة_مقنن(&الجذر),
        احتفظ_بحقائق_الأدوات: صواب
    };
    // A project with errors still comes back complete, with its diagnostics
    // and per-source completeness (docs/en/internals/tooling-api.md,
    // "Partial results"); `مرفوضة` is left for a request that cannot start.
    ليكن الناتج: متغير نتيجة_بناء_واجهة_قابلة_للإلغاء = نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة();
    إذا (الجلسة == 0) {
        الناتج := ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, هدف_تحليل_لغة(), &الإضافية, الإلغاء);
    } وإلا {
        ليكن القفل: &قفل<جلسات_تحليل_لغة> = اقرأ_مشترك(&(*المساحة).الجلسات);
        اقفل_خام(القفل);
        ليكن المؤشر: *متغير جلسات_تحليل_لغة = مؤشر_مشترك(&(*القفل).القيمة);
        ليكن المفتوحة: متجه مفتاح_وحدة_مقنن = [انسخ_مفتاح_وحدة_مقنن(&الجذر)];
        ليكن البدء: عدد = لحظة_لغة();
        ليكن الإحصاء: متغير اختياري إحصاء_طلب_جلسة = اختياري.لا_شيء();
        غير_آمن {
            إذا (الجلسة == 1) {
                عيّن_مستندات_مفتوحة_جلسة(&متغير (*المؤشر).المشروع, المفتوحة);
                الناتج := ابن_واجهة_في_جلسة(&متغير (*المؤشر).المشروع, الطلب, هدف_تحليل_لغة(), &الإضافية, الإلغاء);
                الإحصاء := اختياري.موجود(إحصاء_جلسة_تحليل(&(*المؤشر).المشروع));
            } وإلا {
                عيّن_مستندات_مفتوحة_جلسة(&متغير (*المؤشر).المستند, المفتوحة);
                الناتج := ابن_واجهة_في_جلسة(&متغير (*المؤشر).المستند, الطلب, هدف_تحليل_لغة(), &الإضافية, الإلغاء);
                الإحصاء := اختياري.موجود(إحصاء_جلسة_تحليل(&(*المؤشر).المستند));
            };
        };
        طابق الإحصاء مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(إ) -> {
            ليكن الأجزاء: متجه نص = [
                «session », طبيعي_إلى_نص(الجلسة), «: », طبيعي_إلى_نص(((لحظة_لغة() - البدء) / 1000000) مثل طبيعي), « ms, state », طبيعي_إلى_نص(إ.اللقطة),
                «, analysed », طبيعي_إلى_نص(إ.المحللة), «, reused », طبيعي_إلى_نص(إ.المعاد_استعمالها),
                «, changed », طبيعي_إلى_نص(إ.المتغيرة), «, prepared », نص_منطقي_لغة(إ.جاهزة), «, full », نص_منطقي_لغة(إ.كاملة)
            ];
            ليكن بلا: نص = «»;
            سجل_لغة(صل_النصوص(&الأجزاء, &بلا));
        };
        افتح_خام(القفل);
    };
    طابق الناتج مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة); }
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات) -> { أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات); }
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(مجموعة_تشخيصات_جديدة()); };
}

عام عرف لحظة_لغة(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// Logs «label: N ms» since البدء (SULTANC_ANALYZER_LOG).
عام عرف سجل_مدة_لغة(الوصف: نص, البدء: عدد): فراغ {
    ليكن الأجزاء: متجه نص = [الوصف, «: », طبيعي_إلى_نص(((لحظة_لغة() - البدء) / 1000000) مثل طبيعي), « ms»];
    ليكن بلا: نص = «»;
    سجل_لغة(صل_النصوص(&الأجزاء, &بلا));
}

عرف نص_منطقي_لغة(القيمة: منطقي): نص {
    إذا (القيمة) { أرجع «yes»; };
    أرجع «no»;
}

// While the server waits for input (a result shown, nothing queued): each
// session copies the kept state its next request starts from
// (جهز_جلسة_تحليل), so that request does not copy it. Nothing when a copy is
// ready or nothing is kept.
عام عرف جهز_جلسات_لغة(المساحة: &مساحة_عمل_لغة): فراغ {
    ليكن القفل: &قفل<جلسات_تحليل_لغة> = اقرأ_مشترك(&(*المساحة).الجلسات);
    اقفل_خام(القفل);
    ليكن المؤشر: *متغير جلسات_تحليل_لغة = مؤشر_مشترك(&(*القفل).القيمة);
    غير_آمن {
        جهز_جلسة_تحليل(&متغير (*المؤشر).المستند);
        جهز_جلسة_تحليل(&متغير (*المؤشر).المشروع);
    };
    افتح_خام(القفل);
}

// The library directory (the one holding std/), absolute and normalized, as
// the compiler locates it (compiler/driver/std_location.sn
// حدد_دليل_المكتبة_القياسية: $SULTANC_STD, ./library, or next to the running
// binary).
عام عرف دليل_المكتبة_القياسية_لغة(): نص {
    ليكن الدليل: متغير نص = حدد_دليل_المكتبة_القياسية();
    إذا (!مسار_مطلق(&الدليل)) {
        طابق دليل_العمل() مع
        | نتيجة.نجح(الحالي) -> { الدليل := صل_المسار(&الحالي, &الدليل); }
        | نتيجة.خطأ(_) -> { };
    };
    أرجع طبع_المسار(&الدليل);
}

// A path inside the standard library's directory. Those files are std
// modules, loaded through the std root; discovered again as project sources
// they would exist twice and the frontend rejects the project (a workspace
// opened at a SultanC checkout holds library/).
عام عرف داخل_المكتبة_القياسية_لغة(المسار: &نص, دليل_القياسية: &نص): منطقي {
    ليكن المطبع: نص = طبع_المسار(المسار);
    ليكن طول_الدليل: طبيعي = الطول(*دليل_القياسية) مثل طبيعي;
    إذا (نصان_متساويان(&المطبع, دليل_القياسية)) { أرجع صواب; };
    إذا ((الطول(المطبع) مثل طبيعي) <= طول_الدليل) { أرجع خطأ; };
    أرجع يبدأ_بـ(&المطبع, دليل_القياسية) && المطبع[طول_الدليل] == فاصل_المسار();
}

// A path inside (or equal to) a normalized directory.
عرف داخل_دليل_لغة(المسار: &نص, الدليل: &نص): منطقي {
    أرجع داخل_المكتبة_القياسية_لغة(المسار, الدليل);
}

// The Supax package (graph, package index) whose source_root holds المسار,
// the innermost one when roots nest.
عرف حزمة_لمسار_لغة(المساحة: &مساحة_عمل_لغة, المسار: &نص): اختياري مخطط_وحزمة_لغة {
    ليكن المطبع: نص = طبع_المسار(المسار);
    ليكن الناتج: متغير اختياري مخطط_وحزمة_لغة = اختياري.لا_شيء();
    ليكن أطول: متغير طبيعي = 0;
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول((*المساحة).المخططات) مثل طبيعي)) {
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*المساحة).المخططات[م].الحزم) مثل طبيعي)) {
            ليكن الجذر: &نص = &(*المساحة).المخططات[م].الحزم[ح].الجذر;
            إذا (داخل_دليل_لغة(&المطبع, الجذر) && (الطول(*الجذر) مثل طبيعي) > أطول) {
                أطول := الطول(*الجذر) مثل طبيعي;
                ليكن القيمة: مخطط_وحزمة_لغة = { المخطط: م, الحزمة: ح };
                الناتج := اختياري.موجود(القيمة);
            };
            ح := ح + 1;
        }
        م := م + 1;
    }
    أرجع الناتج;
}

عام نوع مخطط_وحزمة_لغة = { المخطط: طبيعي, الحزمة: طبيعي };

// The package graph text for compiling المسار (its package as `root`), when
// it lies in a Supax package: what `sultanc test --package-graph=-` reads.
عام عرف نص_مخطط_لمسار_لغة(المساحة: &مساحة_عمل_لغة, المسار: &نص): اختياري نص {
    طابق حزمة_لمسار_لغة(المساحة, المسار) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        ليكن المخطط: &مخطط_حزم_لغة = &(*المساحة).المخططات[القيمة.المخطط];
        أرجع اختياري.موجود(نص_مخطط_بجذر_لغة(المخطط, &(*المخطط).الحزم[القيمة.الحزمة].المعرف));
    };
}

// The compiler setup of a project, from the files the server lists (std
// directory excluded) and the open documents, each once.
// - In a Supax package: the package graph from `supax metadata`, with `root`
//   set to the package that holds الدخول
//   (ابن_إعداد_تجميع_مباشر_مفصل_برسم_نصي). The inputs are that package's
//   files; other packages are reached through their imports.
// - Otherwise a standalone compilation (ابن_إعداد_تجميع_مباشر).
عرف ابن_إعداد_مشروع_لغة(
    المساحة: &مساحة_عمل_لغة,
    الدخول: &نص,
    الجذور: &متجه نص,
    المفتوحة: &متجه نص,
    المستبعدة: &متجه نص
): نتيجة_إعداد_تجميع_مباشر {
    ليكن القياسية: نص = دليل_المكتبة_القياسية_لغة();
    ليكن الدخول_المطبع: نص = طبع_المسار(الدخول);
    ليكن الإضافية: متغير متجه نص = [];
    ليكن المطبعة: متغير متجه نص = [];
    ليكن المرشحة: متغير متجه نص = [];
    ليكن الحزمة: اختياري مخطط_وحزمة_لغة = حزمة_لمسار_لغة(المساحة, الدخول);
    ليكن جذر_الحزمة: متغير نص = «»;
    طابق الحزمة مع
    | اختياري.لا_شيء -> { المرشحة := اسرد_مصادر_مشروع_لغة(الجذور); }
    | اختياري.موجود(القيمة) -> {
        جذر_الحزمة := استنسخ(&(*المساحة).المخططات[القيمة.المخطط].الحزم[القيمة.الحزمة].الجذر);
        // The package's files within the project roots: a root inside the
        // package (a subfolder opened alone) limits the listing to it.
        ليكن جذور_الحزمة: متغير متجه نص = [];
        ليكن ج: متغير طبيعي = 0;
        طالما (ج < (الطول(*الجذور) مثل طبيعي)) {
            ليكن الجذر: نص = طبع_المسار(&(*الجذور)[ج]);
            إذا (داخل_دليل_لغة(&الجذر, &جذر_الحزمة)) { ألحق(جذور_الحزمة, الجذر); }
            وإلا إذا (داخل_دليل_لغة(&جذر_الحزمة, &الجذر)) { ألحق(جذور_الحزمة, استنسخ(&جذر_الحزمة)); };
            ج := ج + 1;
        }
        // No roots (a document analysed alone): the file is the only input.
        المرشحة := اسرد_مصادر_مشروع_لغة(&جذور_الحزمة);
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفتوحة) مثل طبيعي)) {
        ألحق(المرشحة, استنسخ(&(*المفتوحة)[ف]));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(المرشحة) مثل طبيعي)) {
        ليكن المسار: &نص = &المرشحة[ف];
        ليكن المطبع: نص = طبع_المسار(المسار);
        ليكن في_الحزمة: منطقي = (الطول(جذر_الحزمة) مثل طبيعي) == 0 || داخل_دليل_لغة(&المطبع, &جذر_الحزمة);
        إذا (في_الحزمة
            && !نصان_متساويان(&المطبع, &الدخول_المطبع)
            && !داخل_المكتبة_القياسية_لغة(المسار, &القياسية)
            && !نص_في_قائمة_لغة(المستبعدة, &المطبع)
            && !نص_في_قائمة_لغة(&المطبعة, &المطبع)) {
            ألحق(المطبعة, المطبع);
            ألحق(الإضافية, استنسخ(المسار));
        };
        ف := ف + 1;
    }
    طابق الحزمة مع
    | اختياري.لا_شيء -> { أرجع ابن_إعداد_تجميع_مباشر(الدخول, &الإضافية); }
    | اختياري.موجود(القيمة) -> {
        ليكن المخطط: &مخطط_حزم_لغة = &(*المساحة).المخططات[القيمة.المخطط];
        ليكن النص: نص = نص_مخطط_بجذر_لغة(المخطط, &(*المخطط).الحزم[القيمة.الحزمة].المعرف);
        ليكن اسم_المخطط: نص = مسار_ملف_المخطط_لغة(المخطط);
        طابق ابن_إعداد_تجميع_مباشر_مفصل_برسم_نصي(الدخول, &الإضافية, &اسم_المخطط, &النص) مع
        | نتيجة_إعداد_تجميع_مباشر_مفصلة.جاهز(الإعداد) -> { أرجع نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد); }
        | _ -> {
            سجل_لغة(«package graph setup rejected»);
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        };
    };
}

عرف نص_في_قائمة_لغة(القائمة: &متجه نص, النص: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القائمة)[ف], النص)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// SULTANC_ANALYZER_LOG=1 writes analysis decisions to stderr (editors show it in
// the server's output channel). Off by default.
عام عرف سجل_مفعل_لغة(): منطقي {
    ليكن الاسم: نص = «SULTANC_ANALYZER_LOG»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع (الطول(القيمة) مثل طبيعي) > 0; }
    | _ -> { أرجع خطأ; };
}

عام عرف سجل_لغة(الرسالة: نص): فراغ {
    إذا (!سجل_مفعل_لغة()) { أرجع; };
    ليكن البادئة: نص = «sultanc-analyzer: »;
    ليكن الأجزاء: متجه نص = [البادئة, الرسالة, "\n"];
    ليكن بلا: نص = «»;
    اطبع_خطأ(صل_النصوص(&الأجزاء, &بلا));
}

عرف سجل_تشخيصات_لغة(العنوان: نص, المجموعة: &مجموعة_تشخيصات): فراغ {
    إذا (!سجل_مفعل_لغة()) { أرجع; };
    ليكن الأجزاء: متغير متجه نص = [العنوان, «: », طبيعي_إلى_نص(الطول((*المجموعة).التشخيصات) مثل طبيعي), « diagnostics»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعة).التشخيصات) مثل طبيعي) && ف < 5) {
        ليكن التعريف: تعريف_تشخيص = تعريف_التشخيص((*المجموعة).التشخيصات[ف].المعرف);
        ألحق(الأجزاء, "\n  ");
        ألحق(الأجزاء, استنسخ(&التعريف.الكود));
        طابق استنسخ(&(*المجموعة).التشخيصات[ف].المصدر_الرئيسي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المصدر) -> {
            طابق استنسخ(&المصدر.اسم_المصدر) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الاسم) -> { ألحق(الأجزاء, « »); ألحق(الأجزاء, الاسم); };
        };
        ف := ف + 1;
    }
    ليكن بلا: نص = «»;
    سجل_لغة(صل_النصوص(&الأجزاء, &بلا));
}

// Project-wide requests (references, rename, workspace symbols) analyse the
// whole project once per workspace revision. Measured on the 2026-11-12
// checkpoint: the compiler itself (462 files, 237k lines) 3.1-4.1 s cold, a
// whole SultanC checkout (2221 files) 13 s cold, 0 s warm. The previous cap
// of 300 files answered from the open documents instead, which misses every
// reference in a closed file, so there is no cap by default.
// SULTANC_ANALYZER_MAX_PROJECT_FILES=N restores one (0 or unset: no cap).
عرف حد_مصادر_المشروع_لغة(): اختياري طبيعي {
    ليكن الاسم: نص = «SULTANC_ANALYZER_MAX_PROJECT_FILES»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        طابق حلل_طبيعي(&القيمة) مع
        | نتيجة.نجح(العدد) -> { إذا (العدد > 0) { أرجع اختياري.موجود(العدد); }; }
        | نتيجة.خطأ(_) -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// Bounded source count: stops as soon as the limit is exceeded and skips
// folders that never hold project sources (hidden folders, build output,
// node_modules), so a folder of many projects costs at most `limit` files.
عرف عد_مصادر_دليل_محدود_لغة(الدليل: &نص, العدد: &متغير طبيعي, الحد: طبيعي): فراغ {
    إذا (*العدد > الحد) { أرجع; };
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المدخلات) -> {
        ليكن ف: متغير طبيعي = 0;
        ليكن اللاحقة: نص = «.sn»;
        ليكن نقطة: نص = «.»;
        ليكن بناء: نص = «build»;
        ليكن وحدات_نود: نص = «node_modules»;
        طالما ((ف < (الطول(المدخلات) مثل طبيعي)) && (*العدد <= الحد)) {
            ليكن الاسم: &نص = &المدخلات[ف].الاسم;
            طابق المدخلات[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                إذا (!(يبدأ_بـ(الاسم, &نقطة) || نصان_متساويان(الاسم, &بناء) || نصان_متساويان(الاسم, &وحدات_نود))) {
                    ليكن المسار: نص = صل_المسار(الدليل, الاسم);
                    عد_مصادر_دليل_محدود_لغة(&المسار, العدد, الحد);
                };
            }
            | نوع_مدخل_دليل.ملف -> {
                إذا (ينتهي_بـ(الاسم, &اللاحقة)) { *العدد := *العدد + 1; };
            }
            | _ -> { };
            ف := ف + 1;
        }
    };
}

// The project's source files: every `.sn` file under the roots (the Supax
// graph's source roots, or the workspace folders without Supax), found by
// the server (the compiler does not discover projects). Not listed: the std
// directory (its files are std modules), hidden folders, `build` (Supax and
// compiler output), `node_modules`, and symbolic links. Each path once.
عرف اجمع_مصادر_دليل_لغة(الدليل: &نص, القياسية: &نص, الناتج: &متغير متجه نص, المرئية: &متغير متجه نص): فراغ {
    إذا (داخل_المكتبة_القياسية_لغة(الدليل, القياسية)) { أرجع; };
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المدخلات) -> {
        ليكن اللاحقة: نص = «.sn»;
        ليكن نقطة: نص = «.»;
        ليكن بناء: نص = «build»;
        ليكن وحدات_نود: نص = «node_modules»;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
            ليكن الاسم: &نص = &المدخلات[ف].الاسم;
            ليكن المسار: نص = صل_المسار(الدليل, الاسم);
            طابق المدخلات[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                إذا (!(يبدأ_بـ(الاسم, &نقطة) || نصان_متساويان(الاسم, &بناء) || نصان_متساويان(الاسم, &وحدات_نود))) {
                    اجمع_مصادر_دليل_لغة(&المسار, القياسية, الناتج, المرئية);
                };
            }
            | نوع_مدخل_دليل.ملف -> {
                إذا (ينتهي_بـ(الاسم, &اللاحقة)) {
                    ليكن المطبع: نص = طبع_المسار(&المسار);
                    إذا (!نص_في_قائمة_لغة(&*المرئية, &المطبع)) {
                        ألحق(*المرئية, استنسخ(&المطبع));
                        ألحق(*الناتج, المطبع);
                    };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
    };
}

عام عرف اسرد_مصادر_مشروع_لغة(الجذور: &متجه نص): متجه نص {
    ليكن القياسية: نص = دليل_المكتبة_القياسية_لغة();
    ليكن الناتج: متغير متجه نص = [];
    ليكن المرئية: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجذور) مثل طبيعي)) {
        ليكن الجذر: نص = طبع_المسار(&(*الجذور)[ف]);
        اجمع_مصادر_دليل_لغة(&الجذر, &القياسية, &متغير الناتج, &متغير المرئية);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مشروع_ضمن_الحد_لغة(الجذور: &متجه نص): منطقي {
    ليكن الحد: متغير طبيعي = 0;
    طابق حد_مصادر_المشروع_لغة() مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(القيمة) -> { الحد := القيمة; };
    ليكن العدد: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجذور) مثل طبيعي)) {
        عد_مصادر_دليل_محدود_لغة(&(*الجذور)[ف], &متغير العدد, الحد);
        ف := ف + 1;
    }
    أرجع العدد <= الحد;
}

// جميع overlays المفتوحة تدخل البيئة نفسها قبل التحليل. هذا لا يعيد بناء Module
// ولا Source identity داخل LSP؛ إنه يزود Source Provider المقنن بأحدث بايتات المحرر فقط.
عرف ضع_تراكبات_مساحة_العمل_في_البيئة(
    المساحة: &مساحة_عمل_لغة,
    البيئة: &متغير بيئة_وحدات_منطقية,
    نسبي: منطقي
): فراغ {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المستندات) مثل طبيعي)) {
        طابق الحالة.المستندات[ف] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المستند) -> {
            ليكن مرجع_النص: &نص = &المستند.النص;
            ليكن نسخة_النص: نص = استنسخ(مرجع_النص);
            ليكن مرجع_مسار_الملف: &اختياري نص = &المستند.مسار_الملف;
            ليكن نسخة_مسار_الملف: اختياري نص = استنسخ(مرجع_مسار_الملف);
            طابق نسخة_مسار_الملف مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المسار) -> {
                ليكن مسار_التراكب: متغير نص = استنسخ(&المسار);
                إذا (نسبي) { مسار_التراكب := مسار_للمترجم_لغة(&المسار); };
                ضع_تراكب_مصدر_في_البيئة(البيئة, مسار_التراكب, استنسخ(&نسخة_النص));
            };
        };
        ف := ف + 1;
    }
}

عرف مسارات_مصادر_مفتوحة_إضافية(
    المساحة: &مساحة_عمل_لغة,
    نسبي: منطقي
): متجه نص {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المستندات) مثل طبيعي)) {
        طابق الحالة.المستندات[ف] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المستند) -> {
            طابق المستند.مسار_الملف مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(مسار_المستند) -> {
                إذا (نسبي) { ألحق(الناتج, مسار_للمترجم_لغة(&مسار_المستند)); }
                وإلا { ألحق(الناتج, استنسخ(&مسار_المستند)); };
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Direct mode (no project roots, or a project above the file limit) mirrors
// `sultanc check <file>`: the document alone, by its checkout-relative name
// when inside the working directory; other open documents reach the
// environment as overlays only.
عرف تحليل_مستند_مباشر_لغة(جذور_المشروع: &متجه نص): منطقي {
    أرجع (الطول(*جذور_المشروع) مثل طبيعي) == 0 || !مشروع_ضمن_الحد_لغة(جذور_المشروع);
}

// The compiler setup for analysing one open document (المسار: its file path),
// and whether its source names are checkout-relative (direct mode without a
// package graph, as `sultanc check <file>` names them).
// - With project roots: the project setup (ابن_إعداد_مشروع_لغة).
// - Direct, in a Supax package: the package graph rooted at the file's
//   package, the file alone as input.
// - Direct otherwise: a standalone compilation of the file.
عام نوع إعداد_مستند_لغة_ناتج = { الإعداد: نتيجة_إعداد_تجميع_مباشر, نسبي: منطقي };

عرف إعداد_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    المسار: &نص,
    جذور_المشروع: &متجه نص
): إعداد_مستند_لغة_ناتج {
    ليكن بلا_إضافية: متجه نص = [];
    ليكن بلا_مستبعدة: متجه نص = [];
    إذا (!تحليل_مستند_مباشر_لغة(جذور_المشروع)) {
        ليكن الإضافية: متجه نص = مسارات_مصادر_مفتوحة_إضافية(المساحة, خطأ);
        ليكن الناتج: إعداد_مستند_لغة_ناتج = { الإعداد: ابن_إعداد_مشروع_لغة(المساحة, المسار, جذور_المشروع, &الإضافية, &بلا_مستبعدة), نسبي: خطأ };
        أرجع الناتج;
    };
    طابق حزمة_لمسار_لغة(المساحة, المسار) مع
    | اختياري.موجود(_) -> {
        // The package's own root keeps the listing to the file itself.
        ليكن الجذر_الوحيد: متجه نص = [];
        ليكن الناتج: إعداد_مستند_لغة_ناتج = { الإعداد: ابن_إعداد_مشروع_لغة(المساحة, المسار, &الجذر_الوحيد, &بلا_إضافية, &بلا_مستبعدة), نسبي: خطأ };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    ليكن مسار_المترجم: نص = مسار_للمترجم_لغة(المسار);
    ليكن الناتج: إعداد_مستند_لغة_ناتج = { الإعداد: ابن_إعداد_تجميع_مباشر(&مسار_المترجم, &بلا_إضافية), نسبي: صواب };
    أرجع الناتج;
}

// Completion at the cursor (compiler/frontend/tooling_completion.sn). The
// compiler patches the text (the unfinished statement removed, brackets
// closed). Import and module paths are answered from the module environment;
// names and members from an analysis of the patched text as the document's
// unsaved buffer (analysis/semantic_queries.sn asks the interface).
عام نوع تحليل_إكمال_لغة = {
    الرقعة: رقعة_إكمال,
    البيئة: بيئة_وحدات_منطقية,
    // None for a path or nothing context, or when the patched text could not
    // be analysed.
    الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة>
};

عام عرف حلل_للإكمال_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص,
    البايت: طبيعي
): اختياري تحليل_إكمال_لغة {
    ليكن الرقعة: رقعة_إكمال = رقع_مصدر_للإكمال(&(*المستند).النص, البايت);
    ليكن المسار: متغير نص = «»;
    طابق استنسخ(&(*المستند).مسار_الملف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المسار := القيمة; };
    ليكن ناتج_الإعداد: إعداد_مستند_لغة_ناتج = إعداد_مستند_لغة(المساحة, &المسار, جذور_المشروع);
    ليكن مباشر: منطقي = ناتج_الإعداد.نسبي;
    طابق استنسخ(&ناتج_الإعداد.الإعداد) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        ليكن يحلل: منطقي = الرقعة.السياق == سياق_إكمال.اسم()
            || الرقعة.السياق == سياق_إكمال.عضو_قيمة()
            || الرقعة.السياق == سياق_إكمال.عضو_نوع()
            || الرقعة.السياق == سياق_إكمال.موضع_نوع()
            || الرقعة.السياق == سياق_إكمال.حقل_سجل()
            || الرقعة.السياق == سياق_إكمال.حالة_مطابقة()
            || الرقعة.السياق == سياق_إكمال.معامل_استدعاء();
        إذا (!يحلل) {
            ليكن الناتج: تحليل_إكمال_لغة = { الرقعة: الرقعة, البيئة: انسخ_بيئة_لغة(&الإعداد.البيئة), الواجهة: اختياري.لا_شيء() };
            أرجع اختياري.موجود(الناتج);
        };
        ليكن البيئة: متغير بيئة_وحدات_منطقية = انسخ_بيئة_لغة(&الإعداد.البيئة);
        ليكن المفاتيح: متجه مفتاح_وحدة_مقنن = استنسخ(&الإعداد.المفاتيح_المباشرة);
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير البيئة, مباشر);
        ليكن مسار_التراكب: متغير نص = استنسخ(&المسار);
        إذا (مباشر) { مسار_التراكب := مسار_للمترجم_لغة(&المسار); };
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, مسار_التراكب, استنسخ(&الرقعة.النص));
        ليكن الواجهة: متغير اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.لا_شيء();
        طابق ابن_واجهة_بهدف_لغة(المساحة, البيئة, &المفاتيح, خطأ, 2) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(_) -> { }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(القيمة) -> { الواجهة := اختياري.موجود(أنشئ_مشترك(القيمة)); };
        ليكن الناتج: تحليل_إكمال_لغة = { الرقعة: الرقعة, البيئة: انسخ_بيئة_لغة(&الإعداد.البيئة), الواجهة: الواجهة };
        أرجع اختياري.موجود(الناتج);
    };
}

عرف حلل_واجهة_مستند_لغة_بجذور(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_واجهة_لغة {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مرجع_العنوان: &نص = &د.العنوان;
    ليكن العنوان: نص = استنسخ(مرجع_العنوان);
    ليكن الإصدار: عدد = د.الإصدار;
    ليكن المراجعة: طبيعي = د.المراجعة;
    ليكن المسار: متغير نص = «»;
    طابق د.مسار_الملف مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | اختياري.موجود(القيمة) -> { المسار := استنسخ(&القيمة); };

    ليكن ناتج_الإعداد: إعداد_مستند_لغة_ناتج = إعداد_مستند_لغة(المساحة, &المسار, جذور_المشروع);
    ليكن مباشر: منطقي = ناتج_الإعداد.نسبي;
    ليكن إعداد_المشروع: نتيجة_إعداد_تجميع_مباشر = استنسخ(&ناتج_الإعداد.الإعداد);
    طابق إعداد_المشروع مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الإعداد.البيئة;
        ليكن البيئة: متغير بيئة_وحدات_منطقية = انسخ_بيئة_لغة(مرجع_البيئة);
        ليكن مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الإعداد.المفاتيح_المباشرة;
        ليكن المفاتيح_الجذرية: متجه مفتاح_وحدة_مقنن = استنسخ(مرجع_المفاتيح);
        // كل مستند مفتوح يحتفظ بهوية Source/Module نفسها؛ التراكب يغير المحتوى فقط.
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير البيئة, مباشر);

        طابق ابن_واجهة_بهدف_لغة(المساحة, البيئة, &المفاتيح_الجذرية, خطأ, 2) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            ليكن واجهة_غير_متاحة: اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.لا_شيء();
            ليكن اللقطة: لقطة_تحليل_واجهة_لغة = {
                العنوان: العنوان,
                المسار: المسار,
                الإصدار: الإصدار,
                المراجعة: المراجعة,
                الواجهة: واجهة_غير_متاحة,
                التشخيصات: التشخيصات
            };
            أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
        }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            // Tooling recovery may return a useful partial semantic interface together
            // with canonical compiler diagnostics. Preserve both; LSP must not turn a
            // recovered snapshot into an apparently clean document.
            ليكن تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
            ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &الواجهة.تشخيصات_الأدوات);
            ليكن واجهة_متاحة: اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.موجود(أنشئ_مشترك(الواجهة));
            ليكن اللقطة: لقطة_تحليل_واجهة_لغة = {
                العنوان: العنوان,
                المسار: المسار,
                الإصدار: الإصدار,
                المراجعة: المراجعة,
                الواجهة: واجهة_متاحة,
                التشخيصات: تشخيصات_الأدوات
            };
            أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
        };
    };
}

عام عرف حلل_واجهة_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح
): نتيجة_تحليل_واجهة_لغة {
    ليكن بلا_جذور: متجه نص = [];
    أرجع حلل_واجهة_مستند_لغة_بجذور(المساحة, المستند, &بلا_جذور);
}

عام عرف حلل_واجهة_مستند_لغة_في_مشروع(
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_واجهة_لغة {
    أرجع حلل_واجهة_مستند_لغة_بجذور(المساحة, المستند, جذور_المشروع);
}

// Project-wide semantic analysis for requests that are not anchored to an open
// document (for example workspace symbols). Source discovery remains compiler
// Driver ownership; open editor overlays are applied to the same canonical environment.
عام نوع نتيجة_تحليل_مشروع_لغة =
    | مكتملة بنوع مشترك<نتيجة_واجهة_وحدة>
    | مرفوضة بنوع مجموعة_تشخيصات
    | غير_قابل_للتحليل
;

عام نوع نتيجة_اكتشاف_مصادر_مشروع_لغة =
    | مكتملة بنوع متجه نص
    | فشل
;

عام عرف اكتشف_مسارات_مصادر_مشروع_لغة(
    جذور_المشروع: &متجه نص
): نتيجة_اكتشاف_مصادر_مشروع_لغة {
    أرجع نتيجة_اكتشاف_مصادر_مشروع_لغة.مكتملة(اسرد_مصادر_مشروع_لغة(جذور_المشروع));
}

// A workspace folder holding several projects (or compiler checkouts) is too
// large to analyse per request on a single-threaded server: above the limit,
// project-wide queries cover the open documents and their imports.
عرف حلل_مفتوحة_فقط_لغة(
    المساحة: &مساحة_عمل_لغة,
    المفتوحة: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    إذا ((الطول(*المفتوحة) مثل طبيعي) == 0) {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    };
    ليكن دخول_مفتوح: نص = استنسخ(&(*المفتوحة)[0]);
    طابق ابن_إعداد_تجميع_مباشر(&دخول_مفتوح, المفتوحة) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(إعداد_محدود) -> {
        ليكن بيئة_محدودة: متغير بيئة_وحدات_منطقية = انسخ_بيئة_لغة(&إعداد_محدود.البيئة);
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير بيئة_محدودة, صواب);
        ليكن مفاتيح_محدودة: متجه مفتاح_وحدة_مقنن = استنسخ(&إعداد_محدود.المفاتيح_المباشرة);
        طابق ابن_واجهة_بهدف_لغة(المساحة, بيئة_محدودة, &مفاتيح_محدودة, صواب, 0) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> { أرجع نتيجة_تحليل_مشروع_لغة.مرفوضة(التشخيصات); }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> { أرجع نتيجة_تحليل_مشروع_لغة.مكتملة(أنشئ_مشترك(الواجهة)); };
    };
}

عام عرف حلل_واجهة_مشروع_لغة(
    المساحة: &مساحة_عمل_لغة,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    ليكن الجذور: متجه نص = *جذور_المشروع;
    إذا ((الطول(الجذور) مثل طبيعي) == 0) {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    };
    ليكن ضمن_الحد: منطقي = مشروع_ضمن_الحد_لغة(&الجذور);
    ليكن المكتشفة: متغير متجه نص = [];
    إذا (!ضمن_الحد) {
        ليكن المفتوحة_للحد: متجه نص = مسارات_مصادر_مفتوحة_إضافية(المساحة, صواب);
        أرجع حلل_مفتوحة_فقط_لغة(المساحة, &المفتوحة_للحد);
    };
    المكتشفة := اسرد_مصادر_مشروع_لغة(&الجذور);
    إذا ((الطول(المكتشفة) مثل طبيعي) == 0) {
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    };
    ليكن المفتوحة: متجه نص = مسارات_مصادر_مفتوحة_إضافية(المساحة, خطأ);
    ليكن الدخول: متغير نص = «»;
    إذا ((الطول(المفتوحة) مثل طبيعي) > 0) {
        ليكن مرجع_الدخول_المفتوح: &نص = &المفتوحة[0];
        الدخول := استنسخ(مرجع_الدخول_المفتوح);
    } وإلا {
        ليكن مرجع_الدخول_المكتشف: &نص = &المكتشفة[0];
        الدخول := استنسخ(مرجع_الدخول_المكتشف);
    };
    ليكن بلا_مستبعدة: متجه نص = [];
    أرجع حلل_مشروع_بإعداد_لغة(المساحة, &الدخول, &الجذور, &المفتوحة, &بلا_مستبعدة);
}

عرف حلل_مشروع_بإعداد_لغة(
    المساحة: &مساحة_عمل_لغة,
    الدخول: &نص,
    الجذور: &متجه نص,
    المفتوحة: &متجه نص,
    المستبعدة: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    ليكن البدء: عدد = لحظة_لغة();
    ليكن الإعداد_الناتج: نتيجة_إعداد_تجميع_مباشر = ابن_إعداد_مشروع_لغة(المساحة, الدخول, الجذور, المفتوحة, المستبعدة);
    سجل_مدة_لغة(«project setup», البدء);
    طابق الإعداد_الناتج مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        سجل_لغة(«project setup rejected»);
        أرجع نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل();
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الإعداد.البيئة;
        ليكن البيئة: متغير بيئة_وحدات_منطقية = انسخ_بيئة_لغة(مرجع_البيئة);
        ضع_تراكبات_مساحة_العمل_في_البيئة(المساحة, &متغير البيئة, خطأ);
        ليكن مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الإعداد.المفاتيح_المباشرة;
        ليكن المفاتيح: متجه مفتاح_وحدة_مقنن = استنسخ(مرجع_المفاتيح);
        سجل_مدة_لغة(«project environment», البدء);
        طابق ابن_واجهة_بهدف_لغة(المساحة, البيئة, &المفاتيح, صواب, 1) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            سجل_تشخيصات_لغة(«project analysis rejected», &التشخيصات);
            أرجع نتيجة_تحليل_مشروع_لغة.مرفوضة(التشخيصات);
        }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            سجل_تشخيصات_لغة(«project analysis complete», &الواجهة.تشخيصات_الأدوات);
            أرجع نتيجة_تحليل_مشروع_لغة.مكتملة(أنشئ_مشترك(الواجهة));
        };
    };
}

// Whether the request being answered was cancelled: its analysis may have
// stopped early, so its result is neither cached nor answered as current.
عام عرف طلب_ملغى_لغة(المساحة: &مساحة_عمل_لغة): منطقي {
    أرجع هل_واجهة_ملغاة(اقرأ_مشترك(&(*المساحة).الإلغاء));
}
