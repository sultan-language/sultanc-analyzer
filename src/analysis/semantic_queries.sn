// Workspace symbols: the compiler's module-level declarations
// (tooling_queries.sn رموز_عليا_واجهة: functions, external functions, type
// aliases, records, enums and their constructors, module values).
عام عرف رموز_واجهة_مشروع_دلالية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه رمز_معلن_لغة {
    ليكن الناتج: متغير متجه رمز_معلن_لغة = [];
    ليكن العليا: متجه رمز_أعلى_دلالي = رموز_عليا_واجهة(الواجهة);
    // The workspace's own symbols, as rust-analyzer's default workspace
    // scope: declarations of the standard library (library/std, alloc, core)
    // are left out.
    ليكن القياسية: نص = دليل_المكتبة_القياسية_لغة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العليا) مثل طبيعي)) {
        ليكن من_القياسية: متغير منطقي = خطأ;
        طابق مصدر_واجهة_بمعرف(الواجهة, (العليا[ف].الرمز.نطاق_الاسم.البداية.المصدر مثل طبيعي)) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المصدر) -> {
            ليكن المسار: نص = طبع_المسار(&مسار_مطلق_لغة(&المصدر.الاسم));
            من_القياسية := داخل_المكتبة_القياسية_لغة(&المسار, &القياسية);
        };
        إذا (من_القياسية) { ف := ف + 1; تابع_حلقة; };
        طابق حول_رمز_واجهة_إلى_لغة(الواجهة, &العليا[ف].الرمز) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            ليكن المعلن: متغير رمز_معلن_لغة = الرمز;
            طابق العليا[ف].الحاوية مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الحاوية) -> {
                طابق تصريح_رمز_واجهة(الواجهة, الحاوية) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(رمز_الحاوية) -> { المعلن.الحاوية := اسم_رمز_من_واجهة_لغة(الواجهة, &رمز_الحاوية); };
            };
            ألحق(الناتج, المعلن);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Hierarchy adapters remain protocol-neutral: compiler SymbolIDs and call edges
// decide semantic identity; this layer only converts canonical source facts to
// URI/UTF-16 locations.
عام نوع مجموعة_استدعاء_هرمي_لغة = {
    الرمز: معرف_رمز,
    العنصر: رمز_معلن_لغة,
    النطاقات: متجه نطاق_تغيير_لغة
};

عرف هل_رمز_دالة_لغة(النوع: نوع_تصريح): منطقي {
    أرجع النوع == نوع_تصريح.دالة() || النوع == نوع_تصريح.دالة_خارجية();
}

عرف هل_رمز_نوع_لغة(النوع: نوع_تصريح): منطقي {
    أرجع النوع == نوع_تصريح.مرادف_نوع()
        || النوع == نوع_تصريح.سجل()
        || النوع == نوع_تصريح.معتم()
        || النوع == نوع_تصريح.تعداد();
}

عرف رمز_واجهة_عند_موقع_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): اختياري معرف_رمز {
    ليكن المسار: متغير نص = «»;
    طابق عنوان_ملف_إلى_مسار(العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { المسار := القيمة; };
    ليكن المصدر: متغير طبيعي = 0;
    طابق معرف_مصدر_واجهة_باسم(الواجهة, &المسار) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        ليكن الفهرس: فهرس_سطور = ابن_فهرس_السطور(&القيمة.المحتوى);
        ليكن موضع16: موضع_نصي_يوتيف16 = { السطر: الموضع.السطر, العمود: الموضع.المحرف };
        طابق موضع_نصي_يوتيف16_إلى_إزاحة_بايت(&القيمة.المحتوى, &الفهرس, &موضع16) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(البايت) -> { أرجع رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت); };
    };
}

عرف عنصر_رمز_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري رمز_معلن_لغة {
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التصريح) -> { أرجع حول_رمز_واجهة_إلى_لغة(الواجهة, &التصريح); };
}

عام عرف حضر_هرم_استدعاء_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري رمز_معلن_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التصريح) -> {
                إذا (!هل_رمز_دالة_لغة(التصريح.النوع)) { أرجع اختياري.لا_شيء(); };
                أرجع حول_رمز_واجهة_إلى_لغة(الواجهة, &التصريح);
            };
        };
    };
}

عام عرف حضر_هرم_نوع_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري رمز_معلن_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التصريح) -> {
                إذا (!هل_رمز_نوع_لغة(التصريح.النوع)) { أرجع اختياري.لا_شيء(); };
                أرجع حول_رمز_واجهة_إلى_لغة(الواجهة, &التصريح);
            };
        };
    };
}

عرف حول_رموز_هرم_نوع_إلى_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرموز: &متجه معرف_رمز
): متجه رمز_معلن_لغة {
    ليكن المدخل: متجه معرف_رمز = *الرموز;
    ليكن الناتج: متغير متجه رمز_معلن_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المدخل) مثل طبيعي)) {
        طابق عنصر_رمز_واجهة_لغة(الواجهة, المدخل[ف]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(العنصر) -> { ألحق(الناتج, العنصر); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنواع_عليا_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه رمز_معلن_لغة {
    ليكن الفارغ: متجه رمز_معلن_لغة = [];
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختياري.لا_شيء -> { أرجع الفارغ; }
    | اختياري.موجود(الرمز) -> {
        ليكن الرموز: متجه معرف_رمز = أنواع_عليا_لرمز_واجهة(الواجهة, الرمز);
        أرجع حول_رموز_هرم_نوع_إلى_لغة(الواجهة, &الرموز);
    };
}

عام عرف أنواع_فرعية_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه رمز_معلن_لغة {
    ليكن الفارغ: متجه رمز_معلن_لغة = [];
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختياري.لا_شيء -> { أرجع الفارغ; }
    | اختياري.موجود(الرمز) -> {
        ليكن الرموز: متجه معرف_رمز = أنواع_فرعية_لرمز_واجهة(الواجهة, الرمز);
        أرجع حول_رموز_هرم_نوع_إلى_لغة(الواجهة, &الرموز);
    };
}

عرف أضف_حافة_إلى_مجموعات_هرمية(
    الواجهة: &نتيجة_واجهة_وحدة,
    المجموعات: &متغير متجه مجموعة_استدعاء_هرمي_لغة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): فراغ {
    ليكن موضع_فارغ_بداية: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن موضع_فارغ_نهاية: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن نطاق_لغة: متغير نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_بداية,
        النهاية: موضع_فارغ_نهاية
    };
    طابق موقع_نطاق_واجهة_لغة(الواجهة, النطاق) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(الموقع) -> { نطاق_لغة := الموقع.النطاق; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعات)) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*المجموعات)[ف].الرمز, الرمز)) {
            ألحق((*المجموعات)[ف].النطاقات, نطاق_لغة);
            أرجع;
        };
        ف := ف + 1;
    }
    طابق عنصر_رمز_واجهة_لغة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(العنصر) -> {
        ليكن النطاقات: متجه نطاق_تغيير_لغة = [نطاق_لغة];
        ليكن المجموعة: مجموعة_استدعاء_هرمي_لغة = {
            الرمز: الرمز,
            العنصر: العنصر,
            النطاقات: النطاقات
        };
        ألحق(*المجموعات, المجموعة);
    };
}

عام عرف استدعاءات_واردة_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه مجموعة_استدعاء_هرمي_لغة {
    ليكن الناتج: متغير متجه مجموعة_استدعاء_هرمي_لغة = [];
    ليكن الهدف: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الرمز) -> { الهدف := الرمز; };
    ليكن الحواف: متجه حافة_استدعاء_دلالية = استدعاءات_واردة_رمز_واجهة(الواجهة, الهدف);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        ليكن الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        أضف_حافة_إلى_مجموعات_هرمية(الواجهة, &متغير الناتج, الحافة.المستدعي, الحافة.النطاق);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف استدعاءات_صادرة_هرمية_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة
): متجه مجموعة_استدعاء_هرمي_لغة {
    ليكن الناتج: متغير متجه مجموعة_استدعاء_هرمي_لغة = [];
    ليكن الهدف: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_واجهة_عند_موقع_لغة(الواجهة, العنوان, الموضع) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الرمز) -> { الهدف := الرمز; };
    ليكن الحواف: متجه حافة_استدعاء_دلالية = استدعاءات_صادرة_رمز_واجهة(الواجهة, الهدف);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        ليكن الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        أضف_حافة_إلى_مجموعات_هرمية(الواجهة, &متغير الناتج, الحافة.المستدعى, الحافة.النطاق);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// ---- Inlay hints: parameter names at call sites -------------------------------
// As rust-analyzer and clangd show them: `scale(value: total, factor: 2)`.
// Calls come from the compiler's classified occurrences (a function name
// followed by `(`); arguments are split on top-level commas of the source.

// `نوع_التلميح` follows LSP InlayHintKind: 1 type, 2 parameter.
عام نوع تلميح_مضمن_لغة = {
    الموضع: موضع_تغيير_لغة,
    النص: نص,
    نوع_التلميح: طبيعي
};

// True when the bytes ending at `النهاية` (after skipping blanks) are the word
// `الكلمة` standing on its own; `البداية` receives where that word starts.
عرف ينتهي_بكلمة_لغة(
    النص: &نص,
    النهاية: طبيعي,
    الكلمة: نص,
    البداية: &متغير طبيعي
): منطقي {
    ليكن ح: متغير طبيعي = النهاية;
    طالما ((ح > 0) && (((*النص)[ح - 1] == 0x20) || ((*النص)[ح - 1] == 0x09))) { ح := ح - 1; }
    ليكن الطول_الكلمة: طبيعي = الطول(الكلمة) مثل طبيعي;
    إذا (ح < الطول_الكلمة) { أرجع خطأ; };
    ليكن البدء: طبيعي = ح - الطول_الكلمة;
    طابق مقطع_نص(النص, البدء, الطول_الكلمة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المقطع) -> {
        إذا (!نصان_متساويان(&المقطع, &الكلمة)) { أرجع خطأ; };
    };
    إذا (البدء > 0) {
        ليكن قبل: ط8 = (*النص)[البدء - 1];
        إذا (!((قبل == 0x20) || (قبل == 0x09) || (قبل == 0x0A) || (قبل == 0x0D) || (قبل == 0x7B) || (قبل == 0x3B))) {
            أرجع خطأ;
        };
    };
    *البداية := البدء;
    أرجع صواب;
}

// `ليكن [متغير] الاسم` / `let [mutable] name` directly before the name.
عرف تصريح_دع_قبل_لغة(النص: &نص, بداية_الاسم: طبيعي): منطقي {
    ليكن الموضع: متغير طبيعي = بداية_الاسم;
    ليكن بعد_المعدل: متغير طبيعي = 0;
    إذا (ينتهي_بكلمة_لغة(النص, الموضع, «متغير», &متغير بعد_المعدل)
        || ينتهي_بكلمة_لغة(النص, الموضع, «mutable», &متغير بعد_المعدل)) {
        الموضع := بعد_المعدل;
    };
    ليكن البدء: متغير طبيعي = 0;
    أرجع ينتهي_بكلمة_لغة(النص, الموضع, «ليكن», &متغير البدء)
        || ينتهي_بكلمة_لغة(النص, الموضع, «let», &متغير البدء);
}

// ---- Type hints ----------------------------------------------------------------
// A local binding whose type is not written — a match pattern binding
// (`| اختياري.موجود(القيمة)`) or a loop variable — shows the compiler's type,
// spelled in the document's surface language, the way rust-analyzer does.
// `ليكن`/`let` always carries its type, so it gets none.
عام عرف تلميحات_أنواع_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    السطر_الأول: طبيعي,
    السطر_الأخير: طبيعي
): متجه تلميح_مضمن_لغة {
    ليكن الناتج: متغير متجه تلميح_مضمن_لغة = [];
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: طبيعي;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
        ليكن النص: &نص = &(*المستند).النص;
        ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
        ليكن المصنفة: متجه ظهور_مصنف_دلاليا = ظهورات_مصنفة_واجهة_لمصدر(الواجهة, المصدر);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصنفة) مثل طبيعي)) {
            ليكن الظهور: ظهور_مصنف_دلاليا = استنسخ(&المصنفة[ف]);
            ليكن محلي: متغير منطقي = خطأ;
            طابق الظهور.النوع مع
            | نوع_تصريح.ربط_محلي -> { محلي := صواب; }
            | _ -> { };
            إذا (محلي && الظهور.تصريح && !تصريح_دع_قبل_لغة(النص, (الظهور.النطاق.البداية.البايت مثل طبيعي))) {
                ليكن ح: متغير طبيعي = (الظهور.النطاق.النهاية.البايت مثل طبيعي);
                طالما ((ح < الحد) && (((*النص)[ح] == 0x20) || ((*النص)[ح] == 0x09))) { ح := ح + 1; }
                // A written type (`ليكن x: عدد`) needs no hint.
                ليكن مكتوب: منطقي = (ح < الحد) && ((*النص)[ح] == 0x3A);
                إذا (!مكتوب) {
                    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (الظهور.النطاق.النهاية.البايت مثل طبيعي)) مع
                    | نتيجة.خطأ(_) -> { }
                    | نتيجة.نجح(الموضع) -> {
                        إذا ((الموضع.السطر >= السطر_الأول) && (الموضع.السطر <= السطر_الأخير)) {
                            طابق نوع_رمز_واجهة(الواجهة, الظهور.الرمز) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(معرف_النوع) -> {
                                طابق تهجئة_نوع_لغة(الواجهة, معرف_النوع, عربي) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(التهجئة) -> {
                                    ليكن أجزاء: متجه نص = [«: », التهجئة];
                                    ليكن الفاصل: نص = «»;
                                    ليكن التلميح: تلميح_مضمن_لغة = {
                                        الموضع: الموضع,
                                        النص: صل_النصوص(&أجزاء, &الفاصل),
                                        نوع_التلميح: 1
                                    };
                                    ألحق(الناتج, التلميح);
                                };
                            };
                        };
                    };
                };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عرف اسم_معامل_من_تصريح_لغة(التصريح: &نص): نص {
    ليكن ف: متغير طبيعي = 0;
    ليكن الحد: طبيعي = الطول(*التصريح) مثل طبيعي;
    طالما ((ف < الحد) && ((*التصريح)[ف] != 0x3A)) { ف := ف + 1; }
    طابق مقطع_نص(التصريح, 0, ف) مع
    | اختياري.لا_شيء -> { أرجع «»; }
    | اختياري.موجود(الاسم) -> { أرجع قص_النص(&الاسم); };
}

// Byte ranges [start, end) of the top-level arguments after the `(` at `الفتح`.
عرف حجج_استدعاء_نصية_لغة(النص: &نص, الفتح: طبيعي): متجه نطاق_بايتات_حجة_لغة {
    ليكن الناتج: متغير متجه نطاق_بايتات_حجة_لغة = [];
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن العمق: متغير طبيعي = 0;
    ليكن البداية: متغير طبيعي = الفتح + 1;
    ليكن ف: متغير طبيعي = الفتح + 1;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب == 0x22) {
            ف := ف + 1;
            طالما ((ف < الحد) && ((*النص)[ف] != 0x22) && ((*النص)[ف] != 0x0A)) {
                إذا ((*النص)[ف] == 0x5C) { ف := ف + 1; };
                ف := ف + 1;
            }
        } وإلا إذا ((ب == 0x28) || (ب == 0x5B) || (ب == 0x7B)) {
            العمق := العمق + 1;
        } وإلا إذا ((ب == 0x29) || (ب == 0x5D) || (ب == 0x7D)) {
            إذا (العمق == 0) {
                إذا (ف > البداية) {
                    ليكن آخر: نطاق_بايتات_حجة_لغة = { البداية: البداية, النهاية: ف };
                    ألحق(الناتج, آخر);
                };
                أرجع الناتج;
            };
            العمق := العمق - 1;
        } وإلا إذا ((ب == 0x2C) && (العمق == 0)) {
            ليكن الحجة: نطاق_بايتات_حجة_لغة = { البداية: البداية, النهاية: ف };
            ألحق(الناتج, الحجة);
            البداية := ف + 1;
        } وإلا إذا (ب == 0x3B) {
            أرجع الناتج;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام نوع نطاق_بايتات_حجة_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي
};

عام عرف تلميحات_معاملات_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    السطر_الأول: طبيعي,
    السطر_الأخير: طبيعي
): متجه تلميح_مضمن_لغة {
    ليكن الناتج: متغير متجه تلميح_مضمن_لغة = [];
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: طبيعي;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن النص: &نص = &(*المستند).النص;
        ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
        ليكن المصنفة: متجه ظهور_مصنف_دلاليا = ظهورات_مصنفة_واجهة_لمصدر(الواجهة, المصدر);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصنفة) مثل طبيعي)) {
            ليكن الظهور: ظهور_مصنف_دلاليا = استنسخ(&المصنفة[ف]);
            ليكن هو_دالة: متغير منطقي = خطأ;
            طابق الظهور.النوع مع
            | نوع_تصريح.دالة -> { هو_دالة := صواب; }
            | نوع_تصريح.دالة_خارجية -> { هو_دالة := صواب; }
            | _ -> { };
            إذا (هو_دالة && !الظهور.تصريح) {
                ليكن ح: متغير طبيعي = (الظهور.النطاق.النهاية.البايت مثل طبيعي);
                طالما ((ح < الحد) && ((*النص)[ح] == 0x20)) { ح := ح + 1; }
                ليكن في_المدى: متغير منطقي = خطأ;
                طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (الظهور.النطاق.البداية.البايت مثل طبيعي)) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(الموضع) -> {
                    في_المدى := (الموضع.السطر >= السطر_الأول) && (الموضع.السطر <= السطر_الأخير);
                };
                إذا (في_المدى && (ح < الحد) && ((*النص)[ح] == 0x28)) {
                    طابق تصريح_رمز_واجهة(الواجهة, الظهور.الرمز) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(التصريح) -> {
                        ليكن المعاملات: متجه نص = نصوص_معاملات_مصدر_لغة(الواجهة, &التصريح);
                        ليكن الحجج: متجه نطاق_بايتات_حجة_لغة = حجج_استدعاء_نصية_لغة(النص, ح);
                        // Single-parameter calls read clearly without a hint.
                        إذا ((الطول(المعاملات) مثل طبيعي) > 1) {
                            ليكن ك: متغير طبيعي = 0;
                            طالما ((ك < (الطول(الحجج) مثل طبيعي)) && (ك < (الطول(المعاملات) مثل طبيعي))) {
                                ليكن البداية: متغير طبيعي = الحجج[ك].البداية;
                                طالما ((البداية < الحجج[ك].النهاية) && (((*النص)[البداية] == 0x20) || ((*النص)[البداية] == 0x0A) || ((*النص)[البداية] == 0x09))) {
                                    البداية := البداية + 1;
                                }
                                ليكن الاسم: نص = اسم_معامل_من_تصريح_لغة(&المعاملات[ك]);
                                ليكن نص_الحجة: متغير نص = «»;
                                طابق مقطع_نص(النص, البداية, الحجج[ك].النهاية - البداية) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(القيمة) -> { نص_الحجة := قص_النص(&القيمة); };
                                // Skip when the argument already says it (`value` passed as value).
                                إذا (((الطول(الاسم) مثل طبيعي) > 0) && !نصان_متساويان(&الاسم, &نص_الحجة)) {
                                    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, البداية) مع
                                    | نتيجة.خطأ(_) -> { }
                                    | نتيجة.نجح(الموضع) -> {
                                        ليكن أجزاء: متجه نص = [الاسم, «:»];
                                        ليكن الفاصل: نص = «»;
                                        ليكن التلميح: تلميح_مضمن_لغة = { الموضع: الموضع, النص: صل_النصوص(&أجزاء, &الفاصل), نوع_التلميح: 2 };
                                        ألحق(الناتج, التلميح);
                                    };
                                };
                                ك := ك + 1;
                            }
                        };
                    };
                };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

// ---- Go to type definition ----------------------------------------------------
// The declared type of the symbol under the cursor, spelled by the compiler,
// resolved to the user type it names (`Point`, `&Point`, `vector Point`).

عام عرف تعريف_نوع_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري موقع_دلالي_لغة {
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: طبيعي;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: طبيعي;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        ليكن معرف_النوع: معرف_نوع;
        طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { معرف_النوع := القيمة; };
        }
        | اختياري.لا_شيء -> {
            طابق نوع_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { معرف_النوع := القيمة; };
        };
        ليكن الرموز: متجه رمز_دلالي = كل_رموز_واجهة(الواجهة);
        ليكن اللغات: متجه منطقي = [صواب, خطأ];
        ليكن ل: متغير طبيعي = 0;
        طالما (ل < 2) {
            طابق تهجئة_نوع_لغة(الواجهة, معرف_النوع, اللغات[ل]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(التهجئة) -> {
                // Each identifier in the spelling, outermost first.
                ليكن الكلمات: متجه نص = كلمات_تهجئة_نوع_لغة(&التهجئة);
                ليكن ك: متغير طبيعي = 0;
                طالما (ك < (الطول(الكلمات) مثل طبيعي)) {
                    ليكن ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
                        ليكن المرشح: رمز_دلالي = الرموز[ف];
                        ليكن نوعي: متغير منطقي = خطأ;
                        طابق المرشح.النوع مع
                        | نوع_تصريح.سجل -> { نوعي := صواب; }
                        | نوع_تصريح.معتم -> { نوعي := صواب; }
                        | نوع_تصريح.تعداد -> { نوعي := صواب; }
                        | نوع_تصريح.مرادف_نوع -> { نوعي := صواب; }
                        | _ -> { };
                        إذا (نوعي) {
                            طابق اسم_رمز_تحويم_لغة(الواجهة, &المرشح) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(الاسم) -> {
                                إذا (نصان_متساويان(&الاسم, &الكلمات[ك])) {
                                    أرجع موقع_نطاق_واجهة_لغة(الواجهة, المرشح.نطاق_الاسم);
                                };
                            };
                        };
                        ف := ف + 1;
                    }
                    ك := ك + 1;
                }
            };
            ل := ل + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عرف كلمات_تهجئة_نوع_لغة(التهجئة: &نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الحد: طبيعي = الطول(*التهجئة) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        طالما ((ف < الحد) && !بايت_معرف_إكمال_لغة((*التهجئة)[ف])) { ف := ف + 1; }
        ليكن البداية: طبيعي = ف;
        طالما ((ف < الحد) && بايت_معرف_إكمال_لغة((*التهجئة)[ف])) { ف := ف + 1; }
        إذا (ف > البداية) {
            طابق مقطع_نص(التهجئة, البداية, ف - البداية) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الكلمة) -> { ألحق(الناتج, الكلمة); };
        };
    }
    أرجع الناتج;
}

// ---- Keyword hover --------------------------------------------------------------
// Both spellings of the keyword (SultanC is bilingual) and its role.

عام عرف تحويم_كلمة_محجوزة_لغة(المستند: &مستند_لغة_مفتوح, الموضع: موضع_تغيير_لغة): اختياري نص {
    ليكن البايت: طبيعي;
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
    ليكن النص: &نص = &(*المستند).النص;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن البداية: متغير طبيعي = البايت;
    طالما ((البداية > 0) && بايت_معرف_إكمال_لغة((*النص)[البداية - 1])) { البداية := البداية - 1; }
    ليكن النهاية: متغير طبيعي = البايت;
    طالما ((النهاية < الحد) && بايت_معرف_إكمال_لغة((*النص)[النهاية])) { النهاية := النهاية + 1; }
    إذا (النهاية == البداية) { أرجع اختياري.لا_شيء(); };
    ليكن الكلمة: نص;
    طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الكلمة := القيمة; };
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن الكلمات: متجه كلمة_محجوزة_لغة = الكلمات_المحجوزة_لغة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكلمات) مثل طبيعي)) {
        إذا (نصان_متساويان(&الكلمات[ف].الإنجليزية, &الكلمة) || نصان_متساويان(&الكلمات[ف].العربية, &الكلمة)) {
            ليكن الدور: نص = دور_كلمة_محجوزة_لغة(&الكلمات[ف].المجموعة, عربي);
            ليكن أجزاء: متجه نص = [
                "```sultanc\n", استنسخ(&الكلمة), "\n```\n\n",
                بلغة_العرض_لغة(«**Keyword** — », «**كلمة محجوزة** — », عربي), الدور, "  \n",
                «English: `», استنسخ(&الكلمات[ف].الإنجليزية), «` · العربية: `», استنسخ(&الكلمات[ف].العربية), «`»
            ];
            ليكن الفاصل: نص = «»;
            أرجع اختياري.موجود(صل_النصوص(&أجزاء, &الفاصل));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف دور_كلمة_محجوزة_لغة(المجموعة: &نص, عربي: منطقي): نص {
    ليكن أسماء: متجه نص = [«control», «declaration», «module», «modifier», «wordOperator», «type», «literal»];
    ليكن إنجليزي: متجه نص = [«control flow», «declaration», «modules and imports», «modifier», «operator», «built-in type», «literal»];
    ليكن عربية: متجه نص = [«تحكم في التدفق», «تصريح», «الوحدات والاستيراد», «معدِّل», «عامل», «نوع مدمج», «قيمة حرفية»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أسماء) مثل طبيعي)) {
        إذا (نصان_متساويان(المجموعة, &أسماء[ف])) {
            إذا (عربي) { أرجع استنسخ(&عربية[ف]); };
            أرجع استنسخ(&إنجليزي[ف]);
        };
        ف := ف + 1;
    }
    أرجع استنسخ(المجموعة);
}


// ---- Auto-import completion -----------------------------------------------------
// std names not yet in scope whose spelling starts with the typed prefix; the
// accepted item adds `import std.x.y;` (or `استورد std.x.y;`) after the last
// import of the document.

عام عرف بادئة_مكتوبة_لغة(المستند: &مستند_لغة_مفتوح, الموضع: موضع_تغيير_لغة): نص {
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.خطأ(_) -> { أرجع «»; }
    | نتيجة.نجح(البايت) -> {
        ليكن البداية: متغير طبيعي = البايت;
        طالما ((البداية > 0) && بايت_معرف_إكمال_لغة((*المستند).النص[البداية - 1])) { البداية := البداية - 1; }
        طابق مقطع_نص(&(*المستند).النص, البداية, البايت - البداية) مع
        | اختياري.لا_شيء -> { أرجع «»; }
        | اختياري.موجود(البادئة) -> { أرجع البادئة; };
    };
}

عام عرف سطر_إدراج_استيراد_لغة(المستند: &مستند_لغة_مفتوح): طبيعي {
    ليكن النص: &نص = &(*المستند).النص;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن السطر: متغير طبيعي = 0;
    ليكن الإدراج: متغير طبيعي = 0;
    ليكن البداية: متغير طبيعي = 0;
    ليكن إنجليزي: نص = «import »;
    ليكن عربي: نص = «استورد »;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= الحد) {
        إذا ((ف == الحد) || ((*النص)[ف] == 0x0A)) {
            طابق مقطع_نص(النص, البداية, ف - البداية) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الخام) -> {
                ليكن السطر_المقصوص: نص = قص_النص(&الخام);
                إذا (يبدأ_بـ(&السطر_المقصوص, &إنجليزي) || يبدأ_بـ(&السطر_المقصوص, &عربي)) {
                    الإدراج := السطر + 1;
                };
            };
            السطر := السطر + 1;
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الإدراج;
}

عام عرف اقتراحات_استيراد_تلقائي_لغة(
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الفهرس: &متجه مدخل_فهرس_مكتبة_لغة,
    الموجودة: &متجه اقتراح_إكمال_دلالي_لغة
): متجه اقتراح_إكمال_دلالي_لغة {
    ليكن الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    ليكن البادئة: نص = بادئة_مكتوبة_لغة(المستند, الموضع);
    إذا ((الطول(البادئة) مثل طبيعي) < 2) { أرجع الناتج; };
    // Not after `receiver.`: members only there.
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.خطأ(_) -> { أرجع الناتج; }
    | نتيجة.نجح(البايت) -> {
        طابق مستقبل_إكمال_عضو_لغة(&(*المستند).النص, البايت) مع
        | اختياري.موجود(_) -> { أرجع الناتج; }
        | اختياري.لا_شيء -> { };
    };
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن كلمة_الاستيراد: نص = بلغة_العرض_لغة(«import », «استورد », عربي);
    ليكن سطر_الإدراج: طبيعي = سطر_إدراج_استيراد_لغة(المستند);
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف < (الطول(*الفهرس) مثل طبيعي)) && ((الطول(الناتج) مثل طبيعي) < 40)) {
        ليكن المدخل: &مدخل_فهرس_مكتبة_لغة = &(*الفهرس)[ف];
        إذا (يبدأ_بـ(&(*المدخل).الاسم, &البادئة)) {
            // Already imported, or already offered from the scope.
            ليكن منهي: متجه نص = [استنسخ(&(*المدخل).الوحدة), «;»];
            ليكن فارغ: نص = «»;
            ليكن الوحدة_المنتهية: نص = صل_النصوص(&منهي, &فارغ);
            ليكن مستورد: منطقي = يحتوي_نصا(&(*المستند).النص, &الوحدة_المنتهية);
            ليكن موجود: متغير منطقي = خطأ;
            ليكن ك: متغير طبيعي = 0;
            طالما ((ك < (الطول(*الموجودة) مثل طبيعي)) && !موجود) {
                إذا (نصان_متساويان(&(*الموجودة)[ك].النص, &(*المدخل).الاسم)) { موجود := صواب; };
                ك := ك + 1;
            }
            إذا (!مستورد && !موجود) {
                ليكن أجزاء_السطر: متجه نص = [استنسخ(&كلمة_الاستيراد), استنسخ(&(*المدخل).الوحدة), ";\n"];
                ليكن نص_الإدراج: نص = صل_النصوص(&أجزاء_السطر, &فارغ);
                ليكن الإدراج: إدراج_استيراد_لغة = { السطر: سطر_الإدراج, النص: استنسخ(&نص_الإدراج) };
                ليكن أجزاء_التفصيل: متجه نص = [قص_النص(&نص_الإدراج)];
                ليكن النوع: متغير نوع_تصريح = نوع_تصريح.دالة();
                إذا (!(*المدخل).هو_دالة) { النوع := نوع_تصريح.سجل(); };
                ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = {
                    النص: استنسخ(&(*المدخل).الاسم),
                    النوع: النوع,
                    التفصيل: اختياري.موجود(صل_النصوص(&أجزاء_التفصيل, &فارغ)),
                    التوثيق: اختياري.لا_شيء(),
                    كلمة: خطأ,
                    الإدراج: اختياري.موجود(الإدراج),
                    صنف_العنصر: اختياري.لا_شيء(),
                    نص_الإدراج: اختياري.لا_شيء(),
                    يلائم: خطأ,
                    البعد: 6,
                    المدى: اختياري.لا_شيء()
                };
                ألحق(الناتج, الاقتراح);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}


// Go to Implementation for the one relationship SultanC has: a declaration
// written once per target (`if (os == linux) { ... } else { ... }` at module
// level). The compiler analyses the host branch and records the name spans
// of the declarations it left out (وحدة_مصدر.المستبعدة_للهدف). The
// implementations of a name are its top-level declarations in the declaring
// module, active and excluded, matched by identifier identity. Works from
// a use, from the active declaration, or from an excluded declaration.

عرف نص_نطاق_واجهة_لغة(الواجهة: &نتيجة_واجهة_وحدة, النطاق: نطاق): اختياري نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, (النطاق.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن البداية: طبيعي = النطاق.البداية.البايت مثل طبيعي;
        ليكن النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
        إذا (النهاية < البداية || النهاية > (الطول(المصدر.المحتوى) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع مقطع_نص(&المصدر.المحتوى, البداية, النهاية - البداية);
    };
}

عرف نطاقات_أسماء_عليا_لغة(الوحدة: &وحدة_مصدر): متجه نطاق {
    ليكن الناتج: متغير متجه نطاق = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
        طابق استنسخ(&(*الوحدة).العناصر[ف]) مع
        | عنصر_وحدة.دالة(الدالة) -> { ألحق(الناتج, الدالة.الاسم.النطاق); }
        | عنصر_وحدة.نوع(التصريح) -> { ألحق(الناتج, التصريح.الاسم.النطاق); }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> { ألحق(الناتج, التصريح.الاسم.النطاق); }
        | عنصر_وحدة.تجميع(_, _) -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المستبعدة_للهدف) مثل طبيعي)) {
        ألحق(الناتج, (*الوحدة).المستبعدة_للهدف[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف نطاق_يحوي_بايتا_لغة(النطاق: نطاق, المصدر: طبيعي, البايت: طبيعي): منطقي {
    أرجع (النطاق.البداية.المصدر مثل طبيعي) == المصدر
        && (النطاق.البداية.البايت مثل طبيعي) <= البايت
        && البايت <= (النطاق.النهاية.البايت مثل طبيعي);
}

عام عرف تطبيقات_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): متجه موقع_دلالي_لغة {
    ليكن الناتج: متغير متجه موقع_دلالي_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        // The name: the resolved symbol's declaration, else an excluded
        // declaration under the cursor.
        ليكن نطاق_الاسم: متغير اختياري نطاق = اختياري.لا_شيء();
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.موجود(الرمز) -> {
            // The compiler's relation: the declaration and the same name in
            // the module's other `if (target...)` branches.
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع الناتج; }
            | اختياري.موجود(التصريح) -> {
                ليكن النطاقات: متغير متجه نطاق = [التصريح.نطاق_الاسم];
                ليكن الأخرى: متجه نطاق = تصريحات_لأهداف_أخرى_واجهة(الواجهة, الرمز);
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الأخرى) مثل طبيعي)) { ألحق(النطاقات, الأخرى[ف]); ف := ف + 1; }
                ليكن المواقع: متجه اختياري موقع_دلالي_لغة = مواقع_نطاقات_واجهة_لغة(الواجهة, &النطاقات);
                ف := 0;
                طالما (ف < (الطول(المواقع) مثل طبيعي)) {
                    طابق استنسخ(&المواقع[ف]) مع
                    | اختياري.موجود(الموقع) -> { ألحق(الناتج, الموقع); }
                    | اختياري.لا_شيء -> { };
                    ف := ف + 1;
                }
                أرجع الناتج;
            };
        }
        | اختياري.لا_شيء -> {
            طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المصدر) -> {
                طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(البايت) -> {
                    ليكن و: متغير طبيعي = 0;
                    طالما (و < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
                        ليكن م: متغير طبيعي = 0;
                        طالما (م < (الطول((*الواجهة).الوحدات[و].المستبعدة_للهدف) مثل طبيعي)) {
                            ليكن مرشح: نطاق = (*الواجهة).الوحدات[و].المستبعدة_للهدف[م];
                            إذا (نطاق_يحوي_بايتا_لغة(مرشح, المصدر, البايت)) { نطاق_الاسم := اختياري.موجود(مرشح); };
                            م := م + 1;
                        }
                        و := و + 1;
                    }
                };
            };
        };
        طابق نطاق_الاسم مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الاسم) -> {
            ليكن نص_الاسم: متغير نص = «»;
            طابق نص_نطاق_واجهة_لغة(الواجهة, الاسم) مع
            | اختياري.لا_شيء -> { أرجع الناتج; }
            | اختياري.موجود(القيمة) -> { نص_الاسم := القيمة; };
            ليكن الهوية: متجه ط8 = انسخ_هوية_معرف_من_نص(&نص_الاسم);
            ليكن المصدر: طبيعي = الاسم.البداية.المصدر مثل طبيعي;
            ليكن و: متغير طبيعي = 0;
            طالما (و < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
                إذا ((*الواجهة).الوحدات[و].معرف_المصدر == المصدر) {
                    ليكن النطاقات: متجه نطاق = نطاقات_أسماء_عليا_لغة(&(*الواجهة).الوحدات[و]);
                    ليكن ن: متغير طبيعي = 0;
                    طالما (ن < (الطول(النطاقات) مثل طبيعي)) {
                        طابق نص_نطاق_واجهة_لغة(الواجهة, النطاقات[ن]) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(المرشح) -> {
                            إذا (تطابق_هوية_بايتات_ونص(&الهوية, &المرشح)) {
                                طابق موقع_نطاق_واجهة_لغة(الواجهة, النطاقات[ن]) مع
                                | اختياري.موجود(الموقع) -> { ألحق(الناتج, الموقع); }
                                | اختياري.لا_شيء -> { };
                            };
                        };
                        ن := ن + 1;
                    }
                };
                و := و + 1;
            }
            أرجع الناتج;
        };
    };
}

// Why a rename is refused: the first conflict the compiler reports
// (tooling_queries.sn تعارضات_إعادة_تسمية_واجهة), in the document's language,
// with the place where resolution would change (1-based line:column).
عام عرف وصف_تعارض_إعادة_تسمية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الاسم_الجديد: &نص
): اختياري نص {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        ليكن التعارضات: متجه تعارض_إعادة_تسمية_دلالي = تعارضات_إعادة_تسمية_واجهة(الواجهة, المصدر, البايت, الاسم_الجديد);
        إذا ((الطول(التعارضات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
        ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
        ليكن السبب: متغير نص = «»;
        طابق التعارضات[0].النوع مع
        | نوع_تعارض_إعادة_تسمية.نفس_النطاق -> {
            إذا (عربي) { السبب := «الاسم معرف مسبقا في النطاق نفسه»; } وإلا { السبب := «the name is already declared in the same scope»; };
        }
        | نوع_تعارض_إعادة_تسمية.التقاط_داخلي -> {
            إذا (عربي) { السبب := «تصريح أقرب بهذا الاسم سيلتقط استخداما للرمز»; } وإلا { السبب := «a nearer declaration of this name would capture a use of the symbol»; };
        }
        | نوع_تعارض_إعادة_تسمية.التقاط_خارجي -> {
            إذا (عربي) { السبب := «الرمز بعد التسمية سيلتقط استخداما لرمز آخر بهذا الاسم»; } وإلا { السبب := «the renamed symbol would capture a use of another symbol with this name»; };
        }
        | نوع_تعارض_إعادة_تسمية.تعارض_وحدة -> {
            إذا (عربي) { السبب := «وحدة تستخدم الرمز تصل أصلا إلى رمز آخر بهذا الاسم»; } وإلا { السبب := «a module that uses the symbol already reaches another symbol with this name»; };
        };
        ليكن المكان: متغير نص = «»;
        طابق مدى_أداة_واجهة(الواجهة, التعارضات[0].النطاق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المدى) -> {
            ليكن الاسم_الملف: متغير نص = «»;
            طابق مصدر_واجهة_بمعرف(الواجهة, المدى.المصدر) مع
            | اختياري.موجود(م) -> {
                طابق اسم_الملف(&م.الاسم) مع
                | اختياري.موجود(ق) -> { الاسم_الملف := ق; }
                | اختياري.لا_شيء -> { الاسم_الملف := استنسخ(&م.الاسم); };
            }
            | اختياري.لا_شيء -> { };
            ليكن الأجزاء: متجه نص = [« (», الاسم_الملف, «:», طبيعي_إلى_نص(المدى.البداية.السطر + 1), «:», طبيعي_إلى_نص(المدى.البداية.العمود_يوتيف16 + 1), «)»];
            ليكن بلا: نص = «»;
            المكان := صل_النصوص(&الأجزاء, &بلا);
        };
        ليكن الأجزاء: متجه نص = [السبب, المكان];
        ليكن بلا: نص = «»;
        أرجع اختياري.موجود(صل_النصوص(&الأجزاء, &بلا));
    };
}

// Files that import the module declaring the symbol at the position, or the
// declaring file itself, whose names the compiler could not bind
// (اكتمال_مصدر_واجهة). Only those can hide references of this symbol.
عام عرف مستوردون_ناقصون_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع الناتج; }
            | اختياري.موجود(التصريح) -> {
                ليكن المصدر: طبيعي = التصريح.نطاق_الاسم.البداية.المصدر مثل طبيعي;
                ليكن المصادر: متغير متجه طبيعي = [المصدر];
                ليكن العلاقات: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(الواجهة, المصدر, خطأ);
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(العلاقات) مثل طبيعي)) { ألحق(المصادر, العلاقات[ف].مصدر_المستورد); ف := ف + 1; }
                ف := 0;
                طالما (ف < (الطول(المصادر) مثل طبيعي)) {
                    ليكن الاكتمال: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(الواجهة, المصادر[ف]);
                    إذا (!الاكتمال.الأسماء) {
                        طابق مصدر_واجهة_بمعرف(الواجهة, المصادر[ف]) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(م) -> {
                            ليكن الاسم: نص = مسار_مطلق_لغة(&م.الاسم);
                            إذا (!نص_في_متجه_لغة(&الناتج, &الاسم)) { ألحق(الناتج, الاسم); };
                        };
                    };
                    ف := ف + 1;
                }
                أرجع الناتج;
            };
        };
    };
}

عرف نص_في_متجه_لغة(القائمة: &متجه نص, النص: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القائمة)[ف], النص)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// "these files could not be analysed: a.sn, b.sn" in the document's language.
عام عرف رسالة_ملفات_ناقصة_لغة(المستند: &مستند_لغة_مفتوح, الملفات: &متجه نص, لإعادة_التسمية: منطقي): نص {
    ليكن الأسماء: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الملفات) مثل طبيعي)) {
        طابق اسم_الملف(&(*الملفات)[ف]) مع
        | اختياري.موجود(الاسم) -> { ألحق(الأسماء, الاسم); }
        | اختياري.لا_شيء -> { ألحق(الأسماء, استنسخ(&(*الملفات)[ف])); };
        ف := ف + 1;
    }
    ليكن فاصلة: نص = «, »;
    ليكن القائمة: نص = صل_النصوص(&الأسماء, &فاصلة);
    ليكن البادئة: متغير نص = «»;
    إذا (مستند_لغة_بالعربية(المستند)) {
        إذا (لإعادة_التسمية) { البادئة := «لا يمكن إعادة التسمية بأمان: تعذر تحليل أسماء ملفات قد تستعمل الرمز: »; }
        وإلا { البادئة := «قد تكون المراجع ناقصة: تعذر تحليل أسماء هذه الملفات: »; };
    } وإلا {
        إذا (لإعادة_التسمية) { البادئة := «Rename is not safe: the names of files that may use this symbol could not be analysed: »; }
        وإلا { البادئة := «References may be incomplete: the names of these files could not be analysed: »; };
    };
    ليكن الأجزاء: متجه نص = [البادئة, القائمة];
    ليكن بلا: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &بلا);
}

// Ranges of imports nothing in the document resolves through, repeated
// imports and unneeded selected names (استيرادات_غير_مستخدمة_واجهة), for
// "unnecessary" hints. Nothing when the document's names did not bind.
عام عرف نطاقات_استيرادات_زائدة_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه نطاق_تغيير_لغة {
    ليكن الناتج: متغير متجه نطاق_تغيير_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المصدر) -> {
            ليكن الاكتمال: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(الواجهة, المصدر);
            إذا (!الاكتمال.الأسماء) { أرجع الناتج; };
            ليكن الزائدة: متجه استيراد_غير_مستخدم = استيرادات_غير_مستخدمة_واجهة(الواجهة, المصدر);
            ليكن النطاقات: متغير متجه نطاق = [];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الزائدة) مثل طبيعي)) {
                إذا (الزائدة[ف].مكرر || عبارة_كلها_غير_مستخدمة_لغة(&الزائدة, ف)) {
                    طابق الزائدة[ف].نطاق_العبارة مع
                    | اختياري.موجود(العبارة) -> { ألحق(النطاقات, العبارة); }
                    | اختياري.لا_شيء -> { };
                } وإلا {
                    ليكن ن: متغير طبيعي = 0;
                    طالما (ن < (الطول(الزائدة[ف].الأسماء_غير_المستخدمة) مثل طبيعي)) {
                        ألحق(النطاقات, الزائدة[ف].الأسماء_غير_المستخدمة[ن]);
                        ن := ن + 1;
                    }
                };
                ف := ف + 1;
            }
            ليكن المواقع: متجه اختياري موقع_دلالي_لغة = مواقع_نطاقات_واجهة_لغة(الواجهة, &النطاقات);
            ف := 0;
            طالما (ف < (الطول(المواقع) مثل طبيعي)) {
                طابق استنسخ(&المواقع[ف]) مع
                | اختياري.موجود(الموقع) -> { ألحق(الناتج, الموقع.النطاق); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع الناتج;
        };
    };
}

// Whether the whole import statement of entry الموضع can go: the compiler's
// per-statement flag (`العبارة_غير_مستخدمة`, true when every relation of the
// statement is unused; `from m import a, b` gives one relation per module).
// An entry without a statement span stands for itself.
عام عرف عبارة_كلها_غير_مستخدمة_لغة(الزائدة: &متجه استيراد_غير_مستخدم, الموضع: طبيعي): منطقي {
    طابق (*الزائدة)[الموضع].نطاق_العبارة مع
    | اختياري.موجود(_) -> { أرجع (*الزائدة)[الموضع].العبارة_غير_مستخدمة; }
    | اختياري.لا_شيء -> { أرجع (*الزائدة)[الموضع].غير_مستخدم; };
}

// ---- Tests (`@@test` / `@@اختبار`, docs/en/reference/testing.md) ----------
// The document's tests as `sultanc test` finds them: the compiler's discovery
// (compiler/test_mode/discovery.sn اكتشف_اختبارات) over the document's source
// in the analysed interface, for the analysis target. A test the compiler
// would reject (parameters, a generic or external function, not a function)
// is listed as not runnable; its diagnostic comes with the build.
عام نوع اختبار_مستند_لغة = {
    الاسم: نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    قابل: منطقي
};

عام عرف اختبارات_مستند_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه اختبار_مستند_لغة {
    ليكن الناتج: متغير متجه اختبار_مستند_لغة = [];
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المصدر) -> {
            ليكن المعرفات: متجه طبيعي = [المصدر];
            ليكن الهدف: اختياري واصف_هدف = هدف_تحليل_لغة();
            ليكن المكتشفة: متجه اختبار_مكتشف = اكتشف_اختبارات(&(*الواجهة).خريطة_المصادر, &المعرفات, &الهدف);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المكتشفة) مثل طبيعي)) {
                ليكن الاختبار: اختبار_مستند_لغة = {
                    الاسم: استنسخ(&المكتشفة[ف].الاسم),
                    البداية: المكتشفة[ف].نطاق_الاسم.البداية.البايت مثل طبيعي,
                    النهاية: المكتشفة[ف].نطاق_الاسم.النهاية.البايت مثل طبيعي,
                    قابل: المكتشفة[ف].الصنف == صنف_مكتشف_اختبار.دالة() && المكتشفة[ف].عدد_المعاملات == 0
                };
                ألحق(الناتج, الاختبار);
                ف := ف + 1;
            }
        };
    };
    أرجع الناتج;
}

// The program entry's name (the compiler's رمز_بدء_البرنامج: `الرئيسية` or
// `main`) when it is declared in this document: its byte offset.
عام عرف بدء_برنامج_مستند_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): اختياري طبيعي {
    طابق استنسخ(&(*اللقطة).الواجهة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن الحالة: نتيجة_واجهة_وحدة = *الواجهة;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المصدر) -> {
            طابق الحالة.رمز_بدء_البرنامج مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الرمز) -> {
                طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(التصريح) -> {
                    إذا ((التصريح.نطاق_الاسم.البداية.المصدر مثل طبيعي) != المصدر) { أرجع اختياري.لا_شيء(); };
                    أرجع اختياري.موجود(التصريح.نطاق_الاسم.البداية.البايت مثل طبيعي);
                };
            };
        };
    };
}

// ---- Closing brace hints ---------------------------------------------------------
// After the closing `}` of a declaration of at least الحد lines, its keyword
// and name, as rust-analyzer's closing brace hints: `} // def main`, in the
// document's language (`عرف الرئيسية`). Declarations and their ranges are the
// compiler's (رموز_مستند_دلالية_لغة).
عام عرف تلميحات_أقواس_غالقة_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    من_سطر: طبيعي,
    إلى_سطر: طبيعي,
    الحد: طبيعي
): متجه تلميح_مضمن_لغة {
    ليكن الناتج: متغير متجه تلميح_مضمن_لغة = [];
    إذا (الحد == 0) { أرجع الناتج; };
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن الرموز: متجه رمز_معلن_لغة = رموز_مستند_دلالية_لغة(اللقطة, المستند);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        ليكن الرمز: &رمز_معلن_لغة = &الرموز[ف];
        ليكن الكلمة: متغير نص = «»;
        طابق (*الرمز).النوع مع
        | نوع_تصريح.دالة -> { إذا (عربي) { الكلمة := «عرف»; } وإلا { الكلمة := «def»; }; }
        | نوع_تصريح.سجل -> { إذا (عربي) { الكلمة := «نوع»; } وإلا { الكلمة := «type»; }; }
        | _ -> { };
        ليكن النطاق: نطاق_تغيير_لغة = (*الرمز).الموقع.النطاق;
        إذا ((الطول(الكلمة) مثل طبيعي) > 0
            && النطاق.النهاية.السطر >= النطاق.البداية.السطر
            && النطاق.النهاية.السطر - النطاق.البداية.السطر + 1 >= الحد
            && النطاق.النهاية.السطر >= من_سطر && النطاق.النهاية.السطر <= إلى_سطر) {
            ليكن الأجزاء: متجه نص = [«// », الكلمة, « », استنسخ(&(*الرمز).الاسم)];
            ليكن التلميح: تلميح_مضمن_لغة = {
                الموضع: النطاق.النهاية,
                النص: صل_النصوص(&الأجزاء, &«»),
                نوع_التلميح: 0
            };
            ألحق(الناتج, التلميح);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// ---- Imports from the compiler's import edges -----------------------------------
// Which file an import statement names, and which statements import a file,
// come from the compiler's import relations (علاقات_استيراد_واجهة): the LSP
// does not resolve module paths itself. Only the path's place inside the
// statement is found here, from the statement's own text.

// The module path written in an import statement: its bytes, and whether it
// is a quoted file path (`import "util.sn";`) or a dotted one.
عام نوع مسار_استيراد_مكتوب_لغة = {
    البداية: طبيعي,
    النهاية: طبيعي,
    نصي: منطقي
};

عام عرف مسار_في_عبارة_استيراد_لغة(النص: &نص, البداية: طبيعي, النهاية: طبيعي): اختياري مسار_استيراد_مكتوب_لغة {
    ليكن الحد: طبيعي = النهاية;
    إذا (الحد > (الطول(*النص) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = البداية;
    // The keyword (`import`, `استورد`, `from`, `من`), then spaces.
    طالما (ف < الحد && (*النص)[ف] != 0x20 && (*النص)[ف] != 0x09) { ف := ف + 1; }
    طالما (ف < الحد && ((*النص)[ف] == 0x20 || (*النص)[ف] == 0x09)) { ف := ف + 1; }
    إذا (ف >= الحد) { أرجع اختياري.لا_شيء(); };
    إذا ((*النص)[ف] == 0x22) {
        ليكن البداية_الداخلية: طبيعي = ف + 1;
        ليكن م: متغير طبيعي = البداية_الداخلية;
        طالما (م < الحد && (*النص)[م] != 0x22) { م := م + 1; }
        إذا (م >= الحد) { أرجع اختياري.لا_شيء(); };
        ليكن الناتج: مسار_استيراد_مكتوب_لغة = { البداية: البداية_الداخلية, النهاية: م, نصي: صواب };
        أرجع اختياري.موجود(الناتج);
    };
    ليكن البداية_المنقوطة: طبيعي = ف;
    طالما (ف < الحد && (*النص)[ف] != 0x20 && (*النص)[ف] != 0x09 && (*النص)[ف] != 0x3B
        && (*النص)[ف] != 0x7B && (*النص)[ف] != 0x0A) { ف := ف + 1; }
    إذا (ف == البداية_المنقوطة) { أرجع اختياري.لا_شيء(); };
    ليكن الناتج: مسار_استيراد_مكتوب_لغة = { البداية: البداية_المنقوطة, النهاية: ف, نصي: خطأ };
    أرجع اختياري.موجود(الناتج);
}

// Import links of an open document: each import statement's written path,
// linked to the file the compiler resolved it to (std modules in any layer,
// spelled module names, package imports).
عام عرف روابط_استيراد_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه رابط_بنيوي_لغة {
    ليكن الناتج: متغير متجه رابط_بنيوي_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المصدر) -> {
            ليكن العلاقات: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(الواجهة, المصدر, صواب);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العلاقات) مثل طبيعي)) {
                ليكن العلاقة: &علاقة_استيراد_وحدة = &العلاقات[ف];
                طابق (*العلاقة).نطاق_العبارة مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النطاق) -> {
                    طابق مسار_في_عبارة_استيراد_لغة(&(*المستند).النص, النطاق.البداية.البايت مثل طبيعي, النطاق.النهاية.البايت مثل طبيعي) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(المكتوب) -> {
                        طابق مصدر_واجهة_بمعرف(الواجهة, (*العلاقة).مصدر_المستورد_منه) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(الهدف) -> {
                            ليكن الرابط: رابط_بنيوي_لغة = {
                                البداية: المكتوب.البداية,
                                النهاية: المكتوب.النهاية,
                                المسار: مسار_مطلق_لغة(&الهدف.الاسم)
                            };
                            ألحق(الناتج, الرابط);
                        };
                    };
                };
                ف := ف + 1;
            }
        };
    };
    أرجع الناتج;
}

// One import to rewrite when a file moves: the importing file, its text (for
// positions), the bytes of the written path, and the new path text.
عام نوع تعديل_استيراد_لغة = {
    المسار: نص,
    المحتوى: نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    الجديد: نص
};

// A file's name without `.sn`.
عرف جذع_ملف_مصدر_لغة(المسار: &نص): نص {
    طابق اسم_الملف(المسار) مع
    | اختياري.لا_شيء -> { أرجع «»; }
    | اختياري.موجود(الاسم) -> {
        ليكن اللاحقة: نص = «.sn»;
        إذا (ينتهي_بـ(&الاسم, &اللاحقة)) {
            طابق مقطع_نص(&الاسم, 0, (الطول(الاسم) مثل طبيعي) - 3) مع
            | اختياري.موجود(الجذع) -> { أرجع الجذع; }
            | اختياري.لا_شيء -> { };
        };
        أرجع الاسم;
    };
}

عرف اسم_معرف_صالح_لغة(النص: &نص): منطقي {
    إذا ((الطول(*النص) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن ب: ط8 = (*النص)[0];
    إذا (ب >= 0x30 && ب <= 0x39) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ليكن ح: ط8 = (*النص)[ف];
        إذا (ح == 0x2E || ح == 0x2D || ح == 0x20 || ح == 0x2F || ح == 0x5C) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The import statements to rewrite when القديم moves to الجديد: the
// compiler's edges into القديم (who imports it). A quoted path becomes the
// new path relative to the importing file; a dotted path keeps its modules
// and gets the new file name when the file stays in its folder. A dotted
// import of a file moved to another folder is left as it is (the compiler
// then reports it unresolved).
عام عرف تعديلات_استيراد_لنقل_ملف_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    القديم: &نص,
    الجديد: &نص
): متجه تعديل_استيراد_لغة {
    ليكن الناتج: متغير متجه تعديل_استيراد_لغة = [];
    ليكن القديم_المطبع: نص = مسار_مطلق_لغة(القديم);
    ليكن الجديد_المطبع: نص = مسار_مطلق_لغة(الجديد);
    ليكن المصادر: &متجه مصدر = &(*الواجهة).خريطة_المصادر.المصادر;
    ليكن المعرف: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصادر) مثل طبيعي)) {
        إذا (نصان_متساويان(&مسار_مطلق_لغة(&(*المصادر)[ف].الاسم), &القديم_المطبع)) {
            المعرف := اختياري.موجود((*المصادر)[ف].المعرف);
        };
        ف := ف + 1;
    }
    طابق المعرف مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(معرف_القديم) -> {
        ليكن العلاقات: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(الواجهة, معرف_القديم, خطأ);
        ف := 0;
        طالما (ف < (الطول(العلاقات) مثل طبيعي)) {
            ليكن العلاقة: &علاقة_استيراد_وحدة = &العلاقات[ف];
            طابق مصدر_واجهة_بمعرف(الواجهة, (*العلاقة).مصدر_المستورد) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المستورد) -> {
                طابق (*العلاقة).نطاق_العبارة مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النطاق) -> {
                    طابق مسار_في_عبارة_استيراد_لغة(&المستورد.المحتوى, النطاق.البداية.البايت مثل طبيعي, النطاق.النهاية.البايت مثل طبيعي) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(المكتوب) -> {
                        ليكن مسار_المستورد: نص = مسار_مطلق_لغة(&المستورد.الاسم);
                        ليكن الجديد_المكتوب: متغير اختياري نص = اختياري.لا_شيء();
                        إذا (المكتوب.نصي) {
                            طابق أب_المسار(&مسار_المستورد) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(الدليل) -> {
                                طابق مسار_نسبي_من(&الدليل, &الجديد_المطبع) مع
                                | اختياري.موجود(النسبي) -> { الجديد_المكتوب := اختياري.موجود(استبدل_في_النص(&النسبي, &«\\», &«/»)); }
                                | اختياري.لا_شيء -> { };
                            };
                        } وإلا {
                            // Same folder, new file name: the last module of the path.
                            ليكن نفس_المجلد: متغير منطقي = خطأ;
                            طابق أب_المسار(&القديم_المطبع) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(أ) -> {
                                طابق أب_المسار(&الجديد_المطبع) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(ب) -> { نفس_المجلد := نصان_متساويان(&أ, &ب); };
                            };
                            ليكن الاسم: نص = جذع_ملف_مصدر_لغة(&الجديد_المطبع);
                            إذا (نفس_المجلد && اسم_معرف_صالح_لغة(&الاسم)) {
                                طابق مقطع_نص(&المستورد.المحتوى, المكتوب.البداية, المكتوب.النهاية - المكتوب.البداية) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(القديم_المكتوب) -> {
                                    ليكن الأجزاء: متغير متجه نص = قسم_النص(&القديم_المكتوب, &«.»);
                                    ليكن العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
                                    إذا (العدد > 0) {
                                        الأجزاء[العدد - 1] := استنسخ(&الاسم);
                                        الجديد_المكتوب := اختياري.موجود(صل_النصوص(&الأجزاء, &«.»));
                                    };
                                };
                            };
                        };
                        طابق الجديد_المكتوب مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(النص_الجديد) -> {
                            ليكن التعديل: تعديل_استيراد_لغة = {
                                المسار: مسار_المستورد,
                                المحتوى: استنسخ(&المستورد.المحتوى),
                                البداية: المكتوب.البداية,
                                النهاية: المكتوب.النهاية,
                                الجديد: النص_الجديد
                            };
                            ألحق(الناتج, التعديل);
                        };
                    };
                };
            };
            ف := ف + 1;
        }
    };
    أرجع الناتج;
}
