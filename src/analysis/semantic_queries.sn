عام نوع موقع_دلالي_لغة = {
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة
};

عام عرف معرف_مصدر_مستند_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المستند: &مستند_لغة_مفتوح
): اختياري طبيعي {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مرجع_المسار: &اختياري نص = &د.مسار_الملف;
    ليكن المسار: اختياري نص = *مرجع_المسار;
    طابق المسار مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        // The compiler may know the document by a checkout-relative name.
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الواجهة).خريطة_المصادر.المصادر) مثل طبيعي)) {
            إذا (مساران_لنفس_الملف_لغة(&(*الواجهة).خريطة_المصادر.المصادر[ف].الاسم, &القيمة)) {
                أرجع اختياري.موجود((*الواجهة).خريطة_المصادر.المصادر[ف].المعرف);
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عرف نطاق_مصدر_إلى_نطاق_لغة(
    المصدر: &مصدر,
    النطاق: نطاق
): اختياري نطاق_تغيير_لغة {
    ليكن م: مصدر = *المصدر;
    إذا (((النطاق.البداية.المصدر مثل طبيعي) != م.المعرف) || ((النطاق.النهاية.المصدر مثل طبيعي) != م.المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الفهرس: فهرس_سطور = ابن_فهرس_السطور(&م.المحتوى);
    ليكن بداية16: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
    ليكن نهاية16: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&م.المحتوى, &الفهرس, (النطاق.البداية.البايت مثل طبيعي)) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { بداية16 := الموضع; };
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&م.المحتوى, &الفهرس, (النطاق.النهاية.البايت مثل طبيعي)) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { نهاية16 := الموضع; };
    ليكن البداية: موضع_تغيير_لغة = { السطر: بداية16.السطر, المحرف: بداية16.العمود };
    ليكن النهاية: موضع_تغيير_لغة = { السطر: نهاية16.السطر, المحرف: نهاية16.العمود };
    ليكن الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختياري.موجود(الناتج);
}

// Source names of std modules are relative to the working directory (the
// SultanC checkout); editor locations need absolute file URIs.
عرف مسار_مطلق_لغة(المسار: &نص): نص {
    إذا (مسار_مطلق(المسار)) { أرجع استنسخ(المسار); };
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع استنسخ(المسار); }
    | نتيجة.نجح(الجذر) -> { أرجع صل_المسار(&الجذر, المسار); };
}

// A span as an LSP location: the source's file URI and the compiler's own
// line / UTF-16 column mapping (tooling_queries.sn مدى_أداة_واجهة).
عرف عنوان_مصدر_واجهة_لغة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): اختياري نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        ليكن اسم_المصدر: نص = مسار_مطلق_لغة(&القيمة.الاسم);
        طابق مسار_إلى_عنوان_ملف(&اسم_المصدر) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(العنوان) -> { أرجع اختياري.موجود(العنوان); };
    };
}

عرف نطاق_لغة_من_مدى_أداة(المدى: &مدى_أداة): نطاق_تغيير_لغة {
    ليكن البداية: موضع_تغيير_لغة = { السطر: (*المدى).البداية.السطر, المحرف: (*المدى).البداية.العمود_يوتيف16 };
    ليكن النهاية: موضع_تغيير_لغة = { السطر: (*المدى).النهاية.السطر, المحرف: (*المدى).النهاية.العمود_يوتيف16 };
    ليكن الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع الناتج;
}

عام عرف موقع_نطاق_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النطاق: نطاق
): اختياري موقع_دلالي_لغة {
    طابق مدى_أداة_واجهة(الواجهة, النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المدى) -> {
        طابق عنوان_مصدر_واجهة_لغة(الواجهة, المدى.المصدر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            ليكن الناتج: موقع_دلالي_لغة = { العنوان: العنوان, النطاق: نطاق_لغة_من_مدى_أداة(&المدى) };
            أرجع اختياري.موجود(الناتج);
        };
    };
}

// Many spans at once: each source's line index is built once per batch.
عام عرف مواقع_نطاقات_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النطاقات: &متجه نطاق
): متجه اختياري موقع_دلالي_لغة {
    ليكن المديات: متجه اختياري مدى_أداة = مديات_أداة_واجهة(الواجهة, النطاقات);
    ليكن العناوين: متغير متجه اختياري نص = [];
    ليكن الناتج: متغير متجه اختياري موقع_دلالي_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المديات) مثل طبيعي)) {
        طابق استنسخ(&المديات[ف]) مع
        | اختياري.لا_شيء -> { ألحق(الناتج, اختياري.لا_شيء()); }
        | اختياري.موجود(المدى) -> {
            طالما ((الطول(العناوين) مثل طبيعي) <= المدى.المصدر) { ألحق(العناوين, اختياري.لا_شيء()); }
            إذا (!هل_اختياري_نص_موجود_لغة(&العناوين[المدى.المصدر])) {
                العناوين[المدى.المصدر] := عنوان_مصدر_واجهة_لغة(الواجهة, المدى.المصدر);
            };
            طابق استنسخ(&العناوين[المدى.المصدر]) مع
            | اختياري.لا_شيء -> { ألحق(الناتج, اختياري.لا_شيء()); }
            | اختياري.موجود(العنوان) -> {
                ليكن الموقع: موقع_دلالي_لغة = { العنوان: العنوان, النطاق: نطاق_لغة_من_مدى_أداة(&المدى) };
                ألحق(الناتج, اختياري.موجود(الموقع));
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هل_اختياري_نص_موجود_لغة(القيمة: &اختياري نص): منطقي {
    طابق استنسخ(القيمة) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}


عرف نطاق_مصدر_إلى_نطاق_لغة_للمستند(
    المستند: &مستند_لغة_مفتوح,
    النطاق: نطاق
): اختياري نطاق_تغيير_لغة {
    ليكن البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (النطاق.البداية.البايت مثل طبيعي)) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { البداية := الموضع; };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (النطاق.النهاية.البايت مثل طبيعي)) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { النهاية := الموضع; };
    ليكن الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختياري.موجود(الناتج);
}

عام عرف رمز_لقطة_عند_موضع_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري معرف_رمز {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        أرجع رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت);
    };
}

عام عرف نطاق_إعادة_تسمية_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري نطاق_تغيير_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق حضر_إعادة_تسمية_واجهة(الواجهة, المصدر, البايت) مع
        | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(_) -> {
            طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الظهور) -> {
                أرجع نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق);
            };
        };
    };
}

عرف نص_نوع_تصريح_لغة(النوع: نوع_تصريح): نص {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع «function»; }
    | نوع_تصريح.دالة_خارجية -> { أرجع «extern function»; }
    | نوع_تصريح.مرادف_نوع -> { أرجع «type alias»; }
    | نوع_تصريح.سجل -> { أرجع «record»; }
    | نوع_تصريح.معتم -> { أرجع «opaque type»; }
    | نوع_تصريح.تعداد -> { أرجع «enum»; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع «constructor»; }
    | نوع_تصريح.معامل_نوع -> { أرجع «type parameter»; }
    | نوع_تصريح.معامل -> { أرجع «parameter»; }
    | نوع_تصريح.قيمة_عليا -> { أرجع «module value»; }
    | نوع_تصريح.ربط_محلي -> { أرجع «local»; };
}

عرف صل_أجزاء_تحويم_لغة(الأجزاء: &متجه نص): نص {
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(الأجزاء, &الفاصل);
}

عرف اسم_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_الاسم.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن العدد: طبيعي = طول_نطاق_بالبايت(ت.نطاق_الاسم);
        أرجع مقطع_نص(&المصدر.المحتوى, (ت.نطاق_الاسم.البداية.البايت مثل طبيعي), العدد);
    };
}

// Type spelling in the document's surface language (`int` in an English file,
// `عدد` in an Arabic one), from the compiler's own type renderer.
عام عرف تهجئة_نوع_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع,
    عربي: منطقي
): اختياري نص {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأسماء) -> {
        ليكن اللغة: متغير لغة_تشخيص = لغة_تشخيص.الإنجليزية();
        إذا (عربي) { اللغة := لغة_تشخيص.العربية(); };
        أرجع تهجئة_نوع_بلغة(
            &(*الواجهة).سياقات_الأنواع.الأنواع, &الأسماء.الأسماء, &الأسماء.الرموز, اللغة, النوع
        );
    };
}

عرف بلغة_العرض_لغة(الإنجليزي: نص, العربي: نص, عربي: منطقي): نص {
    إذا (عربي) { أرجع العربي; };
    أرجع الإنجليزي;
}

عرف نص_نوع_تصريح_معروض_لغة(النوع: نوع_تصريح, عربي: منطقي): نص {
    إذا (!عربي) { أرجع نص_نوع_تصريح_لغة(النوع); };
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع «دالة»; }
    | نوع_تصريح.دالة_خارجية -> { أرجع «دالة خارجية»; }
    | نوع_تصريح.مرادف_نوع -> { أرجع «مرادف نوع»; }
    | نوع_تصريح.سجل -> { أرجع «سجل»; }
    | نوع_تصريح.معتم -> { أرجع «نوع معتم»; }
    | نوع_تصريح.تعداد -> { أرجع «تعداد»; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع «منشئ»; }
    | نوع_تصريح.معامل_نوع -> { أرجع «معامل نوع»; }
    | نوع_تصريح.معامل -> { أرجع «معامل»; }
    | نوع_تصريح.قيمة_عليا -> { أرجع «قيمة وحدة»; }
    | نوع_تصريح.ربط_محلي -> { أرجع «متغير محلي»; };
}

// Documentation is the contiguous `//` (or `///`) comment block directly above a
// declaration, read the way gopls reads Go doc comments; a blank line ends it.
عرف نص_تعليق_توثيق_لغة(السطر: &نص): نص {
    ليكن ق: نص = استنسخ(السطر);
    ليكن الطول_الكلي: طبيعي = الطول(ق) مثل طبيعي;
    ليكن البداية: متغير طبيعي = 2;
    إذا (الطول_الكلي > 2) { إذا (ق[2] == 0x2F) { البداية := 3; }; };
    إذا (الطول_الكلي > البداية) { إذا (ق[البداية] == 0x20) { البداية := البداية + 1; }; };
    إذا (البداية >= الطول_الكلي) { أرجع «»; };
    طابق مقطع_نص(&ق, البداية, الطول_الكلي - البداية) مع
    | اختياري.لا_شيء -> { أرجع «»; }
    | اختياري.موجود(الباقي) -> { أرجع الباقي; };
}

عرف توثيق_تصريح_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_التصريح.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن الحد: طبيعي = الطول(المصدر.المحتوى) مثل طبيعي;
        ليكن بداية_السطر: متغير طبيعي = (ت.نطاق_التصريح.البداية.البايت مثل طبيعي);
        إذا (بداية_السطر > الحد) { أرجع اختياري.لا_شيء(); };
        ليكن يبحث: متغير منطقي = صواب;
        طالما (يبحث && (بداية_السطر > 0)) {
            إذا (المصدر.المحتوى[بداية_السطر - 1] == 0x0A) { يبحث := خطأ; } وإلا { بداية_السطر := بداية_السطر - 1; };
        }
        ليكن الأسطر: متغير متجه نص = [];
        ليكن المؤشر: متغير طبيعي = بداية_السطر;
        ليكن مستمر: متغير منطقي = صواب;
        طالما (مستمر && (المؤشر > 0)) {
            ليكن نهاية_السابق: طبيعي = المؤشر - 1;
            ليكن بداية_السابق: متغير طبيعي = نهاية_السابق;
            ليكن يرجع: متغير منطقي = صواب;
            طالما (يرجع && (بداية_السابق > 0)) {
                إذا (المصدر.المحتوى[بداية_السابق - 1] == 0x0A) { يرجع := خطأ; } وإلا { بداية_السابق := بداية_السابق - 1; };
            }
            طابق مقطع_نص(&المصدر.المحتوى, بداية_السابق, نهاية_السابق - بداية_السابق) مع
            | اختياري.لا_شيء -> { مستمر := خطأ; }
            | اختياري.موجود(السطر) -> {
                ليكن المقصوص: نص = قص_النص(&السطر);
                ليكن بادئة: نص = «//»;
                إذا (يبدأ_بـ(&المقصوص, &بادئة)) {
                    ألحق(الأسطر, نص_تعليق_توثيق_لغة(&المقصوص));
                    المؤشر := بداية_السابق;
                } وإلا { مستمر := خطأ; };
            };
        }
        إذا ((الطول(الأسطر) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
        ليكن المرتبة: متغير متجه نص = [];
        ليكن ف: متغير طبيعي = الطول(الأسطر) مثل طبيعي;
        طالما (ف > 0) {
            ف := ف - 1;
            ألحق(المرتبة, استنسخ(&الأسطر[ف]));
        }
        ليكن الفاصل: نص = "\n";
        أرجع اختياري.موجود(صل_النصوص(&المرتبة, &الفاصل));
    };
}

// Full declaration text for type declarations (records and enums show their
// fields and constructors), capped so a large enum does not flood the hover.
عرف نص_تصريح_كامل_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي,
    حد_الأسطر: طبيعي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_التصريح.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن البداية: طبيعي = (ت.نطاق_التصريح.البداية.البايت مثل طبيعي);
        ليكن حد_المصدر: طبيعي = الطول(المصدر.المحتوى) مثل طبيعي;
        ليكن النهاية: متغير طبيعي = (ت.نطاق_التصريح.النهاية.البايت مثل طبيعي);
        إذا (النهاية > حد_المصدر) { النهاية := حد_المصدر; };
        إذا (البداية >= النهاية) { أرجع اختياري.لا_شيء(); };
        ليكن الأسطر_المعدودة: متغير طبيعي = 0;
        ليكن المقطوع: متغير منطقي = خطأ;
        ليكن ف: متغير طبيعي = البداية;
        طالما (ف < النهاية) {
            إذا (المصدر.المحتوى[ف] == 0x0A) {
                الأسطر_المعدودة := الأسطر_المعدودة + 1;
                إذا (الأسطر_المعدودة >= حد_الأسطر) { النهاية := ف; المقطوع := صواب; };
            };
            ف := ف + 1;
        }
        طابق مقطع_نص(&المصدر.المحتوى, البداية, النهاية - البداية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النص) -> {
            ليكن المقصوص: نص = قص_النص(&النص);
            إذا (!المقطوع) { أرجع اختياري.موجود(المقصوص); };
            ليكن الأجزاء: متجه نص = [المقصوص, "\n    …"];
            ليكن الفاصل: نص = «»;
            أرجع اختياري.موجود(صل_النصوص(&الأجزاء, &الفاصل));
        };
    };
}

عرف نوع_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز,
    عربي: منطقي
): اختياري نص {
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(معرف_النوع) -> { أرجع تهجئة_نوع_لغة(الواجهة, معرف_النوع, عربي); };
}

عرف رمز_هو_بدء_البرنامج_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): منطقي {
    ليكن الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    طابق الحالة.رمز_بدء_البرنامج مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(رمز_البدء) -> { أرجع معرفا_رمز_متساويان(رمز_البدء, الرمز); };
}

عرف نوع_ناتج_دالة_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز,
    عربي: منطقي
): اختياري نص {
    ليكن الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(نوع_الدالة) -> {
        طابق نوع_ناتج_دالة_دلالي(&الحالة.سياقات_الأنواع.الأنواع, نوع_الدالة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(نوع_الناتج) -> { أرجع تهجئة_نوع_لغة(الواجهة, نوع_الناتج, عربي); };
    };
}

عرف رأس_تصريح_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_التصريح.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن البداية: طبيعي = (ت.نطاق_التصريح.البداية.البايت مثل طبيعي);
        ليكن حد_التصريح: طبيعي = (ت.نطاق_التصريح.النهاية.البايت مثل طبيعي);
        ليكن حد_المصدر: طبيعي = الطول(المصدر.المحتوى) مثل طبيعي;
        ليكن النهاية_القصوى: متغير طبيعي = حد_المصدر;
        إذا (حد_التصريح < حد_المصدر) { النهاية_القصوى := حد_التصريح; };
        إذا (البداية >= النهاية_القصوى) { أرجع اختياري.لا_شيء(); };
        ليكن النهاية: متغير طبيعي = البداية;
        ليكن مستمر: متغير منطقي = صواب;
        طالما (مستمر && (النهاية < النهاية_القصوى)) {
            ليكن البايت: ط8 = المصدر.المحتوى[النهاية];
            إذا ((البايت == 0x0A) || (البايت == 0x7B) || (البايت == 0x3B)) {
                مستمر := خطأ;
            } وإلا {
                النهاية := النهاية + 1;
            };
        }
        طابق مقطع_نص(&المصدر.المحتوى, البداية, النهاية - البداية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرأس) -> {
            ليكن المنظف: نص = قص_النص(&الرأس);
            إذا ((الطول(المنظف) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(المنظف);
        };
    };
}

عرف وصف_رمز_مالك_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المالك: معرف_رمز,
    عربي: منطقي
): اختياري نص {
    طابق تصريح_رمز_واجهة(الواجهة, المالك) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التصريح) -> {
        طابق اسم_رمز_تحويم_لغة(الواجهة, &التصريح) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> {
            ليكن النوع: نص = نص_نوع_تصريح_معروض_لغة(التصريح.النوع, عربي);
            ليكن الأجزاء: متجه نص = [النوع, « `», الاسم, «`»];
            أرجع اختياري.موجود(صل_أجزاء_تحويم_لغة(&الأجزاء));
        };
    };
}

عرف وصف_دالة_حاوية_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي,
    عربي: منطقي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    ليكن الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, (ت.نطاق_الاسم.البداية.المصدر مثل طبيعي));
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        ليكن المرشح: رمز_دلالي = الرموز[ف];
        ليكن هل_دالة: متغير منطقي = خطأ;
        طابق المرشح.النوع مع
        | نوع_تصريح.دالة -> { هل_دالة := صواب; }
        | نوع_تصريح.دالة_خارجية -> { هل_دالة := صواب; }
        | _ -> { };
        إذا (هل_دالة && !معرفا_رمز_متساويان(المرشح.المعرف, ت.المعرف)
            && نطاق_داخل_نطاق_تحويم_لغة(ت.نطاق_الاسم, المرشح.نطاق_التصريح)) {
            أرجع وصف_رمز_مالك_تحويم_لغة(الواجهة, المرشح.المعرف, عربي);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أسماء_رموز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرموز: &متجه معرف_رمز
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن القيم: متجه معرف_رمز = *الرموز;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        طابق تصريح_رمز_واجهة(الواجهة, القيم[ف]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التصريح) -> {
            طابق اسم_رمز_تحويم_لغة(الواجهة, &التصريح) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الاسم) -> {
                ليكن الأجزاء: متجه نص = [«`», الاسم, «`»];
                ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سطر_وسم_تحويم_لغة(الوسم: نص, القيمة: نص): نص {
    ليكن الأجزاء: متجه نص = [«**», الوسم, «:** », القيمة];
    أرجع صل_أجزاء_تحويم_لغة(&الأجزاء);
}

عرف نطاق_داخل_نطاق_تحويم_لغة(الداخلي: نطاق, الخارجي: نطاق): منطقي {
    إذا ((الداخلي.البداية.المصدر مثل طبيعي) != (الخارجي.البداية.المصدر مثل طبيعي)) { أرجع خطأ; };
    إذا ((الداخلي.النهاية.المصدر مثل طبيعي) != (الخارجي.النهاية.المصدر مثل طبيعي)) { أرجع خطأ; };
    أرجع ((الداخلي.البداية.البايت مثل طبيعي) >= (الخارجي.البداية.البايت مثل طبيعي))
        && ((الداخلي.النهاية.البايت مثل طبيعي) <= (الخارجي.النهاية.البايت مثل طبيعي));
}

عرف معاملات_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    نطاق_التصريح: نطاق,
    عربي: منطقي
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, (نطاق_التصريح.البداية.المصدر مثل طبيعي));
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        ليكن الابن: رمز_دلالي = الرموز[ف];
        إذا (نطاق_داخل_نطاق_تحويم_لغة(الابن.نطاق_الاسم, نطاق_التصريح)) {
            طابق الابن.النوع مع
            | نوع_تصريح.معامل -> {
                طابق اسم_رمز_تحويم_لغة(الواجهة, &الابن) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الاسم) -> {
                    طابق نوع_رمز_تحويم_لغة(الواجهة, الابن.المعرف, عربي) مع
                    | اختياري.لا_شيء -> {
                        ليكن الأجزاء: متجه نص = [«`», الاسم, «`»];
                        ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                    }
                    | اختياري.موجود(النوع) -> {
                        ليكن الأجزاء: متجه نص = [«`», الاسم, «: », النوع, «`»];
                        ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                    };
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف معاملات_نوع_رمز_تحويم_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    نطاق_التصريح: نطاق
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, (نطاق_التصريح.البداية.المصدر مثل طبيعي));
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        ليكن الابن: رمز_دلالي = الرموز[ف];
        إذا (نطاق_داخل_نطاق_تحويم_لغة(الابن.نطاق_الاسم, نطاق_التصريح)) {
            طابق الابن.النوع مع
            | نوع_تصريح.معامل_نوع -> {
                طابق اسم_رمز_تحويم_لغة(الواجهة, &الابن) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الاسم) -> {
                    ليكن الأجزاء: متجه نص = [«`», الاسم, «`»];
                    ألحق(الناتج, صل_أجزاء_تحويم_لغة(&الأجزاء));
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}


// "Defined in" as a link the editor can follow; std paths relative to the
// working directory stay plain text.
عرف موقع_تعريف_تحويم_لغة(المسار_الأصلي: &نص, السطر: نص, العمود: نص): نص {
    // std sources are named relative to the working directory (the checkout).
    ليكن المطلق: متغير نص = استنسخ(المسار_الأصلي);
    إذا (!مسار_مطلق(المسار_الأصلي)) {
        طابق دليل_العمل() مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(الجذر) -> { المطلق := صل_المسار(&الجذر, المسار_الأصلي); };
    };
    ليكن المسار: &نص = &المطلق;
    ليكن الاسم: متغير نص = استنسخ(المسار);
    طابق اسم_الملف(المسار) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
    ليكن الفاصل: نص = «»;
    إذا (مسار_مطلق(المسار)) {
        طابق مسار_إلى_عنوان_ملف(المسار) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(العنوان) -> {
            ليكن أجزاء_الرابط: متجه نص = [
                «[», استنسخ(&الاسم), «:», استنسخ(&السطر), «:», استنسخ(&العمود), «](»,
                العنوان, «#L», استنسخ(&السطر), «,», استنسخ(&العمود), «)»
            ];
            أرجع صل_النصوص(&أجزاء_الرابط, &الفاصل);
        };
    };
    ليكن الأجزاء: متجه نص = [«`», استنسخ(المسار), «:», السطر, «:», العمود, «`»];
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف نص_تحويم_رمز_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز,
    التصريح: &رمز_دلالي,
    عربي: منطقي
): اختياري نص {
    ليكن ت: رمز_دلالي = *التصريح;
    ليكن الاسم: متغير نص = «»;
    طابق اسم_رمز_تحويم_لغة(الواجهة, &ت) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };

    // Signature block: functions show their header; type declarations their body.
    ليكن نوع_كامل: متغير منطقي = خطأ;
    طابق ت.النوع مع
    | نوع_تصريح.سجل -> { نوع_كامل := صواب; }
    | نوع_تصريح.معتم -> { نوع_كامل := صواب; }
    | نوع_تصريح.تعداد -> { نوع_كامل := صواب; }
    | نوع_تصريح.مرادف_نوع -> { نوع_كامل := صواب; }
    | _ -> { };
    ليكن نص_توقيع: متغير نص = «»;
    ليكن وجد_توقيع: متغير منطقي = خطأ;
    إذا (نوع_كامل) {
        طابق نص_تصريح_كامل_لغة(الواجهة, &ت, 20) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النص) -> { نص_توقيع := النص; وجد_توقيع := صواب; };
    };
    إذا (!وجد_توقيع) {
        طابق رأس_تصريح_تحويم_لغة(الواجهة, &ت) مع
        | اختياري.لا_شيء -> {
            ليكن نوع_التوقيع: نص = نص_نوع_تصريح_معروض_لغة(ت.النوع, عربي);
            ليكن أجزاء_التوقيع: متجه نص = [نوع_التوقيع, « », استنسخ(&الاسم)];
            نص_توقيع := صل_أجزاء_تحويم_لغة(&أجزاء_التوقيع);
        }
        | اختياري.موجود(الرأس) -> { نص_توقيع := الرأس; };
    };
    ليكن رأس: متجه نص = ["```sultanc\n", نص_توقيع, "\n```"];
    ليكن نص_الرأس: نص = صل_أجزاء_تحويم_لغة(&رأس);
    ليكن الأسطر: متغير متجه نص = [نص_الرأس];

    طابق توثيق_تصريح_لغة(الواجهة, &ت) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(التوثيق) -> { ألحق(الأسطر, التوثيق); };

    ليكن الخصائص: متغير متجه نص = [];
    ليكن نوع_التصريح: نص = نص_نوع_تصريح_معروض_لغة(ت.النوع, عربي);
    ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Kind», «الصنف», عربي), نوع_التصريح));
    إذا (!نوع_كامل) {
        طابق نوع_رمز_تحويم_لغة(الواجهة, الرمز, عربي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النوع) -> {
            ليكن أجزاء_النوع: متجه نص = [«`», النوع, «`»];
            ليكن نص_النوع: نص = صل_أجزاء_تحويم_لغة(&أجزاء_النوع);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Type», «النوع», عربي), نص_النوع));
        };
    };

    ليكن هو_بدء_البرنامج: منطقي = رمز_هو_بدء_البرنامج_تحويم_لغة(الواجهة, الرمز);
    إذا (هو_بدء_البرنامج) {
        ألحق(الخصائص, سطر_وسم_تحويم_لغة(
            بلغة_العرض_لغة(«Role», «الدور», عربي),
            بلغة_العرض_لغة(«program entry point», «نقطة بدء البرنامج», عربي)
        ));
    };
    ليكن يعرض_الرؤية: متغير منطقي = خطأ;
    طابق ت.النوع مع
    | نوع_تصريح.دالة -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.دالة_خارجية -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.مرادف_نوع -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.سجل -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.معتم -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.تعداد -> { يعرض_الرؤية := صواب; }
    | نوع_تصريح.قيمة_عليا -> { يعرض_الرؤية := صواب; }
    | _ -> { };
    إذا (ت.علني) {
        ألحق(الخصائص, سطر_وسم_تحويم_لغة(
            بلغة_العرض_لغة(«Visibility», «الرؤية», عربي), بلغة_العرض_لغة(«public», «عام», عربي)
        ));
    } وإلا إذا (يعرض_الرؤية && !هو_بدء_البرنامج) {
        ألحق(الخصائص, سطر_وسم_تحويم_لغة(
            بلغة_العرض_لغة(«Visibility», «الرؤية», عربي), بلغة_العرض_لغة(«private», «خاص», عربي)
        ));
    };

    ليكن يعرض_معاملات_نوع: متغير منطقي = خطأ;
    ليكن يعرض_معاملات: متغير منطقي = خطأ;
    طابق ت.النوع مع
    | نوع_تصريح.دالة -> { يعرض_معاملات_نوع := صواب; يعرض_معاملات := صواب; }
    | نوع_تصريح.دالة_خارجية -> { يعرض_معاملات_نوع := صواب; يعرض_معاملات := صواب; }
    | _ -> { };
    إذا (يعرض_معاملات_نوع) {
        ليكن معاملات_النوع: متجه نص = معاملات_نوع_رمز_تحويم_لغة(الواجهة, ت.نطاق_التصريح);
        إذا ((الطول(معاملات_النوع) مثل طبيعي) > 0) {
            ليكن الفاصل: نص = «, »;
            ليكن النص: نص = صل_النصوص(&معاملات_النوع, &الفاصل);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Type parameters», «معاملات النوع», عربي), النص));
        };
    };
    إذا (يعرض_معاملات) {
        ليكن المعاملات: متجه نص = معاملات_رمز_تحويم_لغة(الواجهة, ت.نطاق_التصريح, عربي);
        إذا ((الطول(المعاملات) مثل طبيعي) > 0) {
            ليكن الفاصل: نص = «, »;
            ليكن النص: نص = صل_النصوص(&المعاملات, &الفاصل);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Parameters», «المعاملات», عربي), النص));
        };
        طابق نوع_ناتج_دالة_تحويم_لغة(الواجهة, الرمز, عربي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الناتج) -> {
            ليكن أجزاء_الناتج: متجه نص = [«`», الناتج, «`»];
            ليكن نص_الناتج: نص = صل_أجزاء_تحويم_لغة(&أجزاء_الناتج);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Returns», «يرجع», عربي), نص_الناتج));
        };
    };

    ليكن عرض_المالك: متغير منطقي = خطأ;
    طابق ت.المالك مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المالك) -> {
        طابق وصف_رمز_مالك_تحويم_لغة(الواجهة, المالك, عربي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الوصف) -> {
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Owner», «المالك», عربي), الوصف));
            عرض_المالك := صواب;
        };
    };
    إذا (!عرض_المالك) {
        طابق وصف_دالة_حاوية_تحويم_لغة(الواجهة, &ت, عربي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الوصف) -> {
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Owner», «المالك», عربي), الوصف));
        };
    };

    طابق ت.النوع مع
    | نوع_تصريح.مرادف_نوع -> {
        ليكن العليا: متجه معرف_رمز = أنواع_عليا_لرمز_واجهة(الواجهة, الرمز);
        ليكن أسماء_العليا: متجه نص = أسماء_رموز_تحويم_لغة(الواجهة, &العليا);
        إذا ((الطول(أسماء_العليا) مثل طبيعي) > 0) {
            ليكن فاصل_أسماء: نص = «, »;
            ليكن نص_العليا: نص = صل_النصوص(&أسماء_العليا, &فاصل_أسماء);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Alias of», «مرادف لـ», عربي), نص_العليا));
        };
        ليكن الفرعية: متجه معرف_رمز = أنواع_فرعية_لرمز_واجهة(الواجهة, الرمز);
        ليكن أسماء_الفرعية: متجه نص = أسماء_رموز_تحويم_لغة(الواجهة, &الفرعية);
        إذا ((الطول(أسماء_الفرعية) مثل طبيعي) > 0) {
            ليكن فاصل_أسماء: نص = «, »;
            ليكن نص_الفرعية: نص = صل_النصوص(&أسماء_الفرعية, &فاصل_أسماء);
            ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Aliased by», «مرادفاته», عربي), نص_الفرعية));
        };
    }
    | _ -> { };

    طابق اسم_مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_الاسم.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المصدر) -> {
        // Source positions are byte offsets; line and column come from the source text.
        ليكن معرف_المصدر: طبيعي = (ت.نطاق_الاسم.البداية.المصدر مثل طبيعي);
        إذا (معرف_المصدر < (الطول((*الواجهة).خريطة_المصادر.المصادر) مثل طبيعي)) {
            طابق إحداثي_مصدر_عند(&(*الواجهة).خريطة_المصادر.المصادر[معرف_المصدر], (ت.نطاق_الاسم.البداية.البايت مثل طبيعي)) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الإحداثي) -> {
                ليكن السطر: نص = طبيعي_إلى_نص(الإحداثي.السطر مثل طبيعي);
                ليكن العمود: نص = طبيعي_إلى_نص((الإحداثي.العمود مثل طبيعي) + 1);
                ليكن نص_الموقع: نص = موقع_تعريف_تحويم_لغة(&المصدر, السطر, العمود);
                ألحق(الخصائص, سطر_وسم_تحويم_لغة(بلغة_العرض_لغة(«Defined in», «معرف في», عربي), نص_الموقع));
            };
        };
    };

    // Properties render as one compact block (markdown hard line breaks).
    ليكن فاصل_الخصائص: نص = "  \n";
    ألحق(الأسطر, صل_النصوص(&الخصائص, &فاصل_الخصائص));
    ليكن الفاصل: نص = "\n\n---\n\n";
    أرجع اختياري.موجود(صل_النصوص(&الأسطر, &الفاصل));
}

عام عرف نطاق_تحويم_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري نطاق_تغيير_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الظهور) -> { أرجع نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق); };
    };
}

عام عرف نص_تحويم_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري نص {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };

        طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(التصريح) -> {
                طابق نص_تحويم_رمز_لغة(الواجهة, الرمز, &التصريح, مستند_لغة_بالعربية(المستند)) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النص) -> { أرجع اختياري.موجود(النص); };
            };
        }
        | اختياري.لا_شيء -> { };

        طابق نوع_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(معرف_النوع) -> {
            طابق تهجئة_نوع_لغة(الواجهة, معرف_النوع, مستند_لغة_بالعربية(المستند)) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(النوع) -> {
                ليكن الأجزاء: متجه نص = ["```sultanc\n", النوع, "\n```"];
                أرجع اختياري.موجود(صل_أجزاء_تحويم_لغة(&الأجزاء));
            };
        };
    };
}

عام عرف تعريف_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري موقع_دلالي_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التصريح) -> { أرجع موقع_نطاق_واجهة_لغة(الواجهة, التصريح.نطاق_الاسم); };
        };
    };
}

// One reference with its role (compiler reference_queries.sn دور_مرجع).
عام نوع مرجع_دلالي_لغة = {
    الموقع: موقع_دلالي_لغة,
    الدور: دور_مرجع
};

// Every reference of the symbol at the position, across modules, from the
// compiler's مراجع_رمز_واجهة (exact name spans, one per span).
عام عرف مراجع_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    يتضمن_التصريح: منطقي,
    المستند_الحالي_فقط: منطقي
): متجه مرجع_دلالي_لغة {
    ليكن الناتج: متغير متجه مرجع_دلالي_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر_الحالي: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المعرف) -> { المصدر_الحالي := المعرف; };
        ليكن الرمز: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_لقطة_عند_موضع_لغة(اللقطة, المستند, الموضع) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المعرف) -> { الرمز := المعرف; };
        ليكن المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, الرمز);
        ليكن المقبولة: متغير متجه مرجع_رمز_دلالي = [];
        ليكن النطاقات: متغير متجه نطاق = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المراجع) مثل طبيعي)) {
            ليكن المرجع: مرجع_رمز_دلالي = المراجع[ف];
            ليكن مقبول: متغير منطقي = صواب;
            إذا (المستند_الحالي_فقط && ((المرجع.النطاق.البداية.المصدر مثل طبيعي) != المصدر_الحالي)) { مقبول := خطأ; };
            إذا ((!يتضمن_التصريح) && المرجع.الدور == دور_مرجع.تصريح()) { مقبول := خطأ; };
            إذا (مقبول) { ألحق(المقبولة, المرجع); ألحق(النطاقات, المرجع.النطاق); };
            ف := ف + 1;
        }
        ليكن المواقع: متجه اختياري موقع_دلالي_لغة = مواقع_نطاقات_واجهة_لغة(الواجهة, &النطاقات);
        ف := 0;
        طالما (ف < (الطول(المواقع) مثل طبيعي)) {
            طابق استنسخ(&المواقع[ف]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموقع) -> {
                ليكن العنصر: مرجع_دلالي_لغة = { الموقع: الموقع, الدور: المقبولة[ف].الدور };
                ألحق(الناتج, العنصر);
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

// DocumentHighlightKind: 3 Write for writes and mutable borrows (and the
// declaration, which binds the value), 2 Read for every other reference.
عام عرف نوع_تمييز_دور_لغة(الدور: دور_مرجع): طبيعي {
    طابق الدور مع
    | دور_مرجع.كتابة -> { أرجع 3; }
    | دور_مرجع.استعارة_متغيرة -> { أرجع 3; }
    | دور_مرجع.تصريح -> { أرجع 3; }
    | _ -> { أرجع 2; };
}

عام عرف ظهورات_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    يتضمن_التصريح: منطقي,
    المستند_الحالي_فقط: منطقي
): متجه موقع_دلالي_لغة {
    ليكن المراجع: متجه مرجع_دلالي_لغة = مراجع_دلالية_لغة(اللقطة, المستند, الموضع, يتضمن_التصريح, المستند_الحالي_فقط);
    ليكن الناتج: متغير متجه موقع_دلالي_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المراجع) مثل طبيعي)) {
        ألحق(الناتج, استنسخ(&المراجع[ف].الموقع));
        ف := ف + 1;
    }
    أرجع الناتج;
}


عام نوع نتيجة_خطة_إعادة_تسمية_لغة =
    | جاهزة بنوع متجه موقع_دلالي_لغة
    | مرفوضة بنوع رفض_إعادة_تسمية_دلالي
;

عام عرف خطة_إعادة_تسمية_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    الاسم_الجديد: &نص
): نتيجة_خطة_إعادة_تسمية_لغة {
    ليكن المواقع: متغير متجه موقع_دلالي_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق خطط_إعادة_تسمية_واجهة(الواجهة, المصدر, البايت, الاسم_الجديد) مع
        | نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب) -> {
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(السبب);
        }
        | نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(الخطة) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الخطة.النطاقات) مثل طبيعي)) {
                طابق موقع_نطاق_واجهة_لغة(الواجهة, الخطة.النطاقات[ف]) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الموقع) -> { ألحق(المواقع, الموقع); };
                ف := ف + 1;
            }
            أرجع نتيجة_خطة_إعادة_تسمية_لغة.جاهزة(المواقع);
        };
    };
}

عام نوع اقتراح_إكمال_دلالي_لغة = {
    النص: نص,
    النوع: نوع_تصريح,
    التفصيل: اختياري نص,
    التوثيق: اختياري نص,
    // Keyword items carry no declaration; النوع is then ignored by the encoder.
    كلمة: منطقي,
    // Auto-import: the import line to add when the item is accepted.
    الإدراج: اختياري إدراج_استيراد_لغة,
    // An LSP CompletionItemKind that النوع cannot express (field, module).
    صنف_العنصر: اختياري نص,
    // The text the item inserts when it is not its label (`depth: ` for a
    // record field).
    نص_الإدراج: اختياري نص,
    // Its Type fits the Type the context expects (a call argument): ranked
    // first, and the first such item is preselected.
    يلائم: منطقي,
    // Rank: the compiler's distance (0 local, 1 parameter, 2 this module,
    // 3 imported, 4 std), 5 keywords, 6 auto-import.
    البعد: طبيعي,
    // The range the item replaces: the word being typed.
    المدى: اختياري نطاق_تغيير_لغة
};

عام نوع إدراج_استيراد_لغة = {
    السطر: طبيعي,
    النص: نص
};

عرف بايت_معرف_إكمال_لغة(ب: ط8): منطقي {
    أرجع (ب >= 0x80) || (ب == 0x5F) || (ب >= 0x30 && ب <= 0x39)
        || (ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A);
}

// Member context: `receiver.` or `receiver.pre|`. Returns the receiver spelling.
عرف مستقبل_إكمال_عضو_لغة(النص: &نص, البايت: طبيعي): اختياري نص {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (البايت > الحد) { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = البايت;
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && (ف > 0)) {
        إذا (بايت_معرف_إكمال_لغة((*النص)[ف - 1])) { ف := ف - 1; } وإلا { مستمر := خطأ; };
    }
    إذا (ف == 0) { أرجع اختياري.لا_شيء(); };
    إذا ((*النص)[ف - 1] != 0x2E) { أرجع اختياري.لا_شيء(); };
    ليكن نهاية_المستقبل: طبيعي = ف - 1;
    ليكن بداية_المستقبل: متغير طبيعي = نهاية_المستقبل;
    مستمر := صواب;
    طالما (مستمر && (بداية_المستقبل > 0)) {
        إذا (بايت_معرف_إكمال_لغة((*النص)[بداية_المستقبل - 1])) { بداية_المستقبل := بداية_المستقبل - 1; } وإلا { مستمر := خطأ; };
    }
    إذا (بداية_المستقبل == نهاية_المستقبل) { أرجع اختياري.لا_شيء(); };
    أرجع مقطع_نص(النص, بداية_المستقبل, نهاية_المستقبل - بداية_المستقبل);
}

عرف اقتراح_رمز_إكمال_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: &رمز_دلالي,
    الاسم_البديل: نص,
    عربي: منطقي
): اقتراح_إكمال_دلالي_لغة {
    ليكن ر: رمز_دلالي = *الرمز;
    // Insert the declaration's own spelling; canonical names are normalised
    // (أ/إ/آ -> ا) and would rewrite the user's identifier.
    ليكن النص: متغير نص = الاسم_البديل;
    طابق اسم_رمز_تحويم_لغة(الواجهة, &ر) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> { النص := القيمة; };
    ليكن التفصيل: متغير اختياري نص = اختياري.لا_شيء();
    طابق ر.النوع مع
    | نوع_تصريح.دالة -> { التفصيل := رأس_تصريح_تحويم_لغة(الواجهة, &ر); }
    | نوع_تصريح.دالة_خارجية -> { التفصيل := رأس_تصريح_تحويم_لغة(الواجهة, &ر); }
    | _ -> { التفصيل := نوع_رمز_تحويم_لغة(الواجهة, ر.المعرف, عربي); };
    ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = {
        النص: النص,
        النوع: ر.النوع,
        التفصيل: التفصيل,
        التوثيق: توثيق_تصريح_لغة(الواجهة, &ر),
        كلمة: خطأ,
        الإدراج: اختياري.لا_شيء(),
        صنف_العنصر: اختياري.لا_شيء(),
        نص_الإدراج: اختياري.لا_شيء(),
        يلائم: خطأ,
        البعد: 2,
        المدى: اختياري.لا_شيء()
    };
    أرجع الاقتراح;
}

// `Enum.` lists its constructors; `record_value.` lists the record's fields.
عرف اقتراحات_أعضاء_إكمال_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الروابط: &متجه ربط_اسم_نطاق,
    المستقبل: &نص,
    عربي: منطقي
): متجه اقتراح_إكمال_دلالي_لغة {
    ليكن الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        ليكن الربط: ربط_اسم_نطاق = (*الروابط)[ف];
        طابق تصريح_رمز_واجهة(الواجهة, الربط.الرمز) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            ليكن يطابق: متغير منطقي = خطأ;
            طابق اسم_رمز_تحويم_لغة(الواجهة, &الرمز) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الاسم) -> { يطابق := نصان_متساويان(&الاسم, المستقبل); };
            إذا (يطابق) {
                طابق الرمز.النوع مع
                | نوع_تصريح.تعداد -> {
                    ليكن الكل: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, (الرمز.نطاق_التصريح.البداية.المصدر مثل طبيعي));
                    ليكن ح: متغير طبيعي = 0;
                    طالما (ح < (الطول(الكل) مثل طبيعي)) {
                        ليكن المرشح: رمز_دلالي = الكل[ح];
                        طابق المرشح.النوع مع
                        | نوع_تصريح.منشئ_تعداد -> {
                            طابق المرشح.المالك مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(المالك) -> {
                                إذا (معرفا_رمز_متساويان(المالك, الرمز.المعرف)) {
                                    ألحق(الناتج, اقتراح_رمز_إكمال_لغة(الواجهة, &المرشح, «», عربي));
                                };
                            };
                        }
                        | _ -> { };
                        ح := ح + 1;
                    }
                }
                | _ -> {
                    طابق نوع_رمز_واجهة(الواجهة, الرمز.المعرف) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(نوع_القيمة) -> {
                        ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
                        طابق عدد_حقول_سجل(الأنواع, نوع_القيمة) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(العدد) -> {
                            ليكن ح: متغير طبيعي = 0;
                            طالما (ح < العدد) {
                                طابق حقل_سجل_عند(الأنواع, نوع_القيمة, ح) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(الحقل) -> {
                                    طابق اسم_مقنن_واجهة(الواجهة, الحقل.الاسم) مع
                                    | اختياري.لا_شيء -> { }
                                    | اختياري.موجود(اسم_الحقل) -> {
                                        ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = {
                                            النص: من_بايتات(&اسم_الحقل.البايتات),
                                            النوع: نوع_تصريح.ربط_محلي(),
                                            التفصيل: تهجئة_نوع_لغة(الواجهة, نوع_حقل_سجل(&الحقل), عربي),
                                            التوثيق: اختياري.لا_شيء(),
                                            كلمة: خطأ,
                                            الإدراج: اختياري.لا_شيء(),
                                            صنف_العنصر: اختياري.موجود(«5»),
                                            نص_الإدراج: اختياري.لا_شيء(),
                                            يلائم: خطأ,
                                            البعد: 0,
                                            المدى: اختياري.لا_شيء()
                                        };
                                        ألحق(الناتج, الاقتراح);
                                    };
                                };
                                ح := ح + 1;
                            }
                        };
                    };
                };
                أرجع الناتج;
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Byte for a position, clamped to the start of its line when the column lies
// past the line (positions mapped onto an earlier text of the same document).
عرف بايت_موضع_مقارب_لغة(المستند: &مستند_لغة_مفتوح, الموضع: موضع_تغيير_لغة): اختياري طبيعي {
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | نتيجة.خطأ(_) -> { };
    ليكن بداية_السطر: موضع_تغيير_لغة = { السطر: الموضع.السطر, المحرف: 0 };
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, بداية_السطر) مع
    | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عام عرف اقتراحات_إكمال_دلالية_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): متجه اقتراح_إكمال_دلالي_لغة {
    أرجع اقتراحات_إكمال_مع_نص_حالي_لغة(اللقطة, المستند, المستند, الموضع, الموضع);
}

// `المستند` is the text the snapshot was computed from; `الحالي` is what the
// user sees now. The member receiver is read from the current text.
عام عرف اقتراحات_إكمال_مع_نص_حالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الحالي: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة,
    موضع_اللقطة: موضع_تغيير_لغة
): متجه اقتراح_إكمال_دلالي_لغة {
    ليكن الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    ليكن عربي: منطقي = مستند_لغة_بالعربية(الحالي);
    ليكن المستقبل: متغير اختياري نص = اختياري.لا_شيء();
    طابق موضع_لغة_إلى_إزاحة_بايت(الحالي, الموضع) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(القيمة) -> { المستقبل := مستقبل_إكمال_عضو_لغة(&(*الحالي).النص, القيمة); };
    ليكن البايت: متغير طبيعي = 0;
    طابق بايت_موضع_مقارب_لغة(المستند, موضع_اللقطة) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { البايت := القيمة; };

    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        ليكن له_مصدر: متغير منطقي = خطأ;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; له_مصدر := صواب; };
        إذا (له_مصدر) {
            ليكن الروابط: متجه ربط_اسم_نطاق = روابط_مرئية_واجهة_عند_بايت(الواجهة, المصدر, البايت);
            طابق استنسخ(&المستقبل) مع
            | اختياري.موجود(اسم_المستقبل) -> {
                أرجع اقتراحات_أعضاء_إكمال_لغة(الواجهة, &الروابط, &اسم_المستقبل, عربي);
            }
            | اختياري.لا_شيء -> { };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الروابط) مثل طبيعي)) {
                ليكن الربط: ربط_اسم_نطاق = الروابط[ف];
                طابق اسم_مقنن_واجهة(الواجهة, الربط.الاسم) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الاسم) -> {
                    طابق تصريح_رمز_واجهة(الواجهة, الربط.الرمز) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(الرمز) -> {
                        ألحق(الناتج, اقتراح_رمز_إكمال_لغة(
                            الواجهة, &الرمز, من_بايتات(&الاسم.البايتات), عربي
                        ));
                    };
                };
                ف := ف + 1;
            }
        };
    };
    // No member context: language keywords in the document's own surface.
    طابق المستقبل مع
    | اختياري.موجود(_) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { };
    ليكن الكلمات: متجه كلمة_محجوزة_لغة = الكلمات_المحجوزة_لغة();
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الكلمات) مثل طبيعي)) {
        ليكن الكلمة: كلمة_محجوزة_لغة = استنسخ(&الكلمات[ك]);
        ليكن التهجئة: متغير نص = استنسخ(&الكلمة.الإنجليزية);
        إذا (عربي) { التهجئة := استنسخ(&الكلمة.العربية); };
        ليكن البديل: متغير نص = استنسخ(&الكلمة.العربية);
        إذا (عربي) { البديل := استنسخ(&الكلمة.الإنجليزية); };
        ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = {
            النص: التهجئة,
            النوع: نوع_تصريح.ربط_محلي(),
            التفصيل: اختياري.موجود(البديل),
            التوثيق: اختياري.لا_شيء(),
            كلمة: صواب,
            الإدراج: اختياري.لا_شيء(),
            صنف_العنصر: اختياري.لا_شيء(),
            نص_الإدراج: اختياري.لا_شيء(),
            يلائم: خطأ,
            البعد: 5,
            المدى: اختياري.لا_شيء()
        };
        ألحق(الناتج, الاقتراح);
        ك := ك + 1;
    }
    أرجع الناتج;
}

// The language keywords in the document's own surface (Arabic or English),
// the other spelling as detail.
عرف اقتراحات_كلمات_إكمال_لغة(عربي: منطقي): متجه اقتراح_إكمال_دلالي_لغة {
    ليكن الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    ليكن الكلمات: متجه كلمة_محجوزة_لغة = الكلمات_المحجوزة_لغة();
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الكلمات) مثل طبيعي)) {
        ليكن الكلمة: كلمة_محجوزة_لغة = استنسخ(&الكلمات[ك]);
        ليكن التهجئة: متغير نص = استنسخ(&الكلمة.الإنجليزية);
        ليكن البديل: متغير نص = استنسخ(&الكلمة.العربية);
        إذا (عربي) { التهجئة := استنسخ(&الكلمة.العربية); البديل := استنسخ(&الكلمة.الإنجليزية); };
        ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = {
            النص: التهجئة,
            النوع: نوع_تصريح.ربط_محلي(),
            التفصيل: اختياري.موجود(البديل),
            التوثيق: اختياري.لا_شيء(),
            كلمة: صواب,
            الإدراج: اختياري.لا_شيء(),
            صنف_العنصر: اختياري.لا_شيء(),
            نص_الإدراج: اختياري.لا_شيء(),
            يلائم: خطأ,
            البعد: 5,
            المدى: اختياري.لا_شيء()
        };
        ألحق(الناتج, الاقتراح);
        ك := ك + 1;
    }
    أرجع الناتج;
}

عام نوع إكمال_رقعة_لغة = {
    السياق: سياق_إكمال,
    الاقتراحات: متجه اقتراح_إكمال_دلالي_لغة
};

// Completion from the compiler's answer (tooling_completion.sn): one item per
// candidate, labelled as declared, ranked by the compiler's distance, each
// replacing the word from بداية_الكلمة to the cursor. Declarations carry
// their signature or type and documentation; fields and locals their type;
// modules nothing. A bare name also gets the keywords.
عام عرف اقتراحات_إكمال_بالرقعة_لغة(
    التحليل: &تحليل_إكمال_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): إكمال_رقعة_لغة {
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن الرقعة: &رقعة_إكمال = &(*التحليل).الرقعة;
    ليكن النتيجة: متغير نتيجة_إكمال_أدوات = {
        السياق: (*الرقعة).السياق, بداية_الكلمة: (*الرقعة).بداية_الكلمة, المرشحات: [], النوع_المتوقع: اختياري.لا_شيء()
    };
    ليكن الواجهة_المتاحة: متغير اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.لا_شيء();
    طابق (*الرقعة).السياق مع
    | سياق_إكمال.لا_شيء -> { }
    | سياق_إكمال.مسار_استيراد -> { النتيجة := إكمال_مسار_بيئة(&(*التحليل).البيئة, الرقعة); }
    | سياق_إكمال.مسار_وحدة -> { النتيجة := إكمال_مسار_بيئة(&(*التحليل).البيئة, الرقعة); }
    | _ -> {
        طابق استنسخ(&(*التحليل).الواجهة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
            طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المصدر) -> {
                النتيجة := إكمال_عند_رقعة_واجهة(الواجهة, المصدر, الرقعة);
                // `a.b.` whose first name is no value or type in scope: a module path.
                إذا (النتيجة.السياق == سياق_إكمال.مسار_وحدة() && (الطول(النتيجة.المرشحات) مثل طبيعي) == 0) {
                    النتيجة := إكمال_مسار_بيئة(&(*التحليل).البيئة, الرقعة);
                };
            };
            الواجهة_المتاحة := اختياري.موجود(استنسخ_مشترك(&مشترك_الواجهة));
        };
    };
    ليكن المدى: متغير اختياري نطاق_تغيير_لغة = اختياري.لا_شيء();
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, النتيجة.بداية_الكلمة) مع
    | نتيجة.نجح(البداية) -> {
        ليكن القيمة: نطاق_تغيير_لغة = { البداية: البداية, النهاية: الموضع };
        المدى := اختياري.موجود(القيمة);
    }
    | نتيجة.خطأ(_) -> { };
    ليكن الناتج: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    // Module spellings: the document's own language (`ar` for an Arabic
    // document) first, with the canonical module as detail; other languages'
    // spellings are left out; canonical names stay, after them.
    ليكن لغة_المستند: متغير نص = «en»;
    إذا (عربي) { لغة_المستند := «ar»; };
    طالما (ف < (الطول(النتيجة.المرشحات) مثل طبيعي)) {
        ليكن المرشح: مرشح_إكمال = استنسخ(&النتيجة.المرشحات[ف]);
        ليكن مرئي: متغير منطقي = صواب;
        ليكن تفصيل_الوحدة: متغير اختياري نص = اختياري.لا_شيء();
        ليكن بعد_الوحدة: متغير طبيعي = المرشح.البعد;
        طابق استنسخ(&المرشح.اللغة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(اللغة) -> {
            مرئي := نصان_متساويان(&اللغة, &لغة_المستند);
            تفصيل_الوحدة := استنسخ(&المرشح.الأصلي);
            إذا (بعد_الوحدة > 0) { بعد_الوحدة := بعد_الوحدة - 1; };
        };
        إذا (!مرئي) { ف := ف + 1; تابع_حلقة; };
        ليكن الاقتراح: متغير اقتراح_إكمال_دلالي_لغة = {
            النص: استنسخ(&المرشح.الاسم),
            النوع: نوع_تصريح.ربط_محلي(),
            التفصيل: اختياري.لا_شيء(),
            التوثيق: اختياري.لا_شيء(),
            كلمة: خطأ,
            الإدراج: اختياري.لا_شيء(),
            صنف_العنصر: اختياري.لا_شيء(),
            نص_الإدراج: اختياري.لا_شيء(),
            يلائم: خطأ,
            البعد: المرشح.البعد,
            المدى: استنسخ(&المدى)
        };
        طابق استنسخ(&الواجهة_المتاحة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
            ليكن من_رمز: متغير منطقي = خطأ;
            طابق المرشح.الرمز مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المعرف) -> {
                طابق تصريح_رمز_واجهة(الواجهة, المعرف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الرمز) -> {
                    ليكن المبني: اقتراح_إكمال_دلالي_لغة = اقتراح_رمز_إكمال_لغة(الواجهة, &الرمز, استنسخ(&المرشح.الاسم), عربي);
                    الاقتراح.النوع := المبني.النوع;
                    الاقتراح.التفصيل := استنسخ(&المبني.التفصيل);
                    الاقتراح.التوثيق := استنسخ(&المبني.التوثيق);
                    من_رمز := صواب;
                };
            };
            إذا (!من_رمز) {
                طابق المرشح.النوع مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(نوع_القيمة) -> { الاقتراح.التفصيل := تهجئة_نوع_لغة(الواجهة, نوع_القيمة, عربي); };
            };
        };
        طابق استنسخ(&المرشح.الصنف) مع
        | صنف_مرشح.تصريح(النوع) -> { الاقتراح.النوع := النوع; }
        | صنف_مرشح.حقل -> { الاقتراح.صنف_العنصر := اختياري.موجود(«5»); }
        | صنف_مرشح.وحدة -> {
            الاقتراح.صنف_العنصر := اختياري.موجود(«9»);
            الاقتراح.التفصيل := استنسخ(&تفصيل_الوحدة);
            الاقتراح.البعد := بعد_الوحدة;
        }
        | صنف_مرشح.محلي -> { الاقتراح.صنف_العنصر := اختياري.موجود(«6»); }
        | صنف_مرشح.معامل -> { الاقتراح.صنف_العنصر := اختياري.موجود(«6»); }
        // A builtin Type (`int`, `vector`): shown as a type (LSP Struct).
        | صنف_مرشح.نوع_مدمج -> { الاقتراح.صنف_العنصر := اختياري.موجود(«22»); }
        // `option.some`, `result.ok`.
        | صنف_مرشح.منشئ_مدمج -> { الاقتراح.صنف_العنصر := اختياري.موجود(«20»); }
        // A match arm's pattern, written as the arm needs it (`Color.Red`,
        // `option.some(_)`).
        | صنف_مرشح.نمط_حالة -> { الاقتراح.صنف_العنصر := اختياري.موجود(«20»); };
        // What the compiler says to insert: a constructor in a value position
        // is a call (`Red()`, `Circle(`), in a pattern its name.
        إذا (!نصان_متساويان(&المرشح.نص_الإدراج, &المرشح.الاسم) && (الطول(المرشح.نص_الإدراج) مثل طبيعي) > 0) {
            الاقتراح.نص_الإدراج := اختياري.موجود(استنسخ(&المرشح.نص_الإدراج));
        };
        // A record literal's field: `name: `, ready for its value.
        إذا (النتيجة.السياق == سياق_إكمال.حقل_سجل()) {
            الاقتراح.نص_الإدراج := اختياري.موجود(صل_نصين(&المرشح.الاسم, &«: »));
        };
        الاقتراح.يلائم := المرشح.يلائم_المتوقع;
        ألحق(الناتج, الاقتراح);
        ف := ف + 1;
    }
    إذا (النتيجة.السياق == سياق_إكمال.اسم() || النتيجة.السياق == سياق_إكمال.معامل_استدعاء()) {
        ليكن الكلمات: متجه اقتراح_إكمال_دلالي_لغة = اقتراحات_كلمات_إكمال_لغة(عربي);
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الكلمات) مثل طبيعي)) {
            ليكن الكلمة: متغير اقتراح_إكمال_دلالي_لغة = استنسخ(&الكلمات[ك]);
            الكلمة.المدى := استنسخ(&المدى);
            ألحق(الناتج, الكلمة);
            ك := ك + 1;
        }
    };
    ليكن الجواب: إكمال_رقعة_لغة = { السياق: النتيجة.السياق, الاقتراحات: الناتج };
    أرجع الجواب;
}

عام نوع معلومات_توقيع_استدعاء_لغة = {
    التسمية: نص,
    المعاملات: متجه نص,
    المعامل_النشط: طبيعي,
    التوثيق: اختياري نص
};

// Parameter declarations as written (`value: int`), in declaration order.
عرف نصوص_معاملات_مصدر_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    التصريح: &رمز_دلالي
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ت: رمز_دلالي = *التصريح;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ت.نطاق_التصريح.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(المصدر) -> {
        ليكن الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(الواجهة, (ت.نطاق_التصريح.البداية.المصدر مثل طبيعي));
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الرموز) مثل طبيعي)) {
            ليكن الابن: رمز_دلالي = الرموز[ف];
            إذا (نطاق_داخل_نطاق_تحويم_لغة(الابن.نطاق_الاسم, ت.نطاق_التصريح)) {
                طابق الابن.النوع مع
                | نوع_تصريح.معامل -> {
                    ليكن البداية: طبيعي = (الابن.نطاق_التصريح.البداية.البايت مثل طبيعي);
                    ليكن النهاية: طبيعي = (الابن.نطاق_التصريح.النهاية.البايت مثل طبيعي);
                    إذا (النهاية > البداية) {
                        طابق مقطع_نص(&المصدر.المحتوى, البداية, النهاية - البداية) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(النص) -> { ألحق(الناتج, قص_النص(&النص)); };
                    };
                }
                | _ -> { };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف توقيع_استدعاء_دلالي_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري معلومات_توقيع_استدعاء_لغة {
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن مرجع_الواجهة: &اختياري مشترك<نتيجة_واجهة_وحدة> = &ل.الواجهة;
    ليكن اختيار_الواجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = *مرجع_الواجهة;
    طابق اختيار_الواجهة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        طابق استدعاء_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاستدعاء) -> {
            ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
            ليكن نص_النوع: متغير نص = «»;
            طابق تهجئة_نوع_لغة(الواجهة, الاستدعاء.نوع_المستدعى, عربي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(النص) -> { نص_النوع := النص; };

            ليكن النشط: متغير طبيعي = الاستدعاء.الحجة_النشطة;
            // A named callee shows its declaration as written, with named parameters.
            طابق الاستدعاء.الرمز مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الرمز) -> {
                طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(التصريح) -> {
                    ليكن المعاملات: متجه نص = نصوص_معاملات_مصدر_لغة(الواجهة, &التصريح);
                    طابق رأس_تصريح_تحويم_لغة(الواجهة, &التصريح) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(الرأس) -> {
                        ليكن العدد: طبيعي = الطول(المعاملات) مثل طبيعي;
                        إذا ((العدد > 0) && (النشط >= العدد)) { النشط := العدد - 1; };
                        ليكن الناتج: معلومات_توقيع_استدعاء_لغة = {
                            التسمية: الرأس,
                            المعاملات: المعاملات,
                            المعامل_النشط: النشط,
                            التوثيق: توثيق_تصريح_لغة(الواجهة, &التصريح)
                        };
                        أرجع اختياري.موجود(الناتج);
                    };
                };
            };

            ليكن المعاملات: متغير متجه نص = [];
            طابق عدد_معاملات_نوع_واجهة(الواجهة, الاستدعاء.نوع_المستدعى) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(العدد) -> {
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < العدد) {
                    طابق نوع_معامل_نوع_واجهة_عند(الواجهة, الاستدعاء.نوع_المستدعى, ف) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(نوع_المعامل) -> {
                        طابق تهجئة_نوع_لغة(الواجهة, نوع_المعامل, عربي) مع
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                        | اختياري.موجود(النص) -> { ألحق(المعاملات, النص); };
                    };
                    ف := ف + 1;
                }
                إذا ((العدد > 0) && (النشط >= العدد)) { النشط := العدد - 1; };
                ليكن الناتج: معلومات_توقيع_استدعاء_لغة = {
                    التسمية: نص_النوع,
                    المعاملات: المعاملات,
                    المعامل_النشط: النشط,
                    التوثيق: اختياري.لا_شيء()
                };
                أرجع اختياري.موجود(الناتج);
            };
        };
    };
}

