    النوع: نوع_تصريح,
    تصريح: منطقي
};

عام نوع رمز_معلن_لغة = {
    الاسم: نص,
    النوع: نوع_تصريح,
    الموقع: موقع_دلالي_لغة,
    نطاق_التحديد: نطاق_تغيير_لغة,
    // workspace/symbol containerName: a constructor's enum.
    الحاوية: اختياري نص
};

عام عرف اسم_رمز_من_واجهة_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: &رمز_دلالي
): اختياري نص {
    ليكن ر: رمز_دلالي = *الرمز;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ر.نطاق_الاسم.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        ليكن العدد: طبيعي = طول_نطاق_بالبايت(ر.نطاق_الاسم);
        أرجع مقطع_نص(&المصدر.المحتوى, (ر.نطاق_الاسم.البداية.البايت مثل طبيعي), العدد);
    };
}

عرف حول_رمز_واجهة_إلى_لغة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: &رمز_دلالي
): اختياري رمز_معلن_لغة {
    ليكن ر: رمز_دلالي = *الرمز;
    ليكن الاسم: متغير نص = «»;
    طابق اسم_رمز_من_واجهة_لغة(الواجهة, &ر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
    ليكن موضع_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن نطاق_فارغ_لغة: نطاق_تغيير_لغة = { البداية: موضع_فارغ, النهاية: موضع_فارغ };
    ليكن الموقع: متغير موقع_دلالي_لغة = {
        العنوان: «»,
        النطاق: نطاق_فارغ_لغة
    };
    طابق موقع_نطاق_واجهة_لغة(الواجهة, ر.نطاق_التصريح) مع
    | اختياري.لا_شيء -> {
        طابق موقع_نطاق_واجهة_لغة(الواجهة, ر.نطاق_الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الموقع := القيمة; };
    }
    | اختياري.موجود(القيمة) -> { الموقع := القيمة; };
    ليكن التحديد: متغير نطاق_تغيير_لغة = الموقع.النطاق;
    طابق مصدر_واجهة_بمعرف(الواجهة, (ر.نطاق_الاسم.البداية.المصدر مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المصدر) -> {
        طابق نطاق_مصدر_إلى_نطاق_لغة(&المصدر, ر.نطاق_الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { التحديد := القيمة; };
    };
    ليكن الناتج: رمز_معلن_لغة = {
        الاسم: الاسم,
        النوع: ر.النوع,
        الموقع: الموقع,
        نطاق_التحديد: التحديد,
        الحاوية: اختياري.لا_شيء()
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف ظهورات_مصنفة_دلاليا_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح
): متجه ظهور_مصنف_لغة {
    ليكن الناتج: متغير متجه ظهور_مصنف_لغة = [];
    ليكن ل: لقطة_تحليل_واجهة_لغة = *اللقطة;
    طابق ل.الواجهة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المصدر: متغير طبيعي = 0;
        طابق معرف_مصدر_مستند_لغة(الواجهة, المستند) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(المعرف) -> { المصدر := المعرف; };
        ليكن المصنفة: متجه ظهور_مصنف_دلاليا = ظهورات_مصنفة_واجهة_لمصدر(الواجهة, المصدر);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصنفة) مثل طبيعي)) {
            ليكن مرجع_الظهور: &ظهور_مصنف_دلاليا = &المصنفة[ف];
            ليكن الظهور: ظهور_مصنف_دلاليا = *مرجع_الظهور;
            طابق نطاق_مصدر_إلى_نطاق_لغة_للمستند(المستند, الظهور.النطاق) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(النطاق) -> {
                ليكن القيمة: ظهور_مصنف_لغة = {
                    النطاق: النطاق,
                    النوع: الظهور.النوع,
                    تصريح: الظهور.تصريح
                };
                ألحق(الناتج, القيمة);
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

