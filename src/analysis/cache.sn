استورد sultanc_analyzer.analysis.frontend;
استورد std.sync.arc;
استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.analysis.library_index;
استورد std.text.compare;
استورد std.text.number;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.registry;

// ذاكرة LSP تخزن ناتج الواجهة المقننة فقط. لا تنشئ حقائق دلالية جديدة؛
// المفتاح هو مراجعة Workspace وهوية المستند، وتبطل تلقائيا عند أي تغيير مصدر.
عام نوع مدخل_ذاكرة_لقطة_لغة = {
    مراجعة_المساحة: طبيعي,
    العنوان: نص,
    اللقطة: لقطة_تحليل_واجهة_لغة
};

عام نوع مدخل_ذاكرة_مشروع_لغة = {
    مراجعة_المساحة: طبيعي,
    النتيجة: اختياري نتيجة_تحليل_مشروع_لغة
};

// Last error-free analysis of a document, kept with the text it was computed
// from. While the user is typing (the current text does not analyse cleanly),
// hover, completion and signature help answer from it, mapping positions by
// line and column, the way mature servers keep serving stale-but-useful facts.
عام نوع لقطة_سليمة_لغة = {
    المستند: مستند_لغة_مفتوح,
    اللقطة: لقطة_تحليل_واجهة_لغة
};

عام نوع ذاكرة_تحليل_لغة = {
    مستندات: متجه مدخل_ذاكرة_لقطة_لغة,
    مستندات_في_مشروع: متجه مدخل_ذاكرة_لقطة_لغة,
    مشروع: مدخل_ذاكرة_مشروع_لغة,
    السليمة: متجه لقطة_سليمة_لغة,
    فهرس_المكتبة: اختياري متجه مدخل_فهرس_مكتبة_لغة,
    // Last semantic tokens sent per document, for semanticTokens/full/delta.
    الرموز_المرسلة: متجه رموز_مرسلة_لغة,
    عداد_الرموز: طبيعي
};

عام نوع رموز_مرسلة_لغة = {
    العنوان: نص,
    المعرف: نص,
    البيانات: متجه طبيعي
};

عام عرف رموز_مرسلة_لمستند_لغة(الذاكرة: &ذاكرة_تحليل_لغة, العنوان: &نص): اختياري رموز_مرسلة_لغة {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).الرموز_المرسلة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).الرموز_المرسلة[ف].العنوان, العنوان)) {
            أرجع اختياري.موجود(استنسخ(&(*الذاكرة).الرموز_المرسلة[ف]));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Records `البيانات` as sent for the document and returns its new resultId.
عام عرف خزن_رموز_مرسلة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    العنوان: &نص,
    البيانات: &متجه طبيعي
): نص {
    (*الذاكرة).عداد_الرموز := (*الذاكرة).عداد_الرموز + 1;
    ليكن المعرف: نص = طبيعي_إلى_نص((*الذاكرة).عداد_الرموز);
    ليكن المدخل: رموز_مرسلة_لغة = { العنوان: استنسخ(العنوان), المعرف: استنسخ(&المعرف), البيانات: استنسخ(البيانات) };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).الرموز_المرسلة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).الرموز_المرسلة[ف].العنوان, العنوان)) {
            (*الذاكرة).الرموز_المرسلة[ف] := المدخل;
            أرجع المعرف;
        };
        ف := ف + 1;
    }
    ألحق((*الذاكرة).الرموز_المرسلة, المدخل);
    أرجع المعرف;
}

// std index for auto-import, built on first use.
عام عرف فهرس_مكتبة_من_ذاكرة_لغة(الذاكرة: &متغير ذاكرة_تحليل_لغة): متجه مدخل_فهرس_مكتبة_لغة {
    طابق استنسخ(&(*الذاكرة).فهرس_المكتبة) مع
    | اختياري.موجود(الفهرس) -> { أرجع الفهرس; }
    | اختياري.لا_شيء -> {
        ليكن الفهرس: متجه مدخل_فهرس_مكتبة_لغة = ابن_فهرس_مكتبة_لغة();
        (*الذاكرة).فهرس_المكتبة := اختياري.موجود(استنسخ(&الفهرس));
        أرجع الفهرس;
    };
}

عام عرف لقطة_تحتاج_بديلا_لغة(اللقطة: &لقطة_تحليل_واجهة_لغة): منطقي {
    طابق (*اللقطة).الواجهة مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(_) -> { };
    أرجع (*اللقطة).التشخيصات.عدد_الأخطاء > 0;
}

عام عرف لقطة_سليمة_لمستند_لغة(
    الذاكرة: &ذاكرة_تحليل_لغة,
    العنوان: &نص
): اختياري لقطة_سليمة_لغة {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).السليمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).السليمة[ف].المستند.العنوان, العنوان)) {
            أرجع اختياري.موجود(استنسخ(&(*الذاكرة).السليمة[ف]));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف خزن_لقطة_سليمة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    المستند: &مستند_لغة_مفتوح,
    اللقطة: &لقطة_تحليل_واجهة_لغة
): فراغ {
    إذا (لقطة_تحتاج_بديلا_لغة(اللقطة)) { أرجع; };
    ليكن المدخل: لقطة_سليمة_لغة = { المستند: استنسخ(المستند), اللقطة: استنسخ(اللقطة) };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).السليمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).السليمة[ف].المستند.العنوان, &(*المستند).العنوان)) {
            (*الذاكرة).السليمة[ف] := المدخل;
            أرجع;
        };
        ف := ف + 1;
    }
    ألحق((*الذاكرة).السليمة, المدخل);
}

عام عرف انس_لقطة_سليمة_لغة(الذاكرة: &متغير ذاكرة_تحليل_لغة, العنوان: &نص): فراغ {
    ليكن الباقية: متغير متجه لقطة_سليمة_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).السليمة) مثل طبيعي)) {
        إذا (!نصان_متساويان(&(*الذاكرة).السليمة[ف].المستند.العنوان, العنوان)) {
            ألحق(الباقية, استنسخ(&(*الذاكرة).السليمة[ف]));
        };
        ف := ف + 1;
    }
    (*الذاكرة).السليمة := الباقية;
}

عام عرف ذاكرة_تحليل_لغة_جديدة(): ذاكرة_تحليل_لغة {
    ليكن مستندات: متجه مدخل_ذاكرة_لقطة_لغة = [];
    ليكن مستندات_في_مشروع: متجه مدخل_ذاكرة_لقطة_لغة = [];
    ليكن بلا_مشروع: اختياري نتيجة_تحليل_مشروع_لغة = اختياري.لا_شيء();
    ليكن مشروع: مدخل_ذاكرة_مشروع_لغة = { مراجعة_المساحة: 0, النتيجة: بلا_مشروع };
    ليكن سليمة: متجه لقطة_سليمة_لغة = [];
    ليكن بلا_رموز: متجه رموز_مرسلة_لغة = [];
    ليكن الناتج: ذاكرة_تحليل_لغة = {
        مستندات: مستندات,
        مستندات_في_مشروع: مستندات_في_مشروع,
        مشروع: مشروع,
        السليمة: سليمة,
        فهرس_المكتبة: اختياري.لا_شيء(),
        الرموز_المرسلة: بلا_رموز,
        عداد_الرموز: 0
    };
    أرجع الناتج;
}

عرف لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
    المداخل: &متجه مدخل_ذاكرة_لقطة_لغة,
    مراجعة_المساحة: طبيعي,
    العنوان: &نص
): اختياري لقطة_تحليل_واجهة_لغة {
    ليكن القيم: متجه مدخل_ذاكرة_لقطة_لغة = *المداخل;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        إذا (
            القيم[ف].مراجعة_المساحة == مراجعة_المساحة
            && نصان_متساويان(&القيم[ف].العنوان, العنوان)
        ) {
            ليكن مرجع_اللقطة: &لقطة_تحليل_واجهة_لغة = &القيم[ف].اللقطة;
            ليكن اللقطة: لقطة_تحليل_واجهة_لغة = *مرجع_اللقطة;
            أرجع اختياري.موجود(استنسخ(&اللقطة));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف لقطة_مستند_من_ذاكرة_تحليل_لغة(
    الذاكرة: &ذاكرة_تحليل_لغة,
    مراجعة_المساحة: طبيعي,
    العنوان: &نص,
    في_مشروع: منطقي
): اختياري لقطة_تحليل_واجهة_لغة {
    ليكن الحالة: ذاكرة_تحليل_لغة = *الذاكرة;
    إذا (في_مشروع) {
        أرجع لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
            &الحالة.مستندات_في_مشروع, مراجعة_المساحة, العنوان
        );
    };
    أرجع لقطة_من_مدخلات_ذاكرة_تحليل_لغة(
        &الحالة.مستندات, مراجعة_المساحة, العنوان
    );
}

عرف خزن_في_مدخلات_ذاكرة_تحليل_لغة(
    المداخل: &متجه مدخل_ذاكرة_لقطة_لغة,
    مراجعة_المساحة: طبيعي,
    العنوان: &نص,
    اللقطة: &لقطة_تحليل_واجهة_لغة
): متجه مدخل_ذاكرة_لقطة_لغة {
    ليكن الحالية: متجه مدخل_ذاكرة_لقطة_لغة = *المداخل;
    ليكن الجديدة: متغير متجه مدخل_ذاكرة_لقطة_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالية) مثل طبيعي)) {
        إذا (
            الحالية[ف].مراجعة_المساحة == مراجعة_المساحة
            && !نصان_متساويان(&الحالية[ف].العنوان, العنوان)
        ) {
            ليكن مرجع_المدخل: &مدخل_ذاكرة_لقطة_لغة = &الحالية[ف];
            ليكن المدخل: مدخل_ذاكرة_لقطة_لغة = *مرجع_المدخل;
            ألحق(الجديدة, استنسخ(&المدخل));
        };
        ف := ف + 1;
    }
    ليكن نسخة_العنوان: نص = *العنوان;
    ليكن نسخة_اللقطة: لقطة_تحليل_واجهة_لغة = *اللقطة;
    ليكن المدخل_الجديد: مدخل_ذاكرة_لقطة_لغة = {
        مراجعة_المساحة: مراجعة_المساحة,
        العنوان: استنسخ(&نسخة_العنوان),
        اللقطة: استنسخ(&نسخة_اللقطة)
    };
    ألحق(الجديدة, المدخل_الجديد);
    أرجع الجديدة;
}

عام عرف خزن_لقطة_مستند_في_ذاكرة_تحليل_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    مراجعة_المساحة: طبيعي,
    العنوان: &نص,
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    في_مشروع: منطقي
): فراغ {
    إذا (في_مشروع) {
        (*الذاكرة).مستندات_في_مشروع := خزن_في_مدخلات_ذاكرة_تحليل_لغة(
            &(*الذاكرة).مستندات_في_مشروع, مراجعة_المساحة, العنوان, اللقطة
        );
    } وإلا {
        (*الذاكرة).مستندات := خزن_في_مدخلات_ذاكرة_تحليل_لغة(
            &(*الذاكرة).مستندات, مراجعة_المساحة, العنوان, اللقطة
        );
    };
}

عام عرف نتيجة_مشروع_من_ذاكرة_تحليل_لغة(
    الذاكرة: &ذاكرة_تحليل_لغة,
    مراجعة_المساحة: طبيعي
): اختياري نتيجة_تحليل_مشروع_لغة {
    ليكن الحالة: ذاكرة_تحليل_لغة = *الذاكرة;
    إذا (الحالة.مشروع.مراجعة_المساحة != مراجعة_المساحة) { أرجع اختياري.لا_شيء(); };
    ليكن مرجع_النتيجة: &اختياري نتيجة_تحليل_مشروع_لغة = &الحالة.مشروع.النتيجة;
    ليكن النتيجة: اختياري نتيجة_تحليل_مشروع_لغة = *مرجع_النتيجة;
    أرجع استنسخ(&النتيجة);
}

عام عرف خزن_نتيجة_مشروع_في_ذاكرة_تحليل_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    مراجعة_المساحة: طبيعي,
    النتيجة: &نتيجة_تحليل_مشروع_لغة
): فراغ {
    ليكن نسخة_النتيجة: نتيجة_تحليل_مشروع_لغة = *النتيجة;
    ليكن اختيار_النتيجة: اختياري نتيجة_تحليل_مشروع_لغة = اختياري.موجود(استنسخ(&نسخة_النتيجة));
    ليكن المدخل: مدخل_ذاكرة_مشروع_لغة = {
        مراجعة_المساحة: مراجعة_المساحة,
        النتيجة: اختيار_النتيجة
    };
    (*الذاكرة).مشروع := المدخل;
}

عام عرف حلل_مشروع_بذاكرة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    المساحة: &مساحة_عمل_لغة,
    جذور_المشروع: &متجه نص
): نتيجة_تحليل_مشروع_لغة {
    ليكن حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    ليكن حالة_الذاكرة: ذاكرة_تحليل_لغة = *الذاكرة;
    طابق نتيجة_مشروع_من_ذاكرة_تحليل_لغة(&حالة_الذاكرة, حالة_المساحة.المراجعة) مع
    | اختياري.موجود(النتيجة) -> { أرجع النتيجة; }
    | اختياري.لا_شيء -> { };
    ليكن النتيجة: نتيجة_تحليل_مشروع_لغة = حلل_واجهة_مشروع_لغة(المساحة, جذور_المشروع);
    // A cancelled build stopped early: keep nothing from it.
    إذا (طلب_ملغى_لغة(المساحة)) { أرجع النتيجة; };
    خزن_نتيجة_مشروع_في_ذاكرة_تحليل_لغة(
        الذاكرة, حالة_المساحة.المراجعة, &النتيجة
    );
    أرجع النتيجة;
}

عرف ابن_لقطة_مستند_من_نتيجة_مشروع_لغة(
    المستند: &مستند_لغة_مفتوح,
    النتيجة: &نتيجة_تحليل_مشروع_لغة
): نتيجة_تحليل_واجهة_لغة {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مرجع_العنوان: &نص = &د.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن الإصدار: عدد = د.الإصدار;
    ليكن المراجعة: طبيعي = د.المراجعة;
    ليكن مرجع_اختيار_المسار: &اختياري نص = &د.مسار_الملف;
    ليكن اختيار_المسار: اختياري نص = *مرجع_اختيار_المسار;
    ليكن المسار: متغير نص = «»;
    طابق اختيار_المسار مع
    | اختياري.لا_شيء -> { أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل(); }
    | اختياري.موجود(القيمة) -> { المسار := استنسخ(&القيمة); };
    ليكن نتيجة_المشروع: نتيجة_تحليل_مشروع_لغة = *النتيجة;
    طابق نتيجة_المشروع مع
    | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_تحليل_مشروع_لغة.مرفوضة(التشخيصات) -> {
        ليكن بلا_واجهة: اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.لا_شيء();
        ليكن اللقطة: لقطة_تحليل_واجهة_لغة = {
            العنوان: استنسخ(&العنوان),
            المسار: المسار,
            الإصدار: الإصدار,
            المراجعة: المراجعة,
            الواجهة: بلا_واجهة,
            التشخيصات: استنسخ(&التشخيصات)
        };
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    }
    | نتيجة_تحليل_مشروع_لغة.مكتملة(الواجهة) -> {
        ليكن تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن مرجع_الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&الواجهة);
        ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &(*مرجع_الواجهة).تشخيصات_الأدوات);
        ليكن واجهة_متاحة: اختياري مشترك<نتيجة_واجهة_وحدة> = اختياري.موجود(استنسخ_مشترك(&الواجهة));
        ليكن اللقطة: لقطة_تحليل_واجهة_لغة = {
            العنوان: استنسخ(&العنوان),
            المسار: المسار,
            الإصدار: الإصدار,
            المراجعة: المراجعة,
            الواجهة: واجهة_متاحة,
            التشخيصات: تشخيصات_الأدوات
        };
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    };
}

عام عرف حلل_مستند_بذاكرة_لغة(
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    المساحة: &مساحة_عمل_لغة,
    المستند: &مستند_لغة_مفتوح,
    جذور_المشروع: &متجه نص,
    في_مشروع: منطقي
): نتيجة_تحليل_واجهة_لغة {
    ليكن حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن حالة_الذاكرة: ذاكرة_تحليل_لغة = *الذاكرة;
    طابق لقطة_مستند_من_ذاكرة_تحليل_لغة(
        &حالة_الذاكرة, حالة_المساحة.المراجعة, &د.العنوان, في_مشروع
    ) مع
    | اختياري.موجود(اللقطة) -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    }
    | اختياري.لا_شيء -> { };

    ليكن النتيجة: متغير نتيجة_تحليل_واجهة_لغة =
        نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    // Above the project-size limit, project-wide requests are answered from the
    // requesting document's own analysis (it and its imports).
    إذا (في_مشروع && ((الطول(*جذور_المشروع) مثل طبيعي) > 0) && مشروع_ضمن_الحد_لغة(جذور_المشروع)) {
        ليكن نتيجة_المشروع: نتيجة_تحليل_مشروع_لغة = حلل_مشروع_بذاكرة_لغة(
            الذاكرة, المساحة, جذور_المشروع
        );
        النتيجة := ابن_لقطة_مستند_من_نتيجة_مشروع_لغة(&د, &نتيجة_المشروع);
    } وإلا إذا (في_مشروع) {
        النتيجة := حلل_واجهة_مستند_لغة_في_مشروع(المساحة, المستند, جذور_المشروع);
    } وإلا {
        النتيجة := حلل_واجهة_مستند_لغة(المساحة, المستند);
    };
    طابق النتيجة مع
    | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
        أرجع نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
    }
    | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
        إذا (طلب_ملغى_لغة(المساحة)) { أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة); };
        خزن_لقطة_مستند_في_ذاكرة_تحليل_لغة(
            الذاكرة, حالة_المساحة.المراجعة, &د.العنوان, &اللقطة, في_مشروع
        );
        خزن_لقطة_سليمة_لغة(الذاكرة, المستند, &اللقطة);
        أرجع نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة);
    };
}
