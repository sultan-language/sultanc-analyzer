استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.workspace.positions;
استورد sultanc_analyzer.protocol.text_document;
استورد std.text.substring;
استورد std.text.transform;
استورد std.encoding.positions;

عرف استبدل_نطاق_مستند_لغة(
    المستند: &مستند_لغة_مفتوح,
    النطاق: &نطاق_تغيير_لغة,
    البديل: نص
): اختياري نص {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن حدود: نطاق_تغيير_لغة = *النطاق;
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = 0;

    طابق موضع_لغة_إلى_إزاحة_بايت(&د, حدود.البداية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الإزاحة) -> { البداية := الإزاحة; };
    طابق موضع_لغة_إلى_إزاحة_بايت(&د, حدود.النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الإزاحة) -> { النهاية := الإزاحة; };
    إذا (النهاية < البداية) { أرجع اختياري.لا_شيء(); };

    ليكن العدد: طبيعي = الطول(د.النص) مثل طبيعي;
    ليكن السابق: متغير نص = «»;
    ليكن اللاحق: متغير نص = «»;
    طابق مقطع_نص(&د.النص, 0, البداية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { السابق := القيمة; };
    طابق مقطع_نص(&د.النص, النهاية, العدد - النهاية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { اللاحق := القيمة; };

    ليكن الأجزاء: متجه نص = [السابق, البديل, اللاحق];
    ليكن الفاصل: نص = «»;
    أرجع اختياري.موجود(صل_النصوص(&الأجزاء, &الفاصل));
}

عام عرف طبق_تغييرات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    التغيير: &تغيير_مستند_لغة
): منطقي {
    ليكن الطلب: تغيير_مستند_لغة = *التغيير;
    ليكن مرجع_العنوان: &نص = &الطلب.العنوان;
    ليكن عنوان_الطلب: نص = *مرجع_العنوان;
    ليكن إصدار_الطلب: عدد = الطلب.الإصدار;
    ليكن لقطة_المساحة: مساحة_عمل_لغة = *المساحة;
    طابق مستند_لغة_عند(&لقطة_المساحة, &عنوان_الطلب) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المستند) -> {
        ليكن الحالي: متغير مستند_لغة_مفتوح = المستند;

        // رفض النسخة المكررة/الأقدم قبل تطبيق أي تعديل يمنع تكرار incremental edits.
        إذا (إصدار_الطلب <= الحالي.الإصدار) { أرجع خطأ; };

        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الطلب.التغييرات) مثل طبيعي)) {
            طابق الطلب.التغييرات[ف] مع
            | تغيير_محتوى_لغة.كامل(النص) -> {
                ليكن فهرس_سطور_النص: فهرس_سطور = ابن_فهرس_السطور(&النص);
                الحالي.النص := استنسخ(&النص);
                الحالي.فهرس_السطور := فهرس_سطور_النص;
            }
            | تغيير_محتوى_لغة.نطاق(النطاق, البديل) -> {
                طابق استبدل_نطاق_مستند_لغة(&الحالي, &النطاق, استنسخ(&البديل)) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(النص) -> {
                    ليكن فهرس_سطور_النص: فهرس_سطور = ابن_فهرس_السطور(&النص);
                    الحالي.النص := النص;
                    الحالي.فهرس_السطور := فهرس_سطور_النص;
                };
            };
            ف := ف + 1;
        }

        ليكن مرجع_النص_النهائي: &نص = &الحالي.النص;
        ليكن النص_النهائي: نص = *مرجع_النص_النهائي;
        أرجع غير_مستند_لغة(
            المساحة, &عنوان_الطلب, إصدار_الطلب, استنسخ(&النص_النهائي)
        );
    };
}
