استورد sultanc_analyzer.protocol.initialize;
استورد std.uri.uri;
استورد std.fs.path;
استورد std.text.compare;
استورد sultanc_analyzer.workspace.package_graph;

// حالة مجلدات المشروع فقط. لا يقرر هذا المالك أي دلالة Module أو SourceID.
عام نوع مجلد_مساحة_عمل_لغة = {
    العنوان: نص,
    الاسم: نص,
    مسار_الملف: اختياري نص,
    // The folder's Supax package graph (workspace/package_graph.sn), when it
    // holds Supax.toml and `supax metadata` succeeded.
    المخطط: اختياري مخطط_حزم_لغة
};

عام نوع جذور_مساحة_عمل_لغة = {
    المجلدات: متجه مجلد_مساحة_عمل_لغة
};

عام عرف جذور_مساحة_عمل_لغة_جديدة(): جذور_مساحة_عمل_لغة {
    ليكن المجلدات_الفارغة: متجه مجلد_مساحة_عمل_لغة = [];
    ليكن الناتج: جذور_مساحة_عمل_لغة = { المجلدات: المجلدات_الفارغة };
    أرجع الناتج;
}

عرف حول_وصف_مجلد_مساحة_عمل_لغة(
    الوصف: &وصف_مجلد_مساحة_عمل_لغة
): مجلد_مساحة_عمل_لغة {
    ليكن القيمة: وصف_مجلد_مساحة_عمل_لغة = *الوصف;
    ليكن مرجع_العنوان: &نص = &القيمة.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن مرجع_الاسم: &نص = &القيمة.الاسم;
    ليكن الاسم: نص = *مرجع_الاسم;
    ليكن المسار: متغير اختياري نص = اختياري.لا_شيء();
    طابق عنوان_ملف_إلى_مسار(&العنوان) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(الخام) -> {
        ليكن المطبع: نص = طبع_المسار(&الخام);
        المسار := اختياري.موجود(المطبع);
    };
    ليكن الناتج: مجلد_مساحة_عمل_لغة = {
        العنوان: استنسخ(&العنوان),
        الاسم: استنسخ(&الاسم),
        مسار_الملف: المسار,
        المخطط: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

عرف أضف_أو_حدث_مجلد_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    الوصف: &وصف_مجلد_مساحة_عمل_لغة
): فراغ {
    ليكن الجديد: مجلد_مساحة_عمل_لغة = حول_وصف_مجلد_مساحة_عمل_لغة(الوصف);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجذور).المجلدات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الجذور).المجلدات[ف].العنوان, &الجديد.العنوان)) {
            (*الجذور).المجلدات[ف] := الجديد;
            أرجع;
        };
        ف := ف + 1;
    }
    ألحق((*الجذور).المجلدات, الجديد);
}

عرف احذف_مجلد_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    العنوان: &نص
): فراغ {
    ليكن الحالة: جذور_مساحة_عمل_لغة = *الجذور;
    ليكن الباقية: متغير متجه مجلد_مساحة_عمل_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المجلدات) مثل طبيعي)) {
        إذا (!نصان_متساويان(&الحالة.المجلدات[ف].العنوان, العنوان)) {
            ليكن مرجع_المجلد: &مجلد_مساحة_عمل_لغة = &الحالة.المجلدات[ف];
            ليكن المجلد: مجلد_مساحة_عمل_لغة = *مرجع_المجلد;
            ألحق(الباقية, استنسخ(&المجلد));
        };
        ف := ف + 1;
    }
    ليكن الجديد: جذور_مساحة_عمل_لغة = { المجلدات: الباقية };
    *الجذور := الجديد;
}

عام عرف هيئ_جذور_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    المعاملات: &معاملات_تهيئة_لغة
): فراغ {
    ليكن الحالة: معاملات_تهيئة_لغة = *المعاملات;
    ليكن الجديد: متغير جذور_مساحة_عمل_لغة = جذور_مساحة_عمل_لغة_جديدة();
    طابق الحالة.مجلدات_مساحة_العمل مع
    | اختياري.موجود(المجلدات) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المجلدات) مثل طبيعي)) {
            أضف_أو_حدث_مجلد_مساحة_عمل_لغة(&متغير الجديد, &المجلدات[ف]);
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> {
        طابق الحالة.عنوان_الجذر مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(العنوان) -> {
            ليكن الوصف: وصف_مجلد_مساحة_عمل_لغة = {
                العنوان: استنسخ(&العنوان),
                الاسم: «»
            };
            أضف_أو_حدث_مجلد_مساحة_عمل_لغة(&متغير الجديد, &الوصف);
        };
    };
    *الجذور := الجديد;
}

عام عرف طبق_تغيير_جذور_مساحة_عمل_لغة(
    الجذور: &متغير جذور_مساحة_عمل_لغة,
    التغيير: &تغيير_مجلدات_مساحة_عمل_لغة
): فراغ {
    ليكن القيمة: تغيير_مجلدات_مساحة_عمل_لغة = *التغيير;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة.المحذوفة) مثل طبيعي)) {
        احذف_مجلد_مساحة_عمل_لغة(الجذور, &القيمة.المحذوفة[ف].العنوان);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(القيمة.المضافة) مثل طبيعي)) {
        أضف_أو_حدث_مجلد_مساحة_عمل_لغة(الجذور, &القيمة.المضافة[ف]);
        ف := ف + 1;
    }
}

// Runs `supax metadata` for every folder holding Supax.toml and keeps the
// graph; returns the failure messages (one per folder) for the client.
عام عرف حدث_مخططات_الحزم_لغة(الجذور: &متغير جذور_مساحة_عمل_لغة): متجه نص {
    ليكن الإخفاقات: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجذور).المجلدات) مثل طبيعي)) {
        ليكن الجديد: متغير اختياري مخطط_حزم_لغة = اختياري.لا_شيء();
        طابق استنسخ(&(*الجذور).المجلدات[ف].مسار_الملف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المسار) -> {
            طابق مخطط_حزم_لمجلد_لغة(&المسار) مع
            | نتيجة_مخطط_حزم_لغة.بلا_بيان -> { }
            | نتيجة_مخطط_حزم_لغة.جاهز(المخطط) -> { الجديد := اختياري.موجود(المخطط); }
            | نتيجة_مخطط_حزم_لغة.فشل(الرسالة) -> { ألحق(الإخفاقات, الرسالة); };
        };
        (*الجذور).المجلدات[ف].المخطط := الجديد;
        ف := ف + 1;
    }
    أرجع الإخفاقات;
}
