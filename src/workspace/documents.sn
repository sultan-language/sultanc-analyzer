استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.sync.mutex;
استورد compiler.frontend.incremental_analysis;
استورد compiler.frontend.cancellation;
استورد std.collections.text_index_map;
استورد std.encoding.positions;
استورد std.uri.uri;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.text.compare;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.transform;
استورد std.env.environment;
استورد sultanc_analyzer.workspace.package_graph;

عرف انسخ_نص_مستند_لغة(القيمة: &نص): نص {
    ليكن النسخة: نص = *القيمة;
    أرجع استنسخ(&النسخة);
}

عرف انسخ_مسار_مستند_لغة(القيمة: &اختياري نص): اختياري نص {
    ليكن النسخة: اختياري نص = *القيمة;
    أرجع استنسخ(&النسخة);
}

// Display language for diagnostics and hover. Auto follows the document's own
// surface: an Arabic-surface file reads Arabic messages, an English one English.
عام نوع تفضيل_لغة_عرض_لغة =
    | تلقائي
    | العربية
    | الإنجليزية
;

عام نوع مستند_لغة_مفتوح = {
    العنوان: نص,
    تفضيل_اللغة: تفضيل_لغة_عرض_لغة,
    مسار_الملف: اختياري نص,
    اللغة: نص,
    الإصدار: عدد,
    المراجعة: طبيعي,
    مراجعة_الحفظ: اختياري طبيعي,
    مراجعة_رفض_الدلالات: اختياري طبيعي,
    النص: نص,
    فهرس_السطور: فهرس_سطور
};

عام نوع مساحة_عمل_لغة = {
    المستندات: متجه اختياري مستند_لغة_مفتوح,
    فهرس_العناوين: خريطة_نص_فهرس,
    فهرس_المسارات: خريطة_نص_فهرس,
    المراجعة: طبيعي,
    تفضيل_لغة_العرض: تفضيل_لغة_عرض_لغة,
    // False when the client pulls diagnostics (textDocument/diagnostic): one
    // source per document, so the editor never shows two copies or stale ones.
    ينشر_التشخيصات: منطقي,
    // Cancellation token of the request being answered: every frontend build
    // checks it (compiler cancellation.sn); the reader thread sets it when a
    // $/cancelRequest or a change for that request arrives.
    الإلغاء: مشترك<حالة_إلغاء_واجهة>,
    // Why الإلغاء was set: 1 $/cancelRequest, 2 a change of the document.
    سبب_الإلغاء: مشترك<ذرة_ط32>,
    // The workspace folders' Supax package graphs (workspace/folders.sn
    // keeps them; the server copies them here after each refresh).
    المخططات: متجه مخطط_حزم_لغة,
    // The compiler's incremental analysis sessions
    // (compiler/frontend/incremental_analysis.sn): one for the project
    // analysis and one for document analyses. A session keeps std and the
    // unchanged modules analysed; a request of another shape (another entry,
    // other inputs, another environment) starts it afresh by itself.
    الجلسات: مشترك<قفل<جلسات_تحليل_لغة>>,
    // Closing brace hints after a declaration of at least this many lines
    // (initializationOptions.closingBraceHintsMinLines, default 25 as
    // rust-analyzer; 0 turns them off).
    أسطر_تلميح_القوس: طبيعي,
    // initializationOptions.bidiIsolates (protocol/initialize.sn).
    عوازل_الاتجاه: منطقي
};

عام نوع جلسات_تحليل_لغة = {
    المشروع: جلسة_تحليل_تزايدي,
    المستند: جلسة_تحليل_تزايدي
};

// "ar"/"arabic"/"العربية" select Arabic, "en"/"english" English, anything else Auto.
عام عرف عين_تفضيل_لغة_العرض(
    المساحة: &متغير مساحة_عمل_لغة,
    القيمة: &نص
): فراغ {
    ليكن بادئة_عربية: نص = «ar»;
    ليكن اسم_عربي: نص = «العربية»;
    ليكن بادئة_إنجليزية: نص = «en»;
    إذا (يبدأ_بـ(القيمة, &بادئة_عربية) || نصان_متساويان(القيمة, &اسم_عربي)) {
        (*المساحة).تفضيل_لغة_العرض := تفضيل_لغة_عرض_لغة.العربية();
    } وإلا إذا (يبدأ_بـ(القيمة, &بادئة_إنجليزية)) {
        (*المساحة).تفضيل_لغة_العرض := تفضيل_لغة_عرض_لغة.الإنجليزية();
    } وإلا {
        (*المساحة).تفضيل_لغة_العرض := تفضيل_لغة_عرض_لغة.تلقائي();
    };
}

// Surface detection for Auto: Arabic letters (UTF-8 lead bytes D8..DB) against
// ASCII letters, comments and strings included. Ties read as English.
عام عرف مستند_لغة_بالعربية(المستند: &مستند_لغة_مفتوح): منطقي {
    طابق (*المستند).تفضيل_اللغة مع
    | تفضيل_لغة_عرض_لغة.العربية -> { أرجع صواب; }
    | تفضيل_لغة_عرض_لغة.الإنجليزية -> { أرجع خطأ; }
    | تفضيل_لغة_عرض_لغة.تلقائي -> { };
    أرجع نص_بالعربية_لغة(&(*المستند).النص);
}

// Whether a text is mostly Arabic letters (bytes D8..DB lead Arabic letters).
عام عرف نص_بالعربية_لغة(النص: &نص): منطقي {
    ليكن العربية: متغير طبيعي = 0;
    ليكن اللاتينية: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب >= 0xD8 && ب <= 0xDB) { العربية := العربية + 1; }
        وإلا إذا ((ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A)) { اللاتينية := اللاتينية + 1; };
        ف := ف + 1;
    }
    أرجع العربية > اللاتينية;
}

عرف مسار_ملف_عنوان_لغة(العنوان: &نص): اختياري نص {
    طابق عنوان_ملف_إلى_مسار(العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(المسار) -> {
        ليكن المطبع: نص = طبع_المسار(&المسار);
        أرجع اختياري.موجود(المطبع);
    };
}

// Read-only URI adapter for semantic requests whose hierarchy target is not open.
// File/URI decoding remains workspace ownership; semantic analysis still goes through
// the canonical compiler frontend.
عام عرف مستند_لغة_للقراءة_من_عنوان(العنوان: &نص): اختياري مستند_لغة_مفتوح {
    طابق مسار_ملف_عنوان_لغة(العنوان) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار) -> {
        طابق اقرأ_الملف(&المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(النص) -> { أرجع ابن_مستند_لغة_للقراءة(&المسار, النص); };
    };
}

عرف احذف_فهرسة_مسار_مستند(
    الفهرس: &متغير خريطة_نص_فهرس,
    المستند: &مستند_لغة_مفتوح
): فراغ {
    ليكن القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مسار_الملف مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المسار) -> {
        احذف_من_خريطة_نص_فهرس(الفهرس, &المسار);
    };
}

عرف أضف_فهرسة_مسار_مستند(
    خريطة_المسارات: &متغير خريطة_نص_فهرس,
    المسار: &اختياري نص,
    فهرس_المستند: طبيعي
): فراغ {
    ليكن قيمة_المسار: اختياري نص = *المسار;
    طابق قيمة_المسار مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        أدرج_في_خريطة_نص_فهرس(خريطة_المسارات, استنسخ(&القيمة), فهرس_المستند);
    };
}

عام عرف ابن_مستند_لغة_للقراءة(
    المسار: &نص,
    النص: نص
): اختياري مستند_لغة_مفتوح {
    ليكن المطبع: نص = طبع_المسار(المسار);
    ليكن العنوان: متغير نص = «»;
    طابق مسار_إلى_عنوان_ملف(&المطبع) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
    ليكن فهرس_السطور: فهرس_سطور = ابن_فهرس_السطور(&النص);
    ليكن بلا_حفظ: اختياري طبيعي = اختياري.لا_شيء();
    ليكن بلا_رفض: اختياري طبيعي = اختياري.لا_شيء();
    ليكن اختيار_المسار: اختياري نص = اختياري.موجود(المطبع);
    ليكن المستند: مستند_لغة_مفتوح = {
        العنوان: العنوان,
        تفضيل_اللغة: تفضيل_لغة_عرض_لغة.تلقائي(),
        مسار_الملف: اختيار_المسار,
        اللغة: «sultanc»,
        الإصدار: 0,
        المراجعة: 0,
        مراجعة_الحفظ: بلا_حفظ,
        مراجعة_رفض_الدلالات: بلا_رفض,
        النص: النص,
        فهرس_السطور: فهرس_السطور
    };
    أرجع اختياري.موجود(المستند);
}

// Source names as the compiler sees them. `sultanc check path` is given a path
// relative to the working directory (the SultanC checkout), and that is what
// makes the checkout the module root (compiler.*, tests, examples). A document
// inside the working directory is therefore handed over the same way; any
// other document keeps its absolute path.
عام عرف مسار_للمترجم_لغة(المسار: &نص): نص {
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع استنسخ(المسار); }
    | نتيجة.نجح(الجذر) -> {
        ليكن المطبع: نص = طبع_المسار(المسار);
        ليكن فاصل: نص = «/»;
        ليكن أجزاء: متجه نص = [طبع_المسار(&الجذر), فاصل];
        ليكن الفارغ: نص = «»;
        ليكن البادئة: نص = صل_النصوص(&أجزاء, &الفارغ);
        إذا (يبدأ_بـ(&المطبع, &البادئة)) {
            ليكن الطول_الكلي: طبيعي = الطول(المطبع) مثل طبيعي;
            ليكن طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
            طابق مقطع_نص(&المطبع, طول_البادئة, الطول_الكلي - طول_البادئة) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(النسبي) -> { أرجع النسبي; };
        };
        أرجع استنسخ(المسار);
    };
}

// Absolute, normalised form of a source name (relative names are relative to
// the working directory).
عام عرف مسار_مطلق_مطبع_لغة(المسار: &نص): نص {
    إذا (مسار_مطلق(المسار)) { أرجع طبع_المسار(المسار); };
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع طبع_المسار(المسار); }
    | نتيجة.نجح(الجذر) -> {
        ليكن المضموم: نص = صل_المسار(&الجذر, المسار);
        أرجع طبع_المسار(&المضموم);
    };
}

عام عرف مساران_لنفس_الملف_لغة(أ: &نص, ب: &نص): منطقي {
    ليكن م1: نص = مسار_مطلق_مطبع_لغة(أ);
    ليكن م2: نص = مسار_مطلق_مطبع_لغة(ب);
    أرجع نصان_متساويان(&م1, &م2);
}

عام عرف عدد_أسطر_مستند_لغة(المستند: &مستند_لغة_مفتوح): طبيعي {
    ليكن العدد: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    ليكن الحد: طبيعي = الطول((*المستند).النص) مثل طبيعي;
    طالما (ف < الحد) {
        إذا ((*المستند).النص[ف] == 0x0A) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

// Byte offsets where each line starts (line 0 starts at 0).
عرف بدايات_أسطر_نص_لغة(النص: &نص): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [0];
    ليكن ف: متغير طبيعي = 0;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الحد) {
        إذا ((*النص)[ف] == 0x0A) { ألحق(الناتج, ف + 1); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سطران_متطابقان_لغة(
    أ: &نص, بدايات_أ: &متجه طبيعي, سطر_أ: طبيعي,
    ب: &نص, بدايات_ب: &متجه طبيعي, سطر_ب: طبيعي
): منطقي {
    ليكن بداية_أ: طبيعي = (*بدايات_أ)[سطر_أ];
    ليكن بداية_ب: طبيعي = (*بدايات_ب)[سطر_ب];
    ليكن نهاية_أ: متغير طبيعي = الطول(*أ) مثل طبيعي;
    إذا (سطر_أ + 1 < (الطول(*بدايات_أ) مثل طبيعي)) { نهاية_أ := (*بدايات_أ)[سطر_أ + 1]; };
    ليكن نهاية_ب: متغير طبيعي = الطول(*ب) مثل طبيعي;
    إذا (سطر_ب + 1 < (الطول(*بدايات_ب) مثل طبيعي)) { نهاية_ب := (*بدايات_ب)[سطر_ب + 1]; };
    إذا ((نهاية_أ - بداية_أ) != (نهاية_ب - بداية_ب)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (نهاية_أ - بداية_أ)) {
        إذا ((*أ)[بداية_أ + ف] != (*ب)[بداية_ب + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Maps a line of the current text onto an earlier text of the same document:
// lines before the first changed line keep their number, lines after the last
// changed line shift by the line-count delta (common prefix / common suffix).
// Lines inside the edited region map to the start of that region in the earlier
// text when it still exists there; that keeps the enclosing scope for completion.
عام عرف اربط_سطرا_بنسخة_سابقة_لغة(
    السابق: &مستند_لغة_مفتوح,
    الحالي: &مستند_لغة_مفتوح,
    السطر: طبيعي,
    يقبل_المنطقة_المعدلة: منطقي
): اختياري طبيعي {
    ليكن بدايات_س: متجه طبيعي = بدايات_أسطر_نص_لغة(&(*السابق).النص);
    ليكن بدايات_ح: متجه طبيعي = بدايات_أسطر_نص_لغة(&(*الحالي).النص);
    ليكن عدد_س: طبيعي = الطول(بدايات_س) مثل طبيعي;
    ليكن عدد_ح: طبيعي = الطول(بدايات_ح) مثل طبيعي;
    إذا (السطر >= عدد_ح) { أرجع اختياري.لا_شيء(); };
    ليكن البادئة: متغير طبيعي = 0;
    طالما ((البادئة < عدد_س) && (البادئة < عدد_ح)
        && سطران_متطابقان_لغة(&(*السابق).النص, &بدايات_س, البادئة, &(*الحالي).النص, &بدايات_ح, البادئة)) {
        البادئة := البادئة + 1;
    }
    إذا (السطر < البادئة) { أرجع اختياري.موجود(السطر); };
    ليكن اللاحقة: متغير طبيعي = 0;
    طالما ((اللاحقة < (عدد_س - البادئة)) && (اللاحقة < (عدد_ح - البادئة))
        && سطران_متطابقان_لغة(
            &(*السابق).النص, &بدايات_س, عدد_س - 1 - اللاحقة,
            &(*الحالي).النص, &بدايات_ح, عدد_ح - 1 - اللاحقة
        )) {
        اللاحقة := اللاحقة + 1;
    }
    إذا (السطر >= (عدد_ح - اللاحقة)) {
        أرجع اختياري.موجود(السطر - عدد_ح + عدد_س);
    };
    إذا (يقبل_المنطقة_المعدلة && (البادئة < عدد_س)) { أرجع اختياري.موجود(البادئة); };
    أرجع اختياري.لا_شيء();
}

عرف جلسات_جديدة_لغة(): جلسات_تحليل_لغة {
    ليكن الجلسات: جلسات_تحليل_لغة = { المشروع: جلسة_تحليل_تزايدي_جديدة(), المستند: جلسة_تحليل_تزايدي_جديدة() };
    أرجع الجلسات;
}

عام عرف مساحة_عمل_لغة_جديدة(): مساحة_عمل_لغة {
    ليكن المستندات_الفارغة: متجه اختياري مستند_لغة_مفتوح = [];
    ليكن فهرس_العناوين_الفارغ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن فهرس_المسارات_الفارغ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الناتج: مساحة_عمل_لغة = {
        المستندات: المستندات_الفارغة,
        فهرس_العناوين: فهرس_العناوين_الفارغ,
        فهرس_المسارات: فهرس_المسارات_الفارغ,
        المراجعة: 0,
        تفضيل_لغة_العرض: تفضيل_لغة_عرض_لغة.تلقائي(),
        ينشر_التشخيصات: صواب,
        الإلغاء: أنشئ_مشترك(حالة_إلغاء_واجهة_جديدة()),
        سبب_الإلغاء: أنشئ_مشترك(أنشئ_ذرة_ط32(0 مثل ط32)),
        المخططات: [],
        الجلسات: أنشئ_مشترك(أنشئ_قفل(جلسات_جديدة_لغة())),
        أسطر_تلميح_القوس: 25,
        عوازل_الاتجاه: خطأ
    };
    أرجع الناتج;
}

عام عرف افتح_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: نص,
    اللغة: نص,
    الإصدار: عدد,
    النص: نص
): منطقي {
    (*المساحة).المراجعة := (*المساحة).المراجعة + 1;
    ليكن عنوان_المستند: نص = انسخ_نص_مستند_لغة(&العنوان);
    ليكن مسار_الملف: اختياري نص = مسار_ملف_عنوان_لغة(&العنوان);
    ليكن مسار_المستند: اختياري نص = انسخ_مسار_مستند_لغة(&مسار_الملف);
    ليكن مراجعة_الحفظ_الأولية: اختياري طبيعي = اختياري.لا_شيء();
    ليكن مراجعة_رفض_الدلالات_الأولية: اختياري طبيعي = اختياري.لا_شيء();
    ليكن فهرس_سطور_المستند: فهرس_سطور = ابن_فهرس_السطور(&النص);
    ليكن المستند: مستند_لغة_مفتوح = {
        العنوان: عنوان_المستند,
        تفضيل_اللغة: (*المساحة).تفضيل_لغة_العرض,
        مسار_الملف: مسار_المستند,
        اللغة: اللغة,
        الإصدار: الإصدار,
        المراجعة: (*المساحة).المراجعة,
        مراجعة_الحفظ: مراجعة_الحفظ_الأولية,
        مراجعة_رفض_الدلالات: مراجعة_رفض_الدلالات_الأولية,
        النص: النص,
        فهرس_السطور: فهرس_سطور_المستند
    };

    ليكن فهرس_المستند: متغير طبيعي = 0;
    طابق ابحث_في_خريطة_نص_فهرس(&(*المساحة).فهرس_العناوين, &العنوان) مع
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول((*المساحة).المستندات) مثل طبيعي)) { أرجع خطأ; };
        طابق استنسخ(&(*المساحة).المستندات[الفهرس]) مع
        | اختياري.موجود(القديم) -> {
            احذف_فهرسة_مسار_مستند(&متغير (*المساحة).فهرس_المسارات, &القديم);
        }
        | اختياري.لا_شيء -> { };
        (*المساحة).المستندات[الفهرس] := اختياري.موجود(المستند);
        فهرس_المستند := الفهرس;
    }
    | اختياري.لا_شيء -> {
        فهرس_المستند := الطول((*المساحة).المستندات) مثل طبيعي;
        ألحق((*المساحة).المستندات, اختياري.موجود(المستند));
        أدرج_في_خريطة_نص_فهرس(&متغير (*المساحة).فهرس_العناوين, العنوان, فهرس_المستند);
    };
    أضف_فهرسة_مسار_مستند(&متغير (*المساحة).فهرس_المسارات, &مسار_الملف, فهرس_المستند);
    أرجع صواب;
}

عام عرف غير_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    الإصدار: عدد,
    النص: نص
): منطقي {
    طابق ابحث_في_خريطة_نص_فهرس(&(*المساحة).فهرس_العناوين, العنوان) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول((*المساحة).المستندات) مثل طبيعي)) { أرجع خطأ; };
        طابق استنسخ(&(*المساحة).المستندات[الفهرس]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القديم) -> {
            // LSP TextDocumentItem.version يجب أن يزيد رتيبا؛ النسخة المكررة قد تعيد
            // تطبيق incremental edits، ولذلك نرفض <= وليس فقط النسخة الأقدم.
            إذا (الإصدار <= القديم.الإصدار) { أرجع خطأ; };
            (*المساحة).المراجعة := (*المساحة).المراجعة + 1;
            ليكن فهرس_سطور_الجديد: فهرس_سطور = ابن_فهرس_السطور(&النص);
            ليكن مرجع_القديم: &مستند_لغة_مفتوح = &القديم;
            ليكن الجديد: متغير مستند_لغة_مفتوح = استنسخ(مرجع_القديم);
            الجديد.الإصدار := الإصدار;
            الجديد.المراجعة := (*المساحة).المراجعة;
            الجديد.مراجعة_رفض_الدلالات := اختياري.لا_شيء();
            الجديد.النص := النص;
            الجديد.فهرس_السطور := فهرس_سطور_الجديد;
            (*المساحة).المستندات[الفهرس] := اختياري.موجود(الجديد);
        };
    };
    أرجع صواب;
}

عام عرف احفظ_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    النص: &اختياري نص
): منطقي {
    طابق ابحث_في_خريطة_نص_فهرس(&(*المساحة).فهرس_العناوين, العنوان) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول((*المساحة).المستندات) مثل طبيعي)) { أرجع خطأ; };
        طابق استنسخ(&(*المساحة).المستندات[الفهرس]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القديم) -> {
            ليكن الجديد: متغير مستند_لغة_مفتوح = استنسخ(&القديم);
            ليكن قيمة_النص: اختياري نص = *النص;
            طابق قيمة_النص مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المحفوظ) -> {
                إذا (!نصان_متساويان(&الجديد.النص, &المحفوظ)) {
                    (*المساحة).المراجعة := (*المساحة).المراجعة + 1;
                    الجديد.المراجعة := (*المساحة).المراجعة;
                    الجديد.مراجعة_رفض_الدلالات := اختياري.لا_شيء();
                    ليكن فهرس_سطور_المحفوظ: فهرس_سطور = ابن_فهرس_السطور(&المحفوظ);
                    الجديد.النص := استنسخ(&المحفوظ);
                    الجديد.فهرس_السطور := فهرس_سطور_المحفوظ;
                };
            };
            الجديد.مراجعة_الحفظ := اختياري.موجود(الجديد.المراجعة);
            (*المساحة).المستندات[الفهرس] := اختياري.موجود(الجديد);
        };
    };
    أرجع صواب;
}

عام عرف اغلق_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص
): منطقي {
    طابق احذف_من_خريطة_نص_فهرس(&متغير (*المساحة).فهرس_العناوين, العنوان) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول((*المساحة).المستندات) مثل طبيعي)) { أرجع خطأ; };
        طابق استنسخ(&(*المساحة).المستندات[الفهرس]) مع
        | اختياري.موجود(المستند) -> {
            احذف_فهرسة_مسار_مستند(&متغير (*المساحة).فهرس_المسارات, &المستند);
        }
        | اختياري.لا_شيء -> { };
        (*المساحة).المستندات[الفهرس] := اختياري.لا_شيء();
    };
    (*المساحة).المراجعة := (*المساحة).المراجعة + 1;
    أرجع صواب;
}

عام عرف مستند_لغة_عند(
    المساحة: &مساحة_عمل_لغة,
    العنوان: &نص
): اختياري مستند_لغة_مفتوح {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_العناوين, العنوان) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول(الحالة.المستندات) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        ليكن مرجع_المستند: &اختياري مستند_لغة_مفتوح = &الحالة.المستندات[الفهرس];
        ليكن النتيجة: اختياري مستند_لغة_مفتوح = *مرجع_المستند;
        أرجع استنسخ(&النتيجة);
    };
}

عام عرف مستند_لغة_بالمسار(
    المساحة: &مساحة_عمل_لغة,
    المسار: &نص
): اختياري مستند_لغة_مفتوح {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    ليكن المطبع: نص = طبع_المسار(المسار);
    طابق ابحث_في_خريطة_نص_فهرس(&الحالة.فهرس_المسارات, &المطبع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول(الحالة.المستندات) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        ليكن مرجع_المستند: &اختياري مستند_لغة_مفتوح = &الحالة.المستندات[الفهرس];
        ليكن النتيجة: اختياري مستند_لغة_مفتوح = *مرجع_المستند;
        أرجع استنسخ(&النتيجة);
    };
}

عام عرف لقطة_مستند_لغة_حديثة(
    المساحة: &مساحة_عمل_لغة,
    العنوان: &نص,
    الإصدار: عدد,
    المراجعة: طبيعي
): منطقي {
    طابق مستند_لغة_عند(المساحة, العنوان) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الحالي) -> {
        أرجع (الحالي.الإصدار == الإصدار) && (الحالي.المراجعة == المراجعة);
    };
}

عام عرف مستند_لغة_محفوظ(المستند: &مستند_لغة_مفتوح): منطقي {
    ليكن القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مراجعة_الحفظ مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المراجعة) -> { أرجع المراجعة == القيمة.المراجعة; };
}


عام عرف سجل_رفض_دلالات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    العنوان: &نص,
    المراجعة: طبيعي
): منطقي {
    طابق ابحث_في_خريطة_نص_فهرس(&(*المساحة).فهرس_العناوين, العنوان) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        إذا (الفهرس >= (الطول((*المساحة).المستندات) مثل طبيعي)) { أرجع خطأ; };
        طابق استنسخ(&(*المساحة).المستندات[الفهرس]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(المستند) -> {
            إذا (المستند.المراجعة != المراجعة) { أرجع خطأ; };
            ليكن الجديد: متغير مستند_لغة_مفتوح = استنسخ(&المستند);
            الجديد.مراجعة_رفض_الدلالات := اختياري.موجود(المراجعة);
            (*المساحة).المستندات[الفهرس] := اختياري.موجود(الجديد);
        };
    };
    أرجع صواب;
}

عام عرف دلالات_مستند_مرفوضة_للمراجعة(
    المستند: &مستند_لغة_مفتوح
): منطقي {
    ليكن القيمة: مستند_لغة_مفتوح = *المستند;
    طابق القيمة.مراجعة_رفض_الدلالات مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المراجعة) -> { أرجع المراجعة == القيمة.المراجعة; };
}

عام عرف توجد_دلالات_مرفوضة_في_مساحة_العمل_لغة(
    المساحة: &مساحة_عمل_لغة
): منطقي {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المستندات) مثل طبيعي)) {
        طابق الحالة.المستندات[ف] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المستند) -> {
            إذا (دلالات_مستند_مرفوضة_للمراجعة(&المستند)) {
                أرجع صواب;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}
