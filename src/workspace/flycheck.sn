استورد std.process.command;
استورد std.process.child;
استورد std.env.system;
استورد std.env.variables;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.directory;
استورد std.fs.canonical;
استورد std.json.parse;
استورد std.json.value;
استورد std.uri.uri;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.text.search;
استورد std.text.transform;
استورد sultanc_analyzer.protocol.serialize;
استورد sultanc_analyzer.protocol.text_document;
استورد sultanc_analyzer.workspace.documents;

// Check on save ("flycheck", as rust-analyzer runs `cargo check`): after a
// save, and once at start, the server runs the compiler's own check over the
// project and shows its diagnostics for the files that are not open. An open
// file keeps its live diagnostics (the analysis of its current text); when it
// is closed, the last check's diagnostics for it come back.
//
// The command is the one Supax runs for `supax check`
// (supax src/build/compiler.sn): `sultanc check <entry>`, with the package
// graph on standard input in a Supax package, plus `--diagnostic-format=json`.
// The entry is `src/main.sn` or `main.sn` (the same search as Supax), or the
// files named by the `checkEntries` setting. The check runs on its own thread;
// its result reaches the main loop as a `$/sultanc/flycheck` frame.
//
// Messages are in the file's language: the check runs in English, and once
// more in Arabic when a file it reports is Arabic (the compiler writes one
// language per run).

// One `sultanc check`: the working directory, the entry, and the package
// graph text for standard input (Supax), if any.
عام نوع أمر_فحص_لغة = {
    الدليل: نص,
    المدخل: نص,
    المخطط: اختياري نص
};

// The last check's diagnostics of one file: its normalized path, the uri they
// were published under, and the LSP Diagnostic array (JSON text).
عام نوع ملف_فحص_لغة = {
    المسار: نص,
    العنوان: نص,
    العناصر: نص
};

عام نوع حالة_فحص_لغة = {
    // `checkOnSave` (default true).
    مفعل: منطقي,
    // `checkEntries`: entry files, absolute or relative to the first
    // workspace folder; empty means the Supax search.
    المداخل: متجه نص,
    // `compilerPath`; empty means <home>/build/sultanc, home being the parent
    // of the standard library directory.
    المترجم: نص,
    يعمل: منطقي,
    // A save arrived while a check was running: check again when it ends.
    معلق: منطقي,
    الجيل: طبيعي,
    الملفات: متجه ملف_فحص_لغة,
    // "no entry" has been logged.
    أبلغ_بلا_مدخل: منطقي
};

عام عرف حالة_فحص_جديدة_لغة(): حالة_فحص_لغة {
    ليكن المداخل: متجه نص = [];
    ليكن الملفات: متجه ملف_فحص_لغة = [];
    ليكن الناتج: حالة_فحص_لغة = {
        مفعل: صواب,
        المداخل: المداخل,
        المترجم: «»,
        يعمل: خطأ,
        معلق: خطأ,
        الجيل: 0,
        الملفات: الملفات,
        أبلغ_بلا_مدخل: خطأ
    };
    أرجع الناتج;
}

// A regular file, through symbolic links (a compiler installed as a link,
// as Homebrew and Supax's installer do).
عرف ملف_موجود_فحص_لغة(المسار: &نص): منطقي {
    ليكن الهدف: متغير نص = استنسخ(المسار);
    طابق مسار_قانوني(المسار) مع
    | نتيجة.نجح(القانوني) -> { الهدف := القانوني; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
    طابق حاول_مسار_ملف(&الهدف) مع
    | نتيجة.نجح(موجود) -> { أرجع موجود; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// The compiler a check runs: the setting, else $SULTANC (as Supax), else
// <home>/build/sultanc next to the standard library the server uses (a
// checkout, or a release bundle that includes the compiler), else
// ~/.supax/bin/sultanc (Supax's install), else `sultanc` from PATH.
عام عرف مسار_مترجم_الفحص_لغة(الحالة: &حالة_فحص_لغة, دليل_المكتبة: &نص): نص {
    إذا ((الطول((*الحالة).المترجم) مثل طبيعي) > 0) { أرجع استنسخ(&(*الحالة).المترجم); };
    ليكن الاسم: نص = «SULTANC»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع القيمة; };
    }
    | _ -> { };
    طابق أب_المسار(دليل_المكتبة) مع
    | اختياري.موجود(البيت) -> {
        ليكن النسبي: نص = «build/sultanc»;
        ليكن المرشح: نص = صل_المسار(&البيت, &النسبي);
        إذا (ملف_موجود_فحص_لغة(&المرشح)) { أرجع المرشح; };
    }
    | اختياري.لا_شيء -> { };
    طابق الدليل_الرئيسي() مع
    | نتيجة.نجح(اختياري.موجود(البيت)) -> {
        ليكن النسبي: نص = «.supax/bin/sultanc»;
        ليكن المرشح: نص = صل_المسار(&البيت, &النسبي);
        إذا (ملف_موجود_فحص_لغة(&المرشح)) { أرجع المرشح; };
    }
    | _ -> { };
    أرجع «sultanc»;
}

// The entry Supax would check in a folder: src/main.sn, else main.sn.
عام عرف مدخل_مجلد_فحص_لغة(المجلد: &نص): اختياري نص {
    ليكن المرشحات: متجه نص = [«src/main.sn», «main.sn»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرشحات) مثل طبيعي)) {
        ليكن المسار: نص = صل_المسار(المجلد, &المرشحات[ف]);
        إذا (ملف_موجود_فحص_لغة(&المسار)) { أرجع اختياري.موجود(طبع_المسار(&المسار)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// ---- Running (on the check's thread) ---------------------------------------

عرف شغل_أمر_فحص_لغة(المترجم: &نص, الأمر: &أمر_فحص_لغة, اللغة: &نص, الإخفاق: &متغير نص): نص {
    ليكن الأمر_المبني: متغير أمر = أنشئ_أمرا(المترجم);
    ليكن خيار_اللغة: نص = صل_نصين(&«--lang=», اللغة);
    أضف_وسيطة_للأمر(&متغير الأمر_المبني, &خيار_اللغة);
    أضف_وسيطة_للأمر(&متغير الأمر_المبني, &«check»);
    أضف_وسيطة_للأمر(&متغير الأمر_المبني, &«--diagnostic-format=json»);
    طابق استنسخ(&(*الأمر).المخطط) مع
    | اختياري.موجود(المخطط) -> {
        أضف_وسيطة_للأمر(&متغير الأمر_المبني, &«--package-graph=-»);
        ليكن البايتات: متغير متجه ط8 = [];
        ألحق_بايتات_نص(&متغير البايتات, المخطط);
        اضبط_بيانات_دخل_الأمر(&متغير الأمر_المبني, &البايتات);
    }
    | اختياري.لا_شيء -> { };
    أضف_وسيطة_للأمر(&متغير الأمر_المبني, &(*الأمر).المدخل);
    اضبط_دليل_الأمر(&متغير الأمر_المبني, &(*الأمر).الدليل);
    طابق اجمع_خرج_الأمر(&الأمر_المبني) مع
    | نتيجة.خطأ(_) -> {
        ليكن الأجزاء: متجه نص = [«the compiler could not be started (`», استنسخ(المترجم), «`); set "sultanc.compiler.path"»];
        *الإخفاق := صل_النصوص(&الأجزاء, &«»);
        أرجع «»;
    }
    | نتيجة.نجح(الناتج) -> {
        // The JSON diagnostics are written to standard error.
        ليكن الخطأ: نص = من_بايتات(&الناتج.الخطأ);
        ليكن الخرج: نص = من_بايتات(&الناتج.الخرج);
        أرجع صل_ثلاثة_نصوص(&الخطأ, &"\n", &الخرج);
    };
}

عرف شغل_أوامر_فحص_لغة(المترجم: &نص, الأوامر: &متجه أمر_فحص_لغة, اللغة: &نص, الإخفاق: &متغير نص): نص {
    ليكن الأجزاء: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأوامر) مثل طبيعي)) {
        ألحق(الأجزاء, شغل_أمر_فحص_لغة(المترجم, &(*الأوامر)[ف], اللغة, الإخفاق));
        ف := ف + 1;
    }
    أرجع صل_النصوص(&الأجزاء, &"\n");
}

// The primary file of each JSON diagnostic line of a report.
عرف ملفات_تقرير_فحص_لغة(التقرير: &نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الأسطر: متجه نص = قسم_النص(التقرير, &"\n");
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        طابق حلل_جسون(&الأسطر[ف]) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(الوثيقة) -> {
            طابق ملف_تشخيص_فحص_لغة(&الوثيقة) مع
            | اختياري.موجود(الملف) -> { ألحق(الناتج, الملف); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Whether a file on disk is written in Arabic (the same count as an open
// document's, workspace/documents.sn).
عرف ملف_بالعربية_فحص_لغة(المسار: &نص): منطقي {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع نص_بالعربية_لغة(&النص); }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// The whole check: the English report, and the Arabic one when needed.
// التفضيل: 0 automatic (by file), 1 English, 2 Arabic. Returns the frame
// that carries the result to the main loop.
عام عرف نفذ_فحصا_لغة(المترجم: نص, الأوامر: متجه أمر_فحص_لغة, التفضيل: طبيعي, الجيل: طبيعي): نص {
    ليكن الإخفاق: متغير نص = «»;
    ليكن الإنجليزي: متغير نص = «»;
    ليكن العربي: متغير نص = «»;
    إذا (التفضيل != 2) {
        الإنجليزي := شغل_أوامر_فحص_لغة(&المترجم, &الأوامر, &«en», &متغير الإخفاق);
    };
    ليكن يلزم_العربي: متغير منطقي = التفضيل == 2;
    إذا (التفضيل == 0 && (الطول(الإخفاق) مثل طبيعي) == 0) {
        ليكن الملفات: متجه نص = ملفات_تقرير_فحص_لغة(&الإنجليزي);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الملفات) مثل طبيعي) && !يلزم_العربي) {
            يلزم_العربي := ملف_بالعربية_فحص_لغة(&الملفات[ف]);
            ف := ف + 1;
        }
    };
    إذا (يلزم_العربي && (الطول(الإخفاق) مثل طبيعي) == 0) {
        العربي := شغل_أوامر_فحص_لغة(&المترجم, &الأوامر, &«ar», &متغير الإخفاق);
    };
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"jsonrpc":"2.0","method":"$/sultanc/flycheck","params":{"generation":»);
    ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص(الجيل));
    ألحق_بايتات_نص(&متغير الناتج, «,"en":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &الإنجليزي);
    ألحق_بايتات_نص(&متغير الناتج, «,"ar":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &العربي);
    ألحق_بايتات_نص(&متغير الناتج, «,"failure":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &الإخفاق);
    ألحق_بايتات_نص(&متغير الناتج, «}}»);
    أرجع من_بايتات(&الناتج);
}

// ---- Reading a report (main loop) ------------------------------------------

عرف حقل_فحص_لغة(الوثيقة: &وثيقة_جسون, الفهرس: طبيعي, الاسم: نص): اختياري قيمة_جسون {
    أرجع قيمة_حقل_جسون(الوثيقة, الفهرس, الاسم);
}

عرف نص_حقل_فحص_لغة(الوثيقة: &وثيقة_جسون, الفهرس: طبيعي, الاسم: نص): اختياري نص {
    طابق حقل_فحص_لغة(الوثيقة, الفهرس, الاسم) مع
    | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { أرجع اختياري.موجود(النص); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف كائن_حقل_فحص_لغة(الوثيقة: &وثيقة_جسون, الفهرس: طبيعي, الاسم: نص): اختياري طبيعي {
    طابق حقل_فحص_لغة(الوثيقة, الفهرس, الاسم) مع
    | اختياري.موجود(قيمة_جسون.كائن(ف)) -> { أرجع اختياري.موجود(ف); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A JSON number field as a natural number (0 when absent).
عرف رقم_حقل_فحص_لغة(الوثيقة: &وثيقة_جسون, الفهرس: طبيعي, الاسم: نص): طبيعي {
    طابق حقل_فحص_لغة(الوثيقة, الفهرس, الاسم) مع
    | اختياري.موجود(قيمة_جسون.رقم(النص)) -> {
        ليكن الناتج: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(النص) مثل طبيعي)) {
            ليكن ب: ط8 = النص[ف];
            إذا (ب < 0x30 || ب > 0x39) { أرجع الناتج; };
            الناتج := الناتج * 10 + ((ب - 0x30) مثل طبيعي);
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | _ -> { أرجع 0; };
}

// The diagnostic's primary file (normalized), when it has a location.
عرف ملف_تشخيص_فحص_لغة(الوثيقة: &وثيقة_جسون): اختياري نص {
    طابق فهرس_كائن_جسون(جذر_وثيقة_جسون(الوثيقة)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجذر) -> {
        طابق كائن_حقل_فحص_لغة(الوثيقة, الجذر, «primary_span») مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النطاق) -> {
            طابق نص_حقل_فحص_لغة(الوثيقة, النطاق, «file») مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الملف) -> { أرجع اختياري.موجود(مسار_مطلق_مطبع_لغة(&الملف)); };
        };
    };
}

// An LSP Range from a compiler span (1-based lines, UTF-16 columns).
عرف ألحق_نطاق_فحص_لغة(الناتج: &متغير متجه ط8, الوثيقة: &وثيقة_جسون, النطاق: طبيعي): فراغ {
    ليكن السطر: طبيعي = رقم_حقل_فحص_لغة(الوثيقة, النطاق, «line»);
    ليكن العمود: طبيعي = رقم_حقل_فحص_لغة(الوثيقة, النطاق, «column_utf16»);
    ليكن سطر_النهاية: طبيعي = رقم_حقل_فحص_لغة(الوثيقة, النطاق, «end_line»);
    ليكن عمود_النهاية: طبيعي = رقم_حقل_فحص_لغة(الوثيقة, النطاق, «end_column_utf16»);
    ليكن أ: طبيعي = إذا_موجب_فحص_لغة(السطر);
    ليكن ب: طبيعي = إذا_موجب_فحص_لغة(العمود);
    ليكن ج: طبيعي = إذا_موجب_فحص_لغة(سطر_النهاية);
    ليكن د: طبيعي = إذا_موجب_فحص_لغة(عمود_النهاية);
    ألحق_بايتات_نص(الناتج, «{"start":{"line":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(أ));
    ألحق_بايتات_نص(الناتج, «,"character":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(ب));
    ألحق_بايتات_نص(الناتج, «},"end":{"line":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(ج));
    ألحق_بايتات_نص(الناتج, «,"character":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(د));
    ألحق_بايتات_نص(الناتج, «}}»);
}

عرف إذا_موجب_فحص_لغة(القيمة: طبيعي): طبيعي {
    إذا (القيمة > 0) { أرجع القيمة - 1; };
    أرجع 0;
}

عرف عنوان_مسار_فحص_لغة(المسار: &نص): نص {
    طابق مسار_إلى_عنوان_ملف(المسار) مع
    | نتيجة.نجح(العنوان) -> { أرجع العنوان; }
    | نتيجة.خطأ(_) -> { أرجع صل_نصين(&«file://», المسار); };
}

// LSP DiagnosticSeverity for the compiler's severity name.
عرف شدة_فحص_لغة(الشدة: &نص): نص {
    إذا (نصان_متساويان(الشدة, &«error»)) { أرجع «1»; };
    إذا (نصان_متساويان(الشدة, &«warning»)) { أرجع «2»; };
    إذا (نصان_متساويان(الشدة, &«help»)) { أرجع «4»; };
    أرجع «3»;
}

// One JSON diagnostic line as an LSP Diagnostic (the fields the live
// diagnostics have: range, severity, code, source, message,
// relatedInformation). None for a line without a location.
عرف تشخيص_لغة_من_فحص_لغة(الوثيقة: &وثيقة_جسون): اختياري نص {
    ليكن الجذر: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(جذر_وثيقة_جسون(الوثيقة)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الجذر := ف; };
    ليكن النطاق: متغير طبيعي = 0;
    طابق كائن_حقل_فحص_لغة(الوثيقة, الجذر, «primary_span») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { النطاق := ف; };
    ليكن المعرف: نص = نص_أو_فارغ_فحص_لغة(نص_حقل_فحص_لغة(الوثيقة, الجذر, «id»));
    ليكن الشدة: نص = نص_أو_فارغ_فحص_لغة(نص_حقل_فحص_لغة(الوثيقة, الجذر, «severity»));
    ليكن الرسالة: نص = نص_أو_فارغ_فحص_لغة(نص_حقل_فحص_لغة(الوثيقة, الجذر, «message»));
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"range":»);
    ألحق_نطاق_فحص_لغة(&متغير الناتج, الوثيقة, النطاق);
    ألحق_بايتات_نص(&متغير الناتج, «,"severity":»);
    ألحق_بايتات_نص(&متغير الناتج, شدة_فحص_لغة(&الشدة));
    ألحق_بايتات_نص(&متغير الناتج, «,"code":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &المعرف);
    ألحق_بايتات_نص(&متغير الناتج, «,"source":"SultanC","message":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &الرسالة);
    طابق حقل_فحص_لغة(الوثيقة, الجذر, «related_spans») مع
    | اختياري.موجود(قيمة_جسون.مصفوفة(المصفوفة)) -> {
        ليكن العدد: متغير طبيعي = 0;
        طابق طول_مصفوفة_جسون(الوثيقة, المصفوفة) مع
        | اختياري.موجود(ن) -> { العدد := ن; }
        | اختياري.لا_شيء -> { };
        ليكن المكتوبة: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق عنصر_مصفوفة_جسون(الوثيقة, المصفوفة, ف) مع
            | اختياري.موجود(قيمة_جسون.كائن(المرتبط)) -> {
                طابق كائن_حقل_فحص_لغة(الوثيقة, المرتبط, «span») مع
                | اختياري.موجود(نطاق_مرتبط) -> {
                    طابق نص_حقل_فحص_لغة(الوثيقة, نطاق_مرتبط, «file») مع
                    | اختياري.موجود(الملف) -> {
                        إذا (المكتوبة == 0) { ألحق_بايتات_نص(&متغير الناتج, «,"relatedInformation":[»); }
                        وإلا { ألحق(الناتج, 0x2C); };
                        المكتوبة := المكتوبة + 1;
                        ليكن المطبع: نص = مسار_مطلق_مطبع_لغة(&الملف);
                        ألحق_بايتات_نص(&متغير الناتج, «{"location":{"uri":»);
                        ليكن عنوان_المرتبط: نص = عنوان_مسار_فحص_لغة(&المطبع);
                        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &عنوان_المرتبط);
                        ألحق_بايتات_نص(&متغير الناتج, «,"range":»);
                        ألحق_نطاق_فحص_لغة(&متغير الناتج, الوثيقة, نطاق_مرتبط);
                        ألحق_بايتات_نص(&متغير الناتج, «},"message":»);
                        ليكن الوسم: نص = نص_أو_فارغ_فحص_لغة(نص_حقل_فحص_لغة(الوثيقة, المرتبط, «label»));
                        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &الوسم);
                        ألحق(الناتج, 0x7D);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ف := ف + 1;
        }
        إذا (المكتوبة > 0) { ألحق(الناتج, 0x5D); };
    }
    | _ -> { };
    ألحق(الناتج, 0x7D);
    أرجع اختياري.موجود(من_بايتات(&الناتج));
}

عرف نص_أو_فارغ_فحص_لغة(القيمة: اختياري نص): نص {
    طابق القيمة مع
    | اختياري.موجود(النص) -> { أرجع النص; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// Diagnostics of a report grouped by file (each file once, each identical
// diagnostic once: two entries can report the same module).
عرف أضف_تقرير_فحص_لغة(التقرير: &نص, المسارات: &متغير متجه نص, العناصر: &متغير متجه متجه نص): فراغ {
    ليكن الأسطر: متجه نص = قسم_النص(التقرير, &"\n");
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        طابق حلل_جسون(&الأسطر[ف]) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(الوثيقة) -> {
            طابق ملف_تشخيص_فحص_لغة(&الوثيقة) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الملف) -> {
                طابق تشخيص_لغة_من_فحص_لغة(&الوثيقة) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(العنصر) -> {
                    ليكن الموضع: متغير طبيعي = الطول(*المسارات) مثل طبيعي;
                    ليكن م: متغير طبيعي = 0;
                    طالما (م < (الطول(*المسارات) مثل طبيعي)) {
                        إذا (نصان_متساويان(&(*المسارات)[م], &الملف)) { الموضع := م; };
                        م := م + 1;
                    }
                    إذا (الموضع == (الطول(*المسارات) مثل طبيعي)) {
                        ألحق(*المسارات, استنسخ(&الملف));
                        ليكن فارغ: متجه نص = [];
                        ألحق(*العناصر, فارغ);
                    };
                    ليكن مكرر: متغير منطقي = خطأ;
                    ليكن ع: متغير طبيعي = 0;
                    طالما (ع < (الطول((*العناصر)[الموضع]) مثل طبيعي)) {
                        إذا (نصان_متساويان(&(*العناصر)[الموضع][ع], &العنصر)) { مكرر := صواب; };
                        ع := ع + 1;
                    }
                    إذا (!مكرر) { ألحق((*العناصر)[الموضع], العنصر); };
                };
            };
        };
        ف := ف + 1;
    }
}

// The files of a finished check, each with its diagnostics in its language
// (التفضيل as for نفذ_فحصا_لغة).
عام عرف ملفات_فحص_من_تقريرين_لغة(الإنجليزي: &نص, العربي: &نص, التفضيل: طبيعي): متجه ملف_فحص_لغة {
    ليكن مسارات_en: متغير متجه نص = [];
    ليكن عناصر_en: متغير متجه متجه نص = [];
    أضف_تقرير_فحص_لغة(الإنجليزي, &متغير مسارات_en, &متغير عناصر_en);
    ليكن مسارات_ar: متغير متجه نص = [];
    ليكن عناصر_ar: متغير متجه متجه نص = [];
    أضف_تقرير_فحص_لغة(العربي, &متغير مسارات_ar, &متغير عناصر_ar);
    // The files: those of the English report, else (Arabic only) the Arabic one.
    ليكن الأساس_عربي: منطقي = (الطول(مسارات_en) مثل طبيعي) == 0;
    ليكن الناتج: متغير متجه ملف_فحص_لغة = [];
    ليكن العدد: طبيعي = إذا_عربي_عدد_فحص_لغة(الأساس_عربي, الطول(مسارات_ar) مثل طبيعي, الطول(مسارات_en) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن المسار: نص = إذا_عربي_نص_فحص_لغة(الأساس_عربي, &مسارات_ar, &مسارات_en, ف);
        ليكن العناصر: متغير متجه نص = [];
        إذا (الأساس_عربي) { العناصر := استنسخ(&عناصر_ar[ف]); } وإلا { العناصر := استنسخ(&عناصر_en[ف]); };
        إذا (!الأساس_عربي && التفضيل != 1 && (الطول(مسارات_ar) مثل طبيعي) > 0 && ملف_بالعربية_فحص_لغة(&المسار)) {
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(مسارات_ar) مثل طبيعي)) {
                إذا (نصان_متساويان(&مسارات_ar[م], &المسار)) { العناصر := استنسخ(&عناصر_ar[م]); };
                م := م + 1;
            }
        };
        ليكن الموصولة: نص = صل_النصوص(&العناصر, &«,»);
        ليكن الملف: ملف_فحص_لغة = {
            المسار: استنسخ(&المسار),
            العنوان: عنوان_مسار_فحص_لغة(&المسار),
            العناصر: صل_ثلاثة_نصوص(&«[», &الموصولة, &«]»)
        };
        ألحق(الناتج, الملف);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف إذا_عربي_عدد_فحص_لغة(عربي: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (عربي) { أرجع أ; };
    أرجع ب;
}

عرف إذا_عربي_نص_فحص_لغة(عربي: منطقي, أ: &متجه نص, ب: &متجه نص, ف: طبيعي): نص {
    إذا (عربي) { أرجع استنسخ(&(*أ)[ف]); };
    أرجع استنسخ(&(*ب)[ف]);
}

// A textDocument/publishDiagnostics notification.
عام عرف إشعار_نشر_فحص_لغة(العنوان: &نص, العناصر: &نص): نص {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, العنوان);
    ألحق_بايتات_نص(&متغير الناتج, «,"diagnostics":»);
    ألحق_بايتات_نص(&متغير الناتج, استنسخ(العناصر));
    ألحق_بايتات_نص(&متغير الناتج, «}}»);
    أرجع من_بايتات(&الناتج);
}

// The stored result for a file, by path.
عام عرف ملف_فحص_بالمسار_لغة(الحالة: &حالة_فحص_لغة, المسار: &نص): اختياري ملف_فحص_لغة {
    ليكن المطبع: نص = مسار_مطلق_مطبع_لغة(المسار);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الملفات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الحالة).الملفات[ف].المسار, &المطبع)) {
            أرجع اختياري.موجود(استنسخ(&(*الحالة).الملفات[ف]));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
