استورد std.process.command;
استورد std.process.child;
استورد std.env.system;
استورد std.env.variables;
استورد std.fs.path;
استورد std.fs.directory;
استورد std.toml.parser;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.text.search;
استورد std.text.transform;

// Supax package graph of a workspace folder (Supax docs/compiler-integration.md,
// "Current contract: the package graph"). A folder holding Supax.toml gets its
// graph from `supax metadata`, run in that folder, as rust-analyzer runs
// `cargo metadata`. It is re-run when Supax.toml or Supax.lock changes. The
// server reads only the `source_root` of each `[[package]]`, to list the
// project's source files; every other field is the compiler's to read.
//
// The supax executable: $SUPAX, else `supax` on PATH, else ~/.supax/bin/supax.

عام نوع مخطط_حزم_لغة = {
    // The workspace folder (normalized) whose Supax.toml produced the graph.
    المجلد: نص,
    // `supax metadata` output, as written.
    النص: نص,
    // Every [[package]]: its id and absolute, normalized source_root, root
    // package first.
    الحزم: متجه حزمة_مخطط_لغة
};

عام نوع حزمة_مخطط_لغة = {
    المعرف: نص,
    الجذر: نص
};

عام نوع نتيجة_مخطط_حزم_لغة =
    | بلا_بيان
    | جاهز بنوع مخطط_حزم_لغة
    // supax missing, failing or printing an unreadable graph: the words to show.
    | فشل بنوع نص
;

عرف ملف_موجود_لغة(المسار: &نص): منطقي {
    طابق حاول_مسار_ملف(المسار) مع
    | نتيجة.نجح(موجود) -> { أرجع موجود; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عام عرف مسار_سوباكس_لغة(): نص {
    ليكن الاسم: نص = «SUPAX»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع القيمة; };
    }
    | _ -> { };
    ليكن المسار: نص = «PATH»;
    ليكن الفاصل: نص = «:»;
    طابق متغير_بيئة_النظام(&المسار) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        ليكن الأجزاء: متجه نص = قسم_النص(&القيمة, &الفاصل);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
            إذا ((الطول(الأجزاء[ف]) مثل طبيعي) > 0) {
                ليكن الاسم_التنفيذي: نص = «supax»;
                ليكن المرشح: نص = صل_المسار(&الأجزاء[ف], &الاسم_التنفيذي);
                إذا (ملف_موجود_لغة(&المرشح)) { أرجع المرشح; };
            };
            ف := ف + 1;
        }
    }
    | _ -> { };
    طابق الدليل_الرئيسي() مع
    | نتيجة.نجح(اختياري.موجود(البيت)) -> {
        ليكن النسبي: نص = «.supax/bin/supax»;
        ليكن المرشح: نص = صل_المسار(&البيت, &النسبي);
        إذا (ملف_موجود_لغة(&المرشح)) { أرجع المرشح; };
    }
    | _ -> { };
    أرجع «supax»;
}

// The first line of a command's error output, for a message.
عرف أول_سطر_لغة(البايتات: &متجه ط8): نص {
    ليكن النص: نص = من_بايتات(البايتات);
    ليكن السطر_الجديد: نص = "\n";
    ليكن الأسطر: متجه نص = قسم_النص(&النص, &السطر_الجديد);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        إذا ((الطول(الأسطر[ف]) مثل طبيعي) > 0) { أرجع استنسخ(&الأسطر[ف]); };
        ف := ف + 1;
    }
    أرجع «»;
}

// The id and source_root of each [[package]] of a graph text, the root
// absolute and normalized (a relative one is relative to المجلد); none when
// the text is not a graph.
عام عرف حزم_مخطط_لغة(النص: &نص, المجلد: &نص): اختياري متجه حزمة_مخطط_لغة {
    طابق حلل_تومل(النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الوثيقة) -> {
        ليكن مفتاح_الحزم: نص = «package»;
        ليكن مفتاح_الجذر: نص = «source_root»;
        ليكن مفتاح_المعرف: نص = «id»;
        ليكن الناتج: متغير متجه حزمة_مخطط_لغة = [];
        طابق قيمة_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &مفتاح_الحزم) مع
        | اختياري.موجود(قيمة_تومل.مصفوفة(فهرس_المصفوفة)) -> {
            ليكن الحزم: متجه قيمة_تومل = قيم_مصفوفة_تومل(&الوثيقة, فهرس_المصفوفة);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحزم) مثل طبيعي)) {
                طابق استنسخ(&الحزم[ف]) مع
                | قيمة_تومل.جدول(فهرس_الجدول) -> {
                    طابق قيمة_مفتاح_تومل(&الوثيقة, فهرس_الجدول, &مفتاح_الجذر) مع
                    | اختياري.موجود(قيمة_تومل.سلسلة(الجذر)) -> {
                        ليكن المطلق: متغير نص = استنسخ(&الجذر);
                        إذا (!مسار_مطلق(&المطلق)) { المطلق := صل_المسار(المجلد, &الجذر); };
                        طابق قيمة_مفتاح_تومل(&الوثيقة, فهرس_الجدول, &مفتاح_المعرف) مع
                        | اختياري.موجود(قيمة_تومل.سلسلة(المعرف)) -> {
                            ليكن الحزمة: حزمة_مخطط_لغة = { المعرف: المعرف, الجذر: طبع_المسار(&المطلق) };
                            ألحق(الناتج, الحزمة);
                        }
                        | _ -> { أرجع اختياري.لا_شيء(); };
                    }
                    | _ -> { أرجع اختياري.لا_شيء(); };
                }
                | _ -> { أرجع اختياري.لا_شيء(); };
                ف := ف + 1;
            }
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الناتج);
    };
}

// The graph of a workspace folder: none without Supax.toml in it or above it.
// The folder holding Supax.toml nearest to المجلد: itself or an ancestor (a
// workspace opened at a package's subfolder, as rust-analyzer finds
// Cargo.toml upward).
عام عرف مجلد_البيان_لغة(المجلد: &نص): اختياري نص {
    ليكن اسم_البيان: نص = «Supax.toml»;
    ليكن الحالي: متغير نص = طبع_المسار(المجلد);
    طالما (صواب) {
        ليكن البيان: نص = صل_المسار(&الحالي, &اسم_البيان);
        إذا (ملف_موجود_لغة(&البيان)) { أرجع اختياري.موجود(استنسخ(&الحالي)); };
        طابق أب_المسار(&الحالي) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الأب) -> {
            إذا ((الطول(الأب) مثل طبيعي) == 0 || نصان_متساويان(&الأب, &الحالي)) { أرجع اختياري.لا_شيء(); };
            الحالي := الأب;
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف مخطط_حزم_لمجلد_لغة(مجلد_العمل: &نص): نتيجة_مخطط_حزم_لغة {
    ليكن المجلد_المختار: متغير نص = «»;
    طابق مجلد_البيان_لغة(مجلد_العمل) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_مخطط_حزم_لغة.بلا_بيان(); }
    | اختياري.موجود(القيمة) -> { المجلد_المختار := القيمة; };
    ليكن المجلد: &نص = &المجلد_المختار;
    ليكن السوباكس: نص = مسار_سوباكس_لغة();
    ليكن الأمر: متغير أمر = أنشئ_أمرا(&السوباكس);
    ليكن الوسيطة: نص = «metadata»;
    أضف_وسيطة_للأمر(&متغير الأمر, &الوسيطة);
    ليكن اللغة: نص = «--lang=en»;
    أضف_وسيطة_للأمر(&متغير الأمر, &اللغة);
    اضبط_دليل_الأمر(&متغير الأمر, المجلد);
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة_مخطط_حزم_لغة.فشل(صل_النصوص(&[«supax could not be started (`», استنسخ(&السوباكس), «`); set SUPAX or put supax on PATH»], &«»));
    }
    | نتيجة.نجح(الناتج) -> {
        إذا (!هل_نجح_الأمر(&الناتج.الحالة)) {
            ليكن الأجزاء: متجه نص = [«supax metadata failed: », أول_سطر_لغة(&الناتج.الخطأ)];
            ليكن بلا: نص = «»;
            أرجع نتيجة_مخطط_حزم_لغة.فشل(صل_النصوص(&الأجزاء, &بلا));
        };
        ليكن النص: نص = من_بايتات(&الناتج.الخرج);
        طابق حزم_مخطط_لغة(&النص, المجلد) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_مخطط_حزم_لغة.فشل(«supax metadata printed no readable package graph»);
        }
        | اختياري.موجود(الحزم) -> {
            ليكن المخطط: مخطط_حزم_لغة = { المجلد: طبع_المسار(المجلد), النص: النص, الحزم: الحزم };
            أرجع نتيجة_مخطط_حزم_لغة.جاهز(المخطط);
        };
    };
}

// Whether a changed file (a file:// uri or a path) invalidates the graphs:
// Supax.toml or Supax.lock anywhere.
عام عرف ملف_يغير_المخطط_لغة(العنوان: &نص): منطقي {
    ليكن البيان: نص = «Supax.toml»;
    ليكن القفل: نص = «Supax.lock»;
    إذا (!ينتهي_بـ(العنوان, &البيان) && !ينتهي_بـ(العنوان, &القفل)) { أرجع خطأ; };
    ليكن الطول_الكلي: طبيعي = الطول(*العنوان) مثل طبيعي;
    إذا (الطول_الكلي == 10) { أرجع صواب; };
    ليكن قبل: ط8 = (*العنوان)[الطول_الكلي - 11];
    أرجع قبل == 0x2F || قبل == 0x5C;
}

// Where Supax writes the graph (build/supax/package-graph.toml): the name the
// compiler reports graph errors at; the graph's paths are absolute.
عام عرف مسار_ملف_المخطط_لغة(المخطط: &مخطط_حزم_لغة): نص {
    ليكن النسبي: نص = «build/supax/package-graph.toml»;
    أرجع صل_المسار(&(*المخطط).المجلد, &النسبي);
}

// The graph text with `root` set to the package whose files are compiled:
// the root package for its own files, a dependency for a file of that
// dependency (the graph's `root` is the package that owns the inputs).
عام عرف نص_مخطط_بجذر_لغة(المخطط: &مخطط_حزم_لغة, المعرف: &نص): نص {
    ليكن السطر_الجديد: نص = "\n";
    ليكن الأسطر: متجه نص = قسم_النص(&(*المخطط).النص, &السطر_الجديد);
    ليكن الناتج: متغير متجه نص = [];
    ليكن بادئة: نص = «root»;
    ليكن بُدل: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن السطر: &نص = &الأسطر[ف];
        ليكن بعد: متغير طبيعي = الطول(بادئة) مثل طبيعي;
        ليكن جذري: متغير منطقي = !بُدل && يبدأ_بـ(السطر, &بادئة);
        إذا (جذري) {
            طالما (بعد < (الطول(*السطر) مثل طبيعي) && (*السطر)[بعد] == 0x20) { بعد := بعد + 1; }
            جذري := بعد < (الطول(*السطر) مثل طبيعي) && (*السطر)[بعد] == 0x3D;
        };
        إذا (جذري) {
            ليكن أجزاء: متجه نص = [«root = "», استنسخ(المعرف), «"»];
            ليكن بلا: نص = «»;
            ألحق(الناتج, صل_النصوص(&أجزاء, &بلا));
            بُدل := صواب;
        } وإلا {
            ألحق(الناتج, استنسخ(السطر));
        };
        ف := ف + 1;
    }
    أرجع صل_النصوص(&الناتج, &السطر_الجديد);
}
