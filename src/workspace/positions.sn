استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.protocol.text_document;
استورد std.encoding.positions;

// التحويل الوحيد عند حد LSP: UTF-16 في البروتوكول ↔ إزاحة بايت UTF-8 في SultanC.
عام عرف موضع_لغة_إلى_إزاحة_بايت(
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): نتيجة طبيعي, خطأ_موضع_يونيكود {
    ليكن موضع16: موضع_نصي_يوتيف16 = {
        السطر: الموضع.السطر,
        العمود: الموضع.المحرف
    };
    أرجع موضع_نصي_يوتيف16_إلى_إزاحة_بايت(&(*المستند).النص, &(*المستند).فهرس_السطور, &موضع16);
}

عام عرف إزاحة_بايت_إلى_موضع_لغة(
    المستند: &مستند_لغة_مفتوح,
    الإزاحة: طبيعي
): نتيجة موضع_تغيير_لغة, خطأ_موضع_يونيكود {
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&(*المستند).النص, &(*المستند).فهرس_السطور, الإزاحة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموضع) -> {
        ليكن الناتج: موضع_تغيير_لغة = {
            السطر: الموضع.السطر,
            المحرف: الموضع.العمود
        };
        أرجع نتيجة.نجح(الناتج);
    };
}
