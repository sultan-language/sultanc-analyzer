استورد std.text.search;
استورد std.json.value;

// نماذج wire الخاصة بتهيئة LSP ومساحات العمل. تحويل URI إلى مسار يبقى في workspace.
عام نوع وصف_مجلد_مساحة_عمل_لغة = {
    العنوان: نص,
    الاسم: نص
};

عام نوع معاملات_تهيئة_لغة = {
    عنوان_الجذر: اختياري نص,
    مجلدات_مساحة_العمل: اختياري متجه وصف_مجلد_مساحة_عمل_لغة,
    // initializationOptions.language wins; an Arabic client `locale` is the fallback.
    اللغة: اختياري نص,
    // capabilities.textDocument.diagnostic: the client pulls diagnostics.
    يسحب_التشخيصات: منطقي,
    // initializationOptions.checkOnSave (default true), .checkEntries,
    // .compilerPath: the check on save (workspace/flycheck.sn).
    يفحص_عند_الحفظ: منطقي,
    مداخل_الفحص: متجه نص,
    مسار_المترجم: نص,
    // initializationOptions.lensRun (default true), .lensReferences
    // (default false): protocol/code_lens.sn.
    عدسة_التشغيل: منطقي,
    عدسة_المراجع: منطقي,
    // initializationOptions.closingBraceHintsMinLines (default 25, 0 off).
    أسطر_تلميح_القوس: طبيعي,
    // initializationOptions.bidiIsolates (default false): hover lines that
    // start in Arabic are wrapped in Unicode isolates (RLI … PDI), for
    // clients that render hover Markdown as HTML (VS Code). Terminal
    // clients show the controls as characters, so it is off by default.
    عوازل_الاتجاه: منطقي
};

عام نوع تغيير_مجلدات_مساحة_عمل_لغة = {
    المضافة: متجه وصف_مجلد_مساحة_عمل_لغة,
    المحذوفة: متجه وصف_مجلد_مساحة_عمل_لغة
};

عرف فهرس_كائن_تهيئة(القيمة: قيمة_جسون): اختياري طبيعي {
    طابق القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نص_تهيئة(القيمة: قيمة_جسون): اختياري نص {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع اختياري.موجود(النص); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_حقل_تهيئة(
    الوثيقة: &وثيقة_جسون,
    الفهرس: طبيعي,
    الاسم: نص
): اختياري قيمة_جسون {
    ليكن المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح);
}

عرف فك_وصف_مجلد_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختياري وصف_مجلد_مساحة_عمل_لغة {
    ليكن الفهرس: متغير طبيعي = 0;
    طابق فهرس_كائن_تهيئة(القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الفهرس := ف; };

    ليكن العنوان: متغير نص = «»;
    ليكن الاسم: متغير نص = «»;
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «uri») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق نص_تهيئة(قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النص) -> { العنوان := النص; };
    };
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «name») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق نص_تهيئة(قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النص) -> { الاسم := النص; };
    };

    ليكن الناتج: وصف_مجلد_مساحة_عمل_لغة = {
        العنوان: العنوان,
        الاسم: الاسم
    };
    أرجع اختياري.موجود(الناتج);
}

عرف فك_مصفوفة_مجلدات_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختياري متجه وصف_مجلد_مساحة_عمل_لغة {
    ليكن فهرس_المصفوفة: متغير طبيعي = 0;
    طابق القيمة مع
    | قيمة_جسون.مصفوفة(الفهرس) -> { فهرس_المصفوفة := الفهرس; }
    | _ -> { أرجع اختياري.لا_شيء(); };

    ليكن العدد: متغير طبيعي = 0;
    طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { العدد := ن; };

    ليكن المجلدات: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(عنصر) -> {
            طابق فك_وصف_مجلد_مساحة_عمل_لغة(الوثيقة, عنصر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المجلد) -> { ألحق(المجلدات, المجلد); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(المجلدات);
}

عام عرف فك_معاملات_تهيئة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري معاملات_تهيئة_لغة {
    ليكن الفهرس: متغير طبيعي = 0;
    طابق فهرس_كائن_تهيئة(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الفهرس := ف; };

    ليكن عنوان_الجذر: متغير اختياري نص = اختياري.لا_شيء();
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «rootUri») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.عدم -> { }
        | قيمة_جسون.سلسلة(النص) -> { عنوان_الجذر := اختياري.موجود(النص); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن المجلدات: متغير اختياري متجه وصف_مجلد_مساحة_عمل_لغة = اختياري.لا_شيء();
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «workspaceFolders») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.عدم -> { }
        | _ -> {
            طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيم) -> { المجلدات := اختياري.موجود(القيم); };
        };
    };

    ليكن اللغة: متغير اختياري نص = اختياري.لا_شيء();
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «locale») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق نص_تهيئة(القيمة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النص) -> {
            ليكن بادئة: نص = «ar»;
            إذا (يبدأ_بـ(&النص, &بادئة)) { اللغة := اختياري.موجود(النص); };
        };
    };
    ليكن يفحص: متغير منطقي = صواب;
    ليكن عدسة_تشغيل: متغير منطقي = صواب;
    ليكن عوازل: متغير منطقي = خطأ;
    ليكن عدسة_مراجع: متغير منطقي = خطأ;
    ليكن أسطر_القوس: متغير طبيعي = 25;
    ليكن المترجم: متغير نص = «»;
    ليكن المداخل: متغير متجه نص = [];
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «initializationOptions») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الخيارات) -> {
        طابق فهرس_كائن_تهيئة(الخيارات) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(فهرس_الخيارات) -> {
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «checkOnSave») مع
            | اختياري.موجود(قيمة_جسون.منطق(القيمة)) -> { يفحص := القيمة; }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «closingBraceHintsMinLines») مع
            | اختياري.موجود(قيمة_جسون.رقم(النص)) -> {
                ليكن القيمة: متغير طبيعي = 0;
                ليكن م: متغير طبيعي = 0;
                ليكن صالح: متغير منطقي = (الطول(النص) مثل طبيعي) > 0;
                طالما (م < (الطول(النص) مثل طبيعي)) {
                    ليكن ب: ط8 = النص[م];
                    إذا (ب < 0x30 || ب > 0x39) { صالح := خطأ; } وإلا { القيمة := القيمة * 10 + ((ب - 0x30) مثل طبيعي); };
                    م := م + 1;
                }
                إذا (صالح) { أسطر_القوس := القيمة; };
            }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «bidiIsolates») مع
            | اختياري.موجود(قيمة_جسون.منطق(القيمة)) -> { عوازل := القيمة; }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «lensRun») مع
            | اختياري.موجود(قيمة_جسون.منطق(القيمة)) -> { عدسة_تشغيل := القيمة; }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «lensReferences») مع
            | اختياري.موجود(قيمة_جسون.منطق(القيمة)) -> { عدسة_مراجع := القيمة; }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «compilerPath») مع
            | اختياري.موجود(قيمة_جسون.سلسلة(القيمة)) -> { المترجم := القيمة; }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «checkEntries») مع
            | اختياري.موجود(قيمة_جسون.مصفوفة(فهرس_المداخل)) -> {
                ليكن العدد: متغير طبيعي = 0;
                طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المداخل) مع
                | اختياري.موجود(ن) -> { العدد := ن; }
                | اختياري.لا_شيء -> { };
                ليكن م: متغير طبيعي = 0;
                طالما (م < العدد) {
                    طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المداخل, م) مع
                    | اختياري.موجود(قيمة_جسون.سلسلة(المدخل)) -> {
                        إذا ((الطول(المدخل) مثل طبيعي) > 0) { ألحق(المداخل, المدخل); };
                    }
                    | _ -> { };
                    م := م + 1;
                }
            }
            | _ -> { };
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الخيارات, «language») مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(القيمة) -> {
                طابق نص_تهيئة(القيمة) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النص) -> { اللغة := اختياري.موجود(النص); };
            };
        };
    };

    ليكن يسحب: متغير منطقي = خطأ;
    طابق قيمة_حقل_تهيئة(الوثيقة, الفهرس, «capabilities») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القدرات) -> {
        طابق فهرس_كائن_تهيئة(القدرات) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(فهرس_القدرات) -> {
            طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_القدرات, «textDocument») مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المستند) -> {
                طابق فهرس_كائن_تهيئة(المستند) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(فهرس_المستند) -> {
                    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_المستند, «diagnostic») مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(قيمة_جسون.كائن(_)) -> { يسحب := صواب; }
                    | _ -> { };
                };
            };
        };
    };

    ليكن الناتج: معاملات_تهيئة_لغة = {
        عنوان_الجذر: عنوان_الجذر,
        مجلدات_مساحة_العمل: المجلدات,
        اللغة: اللغة,
        يسحب_التشخيصات: يسحب,
        يفحص_عند_الحفظ: يفحص,
        مداخل_الفحص: المداخل,
        مسار_المترجم: المترجم,
        عدسة_التشغيل: عدسة_تشغيل,
        عدسة_المراجع: عدسة_مراجع,
        أسطر_تلميح_القوس: أسطر_القوس,
        عوازل_الاتجاه: عوازل
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_تغيير_مجلدات_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري تغيير_مجلدات_مساحة_عمل_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_تهيئة(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    ليكن فهرس_الحدث: متغير طبيعي = 0;
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_المعاملات, «event») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فهرس_كائن_تهيئة(القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ف) -> { فهرس_الحدث := ف; };
    };

    ليكن المضافة: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    ليكن المحذوفة: متغير متجه وصف_مجلد_مساحة_عمل_لغة = [];
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الحدث, «added») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيم) -> { المضافة := القيم; };
    };
    طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_الحدث, «removed») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فك_مصفوفة_مجلدات_مساحة_عمل_لغة(الوثيقة, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيم) -> { المحذوفة := القيم; };
    };

    ليكن الناتج: تغيير_مجلدات_مساحة_عمل_لغة = {
        المضافة: المضافة,
        المحذوفة: المحذوفة
    };
    أرجع اختياري.موجود(الناتج);
}

// The uri of every change in workspace/didChangeWatchedFiles params.
عام عرف عناوين_ملفات_متغيرة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    طابق فهرس_كائن_تهيئة(المعاملات) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(فهرس_المعاملات) -> {
        طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_المعاملات, «changes») مع
        | اختياري.موجود(قيمة_جسون.مصفوفة(فهرس_المصفوفة)) -> {
            ليكن العدد: متغير طبيعي = 0;
            طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ن) -> { العدد := ن; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(العنصر) -> {
                    طابق فهرس_كائن_تهيئة(العنصر) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(فهرس_العنصر) -> {
                        طابق قيمة_حقل_تهيئة(الوثيقة, فهرس_العنصر, «uri») مع
                        | اختياري.موجود(قيمة_جسون.سلسلة(العنوان)) -> { ألحق(الناتج, العنوان); }
                        | _ -> { };
                    };
                };
                ف := ف + 1;
            }
        }
        | _ -> { };
    };
    أرجع الناتج;
}
