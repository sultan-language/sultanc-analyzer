استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.encode;
استورد sultanc_analyzer.protocol.diagnostics;
استورد sultanc_analyzer.analysis.frontend;
استورد sultanc_analyzer.workspace.documents;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.fs.read_file;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.transform;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.engine;

// LSP workspace/diagnostic adapter. تحليل المشروع واكتشاف مصادره يبقيان عند
// واجهة المترجم المقننة؛ هذه الوحدة تجمع تقارير البروتوكول فقط.
عام نوع نتيجة_سابقة_لتشخيص_مساحة_لغة = {
    العنوان: نص,
    المعرف: نص
};

عام نوع طلب_تشخيص_مساحة_لغة = {
    النتائج_السابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
};

عرف قيمة_حقل_تشخيص_مساحة_لغة(
    الوثيقة: &وثيقة_جسون,
    الفهرس: طبيعي,
    الاسم: نص
): اختياري قيمة_جسون {
    ليكن المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح);
}

عام عرف فك_طلب_تشخيص_مساحة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_تشخيص_مساحة_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختياري.لا_شيء(); };

    ليكن النتائج: متغير متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = [];
    طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_المعاملات, «previousResultIds») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(قيمة_جسون.مصفوفة(فهرس_المصفوفة)) -> {
        ليكن العدد: متغير طبيعي = 0;
        طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { العدد := ن; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            ليكن فهرس_العنصر: متغير طبيعي = 0;
            طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
            | اختياري.موجود(قيمة_جسون.كائن(ك)) -> { فهرس_العنصر := ك; }
            | _ -> { أرجع اختياري.لا_شيء(); };
            ليكن العنوان: متغير نص = «»;
            ليكن المعرف: متغير نص = «»;
            طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_العنصر, «uri») مع
            | اختياري.موجود(قيمة_جسون.سلسلة(نص_العنوان)) -> { العنوان := نص_العنوان; }
            | _ -> { أرجع اختياري.لا_شيء(); };
            طابق قيمة_حقل_تشخيص_مساحة_لغة(الوثيقة, فهرس_العنصر, «value») مع
            | اختياري.موجود(قيمة_جسون.سلسلة(نص_المعرف)) -> { المعرف := نص_المعرف; }
            | _ -> { أرجع اختياري.لا_شيء(); };
            ليكن السابق: نتيجة_سابقة_لتشخيص_مساحة_لغة = { العنوان: العنوان, المعرف: المعرف };
            ألحق(النتائج, السابق);
            ف := ف + 1;
        }
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الطلب: طلب_تشخيص_مساحة_لغة = { النتائج_السابقة: النتائج };
    أرجع اختياري.موجود(الطلب);
}

عام عرف معرف_نتيجة_تشخيص_مساحة_لغة(
    مراجعة_المساحة: طبيعي,
    مراجعة_الجذور: طبيعي
): نص {
    ليكن نص_مراجعة_المساحة: نص = طبيعي_إلى_نص(مراجعة_المساحة);
    ليكن نص_مراجعة_الجذور: نص = طبيعي_إلى_نص(مراجعة_الجذور);
    ليكن الأجزاء: متجه نص = [نص_مراجعة_المساحة, نص_مراجعة_الجذور];
    ليكن الفاصل: نص = «-»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف معرف_سابق_لعنوان_تشخيص_مساحة_لغة(
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة,
    العنوان: &نص
): اختياري نص {
    ليكن القيم: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = *السابق;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        إذا (نصان_متساويان(&القيم[ف].العنوان, العنوان)) {
            ليكن مرجع_المعرف: &نص = &القيم[ف].المعرف;
            ليكن المعرف: نص = *مرجع_المعرف;
            أرجع اختياري.موجود(استنسخ(&المعرف));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مستند_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    المسار: &نص
): اختياري مستند_لغة_مفتوح {
    طابق مستند_لغة_بالمسار(المساحة, المسار) مع
    | اختياري.موجود(المفتوح) -> { أرجع اختياري.موجود(المفتوح); }
    | اختياري.لا_شيء -> {
        طابق اقرأ_الملف(المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(النص) -> { أرجع ابن_مستند_لغة_للقراءة(المسار, النص); };
    };
}

عرف عنوان_ضمن_مصادر_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    العنوان: &نص
): منطقي {
    ليكن المصادر: متجه نص = *المسارات;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) {
        طابق مستند_تشخيص_مساحة_لغة(المساحة, &المصادر[ف]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المستند) -> {
            إذا (نصان_متساويان(&المستند.العنوان, العنوان)) { أرجع صواب; };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف تقارير_تشخيص_مساحة_لغة_غير_متغيرة(
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة,
    المعرف_الحالي: &نص
): منطقي {
    ليكن المصادر: متجه نص = *المسارات;
    إذا ((الطول(المصادر) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) {
        طابق مستند_تشخيص_مساحة_لغة(المساحة, &المصادر[ف]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(المستند) -> {
            طابق معرف_سابق_لعنوان_تشخيص_مساحة_لغة(السابق, &المستند.العنوان) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(المعرف_السابق) -> {
                إذا (!نصان_متساويان(&المعرف_السابق, المعرف_الحالي)) { أرجع خطأ; };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_تقرير_تشخيص_مساحة_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    قيم_التقارير: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات,
    المعرف_الحالي: &نص,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
): فراغ {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مداخل: متغير متجه مدخل_كائن_جسون = [];
    ليكن مرجع_العنوان: &نص = &د.العنوان;
    ليكن نسخة_العنوان: نص = *مرجع_العنوان;
    ليكن قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&نسخة_العنوان));
    ليكن مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ألحق(مداخل, مدخل_العنوان);

    ليكن قيمة_الإصدار: متغير قيمة_جسون = قيمة_جسون.عدم();
    إذا (د.المراجعة > 0) {
        قيمة_الإصدار := قيمة_جسون.رقم(عدد_إلى_نص(د.الإصدار));
    };
    ليكن مدخل_الإصدار: مدخل_كائن_جسون = { المفتاح: «version», القيمة: قيمة_الإصدار };
    ألحق(مداخل, مدخل_الإصدار);

    ليكن غير_متغير: متغير منطقي = خطأ;
    طابق معرف_سابق_لعنوان_تشخيص_مساحة_لغة(السابق, &د.العنوان) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعرف_السابق) -> {
        إذا (نصان_متساويان(&المعرف_السابق, المعرف_الحالي)) { غير_متغير := صواب; };
    };
    إذا (غير_متغير) {
        ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«unchanged»);
        ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ألحق(مداخل, مدخل_النوع);
        ليكن نسخة_المعرف: نص = *المعرف_الحالي;
        ليكن قيمة_المعرف: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&نسخة_المعرف));
        ليكن مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «resultId», القيمة: قيمة_المعرف };
        ألحق(مداخل, مدخل_المعرف);
    } وإلا {
        ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
        ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ألحق(مداخل, مدخل_النوع);
        ليكن نسخة_المعرف: نص = *المعرف_الحالي;
        ليكن قيمة_المعرف: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&نسخة_المعرف));
        ليكن مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «resultId», القيمة: قيمة_المعرف };
        ألحق(مداخل, مدخل_المعرف);
        ليكن فهرس_العناصر: طبيعي = أضف_عناصر_تشخيصات_لغة(
            الكائنات, المصفوفات, &د, المجموعة, خطأ
        );
        ليكن قيمة_العناصر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_العناصر);
        ليكن مدخل_العناصر: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_العناصر };
        ألحق(مداخل, مدخل_العناصر);
    };
    ليكن فهرس_التقرير: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن التقرير: كائن_جسون = { المداخل: مداخل, الفهرس: فهرس_الخريطة };
    ألحق(*الكائنات, التقرير);
    ألحق(*قيم_التقارير, قيمة_جسون.كائن(فهرس_التقرير));
}

عرف أضف_تقرير_مسح_تشخيص_مساحة_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    قيم_التقارير: &متغير متجه قيمة_جسون,
    العنوان: &نص
): فراغ {
    ليكن مداخل: متغير متجه مدخل_كائن_جسون = [];
    ليكن نسخة_العنوان: نص = *العنوان;
    ليكن قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&نسخة_العنوان));
    ليكن مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ألحق(مداخل, مدخل_العنوان);

    ليكن قيمة_الإصدار: قيمة_جسون = قيمة_جسون.عدم();
    ليكن مدخل_الإصدار: مدخل_كائن_جسون = { المفتاح: «version», القيمة: قيمة_الإصدار };
    ألحق(مداخل, مدخل_الإصدار);

    ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
    ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
    ألحق(مداخل, مدخل_النوع);

    ليكن قيم_العناصر: متجه قيمة_جسون = [];
    ليكن فهرس_العناصر: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن مصفوفة_العناصر: مصفوفة_جسون = { القيم: قيم_العناصر };
    ألحق(*المصفوفات, مصفوفة_العناصر);
    ليكن قيمة_العناصر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_العناصر);
    ليكن مدخل_العناصر: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_العناصر };
    ألحق(مداخل, مدخل_العناصر);

    ليكن فهرس_التقرير: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن التقرير: كائن_جسون = { المداخل: مداخل, الفهرس: فهرس_الخريطة };
    ألحق(*الكائنات, التقرير);
    ليكن قيمة_التقرير: قيمة_جسون = قيمة_جسون.كائن(فهرس_التقرير);
    ألحق(*قيم_التقارير, قيمة_التقرير);
}

عام عرف ابن_رد_تشخيص_مساحة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المساحة: &مساحة_عمل_لغة,
    المسارات: &متجه نص,
    المجموعة: &مجموعة_تشخيصات,
    مراجعة_الجذور: طبيعي,
    السابق: &متجه نتيجة_سابقة_لتشخيص_مساحة_لغة
): وثيقة_جسون {
    ليكن الحالة: مساحة_عمل_لغة = *المساحة;
    ليكن المعرف_الحالي: نص = معرف_نتيجة_تشخيص_مساحة_لغة(الحالة.المراجعة, مراجعة_الجذور);
    ليكن المصادر: متجه نص = *المسارات;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن قيم_التقارير: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) {
        طابق مستند_تشخيص_مساحة_لغة(&الحالة, &المصادر[ف]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المستند) -> {
            أضف_تقرير_تشخيص_مساحة_لغة(
                &متغير الكائنات, &متغير المصفوفات, &متغير قيم_التقارير,
                &المستند, المجموعة, &المعرف_الحالي, السابق
            );
        };
        ف := ف + 1;
    }

    // Clear diagnostics retained by the client for files that disappeared from the current project.
    ليكن النتائج_السابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = *السابق;
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(النتائج_السابقة) مثل طبيعي)) {
        إذا (!عنوان_ضمن_مصادر_تشخيص_مساحة_لغة(&الحالة, &المصادر, &النتائج_السابقة[س].العنوان)) {
            أضف_تقرير_مسح_تشخيص_مساحة_لغة(
                &متغير الكائنات, &متغير المصفوفات, &متغير قيم_التقارير,
                &النتائج_السابقة[س].العنوان
            );
        };
        س := س + 1;
    }

    ليكن فهرس_مصفوفة_التقارير: طبيعي = الطول(المصفوفات) مثل طبيعي;
    ليكن مصفوفة_التقارير: مصفوفة_جسون = { القيم: قيم_التقارير };
    ألحق(المصفوفات, مصفوفة_التقارير);
    ليكن فهرس_النتيجة: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_التقارير: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التقارير);
    ليكن مدخل_التقارير: مدخل_كائن_جسون = { المفتاح: «items», القيمة: قيمة_التقارير };
    ليكن مداخل_النتيجة: متجه مدخل_كائن_جسون = [مدخل_التقارير];
    ليكن فهرس_خريطة_النتيجة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن كائن_النتيجة: كائن_جسون = { المداخل: مداخل_النتيجة, الفهرس: فهرس_خريطة_النتيجة };
    ألحق(الكائنات, كائن_النتيجة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(
        المعرف, قيمة_جسون.كائن(فهرس_النتيجة), المصفوفات, الكائنات
    );
}
