استورد std.json.parse;
استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.text_document;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.text.number;

عام عرف ابن_رد_خطأ_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرمز: عدد,
    الرسالة: نص
): وثيقة_جسون {
    ليكن نص_رمز_الخطأ: نص = عدد_إلى_نص(الرمز);
    ليكن قيمة_رمز_الخطأ: قيمة_جسون = قيمة_جسون.رقم(نص_رمز_الخطأ);
    ليكن مدخل_رمز_الخطأ: مدخل_كائن_جسون = {
        المفتاح: «code»,
        القيمة: قيمة_رمز_الخطأ
    };
    ليكن قيمة_رسالة_الخطأ: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
    ليكن مدخل_رسالة_الخطأ: مدخل_كائن_جسون = {
        المفتاح: «message»,
        القيمة: قيمة_رسالة_الخطأ
    };
    ليكن مداخل_الخطأ: متجه مدخل_كائن_جسون = [
        مدخل_رمز_الخطأ,
        مدخل_رسالة_الخطأ
    ];
    ليكن فهرس_كائن_الخطأ: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن كائن_الخطأ: كائن_جسون = {
        المداخل: مداخل_الخطأ,
        الفهرس: فهرس_كائن_الخطأ
    };

    ليكن قيمة_نسخة_جسون_اربيسي: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_جسون_اربيسي: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_جسون_اربيسي
    };
    ليكن قيمة_معرف_الرد: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_معرف_الرد: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_الرد
    };
    ليكن قيمة_خطأ_الرد: قيمة_جسون = قيمة_جسون.كائن(0);
    ليكن مدخل_خطأ_الرد: مدخل_كائن_جسون = {
        المفتاح: «error»,
        القيمة: قيمة_خطأ_الرد
    };
    ليكن مداخل_الرد: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_جسون_اربيسي,
        مدخل_معرف_الرد,
        مدخل_خطأ_الرد
    ];
    ليكن فهرس_كائن_الرد: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن كائن_الرد: كائن_جسون = {
        المداخل: مداخل_الرد,
        الفهرس: فهرس_كائن_الرد
    };
    ليكن جذر_وثيقة_الخطأ: قيمة_جسون = قيمة_جسون.كائن(1);
    ليكن مصفوفات_وثيقة_الخطأ: متجه مصفوفة_جسون = [];
    ليكن كائنات_وثيقة_الخطأ: متجه كائن_جسون = [كائن_الخطأ, كائن_الرد];
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: جذر_وثيقة_الخطأ,
        المصفوفات: مصفوفات_وثيقة_الخطأ,
        الكائنات: كائنات_وثيقة_الخطأ
    };
    أرجع الوثيقة;
}

عام عرف ابن_رد_عدم_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي
): وثيقة_جسون {
    ليكن قيمة_نسخة_رد_العدم: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_العدم
    };
    ليكن قيمة_معرف_رد_العدم: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_معرف_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_العدم
    };
    ليكن قيمة_نتيجة_رد_العدم: قيمة_جسون = قيمة_جسون.عدم();
    ليكن مدخل_نتيجة_رد_العدم: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_العدم
    };
    ليكن المداخل: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_العدم,
        مدخل_معرف_رد_العدم,
        مدخل_نتيجة_رد_العدم
    ];
    ليكن فهرس_رد_العدم: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = {
        المداخل: المداخل,
        الفهرس: فهرس_رد_العدم
    };
    ليكن جذر_وثيقة_رد_العدم: قيمة_جسون = قيمة_جسون.كائن(0);
    ليكن مصفوفات_وثيقة_رد_العدم: متجه مصفوفة_جسون = [];
    ليكن كائنات_وثيقة_رد_العدم: متجه كائن_جسون = [الكائن];
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: جذر_وثيقة_رد_العدم,
        المصفوفات: مصفوفات_وثيقة_رد_العدم,
        الكائنات: كائنات_وثيقة_رد_العدم
    };
    أرجع الوثيقة;
}

// لا نعلن إلا القدرات المنفذة فعليا. مزامنة النص Incremental لأن Wave 2
// يطبق contentChanges بالتتابع على snapshot المستند الحالي.
// The advertised capabilities are static: one JSON literal, parsed once per
// initialize, instead of hand-indexed object tables. Keep the semantic token
// legend in sync with فهرس_نوع_رمز_دلالي_لغة (protocol/semantic_queries.sn).
عرف نص_نتيجة_تهيئة_خادم_لغة(): نص {
    أرجع «{"capabilities":{
"positionEncoding":"utf-16",
"textDocumentSync":{"openClose":true,"change":2,"save":{"includeText":true}},
"diagnosticProvider":{"identifier":"sultanc","interFileDependencies":true,"workspaceDiagnostics":false},
"codeActionProvider":{"codeActionKinds":["quickfix","refactor.extract.variable","refactor.extract.function","refactor.inline","refactor.rewrite","source.organizeImports"]},
"hoverProvider":true,
"definitionProvider":true,
"declarationProvider":true,
"implementationProvider":true,
"callHierarchyProvider":true,
"typeHierarchyProvider":true,
"documentHighlightProvider":true,
"referencesProvider":true,
"completionProvider":{"triggerCharacters":["."],"resolveProvider":false},
"signatureHelpProvider":{"triggerCharacters":["(",","],"retriggerCharacters":[","]},
"renameProvider":{"prepareProvider":true},
"semanticTokensProvider":{"legend":{"tokenTypes":["function","type","struct","enum","enumMember","parameter","variable"],"tokenModifiers":["declaration"]},"full":{"delta":true},"range":true},
"documentSymbolProvider":true,
"foldingRangeProvider":true,
"documentFormattingProvider":true,
"documentRangeFormattingProvider":true,
"documentOnTypeFormattingProvider":{"firstTriggerCharacter":"}","moreTriggerCharacter":[";"]},
"inlayHintProvider":true,
"typeDefinitionProvider":true,
"selectionRangeProvider":true,
"documentLinkProvider":{"resolveProvider":false},
"codeLensProvider":{"resolveProvider":true},
"workspaceSymbolProvider":true,
"workspace":{"workspaceFolders":{"supported":true,"changeNotifications":true},"fileOperations":{"willRename":{"filters":[{"scheme":"file","pattern":{"glob":"**/*.sn"}}]}}}
},
"serverInfo":{"name":"sultanc-analyzer","version":"0.21.0"}}»;
}

عام عرف ابن_رد_تهيئة_خادم_لغة(
    المعرف: معرف_طلب_جسون_اربيسي
): وثيقة_جسون {
    ليكن النص: نص = نص_نتيجة_تهيئة_خادم_لغة();
    طابق حلل_جسون(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع ابن_رد_خطأ_جسون_اربيسي(المعرف, -32603, «Invalid server capabilities»); }
    | نتيجة.نجح(الوثيقة) -> {
        طابق الوثيقة مع
        | { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: الكائنات } -> {
            أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, الجذر, المصفوفات, الكائنات);
        };
    };
}

// بناة JSON-RPC/LSP عامة لميزات البروتوكول الدلالية.
عام عرف أضف_موضع_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): طبيعي {
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن نص_السطر: نص = طبيعي_إلى_نص(الموضع.السطر);
    ليكن قيمة_السطر: قيمة_جسون = قيمة_جسون.رقم(نص_السطر);
    ليكن مدخل_السطر: مدخل_كائن_جسون = { المفتاح: «line», القيمة: قيمة_السطر };
    ليكن نص_المحرف: نص = طبيعي_إلى_نص(الموضع.المحرف);
    ليكن قيمة_المحرف: قيمة_جسون = قيمة_جسون.رقم(نص_المحرف);
    ليكن مدخل_المحرف: مدخل_كائن_جسون = { المفتاح: «character», القيمة: قيمة_المحرف };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_السطر, مدخل_المحرف];
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عام عرف أضف_نطاق_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تغيير_لغة
): طبيعي {
    ليكن البداية: طبيعي = أضف_موضع_لغة_إلى_جسون(الكائنات, النطاق.البداية);
    ليكن النهاية: طبيعي = أضف_موضع_لغة_إلى_جسون(الكائنات, النطاق.النهاية);
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_البداية: قيمة_جسون = قيمة_جسون.كائن(البداية);
    ليكن مدخل_البداية: مدخل_كائن_جسون = { المفتاح: «start», القيمة: قيمة_البداية };
    ليكن قيمة_النهاية: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    ليكن مدخل_النهاية: مدخل_كائن_جسون = { المفتاح: «end», القيمة: قيمة_النهاية };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_البداية, مدخل_النهاية];
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عام عرف أضف_موقع_لغة_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة
): طبيعي {
    ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(الكائنات, النطاق);
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(العنوان);
    ليكن مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_العنوان, مدخل_النطاق];
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عام عرف ابن_رد_نتيجة_جسون_اربيسي(
    المعرف: معرف_طلب_جسون_اربيسي,
    النتيجة: قيمة_جسون,
    المصفوفات: متجه مصفوفة_جسون,
    الكائنات: متجه كائن_جسون
): وثيقة_جسون {
    ليكن كائنات_الناتج: متغير متجه كائن_جسون = الكائنات;
    ليكن فهرس_الرد: طبيعي = الطول(كائنات_الناتج) مثل طبيعي;
    ليكن قيمة_النسخة: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_النسخة: مدخل_كائن_جسون = { المفتاح: «jsonrpc», القيمة: قيمة_النسخة };
    ليكن قيمة_المعرف: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_المعرف: مدخل_كائن_جسون = { المفتاح: «id», القيمة: قيمة_المعرف };
    ليكن مدخل_النتيجة: مدخل_كائن_جسون = { المفتاح: «result», القيمة: النتيجة };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_النسخة, مدخل_المعرف, مدخل_النتيجة];
    ليكن فهرس_كائن_الرد: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الرد: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_كائن_الرد };
    ألحق(كائنات_الناتج, الرد);
    ليكن الجذر: قيمة_جسون = قيمة_جسون.كائن(فهرس_الرد);
    ليكن الوثيقة: وثيقة_جسون = { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: كائنات_الناتج };
    أرجع الوثيقة;
}

// window/showMessage: 1 Error, 2 Warning, 3 Info, 4 Log.
عام عرف ابن_إشعار_رسالة_لغة(النوع: طبيعي, الرسالة: نص): وثيقة_جسون {
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «type», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(النوع)) };
    ليكن مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_جسون.سلسلة(الرسالة) };
    ليكن مداخل_المعاملات: متجه مدخل_كائن_جسون = [مدخل_النوع, مدخل_الرسالة];
    ليكن المعاملات: كائن_جسون = { المداخل: مداخل_المعاملات, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(الكائنات, المعاملات);
    ليكن مدخل_النسخة: مدخل_كائن_جسون = { المفتاح: «jsonrpc», القيمة: قيمة_جسون.سلسلة(«2.0») };
    ليكن مدخل_الطريقة: مدخل_كائن_جسون = { المفتاح: «method», القيمة: قيمة_جسون.سلسلة(«window/showMessage») };
    ليكن مدخل_معاملات_الإشعار: مدخل_كائن_جسون = { المفتاح: «params», القيمة: قيمة_جسون.كائن(0) };
    ليكن مداخل_الإشعار: متجه مدخل_كائن_جسون = [مدخل_النسخة, مدخل_الطريقة, مدخل_معاملات_الإشعار];
    ليكن الإشعار: كائن_جسون = { المداخل: مداخل_الإشعار, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(الكائنات, الإشعار);
    ليكن المصفوفات: متجه مصفوفة_جسون = [];
    ليكن الوثيقة: وثيقة_جسون = { الجذر: قيمة_جسون.كائن(1), المصفوفات: المصفوفات, الكائنات: الكائنات };
    أرجع الوثيقة;
}
