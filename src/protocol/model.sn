استورد std.json.value;

// نماذج JSON-RPC/LSP فقط. لا تملك هذه الوحدة JSON أو النص أو URI أو الترميز.

عام نوع معرف_طلب_جسون_اربيسي =
    | رقم بنوع نص
    | سلسلة بنوع نص
    | عدم
;


عام عرف قيمة_معرف_طلب_جسون_اربيسي(المعرف: معرف_طلب_جسون_اربيسي): قيمة_جسون {
    طابق المعرف مع
    | معرف_طلب_جسون_اربيسي.رقم(النص) -> { أرجع قيمة_جسون.رقم(النص); }
    | معرف_طلب_جسون_اربيسي.سلسلة(النص) -> { أرجع قيمة_جسون.سلسلة(النص); }
    | معرف_طلب_جسون_اربيسي.عدم -> { أرجع قيمة_جسون.عدم(); };
}

عام نوع رسالة_جسون_اربيسي = {
    الطريقة: نص,
    المعرف: اختياري معرف_طلب_جسون_اربيسي,
    المعاملات: اختياري قيمة_جسون
};

عام نوع خطأ_فك_رسالة_جسون_اربيسي =
    | الجذر_ليس_كائنا
    | إصدار_جسون_اربيسي_مفقود
    | إصدار_جسون_اربيسي_غير_صالح
    | الطريقة_مفقودة
    | الطريقة_ليست_نصا
    | المعرف_غير_صالح
;

عام نوع حالة_خادم_لغة =
    | قبل_التهيئة
    | ينتظر_التهيئة
    | يعمل
    | أوقف
;
