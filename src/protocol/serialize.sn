استورد std.json.value;
استورد std.text.from_bytes;

// LSP-owned JSON serialization of the shared document model. Strings are
// escaped here (RFC 8259: quote, backslash and control characters), so the
// wire format does not depend on a library serializer.

عرف ألحق_نص_خام_لغة(الناتج: &متغير متجه ط8, النص: نص): فراغ {
    ألحق_بايتات_نص(الناتج, النص);
}

عرف رقم_سداسي_لغة(القيمة: ط8): ط8 {
    إذا (القيمة < 10) { أرجع 0x30 + القيمة; };
    أرجع 0x61 + (القيمة - 10);
}

عام عرف ألحق_سلسلة_جسون_لغة(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    ألحق(*الناتج, 0x22);
    ليكن ف: متغير طبيعي = 0;
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب == 0x22) { ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x22); }
        وإلا إذا (ب == 0x5C) { ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x5C); }
        وإلا إذا (ب == 0x0A) { ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x6E); }
        وإلا إذا (ب == 0x0D) { ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x72); }
        وإلا إذا (ب == 0x09) { ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x74); }
        وإلا إذا (ب < 0x20) {
            ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x75); ألحق(*الناتج, 0x30); ألحق(*الناتج, 0x30);
            ألحق(*الناتج, رقم_سداسي_لغة((ب >> 4) & 0x0F));
            ألحق(*الناتج, رقم_سداسي_لغة(ب & 0x0F));
        } وإلا {
            ألحق(*الناتج, ب);
        };
        ف := ف + 1;
    }
    ألحق(*الناتج, 0x22);
}

عام عرف ألحق_قيمة_جسون_لغة(
    الناتج: &متغير متجه ط8,
    الوثيقة: &وثيقة_جسون,
    القيمة: &قيمة_جسون
): فراغ {
    طابق *القيمة مع
    | قيمة_جسون.عدم -> { ألحق_نص_خام_لغة(الناتج, «null»); }
    | قيمة_جسون.منطق(الحالة) -> {
        إذا (الحالة) { ألحق_نص_خام_لغة(الناتج, «true»); } وإلا { ألحق_نص_خام_لغة(الناتج, «false»); };
    }
    | قيمة_جسون.رقم(النص) -> { ألحق_بايتات_نص(الناتج, استنسخ(&النص)); }
    | قيمة_جسون.سلسلة(النص) -> { ألحق_سلسلة_جسون_لغة(الناتج, &النص); }
    | قيمة_جسون.مصفوفة(الفهرس) -> {
        ألحق(*الناتج, 0x5B);
        ليكن ف: متغير طبيعي = 0;
        ليكن العدد: طبيعي = الطول((*الوثيقة).المصفوفات[الفهرس].القيم) مثل طبيعي;
        طالما (ف < العدد) {
            إذا (ف > 0) { ألحق(*الناتج, 0x2C); };
            ألحق_قيمة_جسون_لغة(الناتج, الوثيقة, &(*الوثيقة).المصفوفات[الفهرس].القيم[ف]);
            ف := ف + 1;
        }
        ألحق(*الناتج, 0x5D);
    }
    | قيمة_جسون.كائن(الفهرس) -> {
        ألحق(*الناتج, 0x7B);
        ليكن ف: متغير طبيعي = 0;
        ليكن العدد: طبيعي = الطول((*الوثيقة).الكائنات[الفهرس].المداخل) مثل طبيعي;
        طالما (ف < العدد) {
            إذا (ف > 0) { ألحق(*الناتج, 0x2C); };
            ألحق_سلسلة_جسون_لغة(الناتج, &(*الوثيقة).الكائنات[الفهرس].المداخل[ف].المفتاح);
            ألحق(*الناتج, 0x3A);
            ألحق_قيمة_جسون_لغة(الناتج, الوثيقة, &(*الوثيقة).الكائنات[الفهرس].المداخل[ف].القيمة);
            ف := ف + 1;
        }
        ألحق(*الناتج, 0x7D);
    };
}

عام عرف وثيقة_جسون_إلى_نص_لغة(الوثيقة: &وثيقة_جسون): نص {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_قيمة_جسون_لغة(&متغير الناتج, الوثيقة, &(*الوثيقة).الجذر);
    أرجع من_بايتات(&الناتج);
}
