استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.text_document;
استورد sultanc_analyzer.protocol.serialize;
استورد sultanc_analyzer.protocol.structure;
استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.analysis.semantic_queries;
استورد compiler.frontend.names.symbols;
استورد std.text.number;
استورد std.text.from_bytes;
استورد std.text.transform;
استورد std.text.compare;

// textDocument/codeLens, as rust-analyzer shows them:
// - "▶︎ Run" and "Debug" above the program entry (the compiler's
//   رمز_بدء_البرنامج), running `sultanc.runFile` / `sultanc.debugFile`;
// - "▶︎ Run Test" and "Debug" above each `@@test` (the compiler's test
//   discovery), running the client commands `sultanc.runTest` and
//   `sultanc.debugTest` (uri, test name);
// - "N references" above each top-level declaration, counted in
//   codeLens/resolve from the compiler's references and opened with the
//   client command `sultanc.showReferences` (uri, position, locations).
// Titles follow the document's language. The commands are the client's
// (VS Code: editors/vscode/src/codeLens.js), as rust-analyzer's are.

// `lensRun` (default true) and `lensReferences` (default false, as
// rust-analyzer: counting references is a project-wide query per lens).
عام نوع إعداد_عدسات_لغة = {
    التشغيل: منطقي,
    المراجع: منطقي
};

عام عرف إعداد_عدسات_افتراضي_لغة(): إعداد_عدسات_لغة {
    ليكن الناتج: إعداد_عدسات_لغة = { التشغيل: صواب, المراجع: خطأ };
    أرجع الناتج;
}

// Declarations that get a references lens: functions, types and top-level
// values (not constructors, parameters or locals).
عرف رمز_له_عدسة_لغة(النوع: نوع_تصريح): منطقي {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع صواب; }
    | نوع_تصريح.دالة_خارجية -> { أرجع صواب; }
    | نوع_تصريح.مرادف_نوع -> { أرجع صواب; }
    | نوع_تصريح.سجل -> { أرجع صواب; }
    | نوع_تصريح.تعداد -> { أرجع صواب; }
    | نوع_تصريح.معتم -> { أرجع صواب; }
    | نوع_تصريح.قيمة_عليا -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The CodeLens array of a document (JSON text).
عام عرف عدسات_مستند_لغة(
    المستند: &مستند_لغة_مفتوح,
    الاختبارات: &متجه اختبار_مستند_لغة,
    الرموز: &متجه رمز_معلن_لغة,
    البدء: اختياري طبيعي,
    الإعداد: &إعداد_عدسات_لغة
): متجه ط8 {
    ليكن عربي: منطقي = مستند_لغة_بالعربية(المستند);
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, 0x5B);
    ليكن العدد: متغير طبيعي = 0;
    // "▶︎ Run" and "Debug" above the program entry, as rust-analyzer's
    // runnables on `fn main`: the client's sultanc.runFile / sultanc.debugFile.
    إذا ((*الإعداد).التشغيل) {
        طابق البدء مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(البايت) -> {
            ليكن النطاق: متغير متجه ط8 = [];
            إذا (ألحق_نطاق_بايتات_جسون_لغة(&متغير النطاق, المستند, البايت, البايت)) {
                ليكن عنوان_التشغيل: نص = عنوان_تشغيل_برنامج_عدسة_لغة(عربي);
                ألحق_عدسة_أمر_ملف_لغة(&متغير الناتج, &النطاق, &عنوان_التشغيل, «sultanc.runFile», &(*المستند).العنوان);
                ألحق(الناتج, 0x2C);
                ليكن عنوان_التصحيح: نص = عنوان_تصحيح_عدسة_لغة(عربي);
                ألحق_عدسة_أمر_ملف_لغة(&متغير الناتج, &النطاق, &عنوان_التصحيح, «sultanc.debugFile», &(*المستند).العنوان);
                العدد := العدد + 2;
            };
        };
    };
    إذا ((*الإعداد).التشغيل) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الاختبارات) مثل طبيعي)) {
            ليكن الاختبار: &اختبار_مستند_لغة = &(*الاختبارات)[ف];
            إذا ((*الاختبار).قابل) {
                ليكن النطاق: متغير متجه ط8 = [];
                إذا (ألحق_نطاق_بايتات_جسون_لغة(&متغير النطاق, المستند, (*الاختبار).البداية, (*الاختبار).البداية)) {
                    إذا (العدد > 0) { ألحق(الناتج, 0x2C); };
                    العدد := العدد + 1;
                    ألحق_بايتات_نص(&متغير الناتج, «{"range":»);
                    ألحق_بايتات_نص(&متغير الناتج, من_بايتات(&النطاق));
                    ألحق_بايتات_نص(&متغير الناتج, «,"command":{"title":»);
                    ليكن العنوان: نص = عنوان_تشغيل_عدسة_لغة(عربي);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &العنوان);
                    ألحق_بايتات_نص(&متغير الناتج, «,"command":"sultanc.runTest","arguments":[»);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*المستند).العنوان);
                    ألحق(الناتج, 0x2C);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*الاختبار).الاسم);
                    ألحق_بايتات_نص(&متغير الناتج, «]}}»);
                    // "Debug" beside it: the client builds the test with
                    // `sultanc test --no-run -O0 -o` and debugs `PROGRAM INDEX`.
                    ألحق_بايتات_نص(&متغير الناتج, «,{"range":»);
                    ألحق_بايتات_نص(&متغير الناتج, من_بايتات(&النطاق));
                    ألحق_بايتات_نص(&متغير الناتج, «,"command":{"title":»);
                    ليكن عنوان_التصحيح: نص = عنوان_تصحيح_عدسة_لغة(عربي);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &عنوان_التصحيح);
                    ألحق_بايتات_نص(&متغير الناتج, «,"command":"sultanc.debugTest","arguments":[»);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*المستند).العنوان);
                    ألحق(الناتج, 0x2C);
                    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*الاختبار).الاسم);
                    ألحق_بايتات_نص(&متغير الناتج, «]}}»);
                };
            };
            ف := ف + 1;
        }
    };
    إذا ((*الإعداد).المراجع) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
            ليكن الرمز: &رمز_معلن_لغة = &(*الرموز)[ف];
            // A test is run, not referenced: no references lens on it.
            ليكن اختبار: متغير منطقي = خطأ;
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(*الاختبارات) مثل طبيعي)) {
                إذا (نصان_متساويان(&(*الاختبارات)[م].الاسم, &(*الرمز).الاسم)) { اختبار := صواب; };
                م := م + 1;
            }
            إذا (رمز_له_عدسة_لغة((*الرمز).النوع) && !اختبار) {
                إذا (العدد > 0) { ألحق(الناتج, 0x2C); };
                العدد := العدد + 1;
                ليكن البداية: موضع_تغيير_لغة = (*الرمز).نطاق_التحديد.البداية;
                ألحق_بايتات_نص(&متغير الناتج, «{"range":{"start":»);
                ألحق_موضع_جسون_لغة(&متغير الناتج, البداية);
                ألحق_بايتات_نص(&متغير الناتج, «,"end":»);
                ألحق_موضع_جسون_لغة(&متغير الناتج, البداية);
                ألحق_بايتات_نص(&متغير الناتج, «},"data":{"uri":»);
                ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*المستند).العنوان);
                ألحق_بايتات_نص(&متغير الناتج, «,"position":»);
                ألحق_موضع_جسون_لغة(&متغير الناتج, البداية);
                ألحق_بايتات_نص(&متغير الناتج, «}}»);
            };
            ف := ف + 1;
        }
    };
    ألحق(الناتج, 0x5D);
    أرجع الناتج;
}

عرف ألحق_عدسة_أمر_ملف_لغة(
    الناتج: &متغير متجه ط8,
    النطاق: &متجه ط8,
    العنوان: &نص,
    الأمر: نص,
    الملف: &نص
): فراغ {
    ألحق_بايتات_نص(الناتج, «{"range":»);
    ألحق_بايتات_نص(الناتج, من_بايتات(النطاق));
    ألحق_بايتات_نص(الناتج, «,"command":{"title":»);
    ألحق_سلسلة_جسون_لغة(الناتج, العنوان);
    ألحق_بايتات_نص(الناتج, «,"command":»);
    ألحق_سلسلة_جسون_لغة(الناتج, &الأمر);
    ألحق_بايتات_نص(الناتج, «,"arguments":[»);
    ألحق_سلسلة_جسون_لغة(الناتج, الملف);
    ألحق_بايتات_نص(الناتج, «]}}»);
}

عرف عنوان_تشغيل_برنامج_عدسة_لغة(عربي: منطقي): نص {
    إذا (عربي) { أرجع «▶︎ تشغيل»; };
    أرجع «▶︎ Run»;
}

عرف عنوان_تصحيح_عدسة_لغة(عربي: منطقي): نص {
    إذا (عربي) { أرجع «تصحيح الأخطاء»; };
    أرجع «Debug»;
}

عرف عنوان_تشغيل_عدسة_لغة(عربي: منطقي): نص {
    إذا (عربي) { أرجع «▶︎ تشغيل الاختبار»; };
    أرجع «▶︎ Run Test»;
}

// "N references" in the document's language (Arabic number agreement:
// 0, 1, 2, 3–10, 11 and more).
عام عرف عنوان_مراجع_عدسة_لغة(العدد: طبيعي, عربي: منطقي): نص {
    إذا (عربي) {
        إذا (العدد == 0) { أرجع «لا مراجع»; };
        إذا (العدد == 1) { أرجع «مرجع واحد»; };
        إذا (العدد == 2) { أرجع «مرجعان»; };
        ليكن الرقم: نص = طبيعي_إلى_نص(العدد);
        إذا (العدد <= 10) { أرجع صل_نصين(&الرقم, &« مراجع»); };
        أرجع صل_نصين(&الرقم, &« مرجعًا»);
    };
    إذا (العدد == 1) { أرجع «1 reference»; };
    ليكن الرقم: نص = طبيعي_إلى_نص(العدد);
    أرجع صل_نصين(&الرقم, &« references»);
}

// A resolved references lens: the request's range and data, with the command.
عام عرف عدسة_مراجع_محلولة_لغة(
    النطاق: &متجه ط8,
    البيانات: &متجه ط8,
    العنوان: &نص,
    الموضع: موضع_تغيير_لغة,
    المواقع: &متجه موقع_دلالي_لغة,
    عربي: منطقي
): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"range":»);
    ألحق_بايتات_نص(&متغير الناتج, من_بايتات(النطاق));
    ألحق_بايتات_نص(&متغير الناتج, «,"data":»);
    ألحق_بايتات_نص(&متغير الناتج, من_بايتات(البيانات));
    ألحق_بايتات_نص(&متغير الناتج, «,"command":{"title":»);
    ليكن العنوان_المعروض: نص = عنوان_مراجع_عدسة_لغة(الطول(*المواقع) مثل طبيعي, عربي);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &العنوان_المعروض);
    إذا ((الطول(*المواقع) مثل طبيعي) == 0) {
        ألحق_بايتات_نص(&متغير الناتج, «,"command":""}}»);
        أرجع الناتج;
    };
    ألحق_بايتات_نص(&متغير الناتج, «,"command":"sultanc.showReferences","arguments":[»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, العنوان);
    ألحق(الناتج, 0x2C);
    ألحق_موضع_جسون_لغة(&متغير الناتج, الموضع);
    ألحق_بايتات_نص(&متغير الناتج, «,[»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواقع) مثل طبيعي)) {
        إذا (ف > 0) { ألحق(الناتج, 0x2C); };
        ألحق_بايتات_نص(&متغير الناتج, «{"uri":»);
        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*المواقع)[ف].العنوان);
        ألحق_بايتات_نص(&متغير الناتج, «,"range":{"start":»);
        ألحق_موضع_جسون_لغة(&متغير الناتج, (*المواقع)[ف].النطاق.البداية);
        ألحق_بايتات_نص(&متغير الناتج, «,"end":»);
        ألحق_موضع_جسون_لغة(&متغير الناتج, (*المواقع)[ف].النطاق.النهاية);
        ألحق_بايتات_نص(&متغير الناتج, «}}»);
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]]}}»);
    أرجع الناتج;
}
