استورد std.text.from_bytes;
استورد std.text.transform;
استورد std.collections.sort;
استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.encode;
استورد sultanc_analyzer.protocol.text_document;
استورد sultanc_analyzer.analysis.semantic_queries;
استورد std.json.value;
استورد compiler.frontend.names.symbols;
استورد std.collections.text_index_map;
استورد std.text.compare;
استورد std.text.number;

عرف انسخ_نص_بروتوكول_دلالي(القيمة: &نص): نص {
    ليكن النسخة: نص = *القيمة;
    أرجع استنسخ(&النسخة);
}

عرف رد_نتيجة_عدم_دلالية(المعرف: معرف_طلب_جسون_اربيسي): وثيقة_جسون {
    ليكن المصفوفات: متجه مصفوفة_جسون = [];
    ليكن الكائنات: متجه كائن_جسون = [];
    ليكن العدم: قيمة_جسون = قيمة_جسون.عدم();
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, العدم, المصفوفات, الكائنات);
}

عام عرف ابن_رد_تحويم_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    النص: &اختياري نص,
    النطاق: &اختياري نطاق_تغيير_لغة
): وثيقة_جسون {
    ليكن نسخة_النص: اختياري نص = *النص;
    ليكن نسخة_النطاق: اختياري نطاق_تغيير_لغة = *النطاق;
    طابق نسخة_النص مع
    | اختياري.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختياري.موجود(المحتوى) -> {
        ليكن الكائنات: متغير متجه كائن_جسون = [];
        ليكن فهرس_المحتويات: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن قيمة_نوع_المحتوى: قيمة_جسون = قيمة_جسون.سلسلة(«markdown»);
        ليكن مدخل_نوع_المحتوى: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_نوع_المحتوى };
        ليكن قيمة_المحتوى: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&المحتوى));
        ليكن مدخل_المحتوى: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_المحتوى };
        ليكن مداخل_المحتويات: متجه مدخل_كائن_جسون = [مدخل_نوع_المحتوى, مدخل_المحتوى];
        ليكن فهرس_خريطة_المحتويات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن كائن_المحتويات: كائن_جسون = { المداخل: مداخل_المحتويات, الفهرس: فهرس_خريطة_المحتويات };
        ألحق(الكائنات, كائن_المحتويات);
        ليكن قيمة_المحتويات: قيمة_جسون = قيمة_جسون.كائن(فهرس_المحتويات);
        ليكن مدخل_المحتويات: مدخل_كائن_جسون = { المفتاح: «contents», القيمة: قيمة_المحتويات };
        ليكن مداخل_التحويم: متغير متجه مدخل_كائن_جسون = [مدخل_المحتويات];
        طابق نسخة_النطاق مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(نطاق_التحويم) -> {
            ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, نطاق_التحويم);
            ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            ألحق(مداخل_التحويم, مدخل_النطاق);
        };
        ليكن فهرس_التحويم: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن فهرس_خريطة_التحويم: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن كائن_التحويم: كائن_جسون = { المداخل: مداخل_التحويم, الفهرس: فهرس_خريطة_التحويم };
        ألحق(الكائنات, كائن_التحويم);
        ليكن المصفوفات: متجه مصفوفة_جسون = [];
        ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحويم);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تعريف_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الموقع: &اختياري موقع_دلالي_لغة
): وثيقة_جسون {
    ليكن نسخة: اختياري موقع_دلالي_لغة = *الموقع;
    طابق نسخة مع
    | اختياري.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختياري.موجود(القيمة) -> {
        ليكن الكائنات: متغير متجه كائن_جسون = [];
        ليكن مرجع_العنوان: &نص = &القيمة.العنوان;
        ليكن العنوان: نص = *مرجع_العنوان;
        ليكن الفهرس: طبيعي = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, استنسخ(&العنوان), القيمة.النطاق);
        ليكن المصفوفات: متجه مصفوفة_جسون = [];
        ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(الفهرس);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تهيئة_إعادة_تسمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    النطاق: &اختياري نطاق_تغيير_لغة
): وثيقة_جسون {
    ليكن نسخة: اختياري نطاق_تغيير_لغة = *النطاق;
    طابق نسخة مع
    | اختياري.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختياري.موجود(القيمة) -> {
        ليكن الكائنات: متغير متجه كائن_جسون = [];
        ليكن الفهرس: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, القيمة);
        ليكن المصفوفات: متجه مصفوفة_جسون = [];
        ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(الفهرس);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عرف ابن_رد_مواقع_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة,
    نطاقات_فقط: منطقي,
    الأنواع: &متجه طبيعي
): وثيقة_جسون {
    ليكن نسخة_المواقع: متجه موقع_دلالي_لغة = *المواقع;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(نسخة_المواقع) مثل طبيعي)) {
        ليكن مرجع_الموقع: &موقع_دلالي_لغة = &نسخة_المواقع[ف];
        ليكن الموقع: موقع_دلالي_لغة = *مرجع_الموقع;
        إذا (نطاقات_فقط) {
            ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الموقع.النطاق);
            ليكن فهرس_التمييز: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            ليكن مداخل_التمييز: متغير متجه مدخل_كائن_جسون = [مدخل_النطاق];
            إذا (ف < (الطول(*الأنواع) مثل طبيعي)) {
                ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص((*الأنواع)[ف])) };
                ألحق(مداخل_التمييز, مدخل_النوع);
            };
            ليكن فهرس_خريطة_التمييز: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            ليكن التمييز: كائن_جسون = { المداخل: مداخل_التمييز, الفهرس: فهرس_خريطة_التمييز };
            ألحق(الكائنات, التمييز);
            ألحق(القيم, قيمة_جسون.كائن(فهرس_التمييز));
        } وإلا {
            ليكن مرجع_العنوان: &نص = &الموقع.العنوان;
            ليكن العنوان: نص = *مرجع_العنوان;
            ليكن فهرس_الموقع: طبيعي = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, استنسخ(&العنوان), الموقع.النطاق);
            ألحق(القيم, قيمة_جسون.كائن(فهرس_الموقع));
        };
        ف := ف + 1;
    }
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن فهرس_المصفوفة: طبيعي = الطول(المصفوفات) مثل طبيعي;
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_تمييزات_مستند_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة,
    الأنواع: &متجه طبيعي
): وثيقة_جسون {
    أرجع ابن_رد_مواقع_دلالية_لغة(المعرف, المواقع, صواب, الأنواع);
}

عام عرف ابن_رد_مراجع_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة
): وثيقة_جسون {
    ليكن بلا_أنواع: متجه طبيعي = [];
    أرجع ابن_رد_مواقع_دلالية_لغة(المعرف, المواقع, خطأ, &بلا_أنواع);
}

نوع مجموعة_إعادة_تسمية_لغة = {
    العنوان: نص,
    النطاقات: متجه نطاق_تغيير_لغة
};

عرف اجمع_مواقع_إعادة_تسمية_لغة(
    المواقع: &متجه موقع_دلالي_لغة
): متجه مجموعة_إعادة_تسمية_لغة {
    ليكن المدخل: متجه موقع_دلالي_لغة = *المواقع;
    ليكن المجموعات: متغير متجه مجموعة_إعادة_تسمية_لغة = [];
    ليكن فهرس_المجموعات: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المدخل) مثل طبيعي)) {
        ليكن مرجع_الموقع: &موقع_دلالي_لغة = &المدخل[ف];
        ليكن الموقع: موقع_دلالي_لغة = *مرجع_الموقع;
        ليكن مرجع_العنوان: &نص = &الموقع.العنوان;
        طابق ابحث_في_خريطة_نص_فهرس(&فهرس_المجموعات, مرجع_العنوان) مع
        | اختياري.موجود(ج) -> {
            ألحق(المجموعات[ج].النطاقات, الموقع.النطاق);
        }
        | اختياري.لا_شيء -> {
            ليكن ج: طبيعي = الطول(المجموعات) مثل طبيعي;
            ليكن عنوان_المجموعة: نص = *مرجع_العنوان;
            ليكن عنوان_الفهرس: نص = *مرجع_العنوان;
            ليكن النطاقات: متجه نطاق_تغيير_لغة = [الموقع.النطاق];
            ليكن المجموعة: مجموعة_إعادة_تسمية_لغة = {
                العنوان: استنسخ(&عنوان_المجموعة),
                النطاقات: النطاقات
            };
            ألحق(المجموعات, المجموعة);
            أدرج_في_خريطة_نص_فهرس(&متغير فهرس_المجموعات, استنسخ(&عنوان_الفهرس), ج);
        };
        ف := ف + 1;
    }
    أرجع المجموعات;
}

عام عرف ابن_رد_إعادة_تسمية_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المواقع: &متجه موقع_دلالي_لغة,
    الاسم_الجديد: &نص
): وثيقة_جسون {
    ليكن المجموعات: متجه مجموعة_إعادة_تسمية_لغة = اجمع_مواقع_إعادة_تسمية_لغة(المواقع);
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن مداخل_التغييرات: متغير متجه مدخل_كائن_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المجموعات) مثل طبيعي)) {
        ليكن مرجع_المجموعة: &مجموعة_إعادة_تسمية_لغة = &المجموعات[ف];
        ليكن المجموعة: مجموعة_إعادة_تسمية_لغة = *مرجع_المجموعة;
        ليكن قيم_التحريرات: متغير متجه قيمة_جسون = [];
        ليكن ج: متغير طبيعي = 0;
        طالما (ج < (الطول(المجموعة.النطاقات) مثل طبيعي)) {
            ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, المجموعة.النطاقات[ج]);
            ليكن فهرس_التحرير: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
            ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
            ليكن نسخة_الاسم: نص = انسخ_نص_بروتوكول_دلالي(الاسم_الجديد);
            ليكن قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(نسخة_الاسم);
            ليكن مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_الاسم };
            ليكن مداخل_التحرير: متجه مدخل_كائن_جسون = [مدخل_النطاق, مدخل_الاسم];
            ليكن فهرس_خريطة_التحرير: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            ليكن التحرير: كائن_جسون = { المداخل: مداخل_التحرير, الفهرس: فهرس_خريطة_التحرير };
            ألحق(الكائنات, التحرير);
            ألحق(قيم_التحريرات, قيمة_جسون.كائن(فهرس_التحرير));
            ج := ج + 1;
        }
        ليكن فهرس_مصفوفة_التحريرات: طبيعي = الطول(المصفوفات) مثل طبيعي;
        ليكن مصفوفة_التحريرات: مصفوفة_جسون = { القيم: قيم_التحريرات };
        ألحق(المصفوفات, مصفوفة_التحريرات);
        ليكن مرجع_العنوان: &نص = &المجموعة.العنوان;
        ليكن العنوان: نص = *مرجع_العنوان;
        ليكن قيمة_التحريرات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التحريرات);
        ليكن المدخل: مدخل_كائن_جسون = { المفتاح: استنسخ(&العنوان), القيمة: قيمة_التحريرات };
        ألحق(مداخل_التغييرات, المدخل);
        ف := ف + 1;
    }
    ليكن فهرس_التغييرات: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن فهرس_خريطة_التغييرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن كائن_التغييرات: كائن_جسون = { المداخل: مداخل_التغييرات, الفهرس: فهرس_خريطة_التغييرات };
    ألحق(الكائنات, كائن_التغييرات);
    ليكن فهرس_تحرير_المساحة: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_التغييرات: قيمة_جسون = قيمة_جسون.كائن(فهرس_التغييرات);
    ليكن مدخل_التغييرات: مدخل_كائن_جسون = { المفتاح: «changes», القيمة: قيمة_التغييرات };
    ليكن مداخل_تحرير_المساحة: متجه مدخل_كائن_جسون = [مدخل_التغييرات];
    ليكن فهرس_خريطة_تحرير_المساحة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن تحرير_المساحة: كائن_جسون = { المداخل: مداخل_تحرير_المساحة, الفهرس: فهرس_خريطة_تحرير_المساحة };
    ألحق(الكائنات, تحرير_المساحة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_تحرير_المساحة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عرف أضف_نطاق_إكمال_لغة(الكائنات: &متغير متجه كائن_جسون, النطاق: نطاق_تغيير_لغة): طبيعي {
    ليكن مداخل_البداية: متجه مدخل_كائن_جسون = [
        { المفتاح: «line», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(النطاق.البداية.السطر)) },
        { المفتاح: «character», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(النطاق.البداية.المحرف)) }
    ];
    ليكن فهرس_البداية: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن كائن_البداية: كائن_جسون = { المداخل: مداخل_البداية, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(*الكائنات, كائن_البداية);
    ليكن مداخل_النهاية: متجه مدخل_كائن_جسون = [
        { المفتاح: «line», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(النطاق.النهاية.السطر)) },
        { المفتاح: «character», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(النطاق.النهاية.المحرف)) }
    ];
    ليكن فهرس_النهاية: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن كائن_النهاية: كائن_جسون = { المداخل: مداخل_النهاية, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(*الكائنات, كائن_النهاية);
    ليكن مداخل_النطاق: متجه مدخل_كائن_جسون = [
        { المفتاح: «start», القيمة: قيمة_جسون.كائن(فهرس_البداية) },
        { المفتاح: «end», القيمة: قيمة_جسون.كائن(فهرس_النهاية) }
    ];
    ليكن فهرس_النطاق: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن كائن_النطاق: كائن_جسون = { المداخل: مداخل_النطاق, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(*الكائنات, كائن_النطاق);
    أرجع فهرس_النطاق;
}

عرف نوع_عنصر_إكمال_دلالي_لغة(النوع: نوع_تصريح): نص {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع «3»; }
    | نوع_تصريح.دالة_خارجية -> { أرجع «3»; }
    | نوع_تصريح.مرادف_نوع -> { أرجع «25»; }
    | نوع_تصريح.سجل -> { أرجع «22»; }
    | نوع_تصريح.معتم -> { أرجع «7»; }
    | نوع_تصريح.تعداد -> { أرجع «13»; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع «20»; }
    | نوع_تصريح.معامل_نوع -> { أرجع «25»; }
    | نوع_تصريح.معامل -> { أرجع «6»; }
    | نوع_تصريح.قيمة_عليا -> { أرجع «6»; }
    | نوع_تصريح.ربط_محلي -> { أرجع «6»; };
}

// غير_مكتمل: the list depends on more typing (auto-import items come only
// from the second letter, at most 40), so the reply is a CompletionList with
// isIncomplete and the client asks again as the word grows (LSP 3.17).
عرف نص_إدراج_الاقتراح_لغة(الاقتراح: &اقتراح_إكمال_دلالي_لغة): نص {
    طابق استنسخ(&(*الاقتراح).نص_الإدراج) مع
    | اختياري.موجود(النص) -> { أرجع النص; }
    | اختياري.لا_شيء -> { أرجع استنسخ(&(*الاقتراح).النص); };
}

عام عرف ابن_رد_إكمال_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الاقتراحات: &متجه اقتراح_إكمال_دلالي_لغة,
    غير_مكتمل: منطقي
): وثيقة_جسون {
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن فارغ: نص = «»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاقتراحات) مثل طبيعي)) {
        ليكن الاقتراح: اقتراح_إكمال_دلالي_لغة = استنسخ(&(*الاقتراحات)[ف]);
        ليكن مدخل_النص: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_جسون.سلسلة(استنسخ(&الاقتراح.النص)) };
        ليكن نص_النوع: متغير نص = نوع_عنصر_إكمال_دلالي_لغة(الاقتراح.النوع);
        طابق استنسخ(&الاقتراح.صنف_العنصر) مع
        | اختياري.موجود(الصنف) -> { نص_النوع := الصنف; }
        | اختياري.لا_شيء -> { };
        إذا (الاقتراح.كلمة) { نص_النوع := «14»; };
        // Locals, parameters, this module, imports, std (the compiler's
        // distance), then keywords, then auto-import items.
        // Items whose Type fits the expected one first (`0…`), then the rest.
        ليكن ترتيب_الفرز: متغير نص = صل_نصين(&«1», &طبيعي_إلى_نص(الاقتراح.البعد));
        إذا (الاقتراح.يلائم) { ترتيب_الفرز := صل_نصين(&«0», &طبيعي_إلى_نص(الاقتراح.البعد)); };
        ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_جسون.رقم(نص_النوع) };
        ليكن أجزاء_الفرز: متجه نص = [ترتيب_الفرز, استنسخ(&الاقتراح.النص)];
        ليكن مدخل_الفرز: مدخل_كائن_جسون = { المفتاح: «sortText», القيمة: قيمة_جسون.سلسلة(صل_النصوص(&أجزاء_الفرز, &فارغ)) };
        ليكن المداخل: متغير متجه مدخل_كائن_جسون = [مدخل_النص, مدخل_النوع, مدخل_الفرز];
        طابق استنسخ(&الاقتراح.المدى) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المدى) -> {
            // textEdit: the word being typed, from its start to the cursor.
            ليكن فهرس_المدى: طبيعي = أضف_نطاق_إكمال_لغة(&متغير الكائنات, المدى);
            ليكن مداخل_التحرير_النصي: متجه مدخل_كائن_جسون = [
                { المفتاح: «range», القيمة: قيمة_جسون.كائن(فهرس_المدى) },
                { المفتاح: «newText», القيمة: قيمة_جسون.سلسلة(نص_إدراج_الاقتراح_لغة(&الاقتراح)) }
            ];
            ليكن فهرس_التحرير_النصي: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_التحرير_النصي: كائن_جسون = { المداخل: مداخل_التحرير_النصي, الفهرس: أنشئ_خريطة_نص_فهرس() };
            ألحق(الكائنات, كائن_التحرير_النصي);
            ليكن مدخل_التحرير_النصي: مدخل_كائن_جسون = { المفتاح: «textEdit», القيمة: قيمة_جسون.كائن(فهرس_التحرير_النصي) };
            ألحق(المداخل, مدخل_التحرير_النصي);
        };
        طابق استنسخ(&الاقتراح.التفصيل) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التفصيل) -> {
            ليكن مدخل_التفصيل: مدخل_كائن_جسون = { المفتاح: «detail», القيمة: قيمة_جسون.سلسلة(التفصيل) };
            ألحق(المداخل, مدخل_التفصيل);
        };
        طابق استنسخ(&الاقتراح.التوثيق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التوثيق) -> {
            ليكن مدخل_صنف: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_جسون.سلسلة(«markdown») };
            ليكن مدخل_القيمة: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_جسون.سلسلة(التوثيق) };
            ليكن مداخل_التوثيق: متجه مدخل_كائن_جسون = [مدخل_صنف, مدخل_القيمة];
            ليكن فهرس_التوثيق: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_التوثيق: كائن_جسون = { المداخل: مداخل_التوثيق, الفهرس: أنشئ_خريطة_نص_فهرس() };
            ألحق(الكائنات, كائن_التوثيق);
            ليكن مدخل_التوثيق: مدخل_كائن_جسون = { المفتاح: «documentation», القيمة: قيمة_جسون.كائن(فهرس_التوثيق) };
            ألحق(المداخل, مدخل_التوثيق);
        };
        طابق استنسخ(&الاقتراح.الإدراج) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الإدراج) -> {
            // additionalTextEdits: [{range: {start: {line, 0}, end: {line, 0}}, newText}]
            ليكن مدخل_السطر: مدخل_كائن_جسون = { المفتاح: «line», القيمة: قيمة_جسون.رقم(طبيعي_إلى_نص(الإدراج.السطر)) };
            ليكن مدخل_المحرف: مدخل_كائن_جسون = { المفتاح: «character», القيمة: قيمة_جسون.رقم(«0») };
            ليكن مداخل_الموضع: متجه مدخل_كائن_جسون = [مدخل_السطر, مدخل_المحرف];
            ليكن فهرس_الموضع: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_الموضع: كائن_جسون = { المداخل: مداخل_الموضع, الفهرس: أنشئ_خريطة_نص_فهرس() };
            ألحق(الكائنات, كائن_الموضع);
            ليكن مدخل_البداية: مدخل_كائن_جسون = { المفتاح: «start», القيمة: قيمة_جسون.كائن(فهرس_الموضع) };
            ليكن مدخل_النهاية: مدخل_كائن_جسون = { المفتاح: «end», القيمة: قيمة_جسون.كائن(فهرس_الموضع) };
            ليكن مداخل_النطاق: متجه مدخل_كائن_جسون = [مدخل_البداية, مدخل_النهاية];
            ليكن فهرس_النطاق: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_النطاق: كائن_جسون = { المداخل: مداخل_النطاق, الفهرس: أنشئ_خريطة_نص_فهرس() };
            ألحق(الكائنات, كائن_النطاق);
            ليكن مدخل_المدى: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_جسون.كائن(فهرس_النطاق) };
            ليكن مدخل_الجديد: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_جسون.سلسلة(استنسخ(&الإدراج.النص)) };
            ليكن مداخل_التحرير: متجه مدخل_كائن_جسون = [مدخل_المدى, مدخل_الجديد];
            ليكن فهرس_التحرير: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_التحرير: كائن_جسون = { المداخل: مداخل_التحرير, الفهرس: أنشئ_خريطة_نص_فهرس() };
            ألحق(الكائنات, كائن_التحرير);
            ليكن قيم_التحريرات: متجه قيمة_جسون = [قيمة_جسون.كائن(فهرس_التحرير)];
            ليكن فهرس_التحريرات: طبيعي = الطول(المصفوفات) مثل طبيعي;
            ليكن مصفوفة_التحريرات: مصفوفة_جسون = { القيم: قيم_التحريرات };
            ألحق(المصفوفات, مصفوفة_التحريرات);
            ليكن مدخل_الإضافية: مدخل_كائن_جسون = { المفتاح: «additionalTextEdits», القيمة: قيمة_جسون.مصفوفة(فهرس_التحريرات) };
            ألحق(المداخل, مدخل_الإضافية);
        };
        ليكن فهرس_العنصر: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن كائن_العنصر: كائن_جسون = { المداخل: المداخل, الفهرس: أنشئ_خريطة_نص_فهرس() };
        ألحق(الكائنات, كائن_العنصر);
        ألحق(القيم, قيمة_جسون.كائن(فهرس_العنصر));
        ف := ف + 1;
    }
    ليكن فهرس_المصفوفة: طبيعي = الطول(المصفوفات) مثل طبيعي;
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    إذا (!غير_مكتمل) { أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات); };
    ليكن فهرس_القائمة: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن مدخل_الناقص: مدخل_كائن_جسون = { المفتاح: «isIncomplete», القيمة: قيمة_جسون.منطق(صواب) };
    ليكن مدخل_العناصر: مدخل_كائن_جسون = { المفتاح: «items», القيمة: النتيجة };
    ليكن مداخل_القائمة: متجه مدخل_كائن_جسون = [مدخل_الناقص, مدخل_العناصر];
    ليكن القائمة: كائن_جسون = { المداخل: مداخل_القائمة, الفهرس: أنشئ_خريطة_نص_فهرس() };
    ألحق(الكائنات, القائمة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, قيمة_جسون.كائن(فهرس_القائمة), المصفوفات, الكائنات);
}


عام عرف ابن_رد_توقيع_استدعاء_دلالي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    التوقيع: &اختياري معلومات_توقيع_استدعاء_لغة
): وثيقة_جسون {
    ليكن النسخة: اختياري معلومات_توقيع_استدعاء_لغة = *التوقيع;
    طابق النسخة مع
    | اختياري.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختياري.موجود(المعلومات) -> {
        ليكن الكائنات: متغير متجه كائن_جسون = [];
        ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];

        ليكن قيم_المعاملات: متغير متجه قيمة_جسون = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعلومات.المعاملات) مثل طبيعي)) {
            ليكن مرجع_المعامل: &نص = &المعلومات.المعاملات[ف];
            ليكن نص_المعامل: نص = *مرجع_المعامل;
            ليكن قيمة_التسمية: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&نص_المعامل));
            ليكن مدخل_التسمية: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_التسمية };
            ليكن مداخل_المعامل: متجه مدخل_كائن_جسون = [مدخل_التسمية];
            ليكن فهرس_خريطة_المعامل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            ليكن فهرس_المعامل: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_المعامل: كائن_جسون = { المداخل: مداخل_المعامل, الفهرس: فهرس_خريطة_المعامل };
            ألحق(الكائنات, كائن_المعامل);
            ألحق(قيم_المعاملات, قيمة_جسون.كائن(فهرس_المعامل));
            ف := ف + 1;
        }
        ليكن فهرس_مصفوفة_المعاملات: طبيعي = الطول(المصفوفات) مثل طبيعي;
        ليكن مصفوفة_المعاملات: مصفوفة_جسون = { القيم: قيم_المعاملات };
        ألحق(المصفوفات, مصفوفة_المعاملات);

        ليكن نص_تسمية_التوقيع: نص = انسخ_نص_بروتوكول_دلالي(&المعلومات.التسمية);
        ليكن قيمة_تسمية_التوقيع: قيمة_جسون = قيمة_جسون.سلسلة(نص_تسمية_التوقيع);
        ليكن مدخل_تسمية_التوقيع: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_تسمية_التوقيع };
        ليكن قيمة_معاملات_التوقيع: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_المعاملات);
        ليكن مدخل_معاملات_التوقيع: مدخل_كائن_جسون = { المفتاح: «parameters», القيمة: قيمة_معاملات_التوقيع };
        ليكن مداخل_التوقيع: متغير متجه مدخل_كائن_جسون = [مدخل_تسمية_التوقيع, مدخل_معاملات_التوقيع];
        طابق استنسخ(&المعلومات.التوثيق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التوثيق) -> {
            ليكن قيمة_صنف: قيمة_جسون = قيمة_جسون.سلسلة(«markdown»);
            ليكن مدخل_صنف: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_صنف };
            ليكن قيمة_القيمة: قيمة_جسون = قيمة_جسون.سلسلة(التوثيق);
            ليكن مدخل_القيمة: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_القيمة };
            ليكن مداخل_التوثيق: متجه مدخل_كائن_جسون = [مدخل_صنف, مدخل_القيمة];
            ليكن فهرس_خريطة_التوثيق: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
            ليكن فهرس_التوثيق: طبيعي = الطول(الكائنات) مثل طبيعي;
            ليكن كائن_التوثيق: كائن_جسون = { المداخل: مداخل_التوثيق, الفهرس: فهرس_خريطة_التوثيق };
            ألحق(الكائنات, كائن_التوثيق);
            ليكن مدخل_التوثيق: مدخل_كائن_جسون = { المفتاح: «documentation», القيمة: قيمة_جسون.كائن(فهرس_التوثيق) };
            ألحق(مداخل_التوقيع, مدخل_التوثيق);
        };
        ليكن فهرس_خريطة_التوقيع: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن فهرس_التوقيع: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن كائن_التوقيع: كائن_جسون = { المداخل: مداخل_التوقيع, الفهرس: فهرس_خريطة_التوقيع };
        ألحق(الكائنات, كائن_التوقيع);

        ليكن قيمة_التوقيع: قيمة_جسون = قيمة_جسون.كائن(فهرس_التوقيع);
        ليكن قيم_التواقيع: متجه قيمة_جسون = [قيمة_التوقيع];
        ليكن فهرس_مصفوفة_التواقيع: طبيعي = الطول(المصفوفات) مثل طبيعي;
        ليكن مصفوفة_التواقيع: مصفوفة_جسون = { القيم: قيم_التواقيع };
        ألحق(المصفوفات, مصفوفة_التواقيع);

        ليكن قيمة_التواقيع: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_مصفوفة_التواقيع);
        ليكن مدخل_التواقيع: مدخل_كائن_جسون = { المفتاح: «signatures», القيمة: قيمة_التواقيع };
        ليكن قيمة_التوقيع_النشط: قيمة_جسون = قيمة_جسون.رقم(«0»);
        ليكن مدخل_التوقيع_النشط: مدخل_كائن_جسون = { المفتاح: «activeSignature», القيمة: قيمة_التوقيع_النشط };
        ليكن نص_المعامل_النشط: نص = طبيعي_إلى_نص(المعلومات.المعامل_النشط);
        ليكن قيمة_المعامل_النشط: قيمة_جسون = قيمة_جسون.رقم(نص_المعامل_النشط);
        ليكن مدخل_المعامل_النشط: مدخل_كائن_جسون = { المفتاح: «activeParameter», القيمة: قيمة_المعامل_النشط };
        ليكن مداخل_الجذر: متجه مدخل_كائن_جسون = [
            مدخل_التواقيع, مدخل_التوقيع_النشط, مدخل_المعامل_النشط
        ];
        ليكن فهرس_خريطة_الجذر: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن فهرس_الجذر: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن كائن_الجذر: كائن_جسون = { المداخل: مداخل_الجذر, الفهرس: فهرس_خريطة_الجذر };
        ألحق(الكائنات, كائن_الجذر);
        ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عرف فهرس_نوع_رمز_دلالي_لغة(النوع: نوع_تصريح): طبيعي {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع 0; }
    | نوع_تصريح.دالة_خارجية -> { أرجع 0; }
    | نوع_تصريح.مرادف_نوع -> { أرجع 1; }
    | نوع_تصريح.سجل -> { أرجع 2; }
    | نوع_تصريح.معتم -> { أرجع 1; }
    | نوع_تصريح.تعداد -> { أرجع 3; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع 4; }
    | نوع_تصريح.معامل_نوع -> { أرجع 1; }
    | نوع_تصريح.معامل -> { أرجع 5; }
    | نوع_تصريح.قيمة_عليا -> { أرجع 6; }
    | نوع_تصريح.ربط_محلي -> { أرجع 6; };
}

عرف نوع_رمز_معلن_لغة(النوع: نوع_تصريح): طبيعي {
    طابق النوع مع
    | نوع_تصريح.دالة -> { أرجع 12; }
    | نوع_تصريح.دالة_خارجية -> { أرجع 12; }
    | نوع_تصريح.مرادف_نوع -> { أرجع 26; }
    | نوع_تصريح.سجل -> { أرجع 23; }
    | نوع_تصريح.معتم -> { أرجع 5; }
    | نوع_تصريح.تعداد -> { أرجع 10; }
    | نوع_تصريح.منشئ_تعداد -> { أرجع 22; }
    | نوع_تصريح.معامل_نوع -> { أرجع 26; }
    | نوع_تصريح.معامل -> { أرجع 13; }
    | نوع_تصريح.قيمة_عليا -> { أرجع 13; }
    | نوع_تصريح.ربط_محلي -> { أرجع 13; };
}

// LSP semantic tokens are delta-encoded and must be strictly ordered and
// non-overlapping. Occurrences arrive in collection order (declarations, then
// uses), so sort by start position; ties keep the longer token first.
عرف قارن_ظهورين_مصنفين_لغة(الأول: &ظهور_مصنف_لغة, الثاني: &ظهور_مصنف_لغة): عدد {
    ليكن أ: موضع_تغيير_لغة = (*الأول).النطاق.البداية;
    ليكن ب: موضع_تغيير_لغة = (*الثاني).النطاق.البداية;
    إذا (أ.السطر < ب.السطر) { أرجع -1; };
    إذا (أ.السطر > ب.السطر) { أرجع 1; };
    إذا (أ.المحرف < ب.المحرف) { أرجع -1; };
    إذا (أ.المحرف > ب.المحرف) { أرجع 1; };
    ليكن نأ: موضع_تغيير_لغة = (*الأول).النطاق.النهاية;
    ليكن نب: موضع_تغيير_لغة = (*الثاني).النطاق.النهاية;
    إذا (نأ.المحرف > نب.المحرف) { أرجع -1; };
    إذا (نأ.المحرف < نب.المحرف) { أرجع 1; };
    أرجع 0;
}

عام عرف ابن_رد_رموز_دلالية_كاملة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الظهورات: &متجه ظهور_مصنف_لغة
): وثيقة_جسون {
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن الحالة: متغير متجه ظهور_مصنف_لغة = استنسخ(الظهورات);
    رتب_بالمقارنة(&متغير الحالة, قارن_ظهورين_مصنفين_لغة);
    ليكن السطر_السابق: متغير طبيعي = 0;
    ليكن البداية_السابقة: متغير طبيعي = 0;
    ليكن النهاية_السابقة: متغير طبيعي = 0;
    ليكن له_سابق: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن الظهور: ظهور_مصنف_لغة = الحالة[ف];
        ليكن البداية: موضع_تغيير_لغة = الظهور.النطاق.البداية;
        ليكن النهاية: موضع_تغيير_لغة = الظهور.النطاق.النهاية;
        ليكن متداخل: منطقي = له_سابق && البداية.السطر == السطر_السابق
            && البداية.المحرف < النهاية_السابقة;
        إذا (!متداخل && البداية.السطر == النهاية.السطر && النهاية.المحرف > البداية.المحرف) {
            ليكن فرق_السطر: متغير طبيعي = البداية.السطر;
            ليكن فرق_البداية: متغير طبيعي = البداية.المحرف;
            إذا (له_سابق) {
                فرق_السطر := البداية.السطر - السطر_السابق;
                إذا (فرق_السطر == 0) { فرق_البداية := البداية.المحرف - البداية_السابقة; };
            };
            ليكن الطول_النصي: طبيعي = النهاية.المحرف - البداية.المحرف;
            ليكن النوع: طبيعي = فهرس_نوع_رمز_دلالي_لغة(الظهور.النوع);
            ليكن المعدلات: متغير طبيعي = 0;
            إذا (الظهور.تصريح) { المعدلات := 1; };
            ليكن ن0: نص = طبيعي_إلى_نص(فرق_السطر);
            ليكن ن1: نص = طبيعي_إلى_نص(فرق_البداية);
            ليكن ن2: نص = طبيعي_إلى_نص(الطول_النصي);
            ليكن ن3: نص = طبيعي_إلى_نص(النوع);
            ليكن ن4: نص = طبيعي_إلى_نص(المعدلات);
            ألحق(القيم, قيمة_جسون.رقم(ن0));
            ألحق(القيم, قيمة_جسون.رقم(ن1));
            ألحق(القيم, قيمة_جسون.رقم(ن2));
            ألحق(القيم, قيمة_جسون.رقم(ن3));
            ألحق(القيم, قيمة_جسون.رقم(ن4));
            السطر_السابق := البداية.السطر;
            البداية_السابقة := البداية.المحرف;
            النهاية_السابقة := النهاية.المحرف;
            له_سابق := صواب;
        };
        ف := ف + 1;
    }
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن فهرس_المصفوفة: طبيعي = 0;
    ليكن مصفوفة_البيانات: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, مصفوفة_البيانات);
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن قيمة_البيانات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المصفوفة);
    ليكن مدخل_البيانات: مدخل_كائن_جسون = { المفتاح: «data», القيمة: قيمة_البيانات };
    ليكن مداخل_الجذر: متجه مدخل_كائن_جسون = [مدخل_البيانات];
    ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = { المداخل: مداخل_الجذر, الفهرس: فهرس_الخريطة };
    ألحق(الكائنات, الجذر);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.كائن(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_رموز_مستند_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرموز: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    ليكن الحالة: متجه رمز_معلن_لغة = *الرموز;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن مرجع_الرمز: &رمز_معلن_لغة = &الحالة[ف];
        ليكن الرمز: رمز_معلن_لغة = *مرجع_الرمز;
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الرمز.الموقع.النطاق);
        ليكن فهرس_التحديد: طبيعي = أضف_نطاق_لغة_إلى_جسون(&متغير الكائنات, الرمز.نطاق_التحديد);
        ليكن مرجع_الاسم: &نص = &الرمز.الاسم;
        ليكن الاسم: نص = *مرجع_الاسم;
        ليكن قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&الاسم));
        ليكن مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
        ليكن رقم_النوع: طبيعي = نوع_رمز_معلن_لغة(الرمز.النوع);
        ليكن نص_النوع: نص = طبيعي_إلى_نص(رقم_النوع);
        ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
        ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
        ليكن قيمة_التحديد: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحديد);
        ليكن مدخل_التحديد: مدخل_كائن_جسون = { المفتاح: «selectionRange», القيمة: قيمة_التحديد };
        ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_الاسم, مدخل_النوع, مدخل_النطاق, مدخل_التحديد];
        ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن فهرس_الرمز: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
        ألحق(الكائنات, الكائن);
        ألحق(القيم, قيمة_جسون.كائن(فهرس_الرمز));
        ف := ف + 1;
    }
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_رموز_مساحة_عمل_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرموز: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    ليكن الحالة: متجه رمز_معلن_لغة = *الرموز;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن مرجع_الرمز: &رمز_معلن_لغة = &الحالة[ف];
        ليكن الرمز: رمز_معلن_لغة = *مرجع_الرمز;
        ليكن مرجع_العنوان: &نص = &الرمز.الموقع.العنوان;
        ليكن العنوان: نص = *مرجع_العنوان;
        ليكن فهرس_الموقع: طبيعي = أضف_موقع_لغة_إلى_جسون(&متغير الكائنات, استنسخ(&العنوان), الرمز.نطاق_التحديد);
        ليكن مرجع_الاسم: &نص = &الرمز.الاسم;
        ليكن الاسم: نص = *مرجع_الاسم;
        ليكن قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&الاسم));
        ليكن مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
        ليكن رقم_النوع: طبيعي = نوع_رمز_معلن_لغة(الرمز.النوع);
        ليكن نص_النوع: نص = طبيعي_إلى_نص(رقم_النوع);
        ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
        ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
        ليكن قيمة_الموقع: قيمة_جسون = قيمة_جسون.كائن(فهرس_الموقع);
        ليكن مدخل_الموقع: مدخل_كائن_جسون = { المفتاح: «location», القيمة: قيمة_الموقع };
        ليكن المداخل: متغير متجه مدخل_كائن_جسون = [مدخل_الاسم, مدخل_النوع, مدخل_الموقع];
        طابق استنسخ(&الرمز.الحاوية) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الحاوية) -> {
            ليكن مدخل_الحاوية: مدخل_كائن_جسون = { المفتاح: «containerName», القيمة: قيمة_جسون.سلسلة(الحاوية) };
            ألحق(المداخل, مدخل_الحاوية);
        };
        ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن فهرس_الرمز: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
        ألحق(الكائنات, الكائن);
        ألحق(القيم, قيمة_جسون.كائن(فهرس_الرمز));
        ف := ف + 1;
    }
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

// Call Hierarchy protocol encoding only. Semantic identity and call edges come
// from compiler-owned SymbolID/call-graph queries in the analysis adapter.
عرف أضف_عنصر_هرم_استدعاء_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    العنصر: &رمز_معلن_لغة
): طبيعي {
    ليكن ع: رمز_معلن_لغة = *العنصر;
    ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(الكائنات, ع.الموقع.النطاق);
    ليكن فهرس_التحديد: طبيعي = أضف_نطاق_لغة_إلى_جسون(الكائنات, ع.نطاق_التحديد);
    ليكن مرجع_الاسم: &نص = &ع.الاسم;
    ليكن الاسم: نص = *مرجع_الاسم;
    ليكن قيمة_الاسم: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&الاسم));
    ليكن مدخل_الاسم: مدخل_كائن_جسون = { المفتاح: «name», القيمة: قيمة_الاسم };
    ليكن نص_النوع: نص = طبيعي_إلى_نص(نوع_رمز_معلن_لغة(ع.النوع));
    ليكن قيمة_النوع: قيمة_جسون = قيمة_جسون.رقم(نص_النوع);
    ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_النوع };
    ليكن مرجع_العنوان: &نص = &ع.الموقع.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن قيمة_العنوان: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&العنوان));
    ليكن مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «uri», القيمة: قيمة_العنوان };
    ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
    ليكن قيمة_التحديد: قيمة_جسون = قيمة_جسون.كائن(فهرس_التحديد);
    ليكن مدخل_التحديد: مدخل_كائن_جسون = { المفتاح: «selectionRange», القيمة: قيمة_التحديد };
    ليكن المداخل: متجه مدخل_كائن_جسون = [
        مدخل_الاسم, مدخل_النوع, مدخل_العنوان, مدخل_النطاق, مدخل_التحديد
    ];
    ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عام عرف ابن_رد_تحضير_هرم_استدعاء_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العنصر: &اختياري رمز_معلن_لغة
): وثيقة_جسون {
    ليكن النسخة: اختياري رمز_معلن_لغة = *العنصر;
    طابق النسخة مع
    | اختياري.لا_شيء -> { أرجع رد_نتيجة_عدم_دلالية(المعرف); }
    | اختياري.موجود(القيمة) -> {
        ليكن الكائنات: متغير متجه كائن_جسون = [];
        ليكن فهرس_العنصر: طبيعي = أضف_عنصر_هرم_استدعاء_إلى_جسون(&متغير الكائنات, &القيمة);
        ليكن قيمة_العنصر_في_المصفوفة: قيمة_جسون = قيمة_جسون.كائن(فهرس_العنصر);
        ليكن القيم: متجه قيمة_جسون = [قيمة_العنصر_في_المصفوفة];
        ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
        ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
        ألحق(المصفوفات, المصفوفة);
        ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
        أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
    };
}

عام عرف ابن_رد_تحضير_هرم_نوع_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العنصر: &اختياري رمز_معلن_لغة
): وثيقة_جسون {
    // TypeHierarchyItem and CallHierarchyItem share the same wire shape here.
    أرجع ابن_رد_تحضير_هرم_استدعاء_لغة(المعرف, العنصر);
}

عام عرف ابن_رد_علاقات_هرم_نوع_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    العناصر: &متجه رمز_معلن_لغة
): وثيقة_جسون {
    ليكن الحالة: متجه رمز_معلن_لغة = *العناصر;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن فهرس_العنصر: طبيعي = أضف_عنصر_هرم_استدعاء_إلى_جسون(
            &متغير الكائنات, &الحالة[ف]
        );
        ألحق(القيم, قيمة_جسون.كائن(فهرس_العنصر));
        ف := ف + 1;
    }
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, المصفوفة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عرف أضف_نطاقات_هرم_استدعاء_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    النطاقات: &متجه نطاق_تغيير_لغة
): طبيعي {
    ليكن الحالة: متجه نطاق_تغيير_لغة = *النطاقات;
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_لغة_إلى_جسون(الكائنات, الحالة[ف]);
        ليكن القيمة: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        ألحق(القيم, القيمة);
        ف := ف + 1;
    }
    ليكن الفهرس: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(*المصفوفات, المصفوفة);
    أرجع الفهرس;
}

عرف أضف_استدعاء_هرمي_إلى_جسون(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المجموعة: &مجموعة_استدعاء_هرمي_لغة,
    واردة: منطقي
): طبيعي {
    ليكن م: مجموعة_استدعاء_هرمي_لغة = *المجموعة;
    ليكن فهرس_العنصر: طبيعي = أضف_عنصر_هرم_استدعاء_إلى_جسون(الكائنات, &م.العنصر);
    ليكن فهرس_النطاقات: طبيعي = أضف_نطاقات_هرم_استدعاء_إلى_جسون(
        الكائنات, المصفوفات, &م.النطاقات
    );
    ليكن مفتاح_العنصر: متغير نص = «to»;
    إذا (واردة) { مفتاح_العنصر := «from»; };
    ليكن قيمة_العنصر: قيمة_جسون = قيمة_جسون.كائن(فهرس_العنصر);
    ليكن مدخل_العنصر: مدخل_كائن_جسون = { المفتاح: مفتاح_العنصر, القيمة: قيمة_العنصر };
    ليكن قيمة_النطاقات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_النطاقات);
    ليكن مدخل_النطاقات: مدخل_كائن_جسون = { المفتاح: «fromRanges», القيمة: قيمة_النطاقات };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_العنصر, مدخل_النطاقات];
    ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الخريطة };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عرف ابن_رد_استدعاءات_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة,
    واردة: منطقي
): وثيقة_جسون {
    ليكن الحالة: متجه مجموعة_استدعاء_هرمي_لغة = *المجموعات;
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن مرجع_المجموعة: &مجموعة_استدعاء_هرمي_لغة = &الحالة[ف];
        ليكن فهرس_الاستدعاء: طبيعي = أضف_استدعاء_هرمي_إلى_جسون(
            &متغير الكائنات, &متغير المصفوفات, مرجع_المجموعة, واردة
        );
        ليكن قيمة_الاستدعاء: قيمة_جسون = قيمة_جسون.كائن(فهرس_الاستدعاء);
        ألحق(القيم, قيمة_الاستدعاء);
        ف := ف + 1;
    }
    ليكن فهرس_النتيجة: طبيعي = الطول(المصفوفات) مثل طبيعي;
    ليكن مصفوفة_النتيجة: مصفوفة_جسون = { القيم: القيم };
    ألحق(المصفوفات, مصفوفة_النتيجة);
    ليكن النتيجة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_النتيجة);
    أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, النتيجة, المصفوفات, الكائنات);
}

عام عرف ابن_رد_استدعاءات_واردة_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_استدعاءات_هرمية_لغة(المعرف, المجموعات, صواب);
}

عام عرف ابن_رد_استدعاءات_صادرة_هرمية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المجموعات: &متجه مجموعة_استدعاء_هرمي_لغة
): وثيقة_جسون {
    أرجع ابن_رد_استدعاءات_هرمية_لغة(المعرف, المجموعات, خطأ);
}


// SemanticTokens data as numbers (5 per token, LSP relative encoding), shared
// by full and delta answers.
عام عرف بيانات_رموز_دلالية_لغة(الظهورات: &متجه ظهور_مصنف_لغة): متجه طبيعي {
    ليكن القيم: متغير متجه طبيعي = [];
    ليكن الحالة: متغير متجه ظهور_مصنف_لغة = استنسخ(الظهورات);
    رتب_بالمقارنة(&متغير الحالة, قارن_ظهورين_مصنفين_لغة);
    ليكن السطر_السابق: متغير طبيعي = 0;
    ليكن البداية_السابقة: متغير طبيعي = 0;
    ليكن النهاية_السابقة: متغير طبيعي = 0;
    ليكن له_سابق: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن الظهور: ظهور_مصنف_لغة = استنسخ(&الحالة[ف]);
        ليكن البداية: موضع_تغيير_لغة = الظهور.النطاق.البداية;
        ليكن النهاية: موضع_تغيير_لغة = الظهور.النطاق.النهاية;
        ليكن متداخل: منطقي = له_سابق && البداية.السطر == السطر_السابق
            && البداية.المحرف < النهاية_السابقة;
        إذا (!متداخل && البداية.السطر == النهاية.السطر && النهاية.المحرف > البداية.المحرف) {
            ليكن فرق_السطر: متغير طبيعي = البداية.السطر;
            ليكن فرق_البداية: متغير طبيعي = البداية.المحرف;
            إذا (له_سابق) {
                فرق_السطر := البداية.السطر - السطر_السابق;
                إذا (فرق_السطر == 0) { فرق_البداية := البداية.المحرف - البداية_السابقة; };
            };
            ليكن المعدلات: متغير طبيعي = 0;
            إذا (الظهور.تصريح) { المعدلات := 1; };
            ألحق(القيم, فرق_السطر);
            ألحق(القيم, فرق_البداية);
            ألحق(القيم, النهاية.المحرف - البداية.المحرف);
            ألحق(القيم, فهرس_نوع_رمز_دلالي_لغة(الظهور.النوع));
            ألحق(القيم, المعدلات);
            السطر_السابق := البداية.السطر;
            البداية_السابقة := البداية.المحرف;
            النهاية_السابقة := النهاية.المحرف;
            له_سابق := صواب;
        };
        ف := ف + 1;
    }
    أرجع القيم;
}

// ---- Text direction in hover Markdown ----------------------------------------

// Whether the first strong letter of البايتات[البداية, الحد) is Arabic (a line read
// right to left): Arabic letters U+0600–U+06FF, U+0750–U+077F, U+08A0–U+08FF
// and the presentation forms U+FB50–U+FEFF; an ASCII or Latin-1 letter first
// makes it left to right.
عرف يبدأ_بحرف_عربي_لغة(البايتات: &متجه ط8, البدء: طبيعي, الحد: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = البدء;
    طالما (ف < الحد) {
        ليكن ب: ط8 = (*البايتات)[ف];
        إذا ((ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A) || ب == 0xC3) { أرجع خطأ; };
        إذا ((ب >= 0xD8 && ب <= 0xDB) || ب == 0xDD) { أرجع صواب; };
        إذا (ب == 0xE0 && ف + 1 < الحد && ((*البايتات)[ف + 1] == 0xA2 || (*البايتات)[ف + 1] == 0xA3)) { أرجع صواب; };
        إذا (ب == 0xEF && ف + 1 < الحد && (*البايتات)[ف + 1] >= 0xAD && (*البايتات)[ف + 1] <= 0xBB) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The Markdown block marker a line starts with, kept outside the isolate:
// `- `, `* `, `+ ` (a list item) and `#… ` (a heading). Its length in bytes.
عرف طول_علامة_كتلة_لغة(البايتات: &متجه ط8, البدء: طبيعي, الحد: طبيعي): طبيعي {
    إذا (البدء + 1 < الحد) {
        ليكن ب: ط8 = (*البايتات)[البدء];
        إذا ((ب == 0x2D || ب == 0x2A || ب == 0x2B) && (*البايتات)[البدء + 1] == 0x20) { أرجع 2; };
    };
    ليكن ف: متغير طبيعي = البدء;
    طالما (ف < الحد && (*البايتات)[ف] == 0x23) { ف := ف + 1; }
    إذا (ف > البدء && ف < الحد && (*البايتات)[ف] == 0x20) { أرجع ف - البدء + 1; };
    أرجع 0;
}

// Hover Markdown with each line that starts in Arabic wrapped in RLI … PDI
// (U+2067, U+2069), so an Arabic signature such as
// `عرف الأكبر(الأول: عدد, الثاني: عدد): عدد` reads right to left inside a
// left-to-right hover, punctuation and Latin runs in place. Code fences,
// `---` rules, blank lines and lines that start in Latin are unchanged; a
// list or heading marker and a trailing hard break (two spaces) stay outside
// the isolate.
عام عرف اعزل_أسطر_عربية_لغة(النص: &نص): نص {
    ليكن البايتات: متجه ط8 = بايتات_من_نص(استنسخ(النص));
    ليكن الطول_الكلي: طبيعي = الطول(البايتات) مثل طبيعي;
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن البداية: متغير طبيعي = 0;
    طالما (البداية <= الطول_الكلي) {
        ليكن النهاية: متغير طبيعي = البداية;
        طالما (النهاية < الطول_الكلي && البايتات[النهاية] != 0x0A) { النهاية := النهاية + 1; }
        ليكن السياج: منطقي = النهاية >= البداية + 3 && البايتات[البداية] == 0x60
            && البايتات[البداية + 1] == 0x60 && البايتات[البداية + 2] == 0x60;
        ليكن الآخر: متغير طبيعي = النهاية;
        طالما (الآخر > البداية && البايتات[الآخر - 1] == 0x20) { الآخر := الآخر - 1; }
        ليكن العلامة: طبيعي = طول_علامة_كتلة_لغة(&البايتات, البداية, الآخر);
        ليكن يعزل: منطقي = !السياج && الآخر > البداية + العلامة
            && يبدأ_بحرف_عربي_لغة(&البايتات, البداية + العلامة, الآخر);
        ليكن ف: متغير طبيعي = البداية;
        إذا (يعزل) {
            طالما (ف < البداية + العلامة) { ألحق(الناتج, البايتات[ف]); ف := ف + 1; }
            ألحق(الناتج, 0xE2); ألحق(الناتج, 0x81); ألحق(الناتج, 0xA7);
            طالما (ف < الآخر) { ألحق(الناتج, البايتات[ف]); ف := ف + 1; }
            ألحق(الناتج, 0xE2); ألحق(الناتج, 0x81); ألحق(الناتج, 0xA9);
        };
        طالما (ف < النهاية) { ألحق(الناتج, البايتات[ف]); ف := ف + 1; }
        إذا (النهاية < الطول_الكلي) { ألحق(الناتج, 0x0A); };
        البداية := النهاية + 1;
    }
    أرجع من_بايتات(&الناتج);
}
