استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.encode;
استورد sultanc_analyzer.protocol.text_document;
استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.workspace.positions;
استورد sultanc_analyzer.analysis.structure;
استورد sultanc_analyzer.analysis.semantic_queries;
استورد std.json.value;
استورد std.json.parse;
استورد sultanc_analyzer.protocol.serialize;
استورد std.text.number;
استورد std.text.from_bytes;
استورد std.uri.uri;
استورد compiler.format.format;
استورد compiler.format.edits;

// Structure responses are written as JSON text and parsed once into the shared
// document model: the shape stays readable and strings are escaped by std.json.

عام عرف ألحق_موضع_جسون_لغة(الناتج: &متغير متجه ط8, الموضع: موضع_تغيير_لغة): فراغ {
    ألحق_بايتات_نص(الناتج, «{"line":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(الموضع.السطر));
    ألحق_بايتات_نص(الناتج, «,"character":»);
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(الموضع.المحرف));
    ألحق_بايتات_نص(الناتج, «}»);
}

عام عرف ألحق_نطاق_بايتات_جسون_لغة(
    الناتج: &متغير متجه ط8,
    المستند: &مستند_لغة_مفتوح,
    البداية: طبيعي,
    النهاية: طبيعي
): منطقي {
    ليكن أ: موضع_تغيير_لغة;
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, البداية) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(القيمة) -> { أ := القيمة; };
    ليكن ب: موضع_تغيير_لغة;
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(القيمة) -> { ب := القيمة; };
    ألحق_بايتات_نص(الناتج, «{"start":»);
    ألحق_موضع_جسون_لغة(الناتج, أ);
    ألحق_بايتات_نص(الناتج, «,"end":»);
    ألحق_موضع_جسون_لغة(الناتج, ب);
    ألحق_بايتات_نص(الناتج, «}»);
    أرجع صواب;
}

عام عرف رد_من_نص_جسون_لغة(المعرف: معرف_طلب_جسون_اربيسي, البايتات: &متجه ط8): وثيقة_جسون {
    ليكن النص: نص = من_بايتات(البايتات);
    طابق حلل_جسون(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع ابن_رد_خطأ_جسون_اربيسي(المعرف, -32603, «Invalid structure response»); }
    | نتيجة.نجح(الوثيقة) -> {
        طابق الوثيقة مع
        | { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: الكائنات } -> {
            أرجع ابن_رد_نتيجة_جسون_اربيسي(المعرف, الجذر, المصفوفات, الكائنات);
        };
    };
}

عام عرف ابن_رد_نطاقات_طي_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    النطاقات: &متجه نطاق_طي_بنيوي_لغة
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
        ألحق_بايتات_نص(&متغير الناتج, «{"startLine":»);
        ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص((*النطاقات)[ف].السطر_الأول));
        ألحق_بايتات_نص(&متغير الناتج, «,"endLine":»);
        ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص((*النطاقات)[ف].السطر_الأخير));
        إذا ((الطول((*النطاقات)[ف].الصنف) مثل طبيعي) > 0) {
            ألحق_بايتات_نص(&متغير الناتج, «,"kind":»);
            ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*النطاقات)[ف].الصنف);
        };
        ألحق_بايتات_نص(&متغير الناتج, «}»);
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

عام عرف ابن_رد_روابط_مستند_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    الروابط: &متجه رابط_بنيوي_لغة
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ليكن الأول: متغير منطقي = صواب;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        طابق مسار_إلى_عنوان_ملف(&(*الروابط)[ف].المسار) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(العنوان) -> {
            ليكن جزء: متغير متجه ط8 = [];
            ألحق_بايتات_نص(&متغير جزء, «{"range":»);
            إذا (ألحق_نطاق_بايتات_جسون_لغة(&متغير جزء, المستند, (*الروابط)[ف].البداية, (*الروابط)[ف].النهاية)) {
                ألحق_بايتات_نص(&متغير جزء, «,"target":»);
                ألحق_سلسلة_جسون_لغة(&متغير جزء, &العنوان);
                ألحق_بايتات_نص(&متغير جزء, «}»);
                إذا (!الأول) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
                الأول := خطأ;
                ليكن ك: متغير طبيعي = 0;
                طالما (ك < (الطول(جزء) مثل طبيعي)) { ألحق(الناتج, جزء[ك]); ك := ك + 1; }
            };
        };
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

// SelectionRange[] for each requested position: innermost range with a chain of
// `parent` ranges.
عام عرف ابن_رد_نطاقات_تحديد_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    المواضع: &متجه موضع_تغيير_لغة
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(المستند, (*المواضع)[ف]) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        ليكن النطاقات: متجه نطاق_بايتات_بنيوي_لغة = نطاقات_تحديد_بنيوية_لغة(&(*المستند).النص, البايت);
        ليكن المفتوحة: متغير طبيعي = 0;
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(النطاقات) مثل طبيعي)) {
            إذا (ك > 0) { ألحق_بايتات_نص(&متغير الناتج, «,"parent":»); };
            ألحق_بايتات_نص(&متغير الناتج, «{"range":»);
            إذا (!ألحق_نطاق_بايتات_جسون_لغة(&متغير الناتج, المستند, النطاقات[ك].البداية, النطاقات[ك].النهاية)) {
                ألحق_بايتات_نص(&متغير الناتج, «{"start":{"line":0,"character":0},"end":{"line":0,"character":0}}»);
            };
            المفتوحة := المفتوحة + 1;
            ك := ك + 1;
        }
        إذا (المفتوحة == 0) {
            ألحق_بايتات_نص(&متغير الناتج, «{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}}»);
            المفتوحة := 1;
        };
        طالما (المفتوحة > 0) { ألحق_بايتات_نص(&متغير الناتج, «}»); المفتوحة := المفتوحة - 1; }
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

عرف رقم_حقل_جسون_لغة(الوثيقة: &وثيقة_جسون, الفهرس: طبيعي, الاسم: نص): اختياري طبيعي {
    ليكن المفتاح: نص = الاسم;
    طابق قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.رقم(النص) -> {
            طابق حلل_طبيعي(&النص) مع
            | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
            | نتيجة.نجح(العدد) -> { أرجع اختياري.موجود(العدد); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// {"textDocument":{...}, "positions":[{line,character}...]} -> positions.
عام عرف فك_مواضع_طلب_تحديد_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري متجه موضع_تغيير_لغة {
    ليكن فهرس_المعاملات: طبيعي;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن المفتاح: نص = «positions»;
    ليكن فهرس_المصفوفة: طبيعي;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.مصفوفة(ف) -> { فهرس_المصفوفة := ف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    ليكن العدد: طبيعي;
    طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { العدد := ن; };
    ليكن الناتج: متغير متجه موضع_تغيير_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنصر) -> {
            طابق العنصر مع
            | قيمة_جسون.كائن(فهرس_الموضع) -> {
                طابق رقم_حقل_جسون_لغة(الوثيقة, فهرس_الموضع, «line») مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(السطر) -> {
                    طابق رقم_حقل_جسون_لغة(الوثيقة, فهرس_الموضع, «character») مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(المحرف) -> {
                        ليكن الموضع: موضع_تغيير_لغة = { السطر: السطر, المحرف: المحرف };
                        ألحق(الناتج, الموضع);
                    };
                };
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// {"textDocument":…, "range":{…}} -> range (inlay hints, semantic tokens range).
عام عرف فك_نطاق_طلب_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري نطاق_تغيير_لغة {
    طابق المعاملات مع
    | قيمة_جسون.كائن(الفهرس) -> {
        ليكن المفتاح: نص = «range»;
        طابق قيمة_مفتاح_جسون(الوثيقة, الفهرس, &المفتاح) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { أرجع فك_نطاق_تغيير_لغة(الوثيقة, القيمة); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف ابن_رد_تلميحات_مضمنة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    التلميحات: &متجه تلميح_مضمن_لغة
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التلميحات) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
        ألحق_بايتات_نص(&متغير الناتج, «{"position":»);
        ألحق_موضع_جسون_لغة(&متغير الناتج, (*التلميحات)[ف].الموضع);
        ألحق_بايتات_نص(&متغير الناتج, «,"label":»);
        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*التلميحات)[ف].النص);
        إذا ((*التلميحات)[ف].نوع_التلميح == 1) {
            ألحق_بايتات_نص(&متغير الناتج, «,"kind":1}»);
        } وإلا إذا ((*التلميحات)[ف].نوع_التلميح == 0) {
            // A closing brace hint: no InlayHintKind.
            ألحق_بايتات_نص(&متغير الناتج, «,"paddingLeft":true}»);
        } وإلا {
            ألحق_بايتات_نص(&متغير الناتج, «,"kind":2,"paddingRight":true}»);
        };
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

عرف ألحق_أرقام_جسون_لغة(الناتج: &متغير متجه ط8, القيم: &متجه طبيعي, البدء: طبيعي, الحد: طبيعي): فراغ {
    ألحق_بايتات_نص(الناتج, «[»);
    ليكن ف: متغير طبيعي = البدء;
    طالما (ف < الحد) {
        إذا (ف > البدء) { ألحق_بايتات_نص(الناتج, «,»); };
        ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص((*القيم)[ف]));
        ف := ف + 1;
    }
    ألحق_بايتات_نص(الناتج, «]»);
}

// {"resultId": …, "data": […]}
عام عرف ابن_رد_رموز_دلالية_بمعرف_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    البيانات: &متجه طبيعي,
    معرف_النتيجة: &نص
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"resultId":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, معرف_النتيجة);
    ألحق_بايتات_نص(&متغير الناتج, «,"data":»);
    ألحق_أرقام_جسون_لغة(&متغير الناتج, البيانات, 0, الطول(*البيانات) مثل طبيعي);
    ألحق_بايتات_نص(&متغير الناتج, «}»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

// SemanticTokensDelta: one edit replacing the changed middle of the data,
// found by the longest common prefix and suffix with the previous data.
عام عرف ابن_رد_فرق_رموز_دلالية_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    السابقة: &متجه طبيعي,
    الحالية: &متجه طبيعي,
    معرف_النتيجة: &نص
): وثيقة_جسون {
    ليكن طول_أ: طبيعي = الطول(*السابقة) مثل طبيعي;
    ليكن طول_ب: طبيعي = الطول(*الحالية) مثل طبيعي;
    ليكن البادئة: متغير طبيعي = 0;
    طالما ((البادئة < طول_أ) && (البادئة < طول_ب) && ((*السابقة)[البادئة] == (*الحالية)[البادئة])) {
        البادئة := البادئة + 1;
    }
    ليكن اللاحقة: متغير طبيعي = 0;
    طالما ((اللاحقة < طول_أ - البادئة) && (اللاحقة < طول_ب - البادئة)
        && ((*السابقة)[طول_أ - 1 - اللاحقة] == (*الحالية)[طول_ب - 1 - اللاحقة])) {
        اللاحقة := اللاحقة + 1;
    }
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"resultId":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, معرف_النتيجة);
    ألحق_بايتات_نص(&متغير الناتج, «,"edits":[»);
    إذا ((البادئة != طول_أ) || (البادئة != طول_ب)) {
        ألحق_بايتات_نص(&متغير الناتج, «{"start":»);
        ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص(البادئة));
        ألحق_بايتات_نص(&متغير الناتج, «,"deleteCount":»);
        ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص(طول_أ - البادئة - اللاحقة));
        ألحق_بايتات_نص(&متغير الناتج, «,"data":»);
        ألحق_أرقام_جسون_لغة(&متغير الناتج, الحالية, البادئة, طول_ب - اللاحقة);
        ألحق_بايتات_نص(&متغير الناتج, «}»);
    };
    ألحق_بايتات_نص(&متغير الناتج, «]}»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}


// textDocument/formatting and rangeFormatting: the compiler's formatter
// (compiler/format/format.sn), the one `sultanc fmt` uses. Its edits are byte
// offsets into the document's text, mapped to LSP ranges here. A document
// that does not lex or parse is not formatted: the answer is null, and its
// diagnostics already show why. A range is formatted exactly as the whole
// file formats it (the formatter's own rule).
عام عرف ابن_رد_تنسيق_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    المدى: اختياري مدى_بايتات_تنسيق_لغة
): وثيقة_جسون {
    ليكن الاسم: متغير نص = استنسخ(&(*المستند).العنوان);
    طابق استنسخ(&(*المستند).مسار_الملف) مع
    | اختياري.موجود(المسار) -> { الاسم := المسار; }
    | اختياري.لا_شيء -> { };
    ليكن النتيجة: متغير نتيجة_تعديلات_تنسيق = نتيجة_تعديلات_تنسيق.تعديلات([]);
    طابق المدى مع
    | اختياري.لا_شيء -> { النتيجة := تعديلات_تنسيق_نص(&الاسم, &(*المستند).النص); }
    | اختياري.موجود(القيمة) -> {
        النتيجة := تعديلات_تنسيق_مدى(&الاسم, &(*المستند).النص, القيمة.البداية, القيمة.النهاية);
    };
    طابق النتيجة مع
    | نتيجة_تعديلات_تنسيق.مرفوضة(_) -> { أرجع ابن_رد_عدم_جسون_لغة(المعرف); }
    | نتيجة_تعديلات_تنسيق.تعديلات(التعديلات) -> {
        ليكن الناتج: متغير متجه ط8 = [];
        ألحق_بايتات_نص(&متغير الناتج, «[»);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعديلات) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
            ألحق_بايتات_نص(&متغير الناتج, «{"range":»);
            إذا (!ألحق_نطاق_بايتات_جسون_لغة(&متغير الناتج, المستند, التعديلات[ف].البداية, التعديلات[ف].النهاية)) {
                أرجع ابن_رد_عدم_جسون_لغة(المعرف);
            };
            ألحق_بايتات_نص(&متغير الناتج, «,"newText":»);
            ألحق_سلسلة_جسون_لغة(&متغير الناتج, &التعديلات[ف].النص);
            ألحق_بايتات_نص(&متغير الناتج, «}»);
            ف := ف + 1;
        }
        ألحق_بايتات_نص(&متغير الناتج, «]»);
        أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
    };
}

عام نوع مدى_بايتات_تنسيق_لغة = { البداية: طبيعي, النهاية: طبيعي };

عرف ابن_رد_عدم_جسون_لغة(المعرف: معرف_طلب_جسون_اربيسي): وثيقة_جسون {
    ليكن الناتج: متجه ط8 = بايتات_من_نص(«null»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

// `sultanc/tests` (an extension request, like rust-analyzer's runnables):
// [{ name, range, runnable }] for the document's `@@test` functions, the
// range being the test's name.
عام عرف ابن_رد_اختبارات_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    الاختبارات: &متجه اختبار_مستند_لغة
): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ليكن المكتوبة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاختبارات) مثل طبيعي)) {
        ليكن البداية_المؤقتة: متجه ط8 = استنسخ(&الناتج);
        إذا (المكتوبة > 0) { ألحق_بايتات_نص(&متغير الناتج, «,»); };
        ألحق_بايتات_نص(&متغير الناتج, «{"name":»);
        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &(*الاختبارات)[ف].الاسم);
        ألحق_بايتات_نص(&متغير الناتج, «,"range":»);
        إذا (ألحق_نطاق_بايتات_جسون_لغة(&متغير الناتج, المستند, (*الاختبارات)[ف].البداية, (*الاختبارات)[ف].النهاية)) {
            إذا ((*الاختبارات)[ف].قابل) { ألحق_بايتات_نص(&متغير الناتج, «,"runnable":true}»); }
            وإلا { ألحق_بايتات_نص(&متغير الناتج, «,"runnable":false}»); };
            المكتوبة := المكتوبة + 1;
        } وإلا {
            الناتج := البداية_المؤقتة;
        };
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «]»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}

عام عرف ابن_رد_مخطط_حزم_لغة(المعرف: معرف_طلب_جسون_اربيسي, النص: &نص): وثيقة_جسون {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"graph":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, النص);
    ألحق_بايتات_نص(&متغير الناتج, «}»);
    أرجع رد_من_نص_جسون_لغة(المعرف, &الناتج);
}
