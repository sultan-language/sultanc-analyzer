استورد std.json.value;
استورد std.text.number;

عام نوع موضع_تغيير_لغة = {
    السطر: طبيعي,
    المحرف: طبيعي
};

عام نوع نطاق_تغيير_لغة = {
    البداية: موضع_تغيير_لغة,
    النهاية: موضع_تغيير_لغة
};

عام نوع تغيير_محتوى_لغة =
    | كامل بنوع نص
    | نطاق بنوع (نطاق_تغيير_لغة, نص)
;

عام نوع فتح_مستند_لغة = {
    العنوان: نص,
    اللغة: نص,
    الإصدار: عدد,
    النص: نص
};

عام نوع تغيير_مستند_لغة = {
    العنوان: نص,
    الإصدار: عدد,
    التغييرات: متجه تغيير_محتوى_لغة
};

عام نوع حفظ_مستند_لغة = {
    العنوان: نص,
    النص: اختياري نص
};

عام نوع إغلاق_مستند_لغة = {
    العنوان: نص
};

عام عرف فهرس_كائن_جسون(القيمة: قيمة_جسون): اختياري طبيعي {
    طابق القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نص_جسون(القيمة: قيمة_جسون): اختياري نص {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع اختياري.موجود(النص); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف طبيعي_جسون(القيمة: قيمة_جسون): اختياري طبيعي {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_طبيعي(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع اختياري.موجود(العدد); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حلل_إصدار_مستند(القيمة: قيمة_جسون): اختياري عدد {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع اختياري.موجود(العدد); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف قيمة_حقل_جسون(
    الوثيقة: &وثيقة_جسون,
    فهرس_الكائن: طبيعي,
    الاسم: نص
): اختياري قيمة_جسون {
    ليكن المفتاح: نص = الاسم;
    أرجع قيمة_مفتاح_جسون(الوثيقة, فهرس_الكائن, &المفتاح);
}

عام عرف فك_موضع_تغيير_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختياري موضع_تغيير_لغة {
    ليكن الفهرس: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الفهرس := ف; };

    ليكن السطر: متغير طبيعي = 0;
    ليكن المحرف: متغير طبيعي = 0;
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «line») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق طبيعي_جسون(قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { السطر := ن; };
    };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «character») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق طبيعي_جسون(قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { المحرف := ن; };
    };
    ليكن الناتج: موضع_تغيير_لغة = { السطر: السطر, المحرف: المحرف };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_نطاق_تغيير_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختياري نطاق_تغيير_لغة {
    ليكن الفهرس: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الفهرس := ف; };

    ليكن البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «start») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(موضع) -> { البداية := موضع; };
    };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «end») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(موضع) -> { النهاية := موضع; };
    };
    ليكن الناتج: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_هوية_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    القيمة: قيمة_جسون
): اختياري نص {
    ليكن الفهرس: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { الفهرس := ف; };
    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «uri») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> { أرجع نص_جسون(قيمة); };
}

عام عرف فك_فتح_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري فتح_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    ليكن قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> { قيمة_المستند := قيمة; };

    ليكن فهرس_المستند: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(قيمة_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المستند := ف; };

    ليكن العنوان: متغير نص = «»;
    ليكن اللغة: متغير نص = «»;
    ليكن الإصدار: متغير عدد = 0;
    ليكن النص: متغير نص = «»;

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «uri») مع
    | اختياري.موجود(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختياري.موجود(ن) -> { العنوان := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «languageId») مع
    | اختياري.موجود(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختياري.موجود(ن) -> { اللغة := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «version») مع
    | اختياري.موجود(قيمة) -> {
        طابق حلل_إصدار_مستند(قيمة) مع
        | اختياري.موجود(ن) -> { الإصدار := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «text») مع
    | اختياري.موجود(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختياري.موجود(ن) -> { النص := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    ليكن الناتج: فتح_مستند_لغة = {
        العنوان: العنوان,
        اللغة: اللغة,
        الإصدار: الإصدار,
        النص: النص
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_تغيير_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري تغيير_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    ليكن قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> { قيمة_المستند := قيمة; };

    ليكن فهرس_المستند: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(قيمة_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المستند := ف; };

    ليكن العنوان: متغير نص = «»;
    ليكن الإصدار: متغير عدد = 0;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «uri») مع
    | اختياري.موجود(قيمة) -> {
        طابق نص_جسون(قيمة) مع
        | اختياري.موجود(ن) -> { العنوان := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المستند, «version») مع
    | اختياري.موجود(قيمة) -> {
        طابق حلل_إصدار_مستند(قيمة) مع
        | اختياري.موجود(ن) -> { الإصدار := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    ليكن فهرس_التغييرات: متغير طبيعي = 0;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «contentChanges») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        طابق قيمة مع
        | قيمة_جسون.مصفوفة(ف) -> { فهرس_التغييرات := ف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن عدد_التغييرات: متغير طبيعي = 0;
    طابق طول_مصفوفة_جسون(الوثيقة, فهرس_التغييرات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { عدد_التغييرات := ن; };
    إذا (عدد_التغييرات == 0) { أرجع اختياري.لا_شيء(); };

    ليكن التغييرات: متغير متجه تغيير_محتوى_لغة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_التغييرات) {
        ليكن قيمة_التغيير: متغير قيمة_جسون = قيمة_جسون.عدم();
        طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_التغييرات, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(قيمة) -> { قيمة_التغيير := قيمة; };

        ليكن فهرس_التغيير: متغير طبيعي = 0;
        طابق فهرس_كائن_جسون(قيمة_التغيير) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(م) -> { فهرس_التغيير := م; };

        ليكن النص: متغير نص = «»;
        طابق قيمة_حقل_جسون(الوثيقة, فهرس_التغيير, «text») مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(قيمة) -> {
            طابق نص_جسون(قيمة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ن) -> { النص := ن; };
        };

        طابق قيمة_حقل_جسون(الوثيقة, فهرس_التغيير, «range») مع
        | اختياري.لا_شيء -> {
            ألحق(التغييرات, تغيير_محتوى_لغة.كامل(النص));
        }
        | اختياري.موجود(قيمة_النطاق) -> {
            طابق فك_نطاق_تغيير_لغة(الوثيقة, قيمة_النطاق) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(النطاق) -> {
                ألحق(التغييرات, تغيير_محتوى_لغة.نطاق(النطاق, النص));
            };
        };
        ف := ف + 1;
    }

    ليكن الناتج: تغيير_مستند_لغة = {
        العنوان: العنوان,
        الإصدار: الإصدار,
        التغييرات: التغييرات
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_حفظ_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري حفظ_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    ليكن العنوان: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فك_هوية_مستند_لغة(الوثيقة, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { العنوان := ن; };
    };

    ليكن النص: متغير اختياري نص = اختياري.لا_شيء();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «text») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { النص := اختياري.موجود(ن); };
    };

    ليكن الناتج: حفظ_مستند_لغة = { العنوان: العنوان, النص: النص };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_إغلاق_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري إغلاق_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فك_هوية_مستند_لغة(الوثيقة, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            ليكن الناتج: إغلاق_مستند_لغة = { العنوان: العنوان };
            أرجع اختياري.موجود(الناتج);
        };
    };
}

// معاملات موضع دلالي مشتركة بين hover/definition/highlight/references/rename.
عام نوع طلب_موضع_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة
};

عام نوع طلب_مراجع_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة,
    يتضمن_التصريح: منطقي
};

عام نوع طلب_إعادة_تسمية_مستند_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة,
    الاسم_الجديد: نص
};

عام عرف فك_طلب_موضع_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_موضع_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };

    ليكن قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_المستند := القيمة; };
    ليكن العنوان: متغير نص = «»;
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { العنوان := القيمة; };

    ليكن قيمة_الموضع: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «position») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_الموضع := القيمة; };
    ليكن الموضع: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة_الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الموضع := القيمة; };

    ليكن الناتج: طلب_موضع_مستند_لغة = { العنوان: العنوان, الموضع: الموضع };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_طلب_مراجع_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_مراجع_مستند_لغة {
    ليكن مرجع_المعاملات: &قيمة_جسون = &المعاملات;
    ليكن معاملات_الموضع: قيمة_جسون = *مرجع_المعاملات;
    ليكن معاملات_السياق: قيمة_جسون = *مرجع_المعاملات;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الأساسي: متغير طلب_موضع_مستند_لغة = {
        العنوان: «»,
        الموضع: الموضع_الفارغ
    };
    طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&معاملات_الموضع)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الأساسي := القيمة; };
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(استنسخ(&معاملات_السياق)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };
    ليكن قيمة_السياق: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «context») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_السياق := القيمة; };
    ليكن فهرس_السياق: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(قيمة_السياق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_السياق := ف; };
    ليكن يتضمن: متغير منطقي = صواب;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_السياق, «includeDeclaration») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.منطق(المنطق) -> { يتضمن := المنطق; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    ليكن مرجع_العنوان: &نص = &الأساسي.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن الموضع: موضع_تغيير_لغة = الأساسي.الموضع;
    ليكن الناتج: طلب_مراجع_مستند_لغة = {
        العنوان: استنسخ(&العنوان),
        الموضع: الموضع,
        يتضمن_التصريح: يتضمن
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف فك_طلب_إعادة_تسمية_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_إعادة_تسمية_مستند_لغة {
    ليكن مرجع_المعاملات: &قيمة_جسون = &المعاملات;
    ليكن معاملات_الموضع: قيمة_جسون = *مرجع_المعاملات;
    ليكن معاملات_الاسم: قيمة_جسون = *مرجع_المعاملات;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الأساسي: متغير طلب_موضع_مستند_لغة = {
        العنوان: «»,
        الموضع: الموضع_الفارغ
    };
    طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&معاملات_الموضع)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الأساسي := القيمة; };
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(استنسخ(&معاملات_الاسم)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };
    ليكن الاسم_الجديد: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «newName») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النص) -> { الاسم_الجديد := النص; };
    };
    ليكن مرجع_العنوان: &نص = &الأساسي.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن الموضع: موضع_تغيير_لغة = الأساسي.الموضع;
    ليكن الناتج: طلب_إعادة_تسمية_مستند_لغة = {
        العنوان: استنسخ(&العنوان),
        الموضع: الموضع,
        الاسم_الجديد: الاسم_الجديد
    };
    أرجع اختياري.موجود(الناتج);
}

// Shared parameters for document-wide semantic requests such as symbols and
// semantic tokens. Decoding remains protocol-owned and carries only the URI.
عام نوع طلب_مستند_لغة = {
    العنوان: نص
};

عام عرف فك_طلب_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };
    ليكن قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «textDocument») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_المستند := القيمة; };
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العنوان) -> {
        ليكن الناتج: طلب_مستند_لغة = { العنوان: العنوان };
        أرجع اختياري.موجود(الناتج);
    };
}

عام عرف فك_استعلام_رموز_مساحة_عمل_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري نص {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «query») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع نص_جسون(القيمة); };
}

// Follow-up hierarchy requests carry the previously returned hierarchy item.
// Only URI + selectionRange.start are required to re-resolve its canonical
// SymbolID in the fresh project semantic snapshot.
عام نوع طلب_عنصر_هرم_لغة = {
    العنوان: نص,
    الموضع: موضع_تغيير_لغة
};

عام عرف فك_طلب_عنصر_هرم_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_عنصر_هرم_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_المعاملات := ف; };
    ليكن قيمة_العنصر: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_المعاملات, «item») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_العنصر := القيمة; };
    ليكن فهرس_العنصر: متغير طبيعي = 0;
    طابق فهرس_كائن_جسون(قيمة_العنصر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ف) -> { فهرس_العنصر := ف; };
    ليكن العنوان: متغير نص = «»;
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_العنصر, «uri») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق نص_جسون(القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النص) -> { العنوان := النص; };
    };
    ليكن قيمة_النطاق: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_حقل_جسون(الوثيقة, فهرس_العنصر, «selectionRange») مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_النطاق := القيمة; };
    ليكن موضع_بداية_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن موضع_نهاية_فارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن النطاق: متغير نطاق_تغيير_لغة = {
        البداية: موضع_بداية_فارغ,
        النهاية: موضع_نهاية_فارغ
    };
    طابق فك_نطاق_تغيير_لغة(الوثيقة, قيمة_النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { النطاق := القيمة; };
    ليكن الناتج: طلب_عنصر_هرم_لغة = { العنوان: العنوان, الموضع: النطاق.البداية };
    أرجع اختياري.موجود(الناتج);
}
