// Code Action هنا مجرد تكييف لإصلاحات Diagnostics المقننة؛ لا يستنتج LSP إصلاحات جديدة.
عام نوع طلب_إجراء_شفرة_لغة = {
    العنوان: نص,
    النطاق: نطاق_تغيير_لغة,
    يسمح_إصلاح_سريع: منطقي,
    // context.only as sent; empty means every kind.
    الأنواع: متجه نص
};

// LSP CodeActionKind matching: `refactor` admits `refactor.extract.variable`.
عام عرف نوع_إجراء_مسموح_لغة(الطلب: &طلب_إجراء_شفرة_لغة, النوع: نص): منطقي {
    إذا ((الطول((*الطلب).الأنواع) مثل طبيعي) == 0) { أرجع صواب; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).الأنواع) مثل طبيعي)) {
        ليكن المسموح: نص = استنسخ(&(*الطلب).الأنواع[ف]);
        إذا (نصان_متساويان(&المسموح, &النوع)) { أرجع صواب; };
        ليكن أجزاء: متجه نص = [استنسخ(&المسموح), «.»];
        ليكن الفاصل: نص = «»;
        ليكن البادئة: نص = صل_النصوص(&أجزاء, &الفاصل);
        إذا (يبدأ_بـ(&النوع, &البادئة)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The kinds listed in context.only.
عرف أنواع_سياق_الإجراء_لغة(
    الوثيقة: &وثيقة_جسون,
    فهرس_المعاملات: طبيعي
): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن مفتاح_السياق: نص = «context»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_السياق) مع
    | اختياري.موجود(قيمة_جسون.كائن(فهرس_السياق)) -> {
        ليكن مفتاح_فقط: نص = «only»;
        طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_السياق, &مفتاح_فقط) مع
        | اختياري.موجود(قيمة_جسون.مصفوفة(فهرس_المصفوفة)) -> {
            ليكن العدد: متغير طبيعي = 0;
            طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ن) -> { العدد := ن; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
                | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { ألحق(الناتج, النص); }
                | _ -> { };
                ف := ف + 1;
            }
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع الناتج;
}

عرف هل_قيمة_نص_تساوي(القيمة: قيمة_جسون, المطلوب: نص): منطقي {
    طابق القيمة مع
    | قيمة_جسون.سلسلة(النص) -> {
        ليكن م: نص = المطلوب;
        أرجع نصان_متساويان(&النص, &م);
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_السياق_يسمح_إصلاحا_سريعا(
    الوثيقة: &وثيقة_جسون,
    فهرس_المعاملات: طبيعي
): اختياري منطقي {
    ليكن مفتاح_السياق: نص = «context»;
    ليكن فهرس_السياق: متغير طبيعي = 0;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_السياق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.كائن(ف) -> { فهرس_السياق := ف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن مفتاح_فقط: نص = «only»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_السياق, &مفتاح_فقط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(صواب); }
    | اختياري.موجود(القيمة) -> {
        ليكن فهرس_المصفوفة: متغير طبيعي = 0;
        طابق القيمة مع
        | قيمة_جسون.مصفوفة(ف) -> { فهرس_المصفوفة := ف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
        ليكن العدد: متغير طبيعي = 0;
        طابق طول_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { العدد := ن; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق عنصر_مصفوفة_جسون(الوثيقة, فهرس_المصفوفة, ف) مع
            | اختياري.موجود(عنصر) -> {
                إذا (هل_قيمة_نص_تساوي(عنصر, «quickfix»)) {
                    أرجع اختياري.موجود(صواب);
                };
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(خطأ);
    };
}

عام عرف فك_طلب_إجراء_شفرة_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_إجراء_شفرة_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختياري.لا_شيء(); };

    ليكن مفتاح_المستند: نص = «textDocument»;
    ليكن قيمة_المستند: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { قيمة_المستند := القيمة; };
    ليكن العنوان: متغير نص = «»;
    طابق فك_هوية_مستند_لغة(الوثيقة, قيمة_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { العنوان := القيمة; };

    ليكن مفتاح_النطاق: نص = «range»;
    ليكن موضع_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن موضع_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن النطاق: متغير نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_أ,
        النهاية: موضع_فارغ_ب
    };
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق فك_نطاق_تغيير_لغة(الوثيقة, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة_المحللة) -> { النطاق := القيمة_المحللة; };
    };

    ليكن يسمح: متغير منطقي = صواب;
    طابق هل_السياق_يسمح_إصلاحا_سريعا(الوثيقة, فهرس_المعاملات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { يسمح := القيمة; };

    ليكن الطلب: طلب_إجراء_شفرة_لغة = {
        العنوان: العنوان,
        النطاق: النطاق,
        يسمح_إصلاح_سريع: يسمح,
        الأنواع: أنواع_سياق_الإجراء_لغة(الوثيقة, فهرس_المعاملات)
    };
    أرجع اختياري.موجود(الطلب);
}

عرف موضع_لغة_قبل_أو_يساوي(أ: موضع_تغيير_لغة, ب: موضع_تغيير_لغة): منطقي {
    إذا (أ.السطر < ب.السطر) { أرجع صواب; };
    إذا (أ.السطر > ب.السطر) { أرجع خطأ; };
    أرجع أ.المحرف <= ب.المحرف;
}

عرف نطاقا_لغة_متداخلان(أ: نطاق_تغيير_لغة, ب: نطاق_تغيير_لغة): منطقي {
    أرجع موضع_لغة_قبل_أو_يساوي(أ.البداية, ب.النهاية)
        && موضع_لغة_قبل_أو_يساوي(ب.البداية, أ.النهاية);
}

// CodeActionParams.range يصف موضع التشخيص/اختيار المستخدم، لا موضع التحرير
// الذي قد يكون في مكان آخر (مثل نقل فاصلة منقوطة). لذلك نرشح الإصلاح
// باستخدام نطاق التشخيص الرئيسي، ثم نطبق جميع تعديلات الإصلاح المقنن.
عرف تشخيص_يتقاطع_مع_نطاق_إجراء_لغة(
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    التشخيص: &تشخيص
): منطقي {
    ليكن ت: تشخيص = *التشخيص;
    طابق ت.المصدر_الرئيسي مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المصدر) -> {
        إذا (!مصدر_تشخيص_للمستند(&المصدر, المستند)) { أرجع خطأ; };
        طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(النطاق) -> {
            ليكن نطاق_التشخيص: نطاق_تغيير_لغة = {
                البداية: النطاق.البداية,
                النهاية: النطاق.النهاية
            };
            أرجع نطاقا_لغة_متداخلان(المطلوب, نطاق_التشخيص);
        };
    };
}

عرف أضف_موضع_إجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): طبيعي {
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن نص_السطر: نص = طبيعي_إلى_نص(الموضع.السطر);
    ليكن قيمة_السطر: قيمة_جسون = قيمة_جسون.رقم(نص_السطر);
    ليكن مدخل_السطر: مدخل_كائن_جسون = { المفتاح: «line», القيمة: قيمة_السطر };
    ليكن نص_المحرف: نص = طبيعي_إلى_نص(الموضع.المحرف);
    ليكن قيمة_المحرف: قيمة_جسون = قيمة_جسون.رقم(نص_المحرف);
    ليكن مدخل_المحرف: مدخل_كائن_جسون = { المفتاح: «character», القيمة: قيمة_المحرف };
    ليكن مداخل_الموضع: متجه مدخل_كائن_جسون = [مدخل_السطر, مدخل_المحرف];
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = {
        المداخل: مداخل_الموضع,
        الفهرس: فهرس_الكائن
    };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عرف أضف_نطاق_إجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تغيير_لغة
): طبيعي {
    ليكن البداية: طبيعي = أضف_موضع_إجراء_شفرة(الكائنات, النطاق.البداية);
    ليكن النهاية: طبيعي = أضف_موضع_إجراء_شفرة(الكائنات, النطاق.النهاية);
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_البداية: قيمة_جسون = قيمة_جسون.كائن(البداية);
    ليكن مدخل_البداية: مدخل_كائن_جسون = { المفتاح: «start», القيمة: قيمة_البداية };
    ليكن قيمة_النهاية: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    ليكن مدخل_النهاية: مدخل_كائن_جسون = { المفتاح: «end», القيمة: قيمة_النهاية };
    ليكن مداخل_النطاق: متجه مدخل_كائن_جسون = [مدخل_البداية, مدخل_النهاية];
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = {
        المداخل: مداخل_النطاق,
        الفهرس: فهرس_الكائن
    };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

// One compiler suggestion (compiler/diagnostics/suggestions.sn) as a quick
// fix: its words, its edits with the compiler's UTF-16 positions, preferred
// when machine-applicable. The edits apply together, so a suggestion with an
// edit outside this document or without positions is not offered.
عرف أضف_إصلاح_كإجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    الإجراءات: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    الإصلاح: &إصلاح_تشخيص
): فراغ {
    إذا (!مصدر_تشخيص_للمستند(&(*الإصلاح).المصدر, المستند)) { أرجع; };
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الإصلاح).التعديلات_الإضافية) مثل طبيعي)) {
        إذا (!مصدر_تشخيص_للمستند(&(*الإصلاح).التعديلات_الإضافية[ت].المصدر, المستند)) { أرجع; };
        ت := ت + 1;
    }
    ليكن لغة_العنوان: متغير لغة_تشخيص = لغة_تشخيص.الإنجليزية();
    إذا (مستند_لغة_بالعربية(المستند)) { لغة_العنوان := لغة_تشخيص.العربية(); };
    ليكن الاقتراح: اقتراح_تشخيص = اقتراح_من_إصلاح(الإصلاح, لغة_العنوان);
    ليكن قيم_التحريرات: متغير متجه قيمة_جسون = [];
    ت := 0;
    طالما (ت < (الطول(الاقتراح.التعديلات) مثل طبيعي)) {
        ليكن التعديل: تعديل_اقتراح_تشخيص = استنسخ(&الاقتراح.التعديلات[ت]);
        ليكن البداية: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
        ليكن النهاية: متغير موضع_نصي_يوتيف16 = { السطر: 0, العمود: 0 };
        طابق التعديل.البداية مع
        | اختياري.لا_شيء -> { أرجع; }
        | اختياري.موجود(القيمة) -> { البداية := القيمة; };
        طابق التعديل.النهاية مع
        | اختياري.لا_شيء -> { أرجع; }
        | اختياري.موجود(القيمة) -> { النهاية := القيمة; };
        ليكن النطاق: نطاق_تغيير_لغة = {
            البداية: { السطر: البداية.السطر, المحرف: البداية.العمود },
            النهاية: { السطر: النهاية.السطر, المحرف: النهاية.العمود }
        };
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_إجراء_شفرة(الكائنات, النطاق);
        ليكن مداخل_التحرير: متجه مدخل_كائن_جسون = [
            { المفتاح: «range», القيمة: قيمة_جسون.كائن(فهرس_النطاق) },
            { المفتاح: «newText», القيمة: قيمة_جسون.سلسلة(استنسخ(&التعديل.الاستبدال)) }
        ];
        ليكن فهرس_التحرير: طبيعي = الطول(*الكائنات) مثل طبيعي;
        ليكن كائن_التحرير: كائن_جسون = { المداخل: مداخل_التحرير, الفهرس: أنشئ_خريطة_نص_فهرس() };
        ألحق(*الكائنات, كائن_التحرير);
        ألحق(قيم_التحريرات, قيمة_جسون.كائن(فهرس_التحرير));
        ت := ت + 1;
    }
    ليكن فهرس_التحريرات: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن مصفوفة_التحريرات: مصفوفة_جسون = { القيم: قيم_التحريرات };
    ألحق(*المصفوفات, مصفوفة_التحريرات);

    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن مرجع_عنوان_تغييرات_المستند: &نص = &د.العنوان;
    ليكن عنوان_تغييرات_المستند: نص = *مرجع_عنوان_تغييرات_المستند;
    ليكن فهرس_التغييرات: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_تحريرات_المستند: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_التحريرات);
    ليكن مدخل_تغييرات_المستند: مدخل_كائن_جسون = { المفتاح: استنسخ(&عنوان_تغييرات_المستند), القيمة: قيمة_تحريرات_المستند };
    ليكن مداخل_التغييرات: متجه مدخل_كائن_جسون = [مدخل_تغييرات_المستند];
    ليكن فهرس_كائن_التغييرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن التغييرات: كائن_جسون = {
        المداخل: مداخل_التغييرات,
        الفهرس: فهرس_كائن_التغييرات
    };
    ألحق(*الكائنات, التغييرات);

    ليكن فهرس_تحرير_المساحة: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_تغييرات_المساحة: قيمة_جسون = قيمة_جسون.كائن(فهرس_التغييرات);
    ليكن مدخل_تغييرات_المساحة: مدخل_كائن_جسون = { المفتاح: «changes», القيمة: قيمة_تغييرات_المساحة };
    ليكن مداخل_تحرير_المساحة: متجه مدخل_كائن_جسون = [مدخل_تغييرات_المساحة];
    ليكن فهرس_كائن_تحرير_المساحة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن تحرير_المساحة: كائن_جسون = {
        المداخل: مداخل_تحرير_المساحة,
        الفهرس: فهرس_كائن_تحرير_المساحة
    };
    ألحق(*الكائنات, تحرير_المساحة);

    ليكن مفضل: منطقي = نصان_متساويان(&الاقتراح.القابلية_الآلية, &«machine-applicable»);

    // `diagnostics` ties the fix to the squiggle it resolves (the editor shows
    // it on that diagnostic and lists it under Quick Fix for it).
    ليكن قيم_التشخيص: متغير متجه قيمة_جسون = [];
    أضف_تشخيص_لغة(الكائنات, المصفوفات, &متغير قيم_التشخيص, المستند, التشخيص, خطأ);
    ليكن فهرس_تشخيصات_الإجراء: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن مصفوفة_تشخيصات_الإجراء: مصفوفة_جسون = { القيم: قيم_التشخيص };
    ألحق(*المصفوفات, مصفوفة_تشخيصات_الإجراء);

    ليكن فهرس_الإجراء: طبيعي = الطول(*الكائنات) مثل طبيعي;
    // The title is the suggestion's words in the document's language.
    ليكن نص_عنوان_الإجراء: نص = استنسخ(&الاقتراح.الرسالة);
    ليكن قيمة_عنوان_الإجراء: قيمة_جسون = قيمة_جسون.سلسلة(نص_عنوان_الإجراء);
    ليكن مدخل_عنوان_الإجراء: مدخل_كائن_جسون = { المفتاح: «title», القيمة: قيمة_عنوان_الإجراء };
    ليكن قيمة_نوع_الإجراء: قيمة_جسون = قيمة_جسون.سلسلة(«quickfix»);
    ليكن مدخل_نوع_الإجراء: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_نوع_الإجراء };
    ليكن قيمة_تفضيل_الإجراء: قيمة_جسون = قيمة_جسون.منطق(مفضل);
    ليكن مدخل_تفضيل_الإجراء: مدخل_كائن_جسون = { المفتاح: «isPreferred», القيمة: قيمة_تفضيل_الإجراء };
    ليكن قيمة_تحرير_الإجراء: قيمة_جسون = قيمة_جسون.كائن(فهرس_تحرير_المساحة);
    ليكن مدخل_تحرير_الإجراء: مدخل_كائن_جسون = { المفتاح: «edit», القيمة: قيمة_تحرير_الإجراء };
    ليكن مدخل_تشخيصات_الإجراء: مدخل_كائن_جسون = { المفتاح: «diagnostics», القيمة: قيمة_جسون.مصفوفة(فهرس_تشخيصات_الإجراء) };
    ليكن مداخل_الإجراء: متجه مدخل_كائن_جسون = [مدخل_عنوان_الإجراء, مدخل_نوع_الإجراء, مدخل_تشخيصات_الإجراء, مدخل_تفضيل_الإجراء, مدخل_تحرير_الإجراء];
    ليكن فهرس_كائن_الإجراء: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الإجراء: كائن_جسون = {
        المداخل: مداخل_الإجراء,
        الفهرس: فهرس_كائن_الإجراء
    };
    ألحق(*الكائنات, الإجراء);
    ألحق(*الإجراءات, قيمة_جسون.كائن(فهرس_الإجراء));
}

عام عرف ابن_رد_إجراءات_شفرة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    المطلوب: نطاق_تغيير_لغة,
    يسمح_إصلاح_سريع: منطقي,
    المجموعة: &مجموعة_تشخيصات,
    الإضافية: &متجه إجراء_بسيط_لغة
): وثيقة_جسون {
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن الإجراءات: متغير متجه قيمة_جسون = [];

    إذا (يسمح_إصلاح_سريع) {
        ليكن ج: مجموعة_تشخيصات = *المجموعة;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ج.التشخيصات) مثل طبيعي)) {
            ليكن مرجع_التشخيص: &تشخيص = &ج.التشخيصات[ف];
            ليكن ت: تشخيص = *مرجع_التشخيص;
            إذا (تشخيص_يتقاطع_مع_نطاق_إجراء_لغة(المستند, المطلوب, &ت)) {
                ليكن ص: متغير طبيعي = 0;
                طالما (ص < (الطول(ت.الإصلاحات) مثل طبيعي)) {
                    أضف_إصلاح_كإجراء_شفرة(
                        &متغير الكائنات,
                        &متغير المصفوفات,
                        &متغير الإجراءات,
                        المستند,
                        &ت,
                        &ت.الإصلاحات[ص]
                    );
                    ص := ص + 1;
                }
            };
            ف := ف + 1;
        }
    };

    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*الإضافية) مثل طبيعي)) {
        أضف_إجراء_بسيط_كإجراء_شفرة(
            &متغير الكائنات, &متغير المصفوفات, &متغير الإجراءات, المستند, &(*الإضافية)[س]
        );
        س := س + 1;
    }

    ليكن فهرس_الإجراءات: طبيعي = الطول(المصفوفات) مثل طبيعي;
    ليكن مصفوفة_الإجراءات: مصفوفة_جسون = { القيم: الإجراءات };
    ألحق(المصفوفات, مصفوفة_الإجراءات);
    ليكن فهرس_الجذر: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_نسخة_رد_الإجراءات: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «jsonrpc», القيمة: قيمة_نسخة_رد_الإجراءات };
    ليكن قيمة_معرف_رد_الإجراءات: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_معرف_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «id», القيمة: قيمة_معرف_رد_الإجراءات };
    ليكن قيمة_نتيجة_رد_الإجراءات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الإجراءات);
    ليكن مدخل_نتيجة_رد_الإجراءات: مدخل_كائن_جسون = { المفتاح: «result», القيمة: قيمة_نتيجة_رد_الإجراءات };
    ليكن مداخل_رد_الإجراءات: متجه مدخل_كائن_جسون = [مدخل_نسخة_رد_الإجراءات, مدخل_معرف_رد_الإجراءات, مدخل_نتيجة_رد_الإجراءات];
    ليكن فهرس_كائن_رد_الإجراءات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = {
        المداخل: مداخل_رد_الإجراءات,
        الفهرس: فهرس_كائن_رد_الإجراءات
    };
    ليكن كائنات_الناتج: متغير متجه كائن_جسون = الكائنات;
    ألحق(كائنات_الناتج, الجذر);
    ليكن قيمة_جذر_رد_الإجراءات: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_رد_الإجراءات,
        المصفوفات: المصفوفات,
        الكائنات: كائنات_الناتج
    };
    أرجع الوثيقة;
}

// A refactoring or LSP-side quick fix as a CodeAction with a WorkspaceEdit.
عرف أضف_إجراء_بسيط_كإجراء_شفرة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    الإجراءات: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    الإجراء: &إجراء_بسيط_لغة
): فراغ {
    ليكن قيم_التحريرات: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الإجراء).التعديلات) مثل طبيعي)) {
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_إجراء_شفرة(الكائنات, (*الإجراء).التعديلات[ف].النطاق);
        ليكن فهرس_التحرير: طبيعي = الطول(*الكائنات) مثل طبيعي;
        ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_جسون.كائن(فهرس_النطاق) };
        ليكن مدخل_النص: مدخل_كائن_جسون = { المفتاح: «newText», القيمة: قيمة_جسون.سلسلة(استنسخ(&(*الإجراء).التعديلات[ف].النص)) };
        ليكن مداخل: متجه مدخل_كائن_جسون = [مدخل_النطاق, مدخل_النص];
        ليكن فهرس_الخريطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن التحرير: كائن_جسون = { المداخل: مداخل, الفهرس: فهرس_الخريطة };
        ألحق(*الكائنات, التحرير);
        ألحق(قيم_التحريرات, قيمة_جسون.كائن(فهرس_التحرير));
        ف := ف + 1;
    }
    ليكن فهرس_التحريرات: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن مصفوفة_التحريرات: مصفوفة_جسون = { القيم: قيم_التحريرات };
    ألحق(*المصفوفات, مصفوفة_التحريرات);

    ليكن فهرس_التغييرات: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن مدخل_المستند: مدخل_كائن_جسون = { المفتاح: استنسخ(&(*المستند).العنوان), القيمة: قيمة_جسون.مصفوفة(فهرس_التحريرات) };
    ليكن مداخل_التغييرات: متجه مدخل_كائن_جسون = [مدخل_المستند];
    ليكن خريطة_التغييرات: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن التغييرات: كائن_جسون = { المداخل: مداخل_التغييرات, الفهرس: خريطة_التغييرات };
    ألحق(*الكائنات, التغييرات);

    ليكن فهرس_المساحة: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن مدخل_التغييرات: مدخل_كائن_جسون = { المفتاح: «changes», القيمة: قيمة_جسون.كائن(فهرس_التغييرات) };
    ليكن مداخل_المساحة: متجه مدخل_كائن_جسون = [مدخل_التغييرات];
    ليكن خريطة_المساحة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن تحرير_المساحة: كائن_جسون = { المداخل: مداخل_المساحة, الفهرس: خريطة_المساحة };
    ألحق(*الكائنات, تحرير_المساحة);

    ليكن فهرس_الإجراء: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن مدخل_العنوان: مدخل_كائن_جسون = { المفتاح: «title», القيمة: قيمة_جسون.سلسلة(استنسخ(&(*الإجراء).العنوان)) };
    ليكن مدخل_النوع: مدخل_كائن_جسون = { المفتاح: «kind», القيمة: قيمة_جسون.سلسلة(استنسخ(&(*الإجراء).النوع)) };
    ليكن مدخل_التفضيل: مدخل_كائن_جسون = { المفتاح: «isPreferred», القيمة: قيمة_جسون.منطق((*الإجراء).مفضل) };
    ليكن مدخل_التحرير: مدخل_كائن_جسون = { المفتاح: «edit», القيمة: قيمة_جسون.كائن(فهرس_المساحة) };
    ليكن مداخل_الإجراء: متجه مدخل_كائن_جسون = [مدخل_العنوان, مدخل_النوع, مدخل_التفضيل, مدخل_التحرير];
    ليكن خريطة_الإجراء: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = { المداخل: مداخل_الإجراء, الفهرس: خريطة_الإجراء };
    ألحق(*الكائنات, الكائن);
    ألحق(*الإجراءات, قيمة_جسون.كائن(فهرس_الإجراء));
}
