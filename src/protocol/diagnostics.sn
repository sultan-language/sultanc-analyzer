استورد sultanc_analyzer.protocol.model;
استورد sultanc_analyzer.protocol.text_document;
استورد sultanc_analyzer.workspace.documents;
استورد sultanc_analyzer.workspace.positions;
استورد std.json.value;
استورد std.collections.text_index_map;
استورد std.text.number;
استورد std.text.compare;
استورد std.fs.path;
استورد std.text.transform;
استورد compiler.source.source_file;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.message;
استورد compiler.diagnostics.suggestions;
استورد std.encoding.positions;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.keys.surface;

// تمثيل LSP فقط. إحداثيات المصدر تأتي من Frontend، وتحويل UTF-16 يأتي من std.
نوع نطاق_تشخيص_لغة = {
    البداية: موضع_تغيير_لغة,
    النهاية: موضع_تغيير_لغة
};

عام عرف مصدر_تشخيص_للمستند(
    المصدر: &نطاق_مصدر_تشخيص,
    المستند: &مستند_لغة_مفتوح
): منطقي {
    ليكن س: نطاق_مصدر_تشخيص = *المصدر;
    ليكن د: مستند_لغة_مفتوح = *المستند;
    طابق س.اسم_المصدر مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(الاسم) -> {
        طابق د.مسار_الملف مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(المسار) -> {
            أرجع مساران_لنفس_الملف_لغة(&الاسم, &المسار);
        };
    };
}

عام عرف نطاق_تشخيص_إلى_لغة(
    المصدر: &نطاق_مصدر_تشخيص,
    المستند: &مستند_لغة_مفتوح
): اختياري نطاق_تشخيص_لغة {
    ليكن س: نطاق_مصدر_تشخيص = *المصدر;
    ليكن البداية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن النهاية: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    // The compiler's own LSP positions (0-based line, UTF-16 column) when it
    // has them; byte offsets are mapped only for a span without them.
    طابق استنسخ(&س.بداية_يوتيف16) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(ب) -> {
        طابق استنسخ(&س.نهاية_يوتيف16) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(ن) -> {
            ليكن الناتج_المباشر: نطاق_تشخيص_لغة = {
                البداية: { السطر: ب.السطر, المحرف: ب.العمود },
                النهاية: { السطر: ن.السطر, المحرف: ن.العمود }
            };
            أرجع اختياري.موجود(الناتج_المباشر);
        };
    };
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, (س.النطاق.البداية.البايت مثل طبيعي)) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { البداية := الموضع; };
    // A lexer span over a non-ASCII character can end inside its UTF-8
    // sequence (start 26, end 27 for a 4-byte `𝒳`); the end then moves to
    // the end of that character.
    ليكن بايت_النهاية: متغير طبيعي = س.النطاق.النهاية.البايت مثل طبيعي;
    ليكن طول_النص: طبيعي = الطول((*المستند).النص) مثل طبيعي;
    طالما (بايت_النهاية < طول_النص && (((*المستند).النص[بايت_النهاية] مثل طبيعي) & 0xC0) == 0x80) {
        بايت_النهاية := بايت_النهاية + 1;
    }
    طابق إزاحة_بايت_إلى_موضع_لغة(المستند, بايت_النهاية) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { النهاية := الموضع; };
    ليكن الناتج: نطاق_تشخيص_لغة = { البداية: البداية, النهاية: النهاية };
    أرجع اختياري.موجود(الناتج);
}

عرف شدة_تشخيص_إلى_رقم_لغة(الشدة: شدة_تشخيص): نص {
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> { أرجع «1»; }
    | شدة_تشخيص.تحذير -> { أرجع «2»; }
    | شدة_تشخيص.ملاحظة -> { أرجع «3»; };
}

عرف أضف_موضع_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    الموضع: موضع_تغيير_لغة
): طبيعي {
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن نص_سطر_الموضع: نص = طبيعي_إلى_نص(الموضع.السطر);
    ليكن قيمة_سطر_الموضع: قيمة_جسون = قيمة_جسون.رقم(نص_سطر_الموضع);
    ليكن مدخل_سطر_الموضع: مدخل_كائن_جسون = {
        المفتاح: «line»,
        القيمة: قيمة_سطر_الموضع
    };
    ليكن نص_محرف_الموضع: نص = طبيعي_إلى_نص(الموضع.المحرف);
    ليكن قيمة_محرف_الموضع: قيمة_جسون = قيمة_جسون.رقم(نص_محرف_الموضع);
    ليكن مدخل_محرف_الموضع: مدخل_كائن_جسون = {
        المفتاح: «character»,
        القيمة: قيمة_محرف_الموضع
    };
    ليكن مداخل_موضع_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_سطر_الموضع,
        مدخل_محرف_الموضع
    ];
    ليكن فهرس_موضع_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = {
        المداخل: مداخل_موضع_التشخيص,
        الفهرس: فهرس_موضع_التشخيص
    };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عرف أضف_نطاق_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    النطاق: نطاق_تشخيص_لغة
): طبيعي {
    ليكن البداية: طبيعي = أضف_موضع_تشخيص_لغة(الكائنات, النطاق.البداية);
    ليكن النهاية: طبيعي = أضف_موضع_تشخيص_لغة(الكائنات, النطاق.النهاية);
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن قيمة_بداية_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(البداية);
    ليكن مدخل_بداية_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «start»,
        القيمة: قيمة_بداية_نطاق_التشخيص
    };
    ليكن قيمة_نهاية_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(النهاية);
    ليكن مدخل_نهاية_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «end»,
        القيمة: قيمة_نهاية_نطاق_التشخيص
    };
    ليكن مداخل_نطاق_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_بداية_نطاق_التشخيص,
        مدخل_نهاية_نطاق_التشخيص
    ];
    ليكن فهرس_نطاق_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = {
        المداخل: مداخل_نطاق_التشخيص,
        الفهرس: فهرس_نطاق_التشخيص
    };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عرف أضف_معلومة_مرتبطة_بتشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    القيم: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المرتبط: &نطاق_مرتبط_بتشخيص
): فراغ {
    ليكن ر: نطاق_مرتبط_بتشخيص = *المرتبط;
    إذا (!مصدر_تشخيص_للمستند(&ر.المصدر, المستند)) { أرجع; };
    طابق نطاق_تشخيص_إلى_لغة(&ر.المصدر, المستند) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(النطاق) -> {
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
        ليكن د: مستند_لغة_مفتوح = *المستند;
        ليكن مرجع_عنوان_موقع_التشخيص: &نص = &د.العنوان;
        ليكن عنوان_موقع_التشخيص: نص = *مرجع_عنوان_موقع_التشخيص;
        ليكن فهرس_الموقع: طبيعي = الطول(*الكائنات) مثل طبيعي;
        ليكن قيمة_عنوان_موقع_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&عنوان_موقع_التشخيص));
        ليكن مدخل_عنوان_موقع_التشخيص: مدخل_كائن_جسون = {
            المفتاح: «uri»,
            القيمة: قيمة_عنوان_موقع_التشخيص
        };
        ليكن قيمة_نطاق_موقع_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
        ليكن مدخل_نطاق_موقع_التشخيص: مدخل_كائن_جسون = {
            المفتاح: «range»,
            القيمة: قيمة_نطاق_موقع_التشخيص
        };
        ليكن مداخل_موقع_التشخيص: متجه مدخل_كائن_جسون = [
            مدخل_عنوان_موقع_التشخيص,
            مدخل_نطاق_موقع_التشخيص
        ];
        ليكن فهرس_كائن_موقع_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن الموقع: كائن_جسون = {
            المداخل: مداخل_موقع_التشخيص,
            الفهرس: فهرس_كائن_موقع_التشخيص
        };
        ألحق(*الكائنات, الموقع);
        ليكن فهرس_المعلومة: طبيعي = الطول(*الكائنات) مثل طبيعي;
        ليكن قيمة_موقع_المعلومة_المرتبطة: قيمة_جسون = قيمة_جسون.كائن(فهرس_الموقع);
        ليكن مدخل_موقع_المعلومة_المرتبطة: مدخل_كائن_جسون = {
            المفتاح: «location»,
            القيمة: قيمة_موقع_المعلومة_المرتبطة
        };
        ليكن لغة_رسالة_المعلومة: لغة_تشخيص = لغة_تشخيص.الإنجليزية();
        ليكن نص_رسالة_المعلومة: نص = صياغة_دور_نطاق(لغة_رسالة_المعلومة, ر.الدور);
        ليكن قيمة_رسالة_المعلومة_المرتبطة: قيمة_جسون = قيمة_جسون.سلسلة(نص_رسالة_المعلومة);
        ليكن مدخل_رسالة_المعلومة_المرتبطة: مدخل_كائن_جسون = {
            المفتاح: «message»,
            القيمة: قيمة_رسالة_المعلومة_المرتبطة
        };
        ليكن مداخل_المعلومة_المرتبطة: متجه مدخل_كائن_جسون = [
            مدخل_موقع_المعلومة_المرتبطة,
            مدخل_رسالة_المعلومة_المرتبطة
        ];
        ليكن فهرس_كائن_المعلومة_المرتبطة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
        ليكن المعلومة: كائن_جسون = {
            المداخل: مداخل_المعلومة_المرتبطة,
            الفهرس: فهرس_كائن_المعلومة_المرتبطة
        };
        ألحق(*الكائنات, المعلومة);
        ألحق(*القيم, قيمة_جسون.كائن(فهرس_المعلومة));
    };
}

عرف أضف_كائن_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المداخل: متجه مدخل_كائن_جسون
): طبيعي {
    ليكن الفهرس: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن فهرس_الكائن: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الكائن: كائن_جسون = { المداخل: المداخل, الفهرس: فهرس_الكائن };
    ألحق(*الكائنات, الكائن);
    أرجع الفهرس;
}

عرف أضف_مصفوفة_بيانات_تشخيص_لغة(
    المصفوفات: &متغير متجه مصفوفة_جسون,
    القيم: متجه قيمة_جسون
): طبيعي {
    ليكن الفهرس: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق(*المصفوفات, المصفوفة);
    أرجع الفهرس;
}

عرف صياغة_قيمة_حجة_تشخيص_لغة(
    القيمة: &قيمة_حجة_تشخيص,
    اللغة: لغة_تشخيص
): نص {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع استنسخ(&النص); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        طابق اللغة مع
        | لغة_تشخيص.الإنجليزية -> { أرجع استنسخ(&الإنجليزية); }
        | لغة_تشخيص.العربية -> { أرجع استنسخ(&العربية); };
    }
    | قيمة_حجة_تشخيص.طبيعية(العدد) -> { أرجع طبيعي_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> { أرجع عدد_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        إذا (القيمة_المنطقية) { أرجع «true»; };
        أرجع «false»;
    }
    // Typed reasons and compiler text keys are worded by iSpeak in the selected language.
    | قيمة_حجة_تشخيص.سبب(السبب) -> { أرجع رسالة_تشخيص(اللغة, مفتاح_رسالة_تشخيص.سبب(السبب)); }
    | قيمة_حجة_تشخيص.نص_مترجم(المفتاح) -> { أرجع نص_المترجم(اللغة, المفتاح); };
}

عرف اسم_مفتاح_حجة_تشخيص_لغة(المفتاح: مفتاح_حجة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_حجة_تشخيص.القيمة -> { أرجع «value»; }
    | مفتاح_حجة_تشخيص.المتوقع -> { أرجع «expected»; }
    | مفتاح_حجة_تشخيص.الاستبدال -> { أرجع «replacement»; }
    | مفتاح_حجة_تشخيص.الموجود -> { أرجع «found»; }
    | مفتاح_حجة_تشخيص.الفهرس -> { أرجع «index»; }
    | مفتاح_حجة_تشخيص.الطول -> { أرجع «length»; }
    | مفتاح_حجة_تشخيص.المجال -> { أرجع «range»; }
    | مفتاح_حجة_تشخيص.النمط -> { أرجع «pattern»; }
    | مفتاح_حجة_تشخيص.المسار -> { أرجع «path»; }
    | مفتاح_حجة_تشخيص.الرمز -> { أرجع «symbol»; }
    | مفتاح_حجة_تشخيص.النوع -> { أرجع «type»; }
    | مفتاح_حجة_تشخيص.السياق -> { أرجع «context»; }
    | مفتاح_حجة_تشخيص.المرحلة -> { أرجع «phase»; }
    | مفتاح_حجة_تشخيص.الهدف -> { أرجع «target»; }
    | مفتاح_حجة_تشخيص.الدالة -> { أرجع «function»; }
    | مفتاح_حجة_تشخيص.الكتلة -> { أرجع «block»; }
    | مفتاح_حجة_تشخيص.التعليمة -> { أرجع «instruction»; }
    | مفتاح_حجة_تشخيص.العملية -> { أرجع «operation»; }
    | مفتاح_حجة_تشخيص.البدائي -> { أرجع «primitive»; }
    | مفتاح_حجة_تشخيص.المصدر -> { أرجع «source»; }
    | مفتاح_حجة_تشخيص.الوجهة -> { أرجع «destination»; }
    | مفتاح_حجة_تشخيص.السبب -> { أرجع «reason»; };
}

عرف اسم_دور_نطاق_تشخيص_لغة(الدور: دور_نطاق_تشخيص): نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع «primary»; }
    | دور_نطاق_تشخيص.مصرح_هنا -> { أرجع «declared-here»; }
    | دور_نطاق_تشخيص.استخدام_غير_صالح -> { أرجع «invalid-use»; }
    | دور_نطاق_تشخيص.أصل_النقل -> { أرجع «move-origin»; }
    | دور_نطاق_تشخيص.أصل_التحرير -> { أرجع «release-origin»; }
    | دور_نطاق_تشخيص.المالك_الأصلي -> { أرجع «original-owner»; }
    | دور_نطاق_تشخيص.استعارة_متعارضة -> { أرجع «conflicting-borrow»; }
    | دور_نطاق_تشخيص.موضع_متوقع -> { أرجع «expected-location»; }
    | دور_نطاق_تشخيص.اكتشاف_المحلل -> { أرجع «parser-found»; }
    | دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> { أرجع «misplaced-semicolon»; }
    | دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة -> { أرجع «semicolon-destination»; }
    | دور_نطاق_تشخيص.عبارة_بلا_عملية -> { أرجع «statement-without-operation»; }
    | دور_نطاق_تشخيص.نمط_غير_قابل_للوصول -> { أرجع «unreachable-pattern»; }
    | دور_نطاق_تشخيص.تغطية_نمط_سابقة -> { أرجع «previous-pattern-coverage»; }
    | دور_نطاق_تشخيص.سياق_مرتبط -> { أرجع «related-context»; }
    | دور_نطاق_تشخيص.استدعاء_وقت_الترجمة -> { أرجع «comptime-call-site»; }
    | دور_نطاق_تشخيص.تصريح_غير_قابل_للتغيير -> { أرجع «immutable-declaration»; }
    | دور_نطاق_تشخيص.مضمن_من -> { أرجع «included-from»; }
    | دور_نطاق_تشخيص.تصريح_سابق -> { أرجع «previous-declaration»; };
}

عرف قيمة_حجة_تشخيص_إلى_جسون_لغة(
    الحجة: &حجة_تشخيص,
    اللغة: لغة_تشخيص
): قيمة_جسون {
    ليكن ح: حجة_تشخيص = *الحجة;
    طابق ح.القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع قيمة_جسون.سلسلة(استنسخ(&النص)); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        ليكن النص: نص = صياغة_قيمة_حجة_تشخيص_لغة(&ح.القيمة, اللغة);
        أرجع قيمة_جسون.سلسلة(النص);
    }
    | قيمة_حجة_تشخيص.طبيعية(العدد) -> {
        أرجع قيمة_جسون.رقم(طبيعي_إلى_نص(العدد));
    }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> {
        أرجع قيمة_جسون.رقم(عدد_إلى_نص(العدد));
    }
    | قيمة_حجة_تشخيص.منطقية(القيمة) -> { أرجع قيمة_جسون.منطق(القيمة); }
    // Machine data stays language-neutral: a reason is its stable machine key.
    | قيمة_حجة_تشخيص.سبب(السبب) -> { أرجع قيمة_جسون.سلسلة(مفتاح_آلي_لسبب_تشخيص(السبب)); }
    | قيمة_حجة_تشخيص.نص_مترجم(_) -> {
        ليكن النص: نص = صياغة_قيمة_حجة_تشخيص_لغة(&ح.القيمة, اللغة);
        أرجع قيمة_جسون.سلسلة(النص);
    };
}

عرف أضف_حجج_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    الحجج: &متجه حجة_تشخيص,
    اللغة: لغة_تشخيص
): طبيعي {
    ليكن الحالة: متجه حجة_تشخيص = *الحجج;
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن المفتاح: نص = اسم_مفتاح_حجة_تشخيص_لغة(الحالة[ف].المفتاح);
        ليكن قيمة_المفتاح: قيمة_جسون = قيمة_جسون.سلسلة(المفتاح);
        ليكن مدخل_المفتاح: مدخل_كائن_جسون = { المفتاح: «key», القيمة: قيمة_المفتاح };
        ليكن قيمة_الحجة: قيمة_جسون = قيمة_حجة_تشخيص_إلى_جسون_لغة(&الحالة[ف], اللغة);
        ليكن مدخل_القيمة: مدخل_كائن_جسون = { المفتاح: «value», القيمة: قيمة_الحجة };
        ليكن تسمية_المفتاح: نص = صياغة_مفتاح_حجة(اللغة, الحالة[ف].المفتاح);
        ليكن قيمة_التسمية: قيمة_جسون = قيمة_جسون.سلسلة(تسمية_المفتاح);
        ليكن مدخل_التسمية: مدخل_كائن_جسون = { المفتاح: «label», القيمة: قيمة_التسمية };
        ليكن مداخل: متجه مدخل_كائن_جسون = [مدخل_المفتاح, مدخل_القيمة, مدخل_التسمية];
        ليكن فهرس: طبيعي = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_تعليقات_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    التعليقات: &متجه تعليق_تشخيص,
    اللغة: لغة_تشخيص
): طبيعي {
    ليكن الحالة: متجه تعليق_تشخيص = *التعليقات;
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن الرسالة: نص = صياغة_تشخيص(اللغة, الحالة[ف].المفتاح);
        ليكن قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        ليكن مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        ليكن فهرس_الحجج: طبيعي = أضف_حجج_إلى_بيانات_تشخيص_لغة(
            الكائنات, المصفوفات, &الحالة[ف].الحجج, اللغة
        );
        ليكن قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
        ليكن مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
        ليكن مداخل: متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_الحجج];
        ليكن فهرس: طبيعي = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_إصلاحات_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): طبيعي {
    ليكن ت: تشخيص = *التشخيص;
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ت.الإصلاحات) مثل طبيعي)) {
        ليكن مرجع_الإصلاح: &إصلاح_تشخيص = &ت.الإصلاحات[ف];
        ليكن ص: إصلاح_تشخيص = *مرجع_الإصلاح;
        ليكن الرسالة: نص = صياغة_تشخيص(اللغة, ص.المفتاح);
        ليكن قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        ليكن مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        ليكن مرجع_الاستبدال: &نص = &ص.الاستبدال;
        ليكن الاستبدال: نص = *مرجع_الاستبدال;
        ليكن قيمة_الاستبدال: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&الاستبدال));
        ليكن مدخل_الاستبدال: مدخل_كائن_جسون = { المفتاح: «replacement», القيمة: قيمة_الاستبدال };
        // Machine names as the compiler's JSON writes them (suggestions.sn):
        // "key" is the stable kind (`insert-semicolon`, `import-module`, ...).
        ليكن القابلية: نص = قابلية_إصلاح_آلية(ص.القابلية);
        ليكن قيمة_القابلية: قيمة_جسون = قيمة_جسون.سلسلة(القابلية);
        ليكن مدخل_القابلية: مدخل_كائن_جسون = { المفتاح: «applicability», القيمة: قيمة_القابلية };
        ليكن قيمة_المفتاح: متغير قيمة_جسون = قيمة_جسون.عدم();
        طابق نوع_اقتراح_آلي(ص.المفتاح) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النوع) -> { قيمة_المفتاح := قيمة_جسون.سلسلة(النوع); };
        ليكن مدخل_المفتاح: مدخل_كائن_جسون = { المفتاح: «key», القيمة: قيمة_المفتاح };
        ليكن مداخل: متغير متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_المفتاح, مدخل_الاستبدال, مدخل_القابلية];

        // حافظ على التعديلات المركبة كما أنتجها Diagnostics. `range` أدناه يبقى
        // التحرير الأساسي للتوافق، و`additionalEdits` يحمل بقية التحريرات.
        ليكن قيم_التعديلات_الإضافية: متغير متجه قيمة_جسون = [];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(ص.التعديلات_الإضافية) مثل طبيعي)) {
            ليكن مرجع_استبدال_التعديل: &نص = &ص.التعديلات_الإضافية[ت].الاستبدال;
            ليكن استبدال_التعديل: نص = *مرجع_استبدال_التعديل;
            ليكن قيمة_استبدال_التعديل: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&استبدال_التعديل));
            ليكن مدخل_استبدال_التعديل: مدخل_كائن_جسون = {
                المفتاح: «replacement»,
                القيمة: قيمة_استبدال_التعديل
            };
            ليكن مداخل_التعديل: متغير متجه مدخل_كائن_جسون = [مدخل_استبدال_التعديل];
            إذا (مصدر_تشخيص_للمستند(&ص.التعديلات_الإضافية[ت].المصدر, المستند)) {
                طابق نطاق_تشخيص_إلى_لغة(&ص.التعديلات_الإضافية[ت].المصدر, المستند) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(نطاق_التعديل) -> {
                    ليكن فهرس_نطاق_التعديل: طبيعي = أضف_نطاق_تشخيص_لغة(الكائنات, نطاق_التعديل);
                    ليكن قيمة_نطاق_التعديل: قيمة_جسون = قيمة_جسون.كائن(فهرس_نطاق_التعديل);
                    ليكن مدخل_نطاق_التعديل: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_نطاق_التعديل };
                    ألحق(مداخل_التعديل, مدخل_نطاق_التعديل);
                };
            };
            ليكن فهرس_التعديل: طبيعي = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل_التعديل);
            ألحق(قيم_التعديلات_الإضافية, قيمة_جسون.كائن(فهرس_التعديل));
            ت := ت + 1;
        }
        ليكن فهرس_التعديلات_الإضافية: طبيعي = أضف_مصفوفة_بيانات_تشخيص_لغة(
            المصفوفات, قيم_التعديلات_الإضافية
        );
        ليكن قيمة_التعديلات_الإضافية: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_التعديلات_الإضافية);
        ليكن مدخل_التعديلات_الإضافية: مدخل_كائن_جسون = {
            المفتاح: «additionalEdits»,
            القيمة: قيمة_التعديلات_الإضافية
        };
        ألحق(مداخل, مدخل_التعديلات_الإضافية);

        إذا (مصدر_تشخيص_للمستند(&ص.المصدر, المستند)) {
            طابق نطاق_تشخيص_إلى_لغة(&ص.المصدر, المستند) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(النطاق) -> {
                ليكن فهرس_النطاق: طبيعي = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
                ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
                ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
                ألحق(مداخل, مدخل_النطاق);
            };
        };
        ليكن فهرس: طبيعي = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_أثر_إلى_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    الأثر: &متجه مدخل_أثر_تشخيص,
    اللغة: لغة_تشخيص
): طبيعي {
    ليكن الحالة: متجه مدخل_أثر_تشخيص = *الأثر;
    ليكن القيم: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        ليكن الرسالة: نص = صياغة_تشخيص(اللغة, الحالة[ف].المفتاح);
        ليكن قيمة_الرسالة: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
        ليكن مدخل_الرسالة: مدخل_كائن_جسون = { المفتاح: «message», القيمة: قيمة_الرسالة };
        ليكن فهرس_الحجج: طبيعي = أضف_حجج_إلى_بيانات_تشخيص_لغة(
            الكائنات, المصفوفات, &الحالة[ف].الحجج, اللغة
        );
        ليكن قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
        ليكن مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
        ليكن مداخل: متغير متجه مدخل_كائن_جسون = [مدخل_الرسالة, مدخل_الحجج];
        طابق الحالة[ف].المصدر مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المصدر) -> {
            إذا (مصدر_تشخيص_للمستند(&المصدر, المستند)) {
                طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النطاق) -> {
                    ليكن فهرس_النطاق: طبيعي = أضف_نطاق_تشخيص_لغة(الكائنات, النطاق);
                    ليكن قيمة_النطاق: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
                    ليكن مدخل_النطاق: مدخل_كائن_جسون = { المفتاح: «range», القيمة: قيمة_النطاق };
                    ألحق(مداخل, مدخل_النطاق);
                };
            };
        };
        ليكن فهرس: طبيعي = أضف_كائن_بيانات_تشخيص_لغة(الكائنات, مداخل);
        ألحق(القيم, قيمة_جسون.كائن(فهرس));
        ف := ف + 1;
    }
    أرجع أضف_مصفوفة_بيانات_تشخيص_لغة(المصفوفات, القيم);
}

عرف أضف_بيانات_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): طبيعي {
    ليكن ت: تشخيص = *التشخيص;
    ليكن الدور: نص = اسم_دور_نطاق_تشخيص_لغة(ت.الدور_الرئيسي);
    ليكن قيمة_الدور: قيمة_جسون = قيمة_جسون.سلسلة(الدور);
    ليكن مدخل_الدور: مدخل_كائن_جسون = { المفتاح: «primaryRole», القيمة: قيمة_الدور };
    ليكن تسمية_الدور: نص = صياغة_دور_نطاق(اللغة, ت.الدور_الرئيسي);
    ليكن قيمة_تسمية_الدور: قيمة_جسون = قيمة_جسون.سلسلة(تسمية_الدور);
    ليكن مدخل_تسمية_الدور: مدخل_كائن_جسون = { المفتاح: «primaryRoleLabel», القيمة: قيمة_تسمية_الدور };
    ليكن فهرس_الحجج: طبيعي = أضف_حجج_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.الحجج, اللغة);
    ليكن قيمة_الحجج: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الحجج);
    ليكن مدخل_الحجج: مدخل_كائن_جسون = { المفتاح: «arguments», القيمة: قيمة_الحجج };
    ليكن فهرس_الملاحظات: طبيعي = أضف_تعليقات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.الملاحظات, اللغة);
    ليكن قيمة_الملاحظات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الملاحظات);
    ليكن مدخل_الملاحظات: مدخل_كائن_جسون = { المفتاح: «notes», القيمة: قيمة_الملاحظات };
    ليكن فهرس_المساعدة: طبيعي = أضف_تعليقات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, &ت.المساعدة, اللغة);
    ليكن قيمة_المساعدة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المساعدة);
    ليكن مدخل_المساعدة: مدخل_كائن_جسون = { المفتاح: «help», القيمة: قيمة_المساعدة };
    ليكن فهرس_الإصلاحات: طبيعي = أضف_إصلاحات_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, المستند, التشخيص, اللغة);
    ليكن قيمة_الإصلاحات: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الإصلاحات);
    ليكن مدخل_الإصلاحات: مدخل_كائن_جسون = { المفتاح: «fixes», القيمة: قيمة_الإصلاحات };
    ليكن فهرس_الأثر: طبيعي = أضف_أثر_إلى_بيانات_تشخيص_لغة(الكائنات, المصفوفات, المستند, &ت.الأثر, اللغة);
    ليكن قيمة_الأثر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_الأثر);
    ليكن مدخل_الأثر: مدخل_كائن_جسون = { المفتاح: «trace», القيمة: قيمة_الأثر };
    ليكن المداخل: متجه مدخل_كائن_جسون = [مدخل_الدور, مدخل_تسمية_الدور, مدخل_الحجج, مدخل_الملاحظات, مدخل_المساعدة, مدخل_الإصلاحات, مدخل_الأثر];
    أرجع أضف_كائن_بيانات_تشخيص_لغة(الكائنات, المداخل);
}

// "path:line:col" for a diagnostic located outside the current document.
عرف موقع_مصدر_خارجي_لغة(المصدر: &نطاق_مصدر_تشخيص): نص {
    ليكن الاسم: متغير نص = «<unknown>»;
    طابق استنسخ(&(*المصدر).اسم_المصدر) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
    طابق (*المصدر).بداية_العرض مع
    | اختياري.لا_شيء -> { أرجع الاسم; }
    | اختياري.موجود(الإحداثي) -> {
        ليكن أجزاء: متجه نص = [
            الاسم, «:», طبيعي_إلى_نص(الإحداثي.السطر مثل طبيعي),
            «:», طبيعي_إلى_نص(الإحداثي.العمود مثل طبيعي)
        ];
        ليكن الفاصل: نص = «»;
        أرجع صل_النصوص(&أجزاء, &الفاصل);
    };
}

عام عرف أضف_تشخيص_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    القيم: &متغير متجه قيمة_جسون,
    المستند: &مستند_لغة_مفتوح,
    التشخيص: &تشخيص,
    الخارجية: منطقي
): فراغ {
    ليكن ت: تشخيص = *التشخيص;
    ليكن موضع_تشخيص_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن موضع_تشخيص_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن نطاق_لغة: متغير نطاق_تشخيص_لغة = {
        البداية: موضع_تشخيص_فارغ_أ,
        النهاية: موضع_تشخيص_فارغ_ب
    };
    ليكن التعريف: تعريف_تشخيص = تعريف_التشخيص(ت.المعرف);
    // An error in another module (std, a dependency, an unopened project file)
    // still blocks this document's analysis. An open document names it at its
    // top as information (the error itself belongs to, and is reported on, its
    // own file), so the explorer marks only files that really contain errors.
    // Workspace reports leave it out: every file is analysed on its own there.
    ليكن موقع_خارجي: متغير اختياري نص = اختياري.لا_شيء();
    ليكن من_وحدة_أخرى: متغير منطقي = خطأ;
    طابق ت.المصدر_الرئيسي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المصدر) -> {
        إذا (!مصدر_تشخيص_للمستند(&المصدر, المستند)) {
            إذا (!الخارجية) { أرجع; };
            طابق التعريف.الشدة مع
            | شدة_تشخيص.خطأ -> { }
            | _ -> { أرجع; };
            موقع_خارجي := اختياري.موجود(موقع_مصدر_خارجي_لغة(&المصدر));
            من_وحدة_أخرى := صواب;
        } وإلا {
            طابق نطاق_تشخيص_إلى_لغة(&المصدر, المستند) مع
            | اختياري.لا_شيء -> { أرجع; }
            | اختياري.موجود(القيمة) -> { نطاق_لغة := القيمة; };
        };
    };

    ليكن فهرس_النطاق: طبيعي = أضف_نطاق_تشخيص_لغة(الكائنات, نطاق_لغة);
    ليكن لغة_العرض: متغير لغة_تشخيص = لغة_تشخيص.الإنجليزية();
    إذا (مستند_لغة_بالعربية(المستند)) { لغة_العرض := لغة_تشخيص.العربية(); };
    ليكن الرسالة: متغير نص = نص_رسالة_تشخيص(التشخيص, لغة_العرض);
    طابق موقع_خارجي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الموقع) -> {
        ليكن أجزاء: متجه نص = [الموقع, «: », استنسخ(&الرسالة)];
        ليكن الفاصل: نص = «»;
        الرسالة := صل_النصوص(&أجزاء, &الفاصل);
    };

    ليكن قيمة_نطاق_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_النطاق);
    ليكن مدخل_نطاق_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «range»,
        القيمة: قيمة_نطاق_التشخيص
    };
    ليكن نص_شدة_التشخيص: متغير نص = شدة_تشخيص_إلى_رقم_لغة(التعريف.الشدة);
    إذا (من_وحدة_أخرى) { نص_شدة_التشخيص := «3»; };
    ليكن قيمة_شدة_التشخيص: قيمة_جسون = قيمة_جسون.رقم(نص_شدة_التشخيص);
    ليكن مدخل_شدة_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «severity»,
        القيمة: قيمة_شدة_التشخيص
    };
    ليكن مرجع_كود_التشخيص: &نص = &التعريف.الكود;
    ليكن كود_التشخيص: نص = *مرجع_كود_التشخيص;
    ليكن قيمة_كود_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&كود_التشخيص));
    ليكن مدخل_كود_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «code»,
        القيمة: قيمة_كود_التشخيص
    };
    ليكن قيمة_مصدر_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«SultanC»);
    ليكن مدخل_مصدر_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «source»,
        القيمة: قيمة_مصدر_التشخيص
    };
    ليكن قيمة_رسالة_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(الرسالة);
    ليكن مدخل_رسالة_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «message»,
        القيمة: قيمة_رسالة_التشخيص
    };
    ليكن مداخل: متغير متجه مدخل_كائن_جسون = [
        مدخل_نطاق_التشخيص,
        مدخل_شدة_التشخيص,
        مدخل_كود_التشخيص,
        مدخل_مصدر_التشخيص,
        مدخل_رسالة_التشخيص
    ];

    ليكن فهرس_البيانات: طبيعي = أضف_بيانات_تشخيص_لغة(
        الكائنات, المصفوفات, المستند, التشخيص, لغة_العرض
    );
    ليكن قيمة_البيانات: قيمة_جسون = قيمة_جسون.كائن(فهرس_البيانات);
    ليكن مدخل_البيانات: مدخل_كائن_جسون = {
        المفتاح: «data»,
        القيمة: قيمة_البيانات
    };
    ألحق(مداخل, مدخل_البيانات);

    ليكن المرتبطة: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ت.النطاقات_المرتبطة) مثل طبيعي)) {
        أضف_معلومة_مرتبطة_بتشخيص_لغة(
            الكائنات, &متغير المرتبطة, المستند, &ت.النطاقات_المرتبطة[ف]
        );
        ف := ف + 1;
    }
    إذا ((الطول(المرتبطة) مثل طبيعي) > 0) {
        ليكن فهرس_المرتبطة: طبيعي = الطول(*المصفوفات) مثل طبيعي;
        ليكن مصفوفة_المرتبطة: مصفوفة_جسون = { القيم: المرتبطة };
        ألحق(*المصفوفات, مصفوفة_المرتبطة);
        ليكن قيمة_المعلومات_المرتبطة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_المرتبطة);
        ليكن مدخل_مرتبط: مدخل_كائن_جسون = {
            المفتاح: «relatedInformation»,
            القيمة: قيمة_المعلومات_المرتبطة
        };
        ألحق(مداخل, مدخل_مرتبط);
    };

    ليكن فهرس_التشخيص: طبيعي = الطول(*الكائنات) مثل طبيعي;
    ليكن فهرس_كائن_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن كائن_التشخيص: كائن_جسون = {
        المداخل: مداخل,
        الفهرس: فهرس_كائن_التشخيص
    };
    ألحق(*الكائنات, كائن_التشخيص);
    ألحق(*القيم, قيمة_جسون.كائن(فهرس_التشخيص));
}

عام نوع عناصر_تشخيصات_لغة = {
    الكائنات: متجه كائن_جسون,
    المصفوفات: متجه مصفوفة_جسون,
    فهرس_العناصر: طبيعي
};

// يبني عناصر Diagnostic داخل مخازن JSON مشتركة حتى تستطيع تقارير مساحة العمل
// جمع عدة ملفات من دون إعادة بناء نموذج تشخيص موازٍ.
عام عرف أضف_عناصر_تشخيصات_لغة(
    الكائنات: &متغير متجه كائن_جسون,
    المصفوفات: &متغير متجه مصفوفة_جسون,
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات,
    الخارجية: منطقي
): طبيعي {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن ج: مجموعة_تشخيصات = *المجموعة;
    ليكن قيم_التشخيصات: متغير متجه قيمة_جسون = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ج.التشخيصات) مثل طبيعي)) {
        أضف_تشخيص_لغة(
            الكائنات, المصفوفات, &متغير قيم_التشخيصات, &د, &ج.التشخيصات[ف], الخارجية
        );
        ف := ف + 1;
    }
    ليكن فهرس_العناصر: طبيعي = الطول(*المصفوفات) مثل طبيعي;
    ليكن مصفوفة_عناصر_التشخيصات: مصفوفة_جسون = { القيم: قيم_التشخيصات };
    ألحق(*المصفوفات, مصفوفة_عناصر_التشخيصات);
    أرجع فهرس_العناصر;
}

// يبني عناصر Diagnostic مرة واحدة ليستهلكها push و pull دون نسخ دلالة التشخيص.
عام عرف ابن_عناصر_تشخيصات_لغة(
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات
): عناصر_تشخيصات_لغة {
    ليكن الكائنات: متغير متجه كائن_جسون = [];
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = [];
    ليكن فهرس_العناصر: طبيعي = أضف_عناصر_تشخيصات_لغة(
        &متغير الكائنات, &متغير المصفوفات, المستند, المجموعة, صواب
    );
    ليكن الناتج: عناصر_تشخيصات_لغة = {
        الكائنات: الكائنات,
        المصفوفات: المصفوفات,
        فهرس_العناصر: فهرس_العناصر
    };
    أرجع الناتج;
}

عام عرف ابن_نشر_تشخيصات_مستند_لغة(
    المستند: &مستند_لغة_مفتوح,
    المجموعة: &مجموعة_تشخيصات
): وثيقة_جسون {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن العناصر: عناصر_تشخيصات_لغة = ابن_عناصر_تشخيصات_لغة(&د, المجموعة);
    ليكن مرجع_كائنات_العناصر: &متجه كائن_جسون = &العناصر.الكائنات;
    ليكن الكائنات: متغير متجه كائن_جسون = استنسخ(مرجع_كائنات_العناصر);
    ليكن مرجع_مصفوفات_العناصر: &متجه مصفوفة_جسون = &العناصر.المصفوفات;
    ليكن المصفوفات: متجه مصفوفة_جسون = *مرجع_مصفوفات_العناصر;
    ليكن فهرس_عناصر_التشخيصات: طبيعي = العناصر.فهرس_العناصر;

    ليكن مرجع_عنوان_معاملات_النشر: &نص = &د.العنوان;
    ليكن عنوان_معاملات_النشر: نص = *مرجع_عنوان_معاملات_النشر;
    ليكن إصدار_معاملات_النشر: عدد = د.الإصدار;
    ليكن فهرس_المعاملات: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_عنوان_معاملات_النشر: قيمة_جسون = قيمة_جسون.سلسلة(استنسخ(&عنوان_معاملات_النشر));
    ليكن مدخل_عنوان_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «uri»,
        القيمة: قيمة_عنوان_معاملات_النشر
    };
    ليكن نص_إصدار_معاملات_النشر: نص = عدد_إلى_نص(إصدار_معاملات_النشر);
    ليكن قيمة_إصدار_معاملات_النشر: قيمة_جسون = قيمة_جسون.رقم(نص_إصدار_معاملات_النشر);
    ليكن مدخل_إصدار_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «version»,
        القيمة: قيمة_إصدار_معاملات_النشر
    };
    ليكن قيمة_تشخيصات_معاملات_النشر: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_عناصر_التشخيصات);
    ليكن مدخل_تشخيصات_معاملات_النشر: مدخل_كائن_جسون = {
        المفتاح: «diagnostics»,
        القيمة: قيمة_تشخيصات_معاملات_النشر
    };
    ليكن مداخل_معاملات_النشر: متجه مدخل_كائن_جسون = [
        مدخل_عنوان_معاملات_النشر,
        مدخل_إصدار_معاملات_النشر,
        مدخل_تشخيصات_معاملات_النشر
    ];
    ليكن فهرس_كائن_معاملات_النشر: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن المعاملات: كائن_جسون = {
        المداخل: مداخل_معاملات_النشر,
        الفهرس: فهرس_كائن_معاملات_النشر
    };
    ألحق(الكائنات, المعاملات);
    ليكن فهرس_الجذر: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_نسخة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_إشعار_التشخيص
    };
    ليكن قيمة_طريقة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«textDocument/publishDiagnostics»);
    ليكن مدخل_طريقة_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «method»,
        القيمة: قيمة_طريقة_إشعار_التشخيص
    };
    ليكن قيمة_معاملات_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_المعاملات);
    ليكن مدخل_معاملات_إشعار_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «params»,
        القيمة: قيمة_معاملات_إشعار_التشخيص
    };
    ليكن مداخل_جذر_إشعار_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_إشعار_التشخيص,
        مدخل_طريقة_إشعار_التشخيص,
        مدخل_معاملات_إشعار_التشخيص
    ];
    ليكن فهرس_كائن_جذر_إشعار_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = {
        المداخل: مداخل_جذر_إشعار_التشخيص,
        الفهرس: فهرس_كائن_جذر_إشعار_التشخيص
    };
    ألحق(الكائنات, الجذر);
    ليكن قيمة_جذر_وثيقة_إشعار_التشخيص: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_إشعار_التشخيص,
        المصفوفات: استنسخ(&المصفوفات),
        الكائنات: الكائنات
    };
    أرجع الوثيقة;
}

عام عرف ابن_مسح_تشخيصات_مستند_لغة(العنوان: نص): وثيقة_جسون {
    ليكن قيم_مصفوفة_فارغة: متجه قيمة_جسون = [];
    ليكن مصفوفة_فارغة: مصفوفة_جسون = { القيم: قيم_مصفوفة_فارغة };
    ليكن قيمة_عنوان_معاملات_المسح: قيمة_جسون = قيمة_جسون.سلسلة(العنوان);
    ليكن مدخل_عنوان_معاملات_المسح: مدخل_كائن_جسون = {
        المفتاح: «uri»,
        القيمة: قيمة_عنوان_معاملات_المسح
    };
    ليكن قيمة_تشخيصات_معاملات_المسح: قيمة_جسون = قيمة_جسون.مصفوفة(0);
    ليكن مدخل_تشخيصات_معاملات_المسح: مدخل_كائن_جسون = {
        المفتاح: «diagnostics»,
        القيمة: قيمة_تشخيصات_معاملات_المسح
    };
    ليكن مداخل_معاملات_المسح: متجه مدخل_كائن_جسون = [
        مدخل_عنوان_معاملات_المسح,
        مدخل_تشخيصات_معاملات_المسح
    ];
    ليكن فهرس_كائن_معاملات_المسح: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن المعاملات: كائن_جسون = {
        المداخل: مداخل_معاملات_المسح,
        الفهرس: فهرس_كائن_معاملات_المسح
    };
    ليكن قيمة_نسخة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_مسح_التشخيص
    };
    ليكن قيمة_طريقة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.سلسلة(«textDocument/publishDiagnostics»);
    ليكن مدخل_طريقة_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «method»,
        القيمة: قيمة_طريقة_مسح_التشخيص
    };
    ليكن قيمة_معاملات_مسح_التشخيص: قيمة_جسون = قيمة_جسون.كائن(0);
    ليكن مدخل_معاملات_مسح_التشخيص: مدخل_كائن_جسون = {
        المفتاح: «params»,
        القيمة: قيمة_معاملات_مسح_التشخيص
    };
    ليكن مداخل_جذر_مسح_التشخيص: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_مسح_التشخيص,
        مدخل_طريقة_مسح_التشخيص,
        مدخل_معاملات_مسح_التشخيص
    ];
    ليكن فهرس_كائن_جذر_مسح_التشخيص: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = {
        المداخل: مداخل_جذر_مسح_التشخيص,
        الفهرس: فهرس_كائن_جذر_مسح_التشخيص
    };
    ليكن قيمة_جذر_وثيقة_مسح_التشخيص: قيمة_جسون = قيمة_جسون.كائن(1);
    ليكن مصفوفات_وثيقة_مسح_التشخيص: متجه مصفوفة_جسون = [مصفوفة_فارغة];
    ليكن كائنات_وثيقة_مسح_التشخيص: متجه كائن_جسون = [المعاملات, الجذر];
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_مسح_التشخيص,
        المصفوفات: مصفوفات_وثيقة_مسح_التشخيص,
        الكائنات: كائنات_وثيقة_مسح_التشخيص
    };
    أرجع الوثيقة;
}

// معاملات textDocument/diagnostic. resultId السابق اختياري حسب LSP pull diagnostics.
عام نوع طلب_تشخيص_مستند_لغة = {
    العنوان: نص,
    معرف_النتيجة_السابق: اختياري نص
};

عام عرف فك_طلب_تشخيص_مستند_لغة(
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): اختياري طلب_تشخيص_مستند_لغة {
    ليكن فهرس_المعاملات: متغير طبيعي = 0;
    طابق المعاملات مع
    | قيمة_جسون.كائن(ف) -> { فهرس_المعاملات := ف; }
    | _ -> { أرجع اختياري.لا_شيء(); };

    ليكن مفتاح_المستند: نص = «textDocument»;
    ليكن فهرس_المستند: متغير طبيعي = 0;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_المستند) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.كائن(ف) -> { فهرس_المستند := ف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن مفتاح_العنوان: نص = «uri»;
    ليكن العنوان: متغير نص = «»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المستند, &مفتاح_العنوان) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { العنوان := النص; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن السابق: متغير اختياري نص = اختياري.لا_شيء();
    ليكن مفتاح_السابق: نص = «previousResultId»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &مفتاح_السابق) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { السابق := اختياري.موجود(النص); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };

    ليكن الناتج: طلب_تشخيص_مستند_لغة = {
        العنوان: العنوان,
        معرف_النتيجة_السابق: السابق
    };
    أرجع اختياري.موجود(الناتج);
}

عام عرف معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة: طبيعي): نص {
    // أي overlay مفتوح قد يؤثر في وحدة أخرى؛ مراجعة مساحة العمل تبطل النتائج بأمان.
    أرجع طبيعي_إلى_نص(مراجعة_المساحة);
}

عام عرف هل_نتيجة_تشخيص_مستند_لغة_غير_متغيرة(
    مراجعة_المساحة: طبيعي,
    السابق: &اختياري نص
): منطقي {
    ليكن القيمة: اختياري نص = *السابق;
    طابق القيمة مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        ليكن الحالي: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
        أرجع نصان_متساويان(&المعرف, &الحالي);
    };
}

عام عرف ابن_رد_تشخيصات_كاملة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    المستند: &مستند_لغة_مفتوح,
    مراجعة_المساحة: طبيعي,
    المجموعة: &مجموعة_تشخيصات,
    الاستيرادات_الزائدة: &متجه نطاق_تغيير_لغة
): وثيقة_جسون {
    ليكن د: مستند_لغة_مفتوح = *المستند;
    ليكن العناصر: عناصر_تشخيصات_لغة = ابن_عناصر_تشخيصات_لغة(&د, المجموعة);
    ليكن مرجع_كائنات_العناصر: &متجه كائن_جسون = &العناصر.الكائنات;
    ليكن الكائنات: متغير متجه كائن_جسون = استنسخ(مرجع_كائنات_العناصر);
    ليكن مرجع_مصفوفات_العناصر: &متجه مصفوفة_جسون = &العناصر.المصفوفات;
    ليكن المصفوفات: متغير متجه مصفوفة_جسون = استنسخ(مرجع_مصفوفات_العناصر);
    ليكن فهرس_عناصر_التشخيصات: طبيعي = العناصر.فهرس_العناصر;
    // Unused imports from the compiler's import facts: Hint severity with the
    // Unnecessary tag (editors fade them). The compiler has no diagnostic code
    // for them, so none is invented.
    ليكن رسالة_زائد: متغير نص = «unused import»;
    إذا (مستند_لغة_بالعربية(المستند)) { رسالة_زائد := «استيراد غير مستخدم»; };
    ليكن ز: متغير طبيعي = 0;
    طالما (ز < (الطول(*الاستيرادات_الزائدة) مثل طبيعي)) {
        ليكن المدى: نطاق_تغيير_لغة = (*الاستيرادات_الزائدة)[ز];
        ليكن نطاق_التلميح: نطاق_تشخيص_لغة = { البداية: المدى.البداية, النهاية: المدى.النهاية };
        ليكن فهرس_النطاق: طبيعي = أضف_نطاق_تشخيص_لغة(&متغير الكائنات, نطاق_التلميح);
        ليكن فهرس_الوسوم: طبيعي = الطول(المصفوفات) مثل طبيعي;
        ليكن وسم: متجه قيمة_جسون = [قيمة_جسون.رقم(«1»)];
        ليكن مصفوفة_الوسوم: مصفوفة_جسون = { القيم: وسم };
        ألحق(المصفوفات, مصفوفة_الوسوم);
        ليكن مداخل_التلميح: متجه مدخل_كائن_جسون = [
            { المفتاح: «range», القيمة: قيمة_جسون.كائن(فهرس_النطاق) },
            { المفتاح: «severity», القيمة: قيمة_جسون.رقم(«4») },
            { المفتاح: «source», القيمة: قيمة_جسون.سلسلة(«SultanC») },
            { المفتاح: «message», القيمة: قيمة_جسون.سلسلة(استنسخ(&رسالة_زائد)) },
            { المفتاح: «tags», القيمة: قيمة_جسون.مصفوفة(فهرس_الوسوم) }
        ];
        ليكن فهرس_التلميح: طبيعي = الطول(الكائنات) مثل طبيعي;
        ليكن التلميح: كائن_جسون = { المداخل: مداخل_التلميح, الفهرس: أنشئ_خريطة_نص_فهرس() };
        ألحق(الكائنات, التلميح);
        ألحق(المصفوفات[فهرس_عناصر_التشخيصات].القيم, قيمة_جسون.كائن(فهرس_التلميح));
        ز := ز + 1;
    }

    ليكن فهرس_النتيجة: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_نوع_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.سلسلة(«full»);
    ليكن مدخل_نوع_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «kind»,
        القيمة: قيمة_نوع_نتيجة_التشخيص_الكاملة
    };
    ليكن نص_معرف_نتيجة_التشخيص_الكاملة: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
    ليكن قيمة_معرف_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.سلسلة(نص_معرف_نتيجة_التشخيص_الكاملة);
    ليكن مدخل_معرف_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «resultId»,
        القيمة: قيمة_معرف_نتيجة_التشخيص_الكاملة
    };
    ليكن قيمة_عناصر_نتيجة_التشخيص_الكاملة: قيمة_جسون = قيمة_جسون.مصفوفة(فهرس_عناصر_التشخيصات);
    ليكن مدخل_عناصر_نتيجة_التشخيص_الكاملة: مدخل_كائن_جسون = {
        المفتاح: «items»,
        القيمة: قيمة_عناصر_نتيجة_التشخيص_الكاملة
    };
    ليكن مداخل_نتيجة_التشخيص_الكاملة: متجه مدخل_كائن_جسون = [
        مدخل_نوع_نتيجة_التشخيص_الكاملة,
        مدخل_معرف_نتيجة_التشخيص_الكاملة,
        مدخل_عناصر_نتيجة_التشخيص_الكاملة
    ];
    ليكن فهرس_كائن_نتيجة_التشخيص_الكاملة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن النتيجة: كائن_جسون = {
        المداخل: مداخل_نتيجة_التشخيص_الكاملة,
        الفهرس: فهرس_كائن_نتيجة_التشخيص_الكاملة
    };
    ألحق(الكائنات, النتيجة);

    ليكن فهرس_الجذر: طبيعي = الطول(الكائنات) مثل طبيعي;
    ليكن قيمة_نسخة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_التشخيص_الكامل
    };
    ليكن قيمة_معرف_رد_التشخيص_الكامل: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_معرف_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_التشخيص_الكامل
    };
    ليكن قيمة_نتيجة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.كائن(فهرس_النتيجة);
    ليكن مدخل_نتيجة_رد_التشخيص_الكامل: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_التشخيص_الكامل
    };
    ليكن مداخل_رد_التشخيص_الكامل: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_التشخيص_الكامل,
        مدخل_معرف_رد_التشخيص_الكامل,
        مدخل_نتيجة_رد_التشخيص_الكامل
    ];
    ليكن فهرس_كائن_رد_التشخيص_الكامل: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = {
        المداخل: مداخل_رد_التشخيص_الكامل,
        الفهرس: فهرس_كائن_رد_التشخيص_الكامل
    };
    ألحق(الكائنات, الجذر);
    ليكن قيمة_جذر_وثيقة_رد_التشخيص_الكامل: قيمة_جسون = قيمة_جسون.كائن(فهرس_الجذر);
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_رد_التشخيص_الكامل,
        المصفوفات: استنسخ(&المصفوفات),
        الكائنات: الكائنات
    };
    أرجع الوثيقة;
}

عام عرف ابن_رد_تشخيصات_غير_متغيرة_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    مراجعة_المساحة: طبيعي
): وثيقة_جسون {
    ليكن قيمة_نوع_نتيجة_التشخيص_غير_المتغيرة: قيمة_جسون = قيمة_جسون.سلسلة(«unchanged»);
    ليكن مدخل_نوع_نتيجة_التشخيص_غير_المتغيرة: مدخل_كائن_جسون = {
        المفتاح: «kind»,
        القيمة: قيمة_نوع_نتيجة_التشخيص_غير_المتغيرة
    };
    ليكن نص_معرف_نتيجة_التشخيص_غير_المتغيرة: نص = معرف_نتيجة_تشخيص_مستند_لغة(مراجعة_المساحة);
    ليكن قيمة_معرف_نتيجة_التشخيص_غير_المتغيرة: قيمة_جسون = قيمة_جسون.سلسلة(نص_معرف_نتيجة_التشخيص_غير_المتغيرة);
    ليكن مدخل_معرف_نتيجة_التشخيص_غير_المتغيرة: مدخل_كائن_جسون = {
        المفتاح: «resultId»,
        القيمة: قيمة_معرف_نتيجة_التشخيص_غير_المتغيرة
    };
    ليكن مداخل_نتيجة_التشخيص_غير_المتغيرة: متجه مدخل_كائن_جسون = [
        مدخل_نوع_نتيجة_التشخيص_غير_المتغيرة,
        مدخل_معرف_نتيجة_التشخيص_غير_المتغيرة
    ];
    ليكن فهرس_كائن_نتيجة_التشخيص_غير_المتغيرة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن النتيجة: كائن_جسون = {
        المداخل: مداخل_نتيجة_التشخيص_غير_المتغيرة,
        الفهرس: فهرس_كائن_نتيجة_التشخيص_غير_المتغيرة
    };
    ليكن قيمة_نسخة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.سلسلة(«2.0»);
    ليكن مدخل_نسخة_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «jsonrpc»,
        القيمة: قيمة_نسخة_رد_التشخيص_غير_المتغير
    };
    ليكن قيمة_معرف_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_معرف_طلب_جسون_اربيسي(المعرف);
    ليكن مدخل_معرف_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «id»,
        القيمة: قيمة_معرف_رد_التشخيص_غير_المتغير
    };
    ليكن قيمة_نتيجة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.كائن(0);
    ليكن مدخل_نتيجة_رد_التشخيص_غير_المتغير: مدخل_كائن_جسون = {
        المفتاح: «result»,
        القيمة: قيمة_نتيجة_رد_التشخيص_غير_المتغير
    };
    ليكن مداخل_رد_التشخيص_غير_المتغير: متجه مدخل_كائن_جسون = [
        مدخل_نسخة_رد_التشخيص_غير_المتغير,
        مدخل_معرف_رد_التشخيص_غير_المتغير,
        مدخل_نتيجة_رد_التشخيص_غير_المتغير
    ];
    ليكن فهرس_كائن_رد_التشخيص_غير_المتغير: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن الجذر: كائن_جسون = {
        المداخل: مداخل_رد_التشخيص_غير_المتغير,
        الفهرس: فهرس_كائن_رد_التشخيص_غير_المتغير
    };
    ليكن قيمة_جذر_وثيقة_رد_التشخيص_غير_المتغير: قيمة_جسون = قيمة_جسون.كائن(1);
    ليكن مصفوفات_وثيقة_رد_التشخيص_غير_المتغير: متجه مصفوفة_جسون = [];
    ليكن كائنات_وثيقة_رد_التشخيص_غير_المتغير: متجه كائن_جسون = [النتيجة, الجذر];
    ليكن الوثيقة: وثيقة_جسون = {
        الجذر: قيمة_جذر_وثيقة_رد_التشخيص_غير_المتغير,
        المصفوفات: مصفوفات_وثيقة_رد_التشخيص_غير_المتغير,
        الكائنات: كائنات_وثيقة_رد_التشخيص_غير_المتغير
    };
    أرجع الوثيقة;
}
