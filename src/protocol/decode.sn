استورد sultanc_analyzer.protocol.model;
استورد std.json.value;
استورد std.text.compare;

عام عرف معرف_طلب_من_قيمة_جسون(القيمة: قيمة_جسون): اختياري معرف_طلب_جسون_اربيسي {
    طابق القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        أرجع اختياري.موجود(معرف_طلب_جسون_اربيسي.رقم(النص));
    }
    | قيمة_جسون.سلسلة(النص) -> {
        أرجع اختياري.موجود(معرف_طلب_جسون_اربيسي.سلسلة(النص));
    }
    | قيمة_جسون.عدم -> {
        أرجع اختياري.موجود(معرف_طلب_جسون_اربيسي.عدم());
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف فك_رسالة_جسون_اربيسي(
    الوثيقة: &وثيقة_جسون
): نتيجة رسالة_جسون_اربيسي, خطأ_فك_رسالة_جسون_اربيسي {
    ليكن فهرس_الجذر: متغير طبيعي = 0;
    طابق جذر_وثيقة_جسون(الوثيقة) مع
    | قيمة_جسون.كائن(الفهرس) -> { فهرس_الجذر := الفهرس; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الجذر_ليس_كائنا()); };

    ليكن مفتاح_الإصدار: نص = «jsonrpc»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_الإصدار) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_مفقود());
    }
    | اختياري.موجود(القيمة) -> {
        ليكن الإصدار_المتوقع: نص = «2.0»;
        طابق القيمة مع
        | قيمة_جسون.سلسلة(الإصدار) -> {
            إذا (!نصان_متساويان(&الإصدار, &الإصدار_المتوقع)) {
                أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_غير_صالح());
            };
        }
        | _ -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.إصدار_جسون_اربيسي_غير_صالح());
        };
    };

    ليكن مفتاح_الطريقة: نص = «method»;
    ليكن الطريقة: متغير نص = «»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_الطريقة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الطريقة_مفقودة());
    }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_جسون.سلسلة(النص) -> { الطريقة := النص; }
        | _ -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.الطريقة_ليست_نصا());
        };
    };

    // غياب id يعني notification. وجود null يبقى RequestID صالحا حسب JSON-RPC 2.0.
    ليكن المعرف: متغير اختياري معرف_طلب_جسون_اربيسي = اختياري.لا_شيء();
    ليكن مفتاح_المعرف: نص = «id»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_المعرف) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق معرف_طلب_من_قيمة_جسون(القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_فك_رسالة_جسون_اربيسي.المعرف_غير_صالح());
        }
        | اختياري.موجود(القيمة_المحللة) -> {
            المعرف := اختياري.موجود(القيمة_المحللة);
        };
    };

    ليكن المعاملات: متغير اختياري قيمة_جسون = اختياري.لا_شيء();
    ليكن مفتاح_المعاملات: نص = «params»;
    طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_الجذر, &مفتاح_المعاملات) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> { المعاملات := اختياري.موجود(القيمة); };

    ليكن الرسالة: رسالة_جسون_اربيسي = {
        الطريقة: الطريقة,
        المعرف: المعرف,
        المعاملات: المعاملات
    };
    أرجع نتيجة.نجح(الرسالة);
}
