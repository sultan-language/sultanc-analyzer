        ليكن النطاق: اختياري نطاق_تغيير_لغة = نطاق_إعادة_تسمية_دلالي_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        ليكن الرد: وثيقة_جسون = ابن_رد_تهيئة_إعادة_تسمية_لغة(المعرف, &النطاق);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
