        | قيمة_جسون.كائن(فهرس_المعاملات) -> {
            ليكن المفتاح: نص = «previousResultId»;
            طابق قيمة_مفتاح_جسون(الوثيقة, فهرس_المعاملات, &المفتاح) مع
            | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { المعرف_السابق := النص; }
            | _ -> { };
        }
        | _ -> { };
    };
    ليكن الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن مرجع_العنوان: &نص = &الطلب.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
