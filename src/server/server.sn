عرف أجب_طلب_إعادة_تسمية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_إعادة_تسمية_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ, الاسم_الجديد: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_إعادة_تسمية_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن مرجع_العنوان: &نص = &الطلب.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&العنوان), الموضع: الطلب.الموضع };
    طابق جهز_طلب_دلالي_لغة(المساحة, الجذور, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن الناقصة: متجه نص = مستوردون_ناقصون_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        إذا ((الطول(الناقصة) مثل طبيعي) > 0) {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, رسالة_ملفات_ناقصة_لغة(&السياق.المستند, &الناقصة, صواب));
        };
        طابق خطة_إعادة_تسمية_دلالية_لغة(
            &السياق.اللقطة, &السياق.المستند, الطلب.الموضع, &الطلب.الاسم_الجديد
        ) مع
        | نتيجة_خطة_إعادة_تسمية_لغة.جاهزة(المواقع) -> {
            ليكن الرد: وثيقة_جسون = ابن_رد_إعادة_تسمية_دلالية_لغة(
                المعرف, &المواقع, &الطلب.الاسم_الجديد
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        }
        | نتيجة_خطة_إعادة_تسمية_لغة.مرفوضة(السبب) -> {
            طابق السبب مع
            | رفض_إعادة_تسمية_دلالي.تهجئة_غير_صالحة -> {
                أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid SultanC identifier»);
            }
            | رفض_إعادة_تسمية_دلالي.تعارض_اسم -> {
                طابق وصف_تعارض_إعادة_تسمية_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع, &الطلب.الاسم_الجديد) مع
                | اختياري.موجود(الوصف) -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, الوصف); }
                | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Rename would collide with an existing binding»); };
            }
            | رفض_إعادة_تسمية_دلالي.رمز_غير_قابل_لإعادة_التسمية -> {
                أرجع ارسل_خطأ_لغة(المعرف, -32602, «Symbol cannot be renamed»);
            }
            | رفض_إعادة_تسمية_دلالي.لا_هدف -> {
                أرجع ارسل_خطأ_لغة(المعرف, -32602, «No semantic rename target»);
            };
        };
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}


