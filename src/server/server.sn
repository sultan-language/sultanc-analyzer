عرف أجب_طلب_علاقات_هرم_نوع_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي,
    عليا: منطقي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_عنصر_هرم_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_عنصر_هرم_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    // The prepared item identifies a source already represented by a canonical
    // compiler snapshot. Reuse document analysis here instead of forcing a full
    // workspace scan for a direct type-relation query.
    ليكن مرجع_عنوان_الطلب: &نص = &الطلب.العنوان;
    ليكن عنوان_الطلب: نص = *مرجع_عنوان_الطلب;
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = {
        العنوان: استنسخ(&عنوان_الطلب),
        الموضع: الطلب.الموضع
    };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        طابق السياق.اللقطة.الواجهة مع
        | اختياري.لا_شيء -> {
            ليكن الفارغ: متجه رمز_معلن_لغة = [];
            ليكن الرد_الفارغ: وثيقة_جسون = ابن_رد_علاقات_هرم_نوع_لغة(المعرف, &الفارغ);
            أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
        }
        | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
            ليكن العناصر: متغير متجه رمز_معلن_لغة = [];
            إذا (عليا) {
                العناصر := أنواع_عليا_هرمية_لغة(الواجهة, &السياق.المستند.العنوان, الطلب.الموضع);
            } وإلا {
                العناصر := أنواع_فرعية_هرمية_لغة(الواجهة, &السياق.المستند.العنوان, الطلب.الموضع);
            };
            ليكن الرد: وثيقة_جسون = ابن_رد_علاقات_هرم_نوع_لغة(المعرف, &العناصر);
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> {
        // TypeHierarchyItem may point at a related type in a closed source file.
        // Read that source through the workspace URI adapter, then analyze it using
        // the same compiler frontend/project roots and current open-document overlays.
        طابق مستند_لغة_للقراءة_من_عنوان(&الطلب.العنوان) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document cannot be read»); }
        | اختياري.موجود(المستند) -> {
            ليكن المسارات: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
            ليكن التحليل: متغير نتيجة_تحليل_واجهة_لغة = نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل();
            إذا ((الطول(المسارات) مثل طبيعي) > 0) {
                التحليل := حلل_واجهة_مستند_لغة_في_مشروع(المساحة, &المستند, &المسارات);
            } وإلا {
                التحليل := حلل_واجهة_مستند_لغة(المساحة, &المستند);
            };
            طابق التحليل مع
            | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
                أرجع ارسل_رد_عدم_لغة(المعرف);
            }
            | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
                طابق اللقطة.الواجهة مع
                | اختياري.لا_شيء -> {
                    ليكن الفارغ: متجه رمز_معلن_لغة = [];
                    ليكن الرد_الفارغ: وثيقة_جسون = ابن_رد_علاقات_هرم_نوع_لغة(المعرف, &الفارغ);
                    أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
                }
                | اختياري.موجود(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
                    ليكن العناصر: متغير متجه رمز_معلن_لغة = [];
                    إذا (عليا) {
                        العناصر := أنواع_عليا_هرمية_لغة(الواجهة, &المستند.العنوان, الطلب.الموضع);
                    } وإلا {
                        العناصر := أنواع_فرعية_هرمية_لغة(الواجهة, &المستند.العنوان, الطلب.الموضع);
                    };
                    ليكن الرد: وثيقة_جسون = ابن_رد_علاقات_هرم_نوع_لغة(المعرف, &العناصر);
                    أرجع ارسل_وثيقة_لغة(&الرد);
                };
            };
        };
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

عرف أجب_طلب_استدعاءات_هرمية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي,
    واردة: منطقي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_عنصر_هرم_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_عنصر_هرم_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن المسارات: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
    طابق حلل_مشروع_بذاكرة_لغة(الذاكرة, المساحة, &المسارات) مع
    | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Workspace cannot be analyzed»);
    }
    | نتيجة_تحليل_مشروع_لغة.مرفوضة(_) -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Workspace has semantic errors»);
    }
    | نتيجة_تحليل_مشروع_لغة.مكتملة(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن المجموعات: متغير متجه مجموعة_استدعاء_هرمي_لغة = [];
        إذا (واردة) {
            المجموعات := استدعاءات_واردة_هرمية_لغة(الواجهة, &الطلب.العنوان, الطلب.الموضع);
        } وإلا {
            المجموعات := استدعاءات_صادرة_هرمية_لغة(الواجهة, &الطلب.العنوان, الطلب.الموضع);
        };
        إذا (واردة) {
            ليكن الرد: وثيقة_جسون = ابن_رد_استدعاءات_واردة_هرمية_لغة(المعرف, &المجموعات);
            أرجع ارسل_وثيقة_لغة(&الرد);
        } وإلا {
            ليكن الرد: وثيقة_جسون = ابن_رد_استدعاءات_صادرة_هرمية_لغة(المعرف, &المجموعات);
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}

عرف أجب_طلب_تمييزات_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_موضع_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &الطلب) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن المراجع: متجه مرجع_دلالي_لغة = مراجع_دلالية_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع, صواب, صواب);
        ليكن المواقع: متغير متجه موقع_دلالي_لغة = [];
        ليكن الأنواع: متغير متجه طبيعي = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المراجع) مثل طبيعي)) {
            ألحق(المواقع, استنسخ(&المراجع[ف].الموقع));
            ألحق(الأنواع, نوع_تمييز_دور_لغة(المراجع[ف].الدور));
            ف := ف + 1;
        }
        ليكن الرد: وثيقة_جسون = ابن_رد_تمييزات_مستند_دلالية_لغة(المعرف, &المواقع, &الأنواع);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

عرف أجب_طلب_مراجع_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_مراجع_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ, يتضمن_التصريح: صواب };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مراجع_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن مرجع_العنوان: &نص = &الطلب.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&العنوان), الموضع: الطلب.الموضع };
    طابق جهز_طلب_دلالي_لغة(المساحة, الجذور, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن المواقع: متجه موقع_دلالي_لغة = ظهورات_دلالية_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع, الطلب.يتضمن_التصريح, خطأ);
        ليكن الرد: وثيقة_جسون = ابن_رد_مراجع_دلالية_لغة(المعرف, &المواقع);
        ليكن أرسل: منطقي = ارسل_وثيقة_لغة(&الرد);
        ليكن الناقصة: متجه نص = مستوردون_ناقصون_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        إذا ((الطول(الناقصة) مثل طبيعي) > 0) {
            ليكن الإشعار: وثيقة_جسون = ابن_إشعار_رسالة_لغة(2, رسالة_ملفات_ناقصة_لغة(&السياق.المستند, &الناقصة, خطأ));
            ارسل_وثيقة_لغة(&الإشعار);
        };
        أرجع أرسل;
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

