    ليكن الطلب: متغير طلب_موضع_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    ليكن النطاق: متغير نطاق_تغيير_لغة = { البداية: الموضع_الفارغ, النهاية: الموضع_الفارغ };
