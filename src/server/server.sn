    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &الطلب) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن التوقيع: متغير اختياري معلومات_توقيع_استدعاء_لغة = توقيع_استدعاء_دلالي_لغة(
            &السياق.اللقطة, &السياق.المستند, الطلب.الموضع
        );
        طابق التوقيع مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            طابق لقطة_سليمة_لمستند_لغة(&(*الذاكرة), &السياق.المستند.العنوان) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(السليمة) -> {
                طابق اربط_سطرا_بنسخة_سابقة_لغة(&السليمة.المستند, &السياق.المستند, الطلب.الموضع.السطر, صواب) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(السطر_السابق) -> {
                    ليكن الموضع_السابق: موضع_تغيير_لغة = { السطر: السطر_السابق, المحرف: الطلب.الموضع.المحرف };
                    التوقيع := توقيع_استدعاء_دلالي_لغة(&السليمة.اللقطة, &السليمة.المستند, الموضع_السابق);
                };
            };
        };
        ليكن الرد: وثيقة_جسون = ابن_رد_توقيع_استدعاء_دلالي_لغة(المعرف, &التوقيع);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// Import line under the cursor -> the imported module's file (start of file).
عرف موقع_استيراد_عند_موضع_لغة(
    اللقطة: &لقطة_تحليل_واجهة_لغة,
    المستند: &مستند_لغة_مفتوح,
    الموضع: موضع_تغيير_لغة
): اختياري موقع_دلالي_لغة {
    ليكن البايت: طبيعي;
    طابق موضع_لغة_إلى_إزاحة_بايت(المستند, الموضع) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
    ليكن الروابط: متجه رابط_بنيوي_لغة = روابط_استيراد_دلالية_لغة(اللقطة, المستند);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الروابط) مثل طبيعي)) {
        إذا ((الروابط[ف].البداية <= البايت) && (البايت <= الروابط[ف].النهاية)) {
            طابق مسار_إلى_عنوان_ملف(&الروابط[ف].المسار) مع
            | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
            | نتيجة.نجح(العنوان) -> {
                ليكن البداية: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
                ليكن النطاق: نطاق_تغيير_لغة = { البداية: البداية, النهاية: البداية };
                ليكن الموقع: موقع_دلالي_لغة = { العنوان: العنوان, النطاق: النطاق };
                أرجع اختياري.موجود(الموقع);
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أجب_طلب_تعريف_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_موضع_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &الطلب) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        // On an import's module path, definition is the module file itself
        // (the file the compiler resolved the import to).
        طابق موقع_استيراد_عند_موضع_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(موقع_الوحدة) -> {
            ليكن موقع_اختياري: اختياري موقع_دلالي_لغة = اختياري.موجود(موقع_الوحدة);
            ليكن رد_الوحدة: وثيقة_جسون = ابن_رد_تعريف_دلالي_لغة(المعرف, &موقع_اختياري);
            أرجع ارسل_وثيقة_لغة(&رد_الوحدة);
        };
        ليكن الموقع: اختياري موقع_دلالي_لغة = تعريف_دلالي_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        ليكن الرد: وثيقة_جسون = ابن_رد_تعريف_دلالي_لغة(المعرف, &الموقع);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

