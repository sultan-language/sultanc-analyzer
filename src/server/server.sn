    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        // While the text does not analyse cleanly, keep the last clean coloring
        // when the layout is unchanged, so highlighting does not flicker off.
        ليكن اللقطة_المستعملة: متغير لقطة_تحليل_واجهة_لغة = استنسخ(&السياق.اللقطة);
        ليكن المستند_المستعمل: متغير مستند_لغة_مفتوح = استنسخ(&السياق.المستند);
        إذا (لقطة_تحتاج_بديلا_لغة(&السياق.اللقطة)) {
            طابق لقطة_سليمة_لمستند_لغة(&(*الذاكرة), &السياق.المستند.العنوان) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(السليمة) -> {
                إذا (عدد_أسطر_مستند_لغة(&السليمة.المستند) == عدد_أسطر_مستند_لغة(&السياق.المستند)) {
                    اللقطة_المستعملة := استنسخ(&السليمة.اللقطة);
                    المستند_المستعمل := استنسخ(&السليمة.المستند);
                };
            };
        };
        ليكن الظهورات: متجه ظهور_مصنف_لغة = ظهورات_مصنفة_دلاليا_لغة(&اللقطة_المستعملة, &المستند_المستعمل);
        ليكن البيانات: متجه طبيعي = بيانات_رموز_دلالية_لغة(&الظهورات);
        ليكن السابقة: اختياري رموز_مرسلة_لغة = رموز_مرسلة_لمستند_لغة(&(*الذاكرة), &العنوان);
        ليكن معرف_النتيجة: نص = خزن_رموز_مرسلة_لغة(الذاكرة, &العنوان, &البيانات);
        إذا (فرق) {
            طابق السابقة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(القيمة) -> {
                إذا (نصان_متساويان(&القيمة.المعرف, &المعرف_السابق)) {
                    ليكن رد_الفرق: وثيقة_جسون = ابن_رد_فرق_رموز_دلالية_لغة(
                        المعرف, &القيمة.البيانات, &البيانات, &معرف_النتيجة
                    );
                    أرجع ارسل_وثيقة_لغة(&رد_الفرق);
                };
            };
        };
        ليكن الرد: وثيقة_جسون = ابن_رد_رموز_دلالية_بمعرف_لغة(المعرف, &البيانات, &معرف_النتيجة);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// Text-structure requests (folding, links, selection) need only the open text.
عرف أجب_طلب_بنية_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي,
    الصنف: طبيعي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    ليكن المواضع: متغير متجه موضع_تغيير_لغة = [];
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
        إذا (الصنف == 2) {
            طابق فك_مواضع_طلب_تحديد_لغة(الوثيقة, استنسخ(&المعاملات)) مع
            | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
            | اختياري.موجود(القيم) -> { المواضع := القيم; };
        };
    };
    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختياري.لا_شيء -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | اختياري.موجود(المستند) -> {
        إذا (الصنف == 0) {
            ليكن النطاقات: متجه نطاق_طي_بنيوي_لغة = نطاقات_طي_بنيوية_لغة(&المستند);
            ليكن الرد: وثيقة_جسون = ابن_رد_نطاقات_طي_لغة(المعرف, &النطاقات);
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
        إذا (الصنف == 3 || الصنف == 4) {
            ليكن المدى: متغير اختياري مدى_بايتات_تنسيق_لغة = اختياري.لا_شيء();
            إذا (الصنف == 4) {
                طابق استنسخ(&ر.المعاملات) مع
                | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
                | اختياري.موجود(المعاملات) -> {
                    طابق فك_نطاق_طلب_لغة(الوثيقة, المعاملات) مع
                    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
                    | اختياري.موجود(النطاق) -> {
                        ليكن البداية: متغير طبيعي = 0;
                        ليكن النهاية: متغير طبيعي = 0;
                        طابق موضع_لغة_إلى_إزاحة_بايت(&المستند, النطاق.البداية) مع
                        | نتيجة.خطأ(_) -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid range»); }
                        | نتيجة.نجح(القيمة) -> { البداية := القيمة; };
                        طابق موضع_لغة_إلى_إزاحة_بايت(&المستند, النطاق.النهاية) مع
                        | نتيجة.خطأ(_) -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid range»); }
                        | نتيجة.نجح(القيمة) -> { النهاية := القيمة; };
                        ليكن القيمة: مدى_بايتات_تنسيق_لغة = { البداية: البداية, النهاية: النهاية };
                        المدى := اختياري.موجود(القيمة);
                    };
                };
            };
            ليكن الرد: وثيقة_جسون = ابن_رد_تنسيق_لغة(المعرف, &المستند, المدى);
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
        // textDocument/onTypeFormatting: after `;` the line, after `}` the
        // block it closes (from the line of its `{`), formatted by the
        // compiler's range formatter exactly as `sultanc fmt` formats them.
        إذا (الصنف == 5) {
            ليكن الموضع: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
            ليكن المحرف: متغير نص = «»;
            طابق استنسخ(&ر.المعاملات) مع
            | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
            | اختياري.موجود(المعاملات) -> {
                طابق فهرس_كائن_جسون(المعاملات) مع
                | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
                | اختياري.موجود(الفهرس) -> {
                    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «position») مع
                    | اختياري.موجود(القيمة) -> {
                        طابق فك_موضع_تغيير_لغة(الوثيقة, القيمة) مع
                        | اختياري.موجود(م) -> { الموضع := م; }
                        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); };
                    }
                    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); };
                    طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «ch») مع
                    | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { المحرف := النص; }
                    | _ -> { };
                };
            };
            ليكن الإزاحة: متغير طبيعي = 0;
            طابق موضع_لغة_إلى_إزاحة_بايت(&المستند, الموضع) مع
            | نتيجة.خطأ(_) -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid position»); }
            | نتيجة.نجح(القيمة) -> { الإزاحة := القيمة; };
            إذا (الإزاحة == 0) { أرجع ارسل_رد_عدم_لغة(المعرف); };
            ليكن البداية: متغير طبيعي = الإزاحة - 1;
            إذا (نصان_متساويان(&المحرف, &«}»)) {
                ليكن الأزواج: متجه زوج_أقواس_لغة = أزواج_أقواس_لغة(&المستند.النص);
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الأزواج) مثل طبيعي)) {
                    إذا (الأزواج[ف].الإغلاق == الإزاحة - 1) { البداية := الأزواج[ف].الفتح; };
                    ف := ف + 1;
                }
            } وإلا إذا (!نصان_متساويان(&المحرف, &«;»)) {
                أرجع ارسل_رد_عدم_لغة(المعرف);
            };
            // From the start of that line.
            طالما (البداية > 0 && المستند.النص[البداية - 1] != 0x0A) { البداية := البداية - 1; }
            ليكن المدى: مدى_بايتات_تنسيق_لغة = { البداية: البداية, النهاية: الإزاحة };
            ليكن الرد: وثيقة_جسون = ابن_رد_تنسيق_لغة(المعرف, &المستند, اختياري.موجود(المدى));
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
        ليكن الرد: وثيقة_جسون = ابن_رد_نطاقات_تحديد_لغة(المعرف, &المستند, &المواضع);
        أرجع ارسل_وثيقة_لغة(&الرد);
    };
}

عرف أجب_طلب_رموز_مستند_دلالية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن مرجع_العنوان: &نص = &الطلب.العنوان;
    ليكن العنوان: نص = *مرجع_العنوان;
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&العنوان), الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن الرموز: متجه رمز_معلن_لغة = رموز_مستند_دلالية_لغة(&السياق.اللقطة, &السياق.المستند);
        ليكن الرد: وثيقة_جسون = ابن_رد_رموز_مستند_دلالية_لغة(المعرف, &الرموز);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

عرف أجب_طلب_اختبارات_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&الطلب.العنوان), الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن الاختبارات: متجه اختبار_مستند_لغة = اختبارات_مستند_لغة(&السياق.اللقطة, &السياق.المستند);
        ليكن الرد: وثيقة_جسون = ابن_رد_اختبارات_لغة(المعرف, &السياق.المستند, &الاختبارات);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// `sultanc/packageGraph`: { graph } for a file in a Supax package (the graph
// with that package as root, for `sultanc test --package-graph=-`), else null.
عرف أجب_طلب_مخطط_حزم_لغة(
    المساحة: &مساحة_عمل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    طابق مستند_لغة_للقراءة_من_عنوان(&الطلب.العنوان) مع
    | اختياري.لا_شيء -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | اختياري.موجود(المستند) -> {
        طابق استنسخ(&المستند.مسار_الملف) مع
        | اختياري.لا_شيء -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
        | اختياري.موجود(المسار) -> {
            طابق نص_مخطط_لمسار_لغة(المساحة, &المسار) مع
            | اختياري.لا_شيء -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
            | اختياري.موجود(النص) -> {
                ليكن الرد: وثيقة_جسون = ابن_رد_مخطط_حزم_لغة(المعرف, &النص);
                أرجع ارسل_وثيقة_لغة(&الرد);
            };
        };
    };
}

عرف أجب_طلب_رموز_مساحة_عمل_دلالية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الاستعلام: متغير نص = «»;
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_استعلام_رموز_مساحة_عمل_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الاستعلام := القيمة; };
    };
    // الاستعلام الفارغ لا يبرر تحليل مساحة العمل كاملة. مواصفة LSP تسمح برد
    // فارغ، والعمل الحقيقي يبدأ عندما يرسل العميل نص البحث الفعلي.
    إذا ((الطول(الاستعلام) مثل طبيعي) == 0) {
        ليكن الرموز_الفارغة: متجه رمز_معلن_لغة = [];
        ليكن الرد_الفارغ: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز_الفارغة);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    };
    // A project with errors is analysed with every module that binds
    // (tooling-api.md "Partial results"), so symbols are answered as usual.
    ليكن المسارات: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
    طابق حلل_مشروع_بذاكرة_لغة(الذاكرة, المساحة, &المسارات) مع
    | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Workspace cannot be analyzed»);
    }
    | نتيجة_تحليل_مشروع_لغة.مرفوضة(_) -> {
        ليكن الرموز_الفارغة: متجه رمز_معلن_لغة = [];
        ليكن الرد_الفارغ: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز_الفارغة);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    }
    | نتيجة_تحليل_مشروع_لغة.مكتملة(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن جميع_الرموز: متجه رمز_معلن_لغة = رموز_واجهة_مشروع_دلالية_لغة(الواجهة);
        ليكن الرموز: متغير متجه رمز_معلن_لغة = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(جميع_الرموز) مثل طبيعي)) {
            ليكن مرجع_الرمز: &رمز_معلن_لغة = &جميع_الرموز[ف];
            ليكن الرمز: رمز_معلن_لغة = *مرجع_الرمز;
            إذا (يطابق_استعلام_رمز_لغة(&الرمز.الاسم, &الاستعلام)) {
                ألحق(الرموز, استنسخ(&الرمز));
            };
            ف := ف + 1;
        }
        ليكن الرد: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز);
        أرجع ارسل_وثيقة_لغة(&الرد);
    };
}

عرف طبق_إشعار_مستند(
    المساحة: &متغير مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي
): فراغ {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المعاملات) -> {
        إذا (الطريقة_هي(&ر.الطريقة, «textDocument/didOpen»)) {
            طابق فك_فتح_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
            | اختياري.موجود(فتح) -> {
                ليكن مرجع_عنوان_الفتح: &نص = &فتح.العنوان;
                ليكن عنوان_الفتح: نص = *مرجع_عنوان_الفتح;
                ليكن عنوان_النشر: نص = *مرجع_عنوان_الفتح;
                ليكن مرجع_لغة_الفتح: &نص = &فتح.اللغة;
                ليكن لغة_الفتح: نص = *مرجع_لغة_الفتح;
                ليكن مرجع_نص_الفتح: &نص = &فتح.النص;
                ليكن نص_الفتح: نص = *مرجع_نص_الفتح;
                ليكن إصدار_الفتح: عدد = فتح.الإصدار;
                إذا (افتح_مستند_لغة(
                    المساحة,
                    استنسخ(&عنوان_الفتح),
                    استنسخ(&لغة_الفتح),
                    إصدار_الفتح,
                    استنسخ(&نص_الفتح)
                )) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &عنوان_النشر);
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع;
        };
        إذا (الطريقة_هي(&ر.الطريقة, «textDocument/didChange»)) {
            طابق فك_تغيير_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
            | اختياري.موجود(تغيير) -> {
                إذا (طبق_تغييرات_مستند_لغة(المساحة, &تغيير)) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &تغيير.العنوان);
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع;
        };
        إذا (الطريقة_هي(&ر.الطريقة, «textDocument/didSave»)) {
            طابق فك_حفظ_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
            | اختياري.موجود(حفظ) -> {
                إذا (احفظ_مستند_لغة(المساحة, &حفظ.العنوان, &حفظ.النص)) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &حفظ.العنوان);
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع;
        };
        إذا (الطريقة_هي(&ر.الطريقة, «textDocument/didClose»)) {
            طابق فك_إغلاق_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
            | اختياري.موجود(إغلاق) -> {
                ليكن مرجع_عنوان_الإغلاق: &نص = &إغلاق.العنوان;
                ليكن عنوان_الإغلاق: نص = *مرجع_عنوان_الإغلاق;
                ليكن عنوان_المسح: نص = *مرجع_عنوان_الإغلاق;
                إذا (اغلق_مستند_لغة(المساحة, &عنوان_الإغلاق)) {
                    امسح_تشخيصات_مستند_لغة(استنسخ(&عنوان_المسح));
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع;
        };
    };
}

عام عرف شغل_خادم_لغة_سلطان(): عدد {
    ليكن الحالة: متغير حالة_خادم_لغة = حالة_خادم_لغة.قبل_التهيئة();
    ليكن المساحة: متغير مساحة_عمل_لغة = مساحة_عمل_لغة_جديدة();
    ليكن الجذور: متغير جذور_مساحة_عمل_لغة = جذور_مساحة_عمل_لغة_جديدة();
    ليكن ذاكرة_التحليل: متغير ذاكرة_تحليل_لغة = ذاكرة_تحليل_لغة_جديدة();
    ليكن المجدول: متغير مجدول_طلبات_لغة = مجدول_طلبات_جديد_لغة();
    ليكن الفحص: متغير حالة_فحص_لغة = حالة_فحص_جديدة_لغة();
    ليكن العدسات: متغير إعداد_عدسات_لغة = إعداد_عدسات_افتراضي_لغة();
    ليكن مستمر: متغير منطقي = صواب;
    ليكن رمز_الخروج: متغير عدد = 0;

    طالما (مستمر) {
        ليكن جسم: متغير نص = «»;
        طابق الإطار_التالي_لغة(&متغير المجدول) مع
        | نتيجة_قراءة_إطار_لغة.نهاية -> { مستمر := خطأ; }
        | نتيجة_قراءة_إطار_لغة.إطار(النص) -> { جسم := النص; }
        | _ -> {
            ارسل_خطأ_بلا_معرف(-32700, «Parse error»);
            رمز_الخروج := 1;
            مستمر := خطأ;
        };
        إذا (!مستمر) { }
        وإلا {
            طابق حلل_جسون(&جسم) مع
            | نتيجة.خطأ(_) -> {
                ارسل_خطأ_بلا_معرف(-32700, «Parse error»);
            }
            | نتيجة.نجح(الوثيقة) -> {
                طابق فك_رسالة_جسون_اربيسي(&الوثيقة) مع
                | نتيجة.خطأ(_) -> {
                    ارسل_خطأ_بلا_معرف(-32600, «Invalid Request»);
                }
                | نتيجة.نجح(الرسالة) -> {
                    // This request is now the running one: the reader thread
                    // cancels its token on $/cancelRequest or a change of its
                    // document, and every build of it checks that token.
                    ليكن عنوان_الطلب: متغير اختياري نص = اختياري.لا_شيء();
                    طابق استنسخ(&الرسالة.المعاملات) مع
                    | اختياري.موجود(المعاملات) -> {
                        طابق فك_طلب_مستند_لغة(&الوثيقة, المعاملات) مع
                        | اختياري.موجود(الطلب) -> { عنوان_الطلب := اختياري.موجود(استنسخ(&الطلب.العنوان)); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
