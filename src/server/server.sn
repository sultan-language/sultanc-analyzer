عرف الطريقة_هي(الطريقة: &نص, المطلوب: نص): منطقي {
    ليكن القيمة: نص = المطلوب;
    أرجع نصان_متساويان(الطريقة, &القيمة);
}

عرف مسارات_جذور_مشروع_لغة(الجذور: &جذور_مساحة_عمل_لغة): متجه نص {
    ليكن الحالة: جذور_مساحة_عمل_لغة = *الجذور;
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المجلدات) مثل طبيعي)) {
        ليكن مرجع_المجلد: &مجلد_مساحة_عمل_لغة = &الحالة.المجلدات[ف];
        ليكن المجلد: مجلد_مساحة_عمل_لغة = *مرجع_المجلد;
        // A Supax folder's project is its root package's source root (the
        // first [[package]] of the graph); any other folder is itself. The
        // graph's `root` owns every input of a compilation, so dependencies
        // come in through their imports (analysis/frontend.sn
        // ابن_إعداد_مشروع_لغة).
        // A folder inside the root package's source root (a subfolder of the
        // package) stays the root.
        طابق استنسخ(&المجلد.المخطط) مع
        | اختياري.موجود(المخطط) -> {
            إذا ((الطول(المخطط.الحزم) مثل طبيعي) > 0) {
                ليكن جذر_الحزمة: نص = استنسخ(&المخطط.الحزم[0].الجذر);
                طابق المجلد.مسار_الملف مع
                | اختياري.موجود(المسار) -> {
                    إذا (داخل_المكتبة_القياسية_لغة(&المسار, &جذر_الحزمة)) { ألحق(الناتج, استنسخ(&المسار)); }
                    وإلا { ألحق(الناتج, جذر_الحزمة); };
                }
                | اختياري.لا_شيء -> { ألحق(الناتج, جذر_الحزمة); };
            };
        }
        | اختياري.لا_شيء -> {
            طابق المجلد.مسار_الملف مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المسار) -> { ألحق(الناتج, استنسخ(&المسار)); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Refreshes the package graphs and reports each failure as a warning.
عرف حدث_مخططات_وأبلغ_لغة(الجذور: &متغير جذور_مساحة_عمل_لغة, المساحة: &متغير مساحة_عمل_لغة): فراغ {
    ليكن الإخفاقات: متجه نص = حدث_مخططات_الحزم_لغة(الجذور);
    ليكن المخططات: متغير متجه مخطط_حزم_لغة = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول((*الجذور).المجلدات) مثل طبيعي)) {
        طابق استنسخ(&(*الجذور).المجلدات[م].المخطط) مع
        | اختياري.موجود(المخطط) -> { ألحق(المخططات, المخطط); }
        | اختياري.لا_شيء -> { };
        م := م + 1;
    }
    (*المساحة).المخططات := المخططات;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الإخفاقات) مثل طبيعي)) {
        سجل_لغة(استنسخ(&الإخفاقات[ف]));
        ليكن الإشعار: وثيقة_جسون = ابن_إشعار_رسالة_لغة(2, استنسخ(&الإخفاقات[ف]));
        ارسل_وثيقة_لغة(&الإشعار);
        ف := ف + 1;
    }
}

// textDocument/documentLink: each import's written path, linked to the file
// the compiler resolved it to.
عرف أجب_طلب_روابط_استيراد_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    ليكن الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&الطلب.العنوان), الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن الروابط: متجه رابط_بنيوي_لغة = روابط_استيراد_دلالية_لغة(&السياق.اللقطة, &السياق.المستند);
        ليكن الرد: وثيقة_جسون = ابن_رد_روابط_مستند_لغة(المعرف, &السياق.المستند, &الروابط);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// workspace/willRenameFiles: the import statements that name a moved `.sn`
// file, rewritten (TypeScript's updateImportsOnFileMove). Which statements
// import the file comes from the compiler (analysis/semantic_queries.sn
// تعديلات_استيراد_لنقل_ملف_لغة).
عرف أجب_طلب_نقل_ملفات_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن القديمة: متغير متجه نص = [];
    ليكن الجديدة: متغير متجه نص = [];
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فهرس_كائن_جسون(استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(الفهرس) -> {
            طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «files») مع
            | اختياري.موجود(قيمة_جسون.مصفوفة(المصفوفة)) -> {
                ليكن العدد: متغير طبيعي = 0;
                طابق طول_مصفوفة_جسون(الوثيقة, المصفوفة) مع
                | اختياري.موجود(ن) -> { العدد := ن; }
                | اختياري.لا_شيء -> { };
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < العدد) {
                    طابق عنصر_مصفوفة_جسون(الوثيقة, المصفوفة, ف) مع
                    | اختياري.موجود(قيمة_جسون.كائن(العنصر)) -> {
                        طابق (قيمة_حقل_جسون(الوثيقة, العنصر, «oldUri»)) مع
                        | اختياري.موجود(قيمة_جسون.سلسلة(القديم)) -> {
                            طابق قيمة_حقل_جسون(الوثيقة, العنصر, «newUri») مع
                            | اختياري.موجود(قيمة_جسون.سلسلة(الجديد)) -> {
                                طابق (عنوان_ملف_إلى_مسار(&القديم), عنوان_ملف_إلى_مسار(&الجديد)) مع
                                | (نتيجة.نجح(أ), نتيجة.نجح(ب)) -> {
                                    ليكن اللاحقة: نص = «.sn»;
                                    إذا (ينتهي_بـ(&أ, &اللاحقة)) { ألحق(القديمة, أ); ألحق(الجديدة, ب); };
                                }
                                | _ -> { };
                            }
                            | _ -> { };
                        }
                        | _ -> { };
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
            }
            | _ -> { };
        };
    };
    إذا ((الطول(القديمة) مثل طبيعي) == 0) { أرجع ارسل_رد_عدم_لغة(المعرف); };
    ليكن المسارات: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
    ليكن التعديلات: متغير متجه تعديل_استيراد_لغة = [];
    طابق حلل_مشروع_بذاكرة_لغة(الذاكرة, المساحة, &المسارات) مع
    | نتيجة_تحليل_مشروع_لغة.مكتملة(مشترك_الواجهة) -> {
        ليكن الواجهة: &نتيجة_واجهة_وحدة = اقرأ_مشترك(&مشترك_الواجهة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القديمة) مثل طبيعي)) {
            ليكن الحاصلة: متجه تعديل_استيراد_لغة = تعديلات_استيراد_لنقل_ملف_لغة(الواجهة, &القديمة[ف], &الجديدة[ف]);
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(الحاصلة) مثل طبيعي)) { ألحق(التعديلات, استنسخ(&الحاصلة[م])); م := م + 1; }
            ف := ف + 1;
        }
    }
    | _ -> { };
    إذا ((الطول(التعديلات) مثل طبيعي) == 0) { أرجع ارسل_رد_عدم_لغة(المعرف); };
    // {"changes":{uri:[{range,newText}]}}, one entry per importing file.
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"changes":{»);
    ليكن المكتوبة: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التعديلات) مثل طبيعي)) {
        ليكن المسار: نص = استنسخ(&التعديلات[ف].المسار);
        إذا (!نص_في_قائمة_لغة(&المكتوبة, &المسار)) {
            إذا ((الطول(المكتوبة) مثل طبيعي) > 0) { ألحق(الناتج, 0x2C); };
            ألحق(المكتوبة, استنسخ(&المسار));
            ليكن العنوان: متغير نص = استنسخ(&المسار);
            طابق مسار_إلى_عنوان_ملف(&المسار) مع
            | نتيجة.نجح(القيمة) -> { العنوان := القيمة; }
            | نتيجة.خطأ(_) -> { };
            ألحق_سلسلة_جسون_لغة(&متغير الناتج, &العنوان);
            ألحق_بايتات_نص(&متغير الناتج, «:[»);
            ليكن فهرس_السطور: فهرس_سطور = ابن_فهرس_السطور(&التعديلات[ف].المحتوى);
            ليكن الأولى: متغير منطقي = صواب;
            ليكن م: متغير طبيعي = ف;
            طالما (م < (الطول(التعديلات) مثل طبيعي)) {
                إذا (نصان_متساويان(&التعديلات[م].المسار, &المسار)) {
                    طابق (إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&التعديلات[م].المحتوى, &فهرس_السطور, التعديلات[م].البداية),
                          إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&التعديلات[م].المحتوى, &فهرس_السطور, التعديلات[م].النهاية)) مع
                    | (نتيجة.نجح(أ), نتيجة.نجح(ب)) -> {
                        إذا (!الأولى) { ألحق(الناتج, 0x2C); };
                        الأولى := خطأ;
                        ليكن أ_ل: موضع_تغيير_لغة = { السطر: أ.السطر, المحرف: أ.العمود };
                        ليكن ب_ل: موضع_تغيير_لغة = { السطر: ب.السطر, المحرف: ب.العمود };
                        ألحق_بايتات_نص(&متغير الناتج, «{"range":{"start":»);
                        ألحق_موضع_جسون_لغة(&متغير الناتج, أ_ل);
                        ألحق_بايتات_نص(&متغير الناتج, «,"end":»);
                        ألحق_موضع_جسون_لغة(&متغير الناتج, ب_ل);
                        ألحق_بايتات_نص(&متغير الناتج, «},"newText":»);
                        ألحق_سلسلة_جسون_لغة(&متغير الناتج, &التعديلات[م].الجديد);
                        ألحق(الناتج, 0x7D);
                    }
                    | _ -> { };
                };
                م := م + 1;
            }
            ألحق(الناتج, 0x5D);
        };
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير الناتج, «}}»);
    ليكن الرد: وثيقة_جسون = رد_من_نص_جسون_لغة(المعرف, &الناتج);
    أرجع ارسل_وثيقة_لغة(&الرد);
}

عرف نص_في_قائمة_لغة(القائمة: &متجه نص, النص: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القائمة)[ف], النص)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// ---- Code lenses (protocol/code_lens.sn) ------------------------------------

عرف أجب_طلب_عدسات_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي,
    الإعداد: &إعداد_عدسات_لغة
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    إذا (!(*الإعداد).التشغيل && !(*الإعداد).المراجع) {
        ليكن فارغ: متجه ط8 = [0x5B, 0x5D];
        ليكن الرد_الفارغ: وثيقة_جسون = رد_من_نص_جسون_لغة(المعرف, &فارغ);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    };
    ليكن الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&الطلب.العنوان), الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن الاختبارات: متغير متجه اختبار_مستند_لغة = [];
        إذا ((*الإعداد).التشغيل) { الاختبارات := اختبارات_مستند_لغة(&السياق.اللقطة, &السياق.المستند); };
        ليكن الرموز: متغير متجه رمز_معلن_لغة = [];
        إذا ((*الإعداد).المراجع) {
            الرموز := رموز_مستند_دلالية_لغة(&السياق.اللقطة, &السياق.المستند);
            إذا (!(*الإعداد).التشغيل) { الاختبارات := اختبارات_مستند_لغة(&السياق.اللقطة, &السياق.المستند); };
        };
        ليكن البدء: متغير اختياري طبيعي = اختياري.لا_شيء();
        إذا ((*الإعداد).التشغيل) { البدء := بدء_برنامج_مستند_لغة(&السياق.اللقطة, &السياق.المستند); };
        ليكن البايتات: متجه ط8 = عدسات_مستند_لغة(&السياق.المستند, &الاختبارات, &الرموز, البدء, الإعداد);
        ليكن الرد: وثيقة_جسون = رد_من_نص_جسون_لغة(المعرف, &البايتات);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// codeLens/resolve: the references lens's count, from the compiler's
// references of the declaration (the declaration itself not counted).
عرف أجب_طلب_حل_عدسة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن النطاق: متغير متجه ط8 = [];
    ليكن البيانات: متغير متجه ط8 = [];
    ليكن العنوان: متغير نص = «»;
    ليكن الموضع: متغير موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن صالح: متغير منطقي = خطأ;
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعاملات) -> {
        طابق فهرس_كائن_جسون(استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الفهرس) -> {
            طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «range») مع
            | اختياري.موجود(القيمة) -> { ألحق_قيمة_جسون_لغة(&متغير النطاق, الوثيقة, &القيمة); }
            | اختياري.لا_شيء -> { };
            طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «data») مع
            | اختياري.موجود(القيمة) -> {
                ألحق_قيمة_جسون_لغة(&متغير البيانات, الوثيقة, &القيمة);
                طابق فهرس_كائن_جسون(القيمة) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(فهرس_البيانات) -> {
                    طابق قيمة_حقل_جسون(الوثيقة, فهرس_البيانات, «uri») مع
                    | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { العنوان := النص; }
                    | _ -> { };
                    طابق قيمة_حقل_جسون(الوثيقة, فهرس_البيانات, «position») مع
                    | اختياري.موجود(قيمة_الموضع) -> {
                        طابق فك_موضع_تغيير_لغة(الوثيقة, قيمة_الموضع) مع
                        | اختياري.موجود(م) -> { الموضع := م; صالح := (الطول(العنوان) مثل طبيعي) > 0; }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        };
    };
    إذا (!صالح || (الطول(النطاق) مثل طبيعي) == 0) { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); };
    ليكن طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: استنسخ(&العنوان), الموضع: الموضع };
    طابق جهز_طلب_دلالي_لغة(المساحة, الجذور, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن المواقع: متجه موقع_دلالي_لغة = ظهورات_دلالية_لغة(&السياق.اللقطة, &السياق.المستند, الموضع, خطأ, خطأ);
        ليكن عربي: منطقي = مستند_لغة_بالعربية(&السياق.المستند);
        ليكن البايتات: متجه ط8 = عدسة_مراجع_محلولة_لغة(&النطاق, &البيانات, &العنوان, الموضع, &المواقع, عربي);
        ليكن الرد: وثيقة_جسون = رد_من_نص_جسون_لغة(المعرف, &البايتات);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_رد_عدم_لغة(المعرف); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
}

// ---- Check on save (workspace/flycheck.sn) ----------------------------------

عرف ارسل_نصا_لغة(النص: &نص): فراغ {
    طابق اكتب_إطار_لغة(النص) مع | _ -> { };
}

// window/logMessage (type 3, Info): shown in the server's output channel.
عرف سجل_للعميل_لغة(الرسالة: نص): فراغ {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «{"jsonrpc":"2.0","method":"window/logMessage","params":{"type":3,"message":»);
    ألحق_سلسلة_جسون_لغة(&متغير الناتج, &الرسالة);
    ألحق_بايتات_نص(&متغير الناتج, «}}»);
    ليكن النص: نص = من_بايتات(&الناتج);
    ارسل_نصا_لغة(&النص);
}

عرف مسار_مفتوح_لغة(المساحة: &مساحة_عمل_لغة, المسار: &نص): منطقي {
    طابق مستند_لغة_بالمسار(المساحة, المسار) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The `sultanc check` runs of a check: the `checkEntries` setting, else the
// entry Supax checks (src/main.sn or main.sn) of each workspace folder, or of
// the folder of its Supax.toml.
عرف أوامر_فحص_مساحة_لغة(
    الفحص: &حالة_فحص_لغة,
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة
): متجه أمر_فحص_لغة {
    ليكن المداخل: متغير متجه نص = [];
    ليكن الأول: متغير نص = «»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجذور).المجلدات) مثل طبيعي)) {
        طابق استنسخ(&(*الجذور).المجلدات[ف].مسار_الملف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المجلد) -> {
            إذا ((الطول(الأول) مثل طبيعي) == 0) { الأول := استنسخ(&المجلد); };
            إذا ((الطول((*الفحص).المداخل) مثل طبيعي) == 0) {
                ليكن مجلد_البحث: متغير نص = استنسخ(&المجلد);
                طابق استنسخ(&(*الجذور).المجلدات[ف].المخطط) مع
                | اختياري.موجود(المخطط) -> { مجلد_البحث := استنسخ(&المخطط.المجلد); }
                | اختياري.لا_شيء -> { };
                طابق مدخل_مجلد_فحص_لغة(&مجلد_البحث) مع
                | اختياري.موجود(المدخل) -> { ألحق(المداخل, المدخل); }
                | اختياري.لا_شيء -> { };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الفحص).المداخل) مثل طبيعي)) {
        ليكن المعطى: &نص = &(*الفحص).المداخل[ف];
        إذا (مسار_مطلق(المعطى)) { ألحق(المداخل, طبع_المسار(المعطى)); }
        وإلا إذا ((الطول(الأول) مثل طبيعي) > 0) {
            ليكن المضموم: نص = صل_المسار(&الأول, المعطى);
            ألحق(المداخل, طبع_المسار(&المضموم));
        };
        ف := ف + 1;
    }
    ليكن الناتج: متغير متجه أمر_فحص_لغة = [];
    ف := 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        ليكن مكرر: متغير منطقي = خطأ;
        ليكن م: متغير طبيعي = 0;
        طالما (م < ف) {
            إذا (نصان_متساويان(&المداخل[م], &المداخل[ف])) { مكرر := صواب; };
            م := م + 1;
        }
        إذا (!مكرر) {
            ليكن الدليل: متغير نص = استنسخ(&الأول);
            طابق أب_المسار(&المداخل[ف]) مع
            | اختياري.موجود(الأب) -> { الدليل := الأب; }
            | اختياري.لا_شيء -> { };
            ليكن الأمر: أمر_فحص_لغة = {
                الدليل: الدليل,
                المدخل: استنسخ(&المداخل[ف]),
                المخطط: نص_مخطط_لمسار_لغة(المساحة, &المداخل[ف])
            };
            ألحق(الناتج, الأمر);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف تفضيل_فحص_لغة(المساحة: &مساحة_عمل_لغة): طبيعي {
    طابق (*المساحة).تفضيل_لغة_العرض مع
    | تفضيل_لغة_عرض_لغة.الإنجليزية -> { أرجع 1; }
    | تفضيل_لغة_عرض_لغة.العربية -> { أرجع 2; }
    | تفضيل_لغة_عرض_لغة.تلقائي -> { أرجع 0; };
}

// Starts a check, or marks one to follow the running check.
عرف ابدأ_فحصا_لغة(
    الفحص: &متغير حالة_فحص_لغة,
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    المجدول: &متغير مجدول_طلبات_لغة
): فراغ {
    إذا (!(*الفحص).مفعل) { أرجع; };
    إذا ((*الفحص).يعمل) { (*الفحص).معلق := صواب; أرجع; };
    ليكن الأوامر: متجه أمر_فحص_لغة = أوامر_فحص_مساحة_لغة(الفحص, المساحة, الجذور);
    إذا ((الطول(الأوامر) مثل طبيعي) == 0) {
        إذا (!(*الفحص).أبلغ_بلا_مدخل) {
            (*الفحص).أبلغ_بلا_مدخل := صواب;
            سجل_للعميل_لغة(«check on save: no entry file (src/main.sn or main.sn); set "sultanc.check.entries"»);
        };
        أرجع;
    };
    ليكن القياسية: نص = دليل_المكتبة_القياسية_لغة();
    ليكن المترجم: نص = مسار_مترجم_الفحص_لغة(الفحص, &القياسية);
    (*الفحص).الجيل := (*الفحص).الجيل + 1;
    (*الفحص).يعمل := صواب;
    ليكن الأجزاء: متغير متجه نص = [«check on save: », استنسخ(&المترجم), « check»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأوامر) مثل طبيعي)) {
        ألحق(الأجزاء, « »);
        ألحق(الأجزاء, استنسخ(&الأوامر[ف].المدخل));
        ف := ف + 1;
    }
    سجل_للعميل_لغة(صل_النصوص(&الأجزاء, &«»));
    أطلق_فحصا_لغة(المجدول, المترجم, الأوامر, تفضيل_فحص_لغة(المساحة), (*الفحص).الجيل);
}

// A finished check: publish its diagnostics for every file that is not open,
// and clear the files it no longer reports.
عرف طبق_نتيجة_فحص_لغة(
    الفحص: &متغير حالة_فحص_لغة,
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    المجدول: &متغير مجدول_طلبات_لغة,
    الوثيقة: &وثيقة_جسون,
    المعاملات: قيمة_جسون
): فراغ {
    (*الفحص).يعمل := خطأ;
    طابق فهرس_كائن_جسون(المعاملات) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الفهرس) -> {
        ليكن الإنجليزي: متغير نص = «»;
        ليكن العربي: متغير نص = «»;
        ليكن الإخفاق: متغير نص = «»;
        طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «en») مع
        | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { الإنجليزي := النص; }
        | _ -> { };
        طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «ar») مع
        | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { العربي := النص; }
        | _ -> { };
        طابق قيمة_حقل_جسون(الوثيقة, الفهرس, «failure») مع
        | اختياري.موجود(قيمة_جسون.سلسلة(النص)) -> { الإخفاق := النص; }
        | _ -> { };
        إذا ((الطول(الإخفاق) مثل طبيعي) > 0) {
            سجل_للعميل_لغة(صل_نصين(&«check on save: », &الإخفاق));
        } وإلا {
            ليكن الجديدة: متجه ملف_فحص_لغة = ملفات_فحص_من_تقريرين_لغة(&الإنجليزي, &العربي, تفضيل_فحص_لغة(المساحة));
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الفحص).الملفات) مثل طبيعي)) {
                ليكن القديم: &ملف_فحص_لغة = &(*الفحص).الملفات[ف];
                ليكن باق: متغير منطقي = خطأ;
                ليكن م: متغير طبيعي = 0;
                طالما (م < (الطول(الجديدة) مثل طبيعي)) {
                    إذا (نصان_متساويان(&الجديدة[م].المسار, &(*القديم).المسار)) { باق := صواب; };
                    م := م + 1;
                }
                إذا (!باق && !مسار_مفتوح_لغة(المساحة, &(*القديم).المسار)) {
                    ليكن الإشعار: نص = إشعار_نشر_فحص_لغة(&(*القديم).العنوان, &«[]»);
                    ارسل_نصا_لغة(&الإشعار);
                };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول(الجديدة) مثل طبيعي)) {
                إذا (!مسار_مفتوح_لغة(المساحة, &الجديدة[ف].المسار)) {
                    ليكن الإشعار: نص = إشعار_نشر_فحص_لغة(&الجديدة[ف].العنوان, &الجديدة[ف].العناصر);
                    ارسل_نصا_لغة(&الإشعار);
                };
                ف := ف + 1;
            }
            ليكن الأجزاء: متجه نص = [«check on save: done, diagnostics in », طبيعي_إلى_نص(الطول(الجديدة) مثل طبيعي), « file(s)»];
            سجل_للعميل_لغة(صل_النصوص(&الأجزاء, &«»));
            (*الفحص).الملفات := الجديدة;
        };
    };
    إذا ((*الفحص).معلق) {
        (*الفحص).معلق := خطأ;
        ابدأ_فحصا_لغة(الفحص, المساحة, الجذور, المجدول);
    };
}

// After didSave / didOpen / didClose: a save of a source starts a check; an
// opened file drops its check diagnostics (its live ones replace them); a
// closed file gets them back.
عرف بعد_إشعار_مستند_للفحص_لغة(
    الفحص: &متغير حالة_فحص_لغة,
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    المجدول: &متغير مجدول_طلبات_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي
): فراغ {
    ليكن العنوان: متغير نص = «»;
    طابق استنسخ(&(*الرسالة).المعاملات) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, المعاملات) مع
        | اختياري.لا_شيء -> { أرجع; }
        | اختياري.موجود(الطلب) -> { العنوان := استنسخ(&الطلب.العنوان); };
    };
    إذا (الطريقة_هي(&(*الرسالة).الطريقة, «textDocument/didSave»)) {
        ليكن اللاحقة: نص = «.sn»;
        إذا (ينتهي_بـ(&العنوان, &اللاحقة)) { ابدأ_فحصا_لغة(الفحص, المساحة, الجذور, المجدول); };
        أرجع;
    };
    ليكن المسار: متغير نص = «»;
    طابق عنوان_ملف_إلى_مسار(&العنوان) مع
    | نتيجة.نجح(القيمة) -> { المسار := القيمة; }
    | نتيجة.خطأ(_) -> { أرجع; };
    طابق ملف_فحص_بالمسار_لغة(الفحص, &المسار) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الملف) -> {
        إذا (الطريقة_هي(&(*الرسالة).الطريقة, «textDocument/didOpen»)) {
            ليكن الإشعار: نص = إشعار_نشر_فحص_لغة(&الملف.العنوان, &«[]»);
            ارسل_نصا_لغة(&الإشعار);
        } وإلا إذا (الطريقة_هي(&(*الرسالة).الطريقة, «textDocument/didClose»)) {
            ليكن الإشعار: نص = إشعار_نشر_فحص_لغة(&الملف.العنوان, &الملف.العناصر);
            ارسل_نصا_لغة(&الإشعار);
        };
    };
}

عرف ارسل_وثيقة_لغة(الوثيقة: &وثيقة_جسون): منطقي {
    ليكن النص: نص = وثيقة_جسون_إلى_نص_لغة(الوثيقة);
    طابق اكتب_إطار_لغة(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(_) -> { أرجع صواب; };
}

عرف ارسل_خطأ_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرمز: عدد,
    الرسالة: نص
): منطقي {
    ليكن الوثيقة: وثيقة_جسون = ابن_رد_خطأ_جسون_اربيسي(المعرف, الرمز, الرسالة);
    أرجع ارسل_وثيقة_لغة(&الوثيقة);
}

// LSP: a request whose document cannot be analysed yet answers `null`, never an
// error; editors surface request errors as noise while the user types.
عرف ارسل_رد_عدم_لغة(المعرف: معرف_طلب_جسون_اربيسي): منطقي {
    ليكن الوثيقة: وثيقة_جسون = ابن_رد_عدم_جسون_اربيسي(المعرف);
    أرجع ارسل_وثيقة_لغة(&الوثيقة);
}

// ServerCancelled (-32802) for a pull-diagnostic request whose document
// changed before it ran: `data.retriggerRequest` asks the client to pull
// again for the new text (LSP 3.17 DiagnosticServerCancellationData).
عرف ارسل_إلغاء_تشخيص_لغة(المعرف: معرف_طلب_جسون_اربيسي): منطقي {
    ليكن الوثيقة: وثيقة_جسون = ابن_رد_خطأ_جسون_اربيسي(المعرف, -32802, «Document changed»);
    ليكن النص: نص = وثيقة_جسون_إلى_نص_لغة(&الوثيقة);
    ليكن الطول_الكلي: طبيعي = الطول(النص) مثل طبيعي;
    // The encoder writes `error` last, so the text ends with `}}`.
    إذا (الطول_الكلي < 2 || النص[الطول_الكلي - 1] != 125 || النص[الطول_الكلي - 2] != 125) {
        أرجع ارسل_وثيقة_لغة(&الوثيقة);
    };
    طابق مقطع_نص(&النص, 0, الطول_الكلي - 2) مع
    | اختياري.لا_شيء -> { أرجع ارسل_وثيقة_لغة(&الوثيقة); }
    | اختياري.موجود(البداية) -> {
        ليكن اللاحقة: نص = «,"data":{"retriggerRequest":true}}}»;
        ليكن الأجزاء: متجه نص = [البداية, اللاحقة];
        ليكن بلا_فاصل: نص = «»;
        ليكن الكامل: نص = صل_النصوص(&الأجزاء, &بلا_فاصل);
        طابق اكتب_إطار_لغة(&الكامل) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { أرجع صواب; };
    };
}

// Answers a request that will not run: cancelled (-32800) or made stale by a
// later change to its document (-32801; -32802 for pull diagnostics).
// Lifecycle requests always run.
عرف أجب_مسبقا_إن_لزم_لغة(
    المجدول: &متغير مجدول_طلبات_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي
): منطقي {
    طابق استنسخ(&(*الرسالة).المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(قيمة_المعرف) -> {
        ليكن المعرف: &معرف_طلب_جسون_اربيسي = &قيمة_المعرف;
        إذا (الطريقة_هي(&(*الرسالة).الطريقة, «initialize») || الطريقة_هي(&(*الرسالة).الطريقة, «shutdown»)) {
            أرجع خطأ;
        };
        اسحب_الجاهز_لغة(المجدول);
        إذا (ألغي_في_الطابور_لغة(المجدول, المعرف)) {
            ارسل_خطأ_لغة(استنسخ(المعرف), -32800, «Request cancelled»);
            أرجع صواب;
        };
        طابق استنسخ(&(*الرسالة).المعاملات) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعاملات) -> {
            طابق فك_طلب_مستند_لغة(الوثيقة, المعاملات) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الطلب) -> {
                إذا (تغير_المستند_لاحقا_لغة(المجدول, &الطلب.العنوان)) {
                    إذا (الطريقة_هي(&(*الرسالة).الطريقة, «textDocument/diagnostic»)) {
                        ارسل_إلغاء_تشخيص_لغة(استنسخ(المعرف));
                    } وإلا {
                        ارسل_خطأ_لغة(استنسخ(المعرف), -32801, «Content modified»);
                    };
                    أرجع صواب;
                };
            };
        };
    };
    أرجع خطأ;
}

// A request that did not run to its end: RequestCancelled (-32800) when the
// client cancelled it, ContentModified (-32801) when its document changed.
عرف ارسل_غير_حديث_لغة(المساحة: &مساحة_عمل_لغة, المعرف: معرف_طلب_جسون_اربيسي): منطقي {
    إذا (طلب_ملغى_لغة(المساحة) && احمل_ط32(اقرأ_مشترك(&(*المساحة).سبب_الإلغاء), ترتيب_ذاكرة.اكتساب()) == (1 مثل ط32)) {
        أرجع ارسل_خطأ_لغة(المعرف, -32800, «Request cancelled»);
    };
    أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»);
}

عرف ارسل_خطأ_بلا_معرف(الرمز: عدد, الرسالة: نص): منطقي {
    أرجع ارسل_خطأ_لغة(معرف_طلب_جسون_اربيسي.عدم(), الرمز, الرسالة);
}

عرف انشر_تشخيصات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    العنوان: &نص
): منطقي {
    إذا (!(*المساحة).ينشر_التشخيصات) { أرجع صواب; };
    طابق مستند_لغة_عند(&(*المساحة), العنوان) مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(المستند) -> {
        ليكن بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, &(*المساحة), &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> { أرجع صواب; }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            // لا يحق لنتيجة لقطة أقدم أن تستبدل حالة أحدث في المحرر.
            ليكن الحالة_الحالية: مساحة_عمل_لغة = *المساحة;
            إذا (طلب_ملغى_لغة(المساحة) || !لقطة_مستند_لغة_حديثة(
                &الحالة_الحالية, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع صواب;
            };
            طابق اللقطة.الواجهة مع
            | اختياري.لا_شيء -> {
                سجل_رفض_دلالات_مستند_لغة(
                    المساحة, &اللقطة.العنوان, اللقطة.المراجعة
                );
            }
            | اختياري.موجود(_) -> { };
            ليكن الرد: وثيقة_جسون = ابن_نشر_تشخيصات_مستند_لغة(
                &المستند, &اللقطة.التشخيصات
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}

عرف امسح_تشخيصات_مستند_لغة(العنوان: نص): منطقي {
    ليكن الرد: وثيقة_جسون = ابن_مسح_تشخيصات_مستند_لغة(العنوان);
    أرجع ارسل_وثيقة_لغة(&الرد);
}

عرف أجب_طلب_تشخيص_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    ليكن بلا_نتيجة_سابقة: اختياري نص = اختياري.لا_شيء();
    ليكن الطلب: متغير طلب_تشخيص_مستند_لغة = {
        العنوان: «»,
        معرف_النتيجة_السابق: بلا_نتيجة_سابقة
    };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
    }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_تشخيص_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
        }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };

    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختياري.لا_شيء -> {
        // Pull diagnostics حاليا تخص snapshots المفتوحة؛ لا نخمن محتوى وثيقة غير متزامنة.
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | اختياري.موجود(المستند) -> {
        إذا (هل_نتيجة_تشخيص_مستند_لغة_غير_متغيرة(
            حالة_المساحة.المراجعة, &الطلب.معرف_النتيجة_السابق
        )) {
            ليكن الرد: وثيقة_جسون = ابن_رد_تشخيصات_غير_متغيرة_لغة(
                المعرف, حالة_المساحة.المراجعة
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };

        ليكن بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            إذا (طلب_ملغى_لغة(المساحة)) { أرجع ارسل_إلغاء_تشخيص_لغة(المعرف); };
            أرجع ارسل_رد_عدم_لغة(المعرف);
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            // Cancelled or outdated: ServerCancelled asks the client to pull again.
            إذا (طلب_ملغى_لغة(المساحة) || !لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع ارسل_إلغاء_تشخيص_لغة(المعرف);
            };
            ليكن الزائدة: متجه نطاق_تغيير_لغة = نطاقات_استيرادات_زائدة_لغة(&اللقطة, &المستند);
            ليكن الرد: وثيقة_جسون = ابن_رد_تشخيصات_كاملة_لغة(
                المعرف, &المستند, حالة_المساحة.المراجعة, &اللقطة.التشخيصات, &الزائدة
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}

// Diagnostics follow open documents only (textDocument/diagnostic), as mature
// servers do; workspaceDiagnostics is not advertised. A client that asks anyway
// gets an empty report, so no file is marked from outside the editor.
عرف أجب_طلب_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن بلا_مصادر: متجه نص = [];
    ليكن بلا_سابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = [];
    ليكن فارغة: مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن الرد: وثيقة_جسون = ابن_رد_تشخيص_مساحة_لغة(
        المعرف, المساحة, &بلا_مصادر, &فارغة, 0, &بلا_سابقة
    );
    أرجع ارسل_وثيقة_لغة(&الرد);
}

عرف أجب_طلب_إجراء_شفرة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن موضع_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن موضع_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن نطاق_فارغ_لغة: نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_أ,
        النهاية: موضع_فارغ_ب
    };
    ليكن بلا_أنواع: متجه نص = [];
    ليكن الطلب: متغير طلب_إجراء_شفرة_لغة = {
        العنوان: «»,
        النطاق: نطاق_فارغ_لغة,
        يسمح_إصلاح_سريع: صواب,
        الأنواع: بلا_أنواع
    };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
    }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_إجراء_شفرة_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
        }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };

    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختياري.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | اختياري.موجود(المستند) -> {
        ليكن بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            أرجع ارسل_رد_عدم_لغة(المعرف);
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            إذا (طلب_ملغى_لغة(المساحة) || !لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع ارسل_غير_حديث_لغة(المساحة, المعرف);
            };
            ليكن الإضافية: متغير متجه إجراء_بسيط_لغة = [];
            ليكن الأخطاء: طبيعي = اللقطة.التشخيصات.عدد_الأخطاء;
            إذا (نوع_إجراء_مسموح_لغة(&الطلب, «quickfix»)) {
                ليكن الفهرس: متجه مدخل_فهرس_مكتبة_لغة = فهرس_مكتبة_من_ذاكرة_لغة(الذاكرة);
                ليكن الاستيرادات: متجه إجراء_بسيط_لغة = إجراءات_استيراد_مفقود_لغة(
                    &المستند, &اللقطة.التشخيصات, الطلب.النطاق, &الفهرس
                );
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الاستيرادات) مثل طبيعي)) { ألحق(الإضافية, استنسخ(&الاستيرادات[ف])); ف := ف + 1; }
            };
            // Organize imports re-checks the file, so it runs only when asked for
            // (Source Action menu, Organize Imports command, save actions).
            إذا ((الطول(الطلب.الأنواع) مثل طبيعي) > 0 && نوع_إجراء_مسموح_لغة(&الطلب, «source.organizeImports»)) {
                طابق إجراء_تنظيم_الاستيرادات_لغة(المساحة, &اللقطة, &المستند, الأخطاء) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الإجراء) -> { ألحق(الإضافية, الإجراء); };
            };
            ليكن محدد: منطقي = (الطلب.النطاق.البداية.السطر != الطلب.النطاق.النهاية.السطر)
                || (الطلب.النطاق.البداية.المحرف != الطلب.النطاق.النهاية.المحرف);
            إذا (محدد && نوع_إجراء_مسموح_لغة(&الطلب, «refactor.extract.variable»)) {
                طابق إجراء_استخراج_متغير_لغة(المساحة, &اللقطة, &المستند, الطلب.النطاق, الأخطاء) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الإجراء) -> { ألحق(الإضافية, الإجراء); };
            };
            إذا (محدد && نوع_إجراء_مسموح_لغة(&الطلب, «refactor.extract.function»)) {
                طابق إجراء_استخراج_دالة_لغة(المساحة, &اللقطة, &المستند, الطلب.النطاق, الأخطاء) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الإجراء) -> { ألحق(الإضافية, الإجراء); };
            };
            إذا (!محدد && نوع_إجراء_مسموح_لغة(&الطلب, «refactor.rewrite»)) {
                ليكن الشروط: متجه إجراء_بسيط_لغة = إجراءات_شرط_إذا_لغة(المساحة, &المستند, الطلب.النطاق.البداية, الأخطاء);
                ليكن ش: متغير طبيعي = 0;
                طالما (ش < (الطول(الشروط) مثل طبيعي)) { ألحق(الإضافية, استنسخ(&الشروط[ش])); ش := ش + 1; }
            };
            إذا (!محدد && نوع_إجراء_مسموح_لغة(&الطلب, «refactor.inline»)) {
                طابق إجراء_تضمين_متغير_لغة(المساحة, &اللقطة, &المستند, الطلب.النطاق.البداية, الأخطاء) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الإجراء) -> { ألحق(الإضافية, الإجراء); };
            };
            ليكن الرد: وثيقة_جسون = ابن_رد_إجراءات_شفرة_لغة(
                المعرف,
                &المستند,
                الطلب.النطاق,
                الطلب.يسمح_إصلاح_سريع,
                &اللقطة.التشخيصات,
                &الإضافية
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}


نوع سياق_طلب_دلالي_لغة = {
    المستند: مستند_لغة_مفتوح,
    اللقطة: لقطة_تحليل_واجهة_لغة
};

نوع نتيجة_تجهيز_طلب_دلالي_لغة =
    | جاهز بنوع سياق_طلب_دلالي_لغة
    | مستند_غير_مفتوح
    | مصدر_غير_قابل_للتحليل
    | محتوى_متغير
;

عرف جهز_طلب_دلالي_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الطلب: &طلب_موضع_مستند_لغة
): نتيجة_تجهيز_طلب_دلالي_لغة {
    ليكن ط: طلب_موضع_مستند_لغة = *الطلب;
    طابق مستند_لغة_عند(المساحة, &ط.العنوان) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح(); }
    | اختياري.موجود(المستند) -> {
        ليكن مسارات_الجذور: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &مسارات_الجذور, صواب
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            إذا (طلب_ملغى_لغة(المساحة)) { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير(); };
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل();
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            إذا (طلب_ملغى_لغة(المساحة) || !لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير();
            };
            ليكن السياق: سياق_طلب_دلالي_لغة = {
                المستند: المستند,
                اللقطة: اللقطة
            };
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق);
        };
    };
}

عرف جهز_طلب_دلالي_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الطلب: &طلب_موضع_مستند_لغة
): نتيجة_تجهيز_طلب_دلالي_لغة {
    ليكن ط: طلب_موضع_مستند_لغة = *الطلب;
    طابق مستند_لغة_عند(المساحة, &ط.العنوان) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح(); }
    | اختياري.موجود(المستند) -> {
        إذا (دلالات_مستند_مرفوضة_للمراجعة(&المستند)) {
            طابق ابن_لقطة_واجهة_بلا_دلالات_لغة(&المستند) مع
            | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل();
            }
            | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
                ليكن السياق: سياق_طلب_دلالي_لغة = {
                    المستند: المستند,
                    اللقطة: اللقطة
                };
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق);
            };
        };
        ليكن بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            إذا (طلب_ملغى_لغة(المساحة)) { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير(); };
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل();
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            إذا (طلب_ملغى_لغة(المساحة) || !لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير();
            };
            ليكن السياق: سياق_طلب_دلالي_لغة = {
                المستند: المستند,
                اللقطة: اللقطة
            };
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق);
        };
    };
}

عرف ارسل_خطأ_تجهيز_طلب_دلالي_لغة(
    المساحة: &مساحة_عمل_لغة,
    النتيجة: نتيجة_تجهيز_طلب_دلالي_لغة,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    طابق النتيجة مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> {
        أرجع ارسل_رد_عدم_لغة(المعرف);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> {
        أرجع ارسل_غير_حديث_لغة(المساحة, المعرف);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(_) -> { أرجع خطأ; };
}

عرف أجب_طلب_تحويم_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_موضع_مستند_لغة = {
        العنوان: «»,
        الموضع: الموضع_الفارغ
    };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &الطلب) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        ليكن النص: متغير اختياري نص = نص_تحويم_دلالي_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        ليكن النطاق: متغير اختياري نطاق_تغيير_لغة = نطاق_تحويم_دلالي_لغة(&السياق.اللقطة, &السياق.المستند, الطلب.الموضع);
        // While typing: answer from the last clean analysis if the layout matches.
        طابق النص مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            طابق لقطة_سليمة_لمستند_لغة(&(*الذاكرة), &السياق.المستند.العنوان) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(السليمة) -> {
                طابق اربط_سطرا_بنسخة_سابقة_لغة(&السليمة.المستند, &السياق.المستند, الطلب.الموضع.السطر, خطأ) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(السطر_السابق) -> {
                    ليكن الموضع_السابق: موضع_تغيير_لغة = { السطر: السطر_السابق, المحرف: الطلب.الموضع.المحرف };
                    النص := نص_تحويم_دلالي_لغة(&السليمة.اللقطة, &السليمة.المستند, الموضع_السابق);
                    // The range belongs to the earlier text; map its line back.
                    طابق نطاق_تحويم_دلالي_لغة(&السليمة.اللقطة, &السليمة.المستند, الموضع_السابق) مع
                    | اختياري.لا_شيء -> { النطاق := اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> {
                        ليكن البداية: موضع_تغيير_لغة = { السطر: الطلب.الموضع.السطر, المحرف: القيمة.البداية.المحرف };
                        ليكن النهاية: موضع_تغيير_لغة = { السطر: الطلب.الموضع.السطر, المحرف: القيمة.النهاية.المحرف };
                        ليكن المحول: نطاق_تغيير_لغة = { البداية: البداية, النهاية: النهاية };
                        النطاق := اختياري.موجود(المحول);
                    };
                };
            };
        };
        طابق النص مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> { النص := تحويم_كلمة_محجوزة_لغة(&السياق.المستند, الطلب.الموضع); };
        إذا ((*المساحة).عوازل_الاتجاه) {
            طابق النص مع
            | اختياري.موجود(القيمة) -> { النص := اختياري.موجود(اعزل_أسطر_عربية_لغة(&القيمة)); }
            | اختياري.لا_شيء -> { };
        };
        ليكن الرد: وثيقة_جسون = ابن_رد_تحويم_دلالي_لغة(المعرف, &النص, &النطاق);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> {
        أرجع ارسل_رد_عدم_لغة(المعرف);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> {
        أرجع ارسل_غير_حديث_لغة(المساحة, المعرف);
    };
}


عرف أجب_طلب_إكمال_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    ليكن ر: رسالة_جسون_اربيسي = *الرسالة;
    ليكن الموضع_الفارغ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    ليكن الطلب: متغير طلب_موضع_مستند_لغة = { العنوان: «», الموضع: الموضع_الفارغ };
    طابق ر.المعاملات مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختياري.موجود(المعاملات) -> {
        طابق فك_طلب_موضع_مستند_لغة(الوثيقة, استنسخ(&المعاملات)) مع
        | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختياري.موجود(القيمة) -> { الطلب := القيمة; };
    };
    // The compiler answers completion on the unfinished text
    // (حلل_للإكمال_لغة → tooling_completion.sn); the server adds keywords
    // and, for a bare name, auto-import items from the std index.
    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختياري.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | اختياري.موجود(المستند) -> {
        ليكن البايت: متغير طبيعي = 0;
        طابق موضع_لغة_إلى_إزاحة_بايت(&المستند, الطلب.الموضع) مع
        | نتيجة.خطأ(_) -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid position»); }
        | نتيجة.نجح(القيمة) -> { البايت := القيمة; };
        ليكن بلا_جذور: متجه نص = [];
        ليكن الاقتراحات: متغير متجه اقتراح_إكمال_دلالي_لغة = [];
        ليكن السياق: متغير سياق_إكمال = سياق_إكمال.لا_شيء();
        طابق حلل_للإكمال_لغة(المساحة, &المستند, &بلا_جذور, البايت) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التحليل) -> {
            ليكن الجواب: إكمال_رقعة_لغة = اقتراحات_إكمال_بالرقعة_لغة(&التحليل, &المستند, الطلب.الموضع);
            السياق := الجواب.السياق;
            الاقتراحات := استنسخ(&الجواب.الاقتراحات);
        };
        إذا (طلب_ملغى_لغة(المساحة)) { أرجع ارسل_غير_حديث_لغة(المساحة, المعرف); };
        ليكن غير_مكتمل: متغير منطقي = خطأ;
        إذا (السياق == سياق_إكمال.اسم()) {
            ليكن الفهرس: متجه مدخل_فهرس_مكتبة_لغة = فهرس_مكتبة_من_ذاكرة_لغة(الذاكرة);
            ليكن المستوردة: متجه اقتراح_إكمال_دلالي_لغة = اقتراحات_استيراد_تلقائي_لغة(
                &المستند, الطلب.الموضع, &الفهرس, &الاقتراحات
            );
            // Auto-import items start at two letters and stop at 40.
            ليكن البادئة: نص = بادئة_مكتوبة_لغة(&المستند, الطلب.الموضع);
            غير_مكتمل := (الطول(البادئة) مثل طبيعي) < 2 || (الطول(المستوردة) مثل طبيعي) >= 40;
            ليكن ف_م: متغير طبيعي = 0;
            طالما (ف_م < (الطول(المستوردة) مثل طبيعي)) {
                ألحق(الاقتراحات, استنسخ(&المستوردة[ف_م]));
                ف_م := ف_م + 1;
            }
        };
        ليكن الرد: وثيقة_جسون = ابن_رد_إكمال_دلالي_لغة(المعرف, &الاقتراحات, غير_مكتمل);
        أرجع ارسل_وثيقة_لغة(&الرد);
    };
}

عرف أجب_طلب_مساعدة_توقيع_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
