استورد std.io.read_line;
استورد std.io.print;
استورد std.text.search;
استورد std.text.transform;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.from_bytes;

عام نوع نتيجة_قراءة_إطار_لغة =
    | نهاية
    | إطار بنوع نص
    | خطأ_دخل بنوع عدد
    | رأس_غير_صالح
    | طول_غير_صالح
    | جسم_مبتور
;

عام عرف اقرأ_إطار_لغة(): نتيجة_قراءة_إطار_لغة {
    ليكن طول_الجسم: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن قرأ_رأسا: متغير منطقي = خطأ;
    ليكن مستمر: متغير منطقي = صواب;
    ليكن بادئة_الطول: نص = «Content-Length:»;

    طالما (مستمر) {
        ليكن السطر: متغير نص = «»;
        طابق اقرأ_السطر() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_إطار_لغة.خطأ_دخل(الخطأ); }
        | نتيجة.نجح(القيمة) -> { السطر := القيمة; };

        // read_line يعيد نصا فارغا عند EOF قبل أي بايت.
        إذا ((الطول(السطر) == 0) && !قرأ_رأسا) {
            أرجع نتيجة_قراءة_إطار_لغة.نهاية();
        };

        ليكن المنقح: نص = قص_النص(&السطر);
        إذا (الطول(المنقح) == 0) {
            مستمر := خطأ;
        } وإلا {
            قرأ_رأسا := صواب;
            إذا (يبدأ_بـ(&المنقح, &بادئة_الطول)) {
                ليكن بداية: طبيعي = الطول(بادئة_الطول) مثل طبيعي;
                طابق مقطع_نص(
                    &المنقح,
                    بداية,
                    (الطول(المنقح) مثل طبيعي) - بداية
                ) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_قراءة_إطار_لغة.طول_غير_صالح(); }
                | اختياري.موجود(جزء_الطول) -> {
                    ليكن نص_الطول: نص = قص_النص(&جزء_الطول);
                    طابق حلل_طبيعي(&نص_الطول) مع
                    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_إطار_لغة.طول_غير_صالح(); }
                    | نتيجة.نجح(القيمة) -> { طول_الجسم := اختياري.موجود(القيمة); };
                };
            };
        };
    }

    ليكن العدد: متغير طبيعي = 0;
    طابق طول_الجسم مع
    | اختياري.لا_شيء -> { أرجع نتيجة_قراءة_إطار_لغة.رأس_غير_صالح(); }
    | اختياري.موجود(القيمة) -> { العدد := القيمة; };

    طابق اقرأ_بالضبط(العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_إطار_لغة.خطأ_دخل(الخطأ); }
    | نتيجة.نجح(القراءة) -> {
        إذا ((الطول(القراءة.البايتات) مثل طبيعي) != العدد) {
            أرجع نتيجة_قراءة_إطار_لغة.جسم_مبتور();
        };
        أرجع نتيجة_قراءة_إطار_لغة.إطار(من_بايتات(&القراءة.البايتات));
    };
}

عام عرف اكتب_إطار_لغة(الجسم: &نص): نتيجة عدد, عدد {
    ليكن النص: نص = *الجسم;
    ليكن طول_النص: نص = طبيعي_إلى_نص(الطول(النص) مثل طبيعي);
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن البادئة: نص = «Content-Length: »;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البادئة) مثل طبيعي)) { ألحق(البايتات, البادئة[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(طول_النص) مثل طبيعي)) { ألحق(البايتات, طول_النص[ف]); ف := ف + 1; }
    ألحق(البايتات, 13);
    ألحق(البايتات, 10);
    ألحق(البايتات, 13);
    ألحق(البايتات, 10);
    ف := 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }

    // std owns stdout byte-write semantics; LSP only composes one protocol frame.
    أرجع اكتب_بايتات_خرج(&البايتات);
}
