عرف الطريقة_هي(الطريقة: &نص, المطلوب: نص): منطقي {
    دع القيمة: نص = المطلوب;
    أرجع نصان_متساويان(الطريقة, &القيمة);
}

عرف مسارات_جذور_مشروع_لغة(الجذور: &جذور_مساحة_عمل_لغة): متجه نص {
    دع الحالة: جذور_مساحة_عمل_لغة = *الجذور;
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المجلدات) مثل غير_موقع)) {
        دع مرجع_المجلد: &مجلد_مساحة_عمل_لغة = &الحالة.المجلدات[ف];
        دع المجلد: مجلد_مساحة_عمل_لغة = *مرجع_المجلد;
        طابق المجلد.مسار_الملف مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المسار) -> { ألحق(الناتج, المسار); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ارسل_وثيقة_لغة(الوثيقة: &وثيقة_جسون): منطقي {
    طابق جسون_إلى_نص(الوثيقة) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(النص) -> {
        طابق اكتب_إطار_لغة(&النص) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { أرجع صواب; };
    };
}

عرف ارسل_خطأ_لغة(
    المعرف: معرف_طلب_جسون_اربيسي,
    الرمز: عدد,
    الرسالة: نص
): منطقي {
    دع الوثيقة: وثيقة_جسون = ابن_رد_خطأ_جسون_اربيسي(المعرف, الرمز, الرسالة);
    أرجع ارسل_وثيقة_لغة(&الوثيقة);
}

عرف ارسل_خطأ_بلا_معرف(الرمز: عدد, الرسالة: نص): منطقي {
    أرجع ارسل_خطأ_لغة(معرف_طلب_جسون_اربيسي.عدم(), الرمز, الرسالة);
}

عرف انشر_تشخيصات_مستند_لغة(
    المساحة: &متغير مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    العنوان: &نص
): منطقي {
    دع لقطة_المساحة: مساحة_عمل_لغة = *المساحة;
    طابق مستند_لغة_عند(&لقطة_المساحة, العنوان) مع
    | اختيار.لا_شيء -> { أرجع صواب; }
    | اختيار.بعض(المستند) -> {
        دع بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, &لقطة_المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> { أرجع صواب; }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            // لا يحق لنتيجة لقطة أقدم أن تستبدل حالة أحدث في المحرر.
            دع الحالة_الحالية: مساحة_عمل_لغة = *المساحة;
            لو (!لقطة_مستند_لغة_حديثة(
                &الحالة_الحالية, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع صواب;
            };
            طابق اللقطة.الواجهة مع
            | اختيار.لا_شيء -> {
                سجل_رفض_دلالات_مستند_لغة(
                    المساحة, &اللقطة.العنوان, اللقطة.المراجعة
                );
            }
            | اختيار.بعض(_) -> { };
            دع الرد: وثيقة_جسون = ابن_نشر_تشخيصات_مستند_لغة(
                &المستند, &اللقطة.التشخيصات
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}

عرف امسح_تشخيصات_مستند_لغة(العنوان: نص): منطقي {
    دع الرد: وثيقة_جسون = ابن_مسح_تشخيصات_مستند_لغة(العنوان);
    أرجع ارسل_وثيقة_لغة(&الرد);
}

عرف أجب_طلب_تشخيص_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    دع بلا_نتيجة_سابقة: اختيار نص = اختيار.لا_شيء();
    دع الطلب: متغير طلب_تشخيص_مستند_لغة = {
        العنوان: «»,
        معرف_النتيجة_السابق: بلا_نتيجة_سابقة
    };
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
    }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_طلب_تشخيص_مستند_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
        }
        | اختيار.بعض(القيمة) -> { الطلب := القيمة; };
    };

    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختيار.لا_شيء -> {
        // Pull diagnostics حاليا تخص snapshots المفتوحة؛ لا نخمن محتوى وثيقة غير متزامنة.
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | اختيار.بعض(المستند) -> {
        لو (هل_نتيجة_تشخيص_مستند_لغة_غير_متغيرة(
            حالة_المساحة.المراجعة, &الطلب.معرف_النتيجة_السابق
        )) {
            دع الرد: وثيقة_جسون = ابن_رد_تشخيصات_غير_متغيرة_لغة(
                المعرف, حالة_المساحة.المراجعة
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };

        دع بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document cannot be analyzed»);
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            لو (!لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»);
            };
            دع الرد: وثيقة_جسون = ابن_رد_تشخيصات_كاملة_لغة(
                المعرف, &المستند, حالة_المساحة.المراجعة, &اللقطة.التشخيصات
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}

عرف أجب_طلب_تشخيص_مساحة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع بلا_نتائج_سابقة: متجه نتيجة_سابقة_لتشخيص_مساحة_لغة = [];
    دع الطلب: متغير طلب_تشخيص_مساحة_لغة = { النتائج_السابقة: بلا_نتائج_سابقة };
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_طلب_تشخيص_مساحة_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختيار.بعض(القيمة) -> { الطلب := القيمة; };
    };
    دع المسارات_الجذرية: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
    دع المصادر: متغير متجه نص = [];
    طابق اكتشف_مسارات_مصادر_مشروع_لغة(&المسارات_الجذرية) مع
    | نتيجة_اكتشاف_مصادر_مشروع_لغة.فشل -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Workspace sources cannot be discovered»);
    }
    | نتيجة_اكتشاف_مصادر_مشروع_لغة.مكتملة(القيم) -> { المصادر := القيم; };

    دع حالة_المساحة: مساحة_عمل_لغة = *المساحة;
    دع معرف_اللقطة: نص = معرف_نتيجة_تشخيص_مساحة_لغة(حالة_المساحة.المراجعة, 0);
    دع التشخيصات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    لو (!تقارير_تشخيص_مساحة_لغة_غير_متغيرة(
        المساحة, &المصادر, &الطلب.النتائج_السابقة, &معرف_اللقطة
    )) {
        طابق حلل_مشروع_بذاكرة_لغة(الذاكرة, المساحة, &المسارات_الجذرية) مع
        | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> { }
        | نتيجة_تحليل_مشروع_لغة.مرفوضة(المجموعة) -> { التشخيصات := المجموعة; }
        | نتيجة_تحليل_مشروع_لغة.مكتملة(الواجهة) -> {
            // A recovered tooling snapshot remains semantically queryable while its
            // compiler-owned diagnostics still belong in workspace/diagnostic.
            ادمج_مجموعة_تشخيصات(&متغير التشخيصات, &الواجهة.تشخيصات_الأدوات);
        };
    };
    دع الرد: وثيقة_جسون = ابن_رد_تشخيص_مساحة_لغة(
        المعرف, المساحة, &المصادر, &التشخيصات, 0, &الطلب.النتائج_السابقة
    );
    أرجع ارسل_وثيقة_لغة(&الرد);
}

عرف أجب_طلب_إجراء_شفرة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع موضع_فارغ_أ: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع موضع_فارغ_ب: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع نطاق_فارغ_لغة: نطاق_تغيير_لغة = {
        البداية: موضع_فارغ_أ,
        النهاية: موضع_فارغ_ب
    };
    دع الطلب: متغير طلب_إجراء_شفرة_لغة = {
        العنوان: «»,
        النطاق: نطاق_فارغ_لغة,
        يسمح_إصلاح_سريع: صواب
    };
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
    }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_طلب_إجراء_شفرة_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
        }
        | اختيار.بعض(القيمة) -> { الطلب := القيمة; };
    };

    طابق مستند_لغة_عند(المساحة, &الطلب.العنوان) مع
    | اختيار.لا_شيء -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»);
    }
    | اختيار.بعض(المستند) -> {
        دع بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document cannot be analyzed»);
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            لو (!لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»);
            };
            دع الرد: وثيقة_جسون = ابن_رد_إجراءات_شفرة_لغة(
                المعرف,
                &المستند,
                الطلب.النطاق,
                الطلب.يسمح_إصلاح_سريع,
                &اللقطة.التشخيصات
            );
            أرجع ارسل_وثيقة_لغة(&الرد);
        };
    };
}


نوع سياق_طلب_دلالي_لغة = {
    المستند: مستند_لغة_مفتوح,
    اللقطة: لقطة_تحليل_واجهة_لغة
};

نوع نتيجة_تجهيز_طلب_دلالي_لغة =
    | جاهز بنوع سياق_طلب_دلالي_لغة
    | مستند_غير_مفتوح
    | مصدر_غير_قابل_للتحليل
    | محتوى_متغير
;

عرف جهز_طلب_دلالي_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الطلب: &طلب_موضع_مستند_لغة
): نتيجة_تجهيز_طلب_دلالي_لغة {
    دع ط: طلب_موضع_مستند_لغة = *الطلب;
    طابق مستند_لغة_عند(المساحة, &ط.العنوان) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح(); }
    | اختيار.بعض(المستند) -> {
        دع مسارات_الجذور: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &مسارات_الجذور, صواب
        ) مع
        | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل();
        }
        | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
            لو (!لقطة_مستند_لغة_حديثة(
                المساحة, &اللقطة.العنوان, اللقطة.الإصدار, اللقطة.المراجعة
            )) {
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير();
            };
            دع السياق: سياق_طلب_دلالي_لغة = {
                المستند: المستند,
                اللقطة: اللقطة
            };
            أرجع نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق);
        };
    };
}

عرف جهز_طلب_دلالي_مستند_لغة(
    المساحة: &مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الطلب: &طلب_موضع_مستند_لغة
): نتيجة_تجهيز_طلب_دلالي_لغة {
    دع ط: طلب_موضع_مستند_لغة = *الطلب;
    طابق مستند_لغة_عند(المساحة, &ط.العنوان) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح(); }
    | اختيار.بعض(المستند) -> {
        لو (دلالات_مستند_مرفوضة_للمراجعة(&المستند)) {
            طابق ابن_لقطة_واجهة_بلا_دلالات_لغة(&المستند) مع
            | نتيجة_تحليل_واجهة_لغة.مصدر_غير_قابل_للتحليل -> {
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل();
            }
            | نتيجة_تحليل_واجهة_لغة.مكتملة(اللقطة) -> {
                دع السياق: سياق_طلب_دلالي_لغة = {
                    المستند: المستند,
                    اللقطة: اللقطة
                };
                أرجع نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق);
            };
        };
        دع بلا_جذور: متجه نص = [];
        طابق حلل_مستند_بذاكرة_لغة(
            الذاكرة, المساحة, &المستند, &بلا_جذور, خطأ
