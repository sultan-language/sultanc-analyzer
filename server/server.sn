                        || الطريقة_هي(&الرسالة.الطريقة, «textDocument/didChange»)
                        || الطريقة_هي(&الرسالة.الطريقة, «textDocument/didSave»)
                        || الطريقة_هي(&الرسالة.الطريقة, «textDocument/didClose»)
                    ) {
                        طابق الرسالة.المعرف مع
                        | اختيار.بعض(المعرف) -> {
                            ارسل_خطأ_لغة(المعرف, -32600, «text document synchronization methods must be notifications»);
                        }
                        | اختيار.لا_شيء -> {
                            لو (الحالة == حالة_خادم_لغة.يعمل()) {
                                طبق_إشعار_مستند(&متغير المساحة, &متغير ذاكرة_التحليل, &الوثيقة, &الرسالة);
                            };
                        };
                    } وإلا {
                        طابق الرسالة.المعرف مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(المعرف) -> {
                            لو ((الحالة == حالة_خادم_لغة.قبل_التهيئة()) ||
                                (الحالة == حالة_خادم_لغة.ينتظر_التهيئة())) {
                                ارسل_خطأ_لغة(المعرف, -32002, «Server not initialized»);
                            } وإلا لو (الحالة == حالة_خادم_لغة.أوقف()) {
                                ارسل_خطأ_لغة(المعرف, -32600, «Server is shutting down»);
                            } وإلا {
                                ارسل_خطأ_لغة(المعرف, -32601, «Method not found»);
                            };
                        };
                    };
                };
            };
        };
    }
    أرجع رمز_الخروج;
}
