    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»); };
}


عرف أجب_طلب_رموز_دلالية_كاملة_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختيار.بعض(القيمة) -> { الطلب := القيمة; };
    };
    دع الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع مرجع_العنوان: &نص = &الطلب.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: العنوان, الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        دع الظهورات: متجه ظهور_مصنف_لغة = ظهورات_مصنفة_دلاليا_لغة(&السياق.اللقطة, &السياق.المستند);
        دع الرد: وثيقة_جسون = ابن_رد_رموز_دلالية_كاملة_لغة(المعرف, &الظهورات);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document cannot be analyzed»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»); };
}

عرف أجب_طلب_رموز_مستند_دلالية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع الطلب: متغير طلب_مستند_لغة = { العنوان: «» };
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_طلب_مستند_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختيار.بعض(القيمة) -> { الطلب := القيمة; };
    };
    دع الموضع: موضع_تغيير_لغة = { السطر: 0, المحرف: 0 };
    دع مرجع_العنوان: &نص = &الطلب.العنوان;
    دع العنوان: نص = *مرجع_العنوان;
    دع طلب_الموضع: طلب_موضع_مستند_لغة = { العنوان: العنوان, الموضع: الموضع };
    طابق جهز_طلب_دلالي_مستند_لغة(المساحة, الذاكرة, &طلب_الموضع) مع
    | نتيجة_تجهيز_طلب_دلالي_لغة.جاهز(السياق) -> {
        دع الرموز: متجه رمز_معلن_لغة = رموز_مستند_دلالية_لغة(&السياق.اللقطة, &السياق.المستند);
        دع الرد: وثيقة_جسون = ابن_رد_رموز_مستند_دلالية_لغة(المعرف, &الرموز);
        أرجع ارسل_وثيقة_لغة(&الرد);
    }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مستند_غير_مفتوح -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document is not open»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.مصدر_غير_قابل_للتحليل -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Document cannot be analyzed»); }
    | نتيجة_تجهيز_طلب_دلالي_لغة.محتوى_متغير -> { أرجع ارسل_خطأ_لغة(المعرف, -32801, «Content modified»); };
}

عرف أجب_طلب_رموز_مساحة_عمل_دلالية_لغة(
    المساحة: &مساحة_عمل_لغة,
    الجذور: &جذور_مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي,
    المعرف: معرف_طلب_جسون_اربيسي
): منطقي {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    دع الاستعلام: متغير نص = «»;
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
    | اختيار.بعض(المعاملات) -> {
        طابق فك_استعلام_رموز_مساحة_عمل_لغة(الوثيقة, المعاملات) مع
        | اختيار.لا_شيء -> { أرجع ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»); }
        | اختيار.بعض(القيمة) -> { الاستعلام := القيمة; };
    };
    // الاستعلام الفارغ لا يبرر تحليل مساحة العمل كاملة. مواصفة LSP تسمح برد
    // فارغ، والعمل الحقيقي يبدأ عندما يرسل العميل نص البحث الفعلي.
    لو ((الطول(الاستعلام) مثل غير_موقع) == 0) {
        دع الرموز_الفارغة: متجه رمز_معلن_لغة = [];
        دع الرد_الفارغ: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز_الفارغة);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    };
    // إذا رفضت الواجهة الدلالية المراجعة الحالية لأي مستند مفتوح، فلا توجد
    // لقطة مشروع جزئية مقننة يمكن لـ LSP استعمالها بأمان. إعادة تحليل المشروع
    // هنا قد تعيد نفس الرفض المكلف؛ نرجع نتيجة فارغة حتى تتغير مراجعة المستند.
    لو (توجد_دلالات_مرفوضة_في_مساحة_العمل_لغة(المساحة)) {
        دع الرموز_الفارغة: متجه رمز_معلن_لغة = [];
        دع الرد_الفارغ: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز_الفارغة);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    };
    دع المسارات: متجه نص = مسارات_جذور_مشروع_لغة(الجذور);
    طابق حلل_مشروع_بذاكرة_لغة(الذاكرة, المساحة, &المسارات) مع
    | نتيجة_تحليل_مشروع_لغة.غير_قابل_للتحليل -> {
        أرجع ارسل_خطأ_لغة(المعرف, -32602, «Workspace cannot be analyzed»);
    }
    | نتيجة_تحليل_مشروع_لغة.مرفوضة(_) -> {
        دع الرموز_الفارغة: متجه رمز_معلن_لغة = [];
        دع الرد_الفارغ: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز_الفارغة);
        أرجع ارسل_وثيقة_لغة(&الرد_الفارغ);
    }
    | نتيجة_تحليل_مشروع_لغة.مكتملة(الواجهة) -> {
        دع جميع_الرموز: متجه رمز_معلن_لغة = رموز_واجهة_مشروع_دلالية_لغة(&الواجهة);
        دع الرموز: متغير متجه رمز_معلن_لغة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(جميع_الرموز) مثل غير_موقع)) {
            دع مرجع_الرمز: &رمز_معلن_لغة = &جميع_الرموز[ف];
            دع الرمز: رمز_معلن_لغة = *مرجع_الرمز;
            لو (((الطول(الاستعلام) مثل غير_موقع) == 0) || يحتوي_نصا(&الرمز.الاسم, &الاستعلام)) {
                ألحق(الرموز, الرمز);
            };
            ف := ف + 1;
        }
        دع الرد: وثيقة_جسون = ابن_رد_رموز_مساحة_عمل_دلالية_لغة(المعرف, &الرموز);
        أرجع ارسل_وثيقة_لغة(&الرد);
    };
}

عرف طبق_إشعار_مستند(
    المساحة: &متغير مساحة_عمل_لغة,
    الذاكرة: &متغير ذاكرة_تحليل_لغة,
    الوثيقة: &وثيقة_جسون,
    الرسالة: &رسالة_جسون_اربيسي
): فراغ {
    دع ر: رسالة_جسون_اربيسي = *الرسالة;
    طابق ر.المعاملات مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(المعاملات) -> {
        لو (الطريقة_هي(&ر.الطريقة, «textDocument/didOpen»)) {
            طابق فك_فتح_مستند_لغة(الوثيقة, المعاملات) مع
            | اختيار.بعض(فتح) -> {
                دع مرجع_عنوان_الفتح: &نص = &فتح.العنوان;
                دع عنوان_الفتح: نص = *مرجع_عنوان_الفتح;
                دع عنوان_النشر: نص = *مرجع_عنوان_الفتح;
                دع مرجع_لغة_الفتح: &نص = &فتح.اللغة;
                دع لغة_الفتح: نص = *مرجع_لغة_الفتح;
                دع مرجع_نص_الفتح: &نص = &فتح.النص;
                دع نص_الفتح: نص = *مرجع_نص_الفتح;
                دع إصدار_الفتح: عدد = فتح.الإصدار;
                لو (افتح_مستند_لغة(
                    المساحة,
                    عنوان_الفتح,
                    لغة_الفتح,
                    إصدار_الفتح,
                    نص_الفتح
                )) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &عنوان_النشر);
                };
            }
            | اختيار.لا_شيء -> { };
            أرجع;
        };
        لو (الطريقة_هي(&ر.الطريقة, «textDocument/didChange»)) {
            طابق فك_تغيير_مستند_لغة(الوثيقة, المعاملات) مع
            | اختيار.بعض(تغيير) -> {
                لو (طبق_تغييرات_مستند_لغة(المساحة, &تغيير)) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &تغيير.العنوان);
                };
            }
            | اختيار.لا_شيء -> { };
            أرجع;
        };
        لو (الطريقة_هي(&ر.الطريقة, «textDocument/didSave»)) {
            طابق فك_حفظ_مستند_لغة(الوثيقة, المعاملات) مع
            | اختيار.بعض(حفظ) -> {
                لو (احفظ_مستند_لغة(المساحة, &حفظ.العنوان, &حفظ.النص)) {
                    انشر_تشخيصات_مستند_لغة(المساحة, الذاكرة, &حفظ.العنوان);
                };
            }
            | اختيار.لا_شيء -> { };
            أرجع;
        };
        لو (الطريقة_هي(&ر.الطريقة, «textDocument/didClose»)) {
            طابق فك_إغلاق_مستند_لغة(الوثيقة, المعاملات) مع
            | اختيار.بعض(إغلاق) -> {
                دع مرجع_عنوان_الإغلاق: &نص = &إغلاق.العنوان;
                دع عنوان_الإغلاق: نص = *مرجع_عنوان_الإغلاق;
                دع عنوان_المسح: نص = *مرجع_عنوان_الإغلاق;
                لو (اغلق_مستند_لغة(المساحة, &عنوان_الإغلاق)) {
                    امسح_تشخيصات_مستند_لغة(عنوان_المسح);
                };
            }
            | اختيار.لا_شيء -> { };
            أرجع;
        };
    };
}

عام عرف شغل_خادم_لغة_سلطان(): عدد {
    دع الحالة: متغير حالة_خادم_لغة = حالة_خادم_لغة.قبل_التهيئة();
    دع المساحة: متغير مساحة_عمل_لغة = مساحة_عمل_لغة_جديدة();
    دع الجذور: متغير جذور_مساحة_عمل_لغة = جذور_مساحة_عمل_لغة_جديدة();
    دع ذاكرة_التحليل: متغير ذاكرة_تحليل_لغة = ذاكرة_تحليل_لغة_جديدة();
    دع مستمر: متغير منطقي = صواب;
    دع رمز_الخروج: متغير عدد = 0;

    بينما (مستمر) {
        دع جسم: متغير نص = «»;
        طابق اقرأ_إطار_لغة() مع
        | نتيجة_قراءة_إطار_لغة.نهاية -> { مستمر := خطأ; }
        | نتيجة_قراءة_إطار_لغة.إطار(النص) -> { جسم := النص; }
        | _ -> {
            ارسل_خطأ_بلا_معرف(-32700, «Parse error»);
            رمز_الخروج := 1;
            مستمر := خطأ;
        };
        لو (!مستمر) { }
        وإلا {
            طابق حلل_جسون(&جسم) مع
            | نتيجة.خطأ(_) -> {
                ارسل_خطأ_بلا_معرف(-32700, «Parse error»);
            }
            | نتيجة.نجح(الوثيقة) -> {
                طابق فك_رسالة_جسون_اربيسي(&الوثيقة) مع
                | نتيجة.خطأ(_) -> {
                    ارسل_خطأ_بلا_معرف(-32600, «Invalid Request»);
                }
                | نتيجة.نجح(الرسالة) -> {
                    لو (الطريقة_هي(&الرسالة.الطريقة, «exit»)) {
                        طابق الرسالة.المعرف مع
                        | اختيار.بعض(المعرف) -> {
                            ارسل_خطأ_لغة(المعرف, -32600, «exit must be a notification»);
                        }
                        | اختيار.لا_شيء -> {
                            لو (الحالة == حالة_خادم_لغة.أوقف()) { رمز_الخروج := 0; }
                            وإلا { رمز_الخروج := 1; };
                            مستمر := خطأ;
                        };
                    } وإلا لو (الحالة == حالة_خادم_لغة.أوقف()) {
                        طابق الرسالة.المعرف مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(المعرف) -> {
                            ارسل_خطأ_لغة(المعرف, -32600, «Server is shutting down»);
                        };
                    } وإلا لو (الطريقة_هي(&الرسالة.الطريقة, «initialize»)) {
                        طابق الرسالة.المعرف مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(المعرف) -> {
                            لو (الحالة != حالة_خادم_لغة.قبل_التهيئة()) {
                                ارسل_خطأ_لغة(المعرف, -32600, «initialize may only be sent once»);
                            } وإلا {
                                طابق الرسالة.المعاملات مع
                                | اختيار.لا_شيء -> {
                                    ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
                                }
                                | اختيار.بعض(المعاملات) -> {
                                    طابق فك_معاملات_تهيئة_لغة(&الوثيقة, المعاملات) مع
                                    | اختيار.لا_شيء -> {
                                        ارسل_خطأ_لغة(المعرف, -32602, «Invalid params»);
                                    }
                                    | اختيار.بعض(تهيئة) -> {
                                        هيئ_جذور_مساحة_عمل_لغة(&متغير الجذور, &تهيئة);
                                        دع الرد: وثيقة_جسون = ابن_رد_تهيئة_خادم_لغة(المعرف);
                                        لو (!ارسل_وثيقة_لغة(&الرد)) {
                                            رمز_الخروج := 1;
                                            مستمر := خطأ;
                                        } وإلا {
                                            الحالة := حالة_خادم_لغة.ينتظر_التهيئة();
                                        };
                                    };
                                };
                            };
                        };
                    } وإلا لو (الطريقة_هي(&الرسالة.الطريقة, «initialized»)) {
                        طابق الرسالة.المعرف مع
                        | اختيار.بعض(المعرف) -> {
                            ارسل_خطأ_لغة(المعرف, -32600, «initialized must be a notification»);
                        }
                        | اختيار.لا_شيء -> {
                            لو (الحالة == حالة_خادم_لغة.ينتظر_التهيئة()) {
                                الحالة := حالة_خادم_لغة.يعمل();
                            };
                        };
                    } وإلا لو (الطريقة_هي(&الرسالة.الطريقة, «shutdown»)) {
                        طابق الرسالة.المعرف مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(المعرف) -> {
                            لو (الحالة == حالة_خادم_لغة.قبل_التهيئة()) {
                                ارسل_خطأ_لغة(المعرف, -32002, «Server not initialized»);
                            } وإلا لو (الحالة == حالة_خادم_لغة.أوقف()) {
                                ارسل_خطأ_لغة(المعرف, -32600, «Server is shutting down»);
